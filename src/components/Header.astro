---
const mainLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/categoria/ia', label: '🤖 IA' },
  { href: '/categoria/errores', label: '🛠️ Errores' },
  { href: '/categoria/comparativas', label: '⚖️ Comparativas' },
  { href: '/categoria/alternativas', label: '🔄 Alternativas' },
  { href: '/herramientas', label: '🧲 Herramientas' },
];

const moreLinks = [
  { href: '/categoria/streaming', label: '📺 Streaming y TV', desc: 'Smart TV, Fire Stick y más' },
  { href: '/categoria/windows-linux', label: '🖥️ Windows, Mac y Linux', desc: 'Optimización y trucos PC' },
  { href: '/categoria/freelance', label: '💼 Trabajo Remoto', desc: 'Teletrabajo y herramientas' },
  { href: '/categoria/finanzas', label: '💰 Finanzas', desc: 'Inversión, cripto y ahorro' },
  { href: '/categoria/ciberseguridad', label: '🔒 Seguridad', desc: 'VPNs, privacidad y estafas' },
  { href: '/categoria/tecnologia', label: '💻 Tecnología', desc: 'Apps, gadgets y trucos' },
  { href: '/categoria/guias', label: '📖 Guías', desc: 'Tutoriales paso a paso' },
  { href: '/categoria/salud', label: '🏥 Salud Digital', desc: 'Bienestar y tecnología' },
  { href: '/categoria/hogar', label: '🏠 Hogar Inteligente', desc: 'Smart home y gadgets' },
  { href: '/categoria/gaming', label: '🎮 Gaming y PC', desc: 'Juegos y hardware' },
  { href: '/categoria/movil', label: '📱 Apps Móviles', desc: 'Android e iOS' },
  { href: '/categoria/familia', label: '👶 Familia y Niños', desc: 'Internet seguro' },
  { href: '/categoria/educacion', label: '🎓 Educación Online', desc: 'Cursos y aprendizaje' },
  { href: '/categoria/productividad', label: '⚡ Productividad', desc: 'Trabaja más inteligente' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">⚡</span>
      <span class="logo-text">GuíaTecnes</span>
    </a>

    <nav class="main-nav" id="main-nav">
      {mainLinks.map(link => (
        <a href={link.href} class={`nav-link ${currentPath === link.href ? 'active' : ''}`}>
          {link.label}
        </a>
      ))}

      <!-- Dropdown: Más categorías -->
      <div class="dropdown">
        <button class="nav-link dropdown-btn" aria-haspopup="true" aria-expanded="false" id="dropdown-btn">
          Más ▾
        </button>
        <div class="dropdown-menu" id="dropdown-menu" role="menu">
          <div class="dropdown-grid">
            {moreLinks.map(link => (
              <a href={link.href} class="dropdown-item" role="menuitem">
                <span class="di-label">{link.label}</span>
                <span class="di-desc">{link.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <button class="search-trigger theme-toggle search-btn-styled" aria-label="Buscar artículos (Ctrl+K)">
        <span>🔍</span>
        <kbd class="search-kbd">Ctrl K</kbd>
      </button>
      <button class="theme-toggle btn-favs-trigger" id="btn-open-favs" aria-label="Ver favoritos guardados" title="Mis herramientas y artículos guardados">
        <span>⭐</span>
        <span class="favs-badge-count" id="header-fav-count" style="display:none;">0</span>
      </button>
      <button class="theme-toggle" onclick="window.toggleTheme()" aria-label="Cambiar tema">
        <span id="theme-icon">☀️</span>
      </button>
      <button class="hamburger" id="hamburger" aria-label="Menú" onclick="toggleMenu()">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile nav (all links) -->
  <nav class="mobile-nav" id="mobile-nav">
    {[...mainLinks, ...moreLinks].map(link => (
      <a href={link.href} class="mobile-link">{link.label}</a>
    ))}
  </nav>

  <!-- FAVORITES SLIDE-OVER DRAWER -->
  <div class="favs-drawer-overlay" id="favs-overlay"></div>
  <aside class="favs-drawer" id="favs-drawer" aria-label="Elementos guardados" aria-hidden="true">
    <div class="favs-drawer-header">
      <div class="favs-drawer-title">
        <span class="favs-star-icon">⭐</span>
        <h3>Mis Guardados</h3>
      </div>
      <button type="button" class="btn-close-favs" id="btn-close-favs" aria-label="Cerrar favoritos">✕</button>
    </div>

    <div class="favs-drawer-tabs">
      <button type="button" class="fav-tab active" data-tab="all">Todos (<span id="fav-count-all">0</span>)</button>
      <button type="button" class="fav-tab" data-tab="tool">Herramientas (<span id="fav-count-tools">0</span>)</button>
      <button type="button" class="fav-tab" data-tab="article">Artículos (<span id="fav-count-articles">0</span>)</button>
    </div>

    <div class="favs-drawer-content" id="favs-content-list">
      <!-- Dynamic list rendered via JS -->
    </div>

    <div class="favs-drawer-footer">
      <button type="button" class="btn-clear-all-favs" id="btn-clear-all-favs">🗑️ Vaciar todo</button>
    </div>
  </aside>
</header>

<script>
  // Theme toggle
  const savedTheme = localStorage.getItem('theme') || 'dark';
  document.documentElement.setAttribute('data-theme', savedTheme);
  const icon = document.getElementById('theme-icon');
  if (icon) icon.textContent = savedTheme === 'dark' ? '☀️' : '🌙';

  window.toggleTheme = function() {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    const i = document.getElementById('theme-icon');
    if (i) i.textContent = next === 'dark' ? '☀️' : '🌙';
  };

  // Hamburger
  function toggleMenu() {
    document.getElementById('mobile-nav')?.classList.toggle('open');
    document.getElementById('hamburger')?.classList.toggle('active');
  }
  window.toggleMenu = toggleMenu;

  // Dropdown
  const btn = document.getElementById('dropdown-btn');
  const menu = document.getElementById('dropdown-menu');

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = menu?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  document.addEventListener('click', () => {
    menu?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
  });

  menu?.addEventListener('click', (e) => e.stopPropagation());

  // FAVORITES DRAWER MANAGEMENT
  const FAVS_KEY = 'gt_saved_items_v2';

  function getSavedItems() {
    try {
      const raw = localStorage.getItem(FAVS_KEY);
      if (raw) return JSON.parse(raw);
    } catch (e) {}
    return [];
  }

  function saveItems(items) {
    try {
      localStorage.setItem(FAVS_KEY, JSON.stringify(items));
      window.dispatchEvent(new CustomEvent('gt:favs-changed', { detail: { items } }));
    } catch (e) {}
  }

  window.gtGetFavs = getSavedItems;
  window.gtIsFav = function(url) {
    const cleanUrl = url.split('?')[0].split('#')[0].replace(/\/$/, '');
    return getSavedItems().some(i => i.url.replace(/\/$/, '') === cleanUrl);
  };
  window.gtToggleFav = function(item) {
    const items = getSavedItems();
    const cleanUrl = item.url.split('?')[0].split('#')[0].replace(/\/$/, '');
    const idx = items.findIndex(i => i.url.replace(/\/$/, '') === cleanUrl);
    let isNowFav = false;
    if (idx >= 0) {
      items.splice(idx, 1);
      isNowFav = false;
    } else {
      items.unshift({
        url: cleanUrl,
        title: item.title || 'Guía / Herramienta',
        type: item.type || (cleanUrl.includes('/herramientas') ? 'tool' : 'article'),
        icon: item.icon || (cleanUrl.includes('/herramientas') ? '🧲' : '📄')
      });
      isNowFav = true;
    }
    saveItems(items);
    return isNowFav;
  };

  let activeFavTab = 'all';

  function renderFavsDrawer() {
    const items = getSavedItems();
    const badge = document.getElementById('header-fav-count');
    const cntAll = document.getElementById('fav-count-all');
    const cntTools = document.getElementById('fav-count-tools');
    const cntArticles = document.getElementById('fav-count-articles');
    const list = document.getElementById('favs-content-list');

    const toolCount = items.filter(i => i.type === 'tool').length;
    const articleCount = items.filter(i => i.type === 'article').length;

    if (badge) {
      if (items.length > 0) {
        badge.style.display = 'inline-flex';
        badge.textContent = items.length > 99 ? '99+' : items.length.toString();
      } else {
        badge.style.display = 'none';
      }
    }

    if (cntAll) cntAll.textContent = items.length.toString();
    if (cntTools) cntTools.textContent = toolCount.toString();
    if (cntArticles) cntArticles.textContent = articleCount.toString();

    if (!list) return;

    const filtered = items.filter(i => {
      if (activeFavTab === 'tool') return i.type === 'tool';
      if (activeFavTab === 'article') return i.type === 'article';
      return true;
    });

    if (filtered.length === 0) {
      list.innerHTML = `
        <div class="favs-empty-state">
          <span class="fes-icon">⭐</span>
          <h4>No tienes nada guardado aún</h4>
          <p>Pulsa en la estrella ⭐ en cualquier herramienta o artículo para tenerlo siempre a mano aquí.</p>
          <a href="/herramientas" class="btn-browse-tools">Ver Herramientas →</a>
        </div>
      `;
      return;
    }

    list.innerHTML = filtered.map(item => `
      <div class="fav-item-row" data-url="${item.url}">
        <a href="${item.url}" class="fav-item-link">
          <span class="fav-item-icon">${item.icon || (item.type === 'tool' ? '🧲' : '📄')}</span>
          <div class="fav-item-info">
            <span class="fav-item-badge ${item.type}">${item.type === 'tool' ? 'Herramienta' : 'Artículo'}</span>
            <span class="fav-item-title">${item.title}</span>
          </div>
        </a>
        <button type="button" class="btn-remove-fav" data-url="${item.url}" title="Quitar de guardados" aria-label="Quitar">✕</button>
      </div>
    `).join('');

    // Attach remove handlers
    list.querySelectorAll('.btn-remove-fav').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const u = btn.getAttribute('data-url');
        if (u) {
          window.gtToggleFav({ url: u });
        }
      });
    });
  }

  function initFavsDrawer() {
    const btnOpen = document.getElementById('btn-open-favs');
    const btnClose = document.getElementById('btn-close-favs');
    const overlay = document.getElementById('favs-overlay');
    const drawer = document.getElementById('favs-drawer');
    const btnClearAll = document.getElementById('btn-clear-all-favs');
    const tabs = document.querySelectorAll('.fav-tab');

    function openDrawer() {
      if (!drawer || !overlay) return;
      drawer.classList.add('open');
      overlay.style.display = 'block';
      renderFavsDrawer();
    }

    function closeDrawer() {
      if (!drawer || !overlay) return;
      drawer.classList.remove('open');
      overlay.style.display = 'none';
    }

    btnOpen?.addEventListener('click', openDrawer);
    btnClose?.addEventListener('click', closeDrawer);
    overlay?.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('open')) {
        closeDrawer();
      }
    });

    btnClearAll?.addEventListener('click', () => {
      if (confirm('¿Quieres vaciar todos tus elementos guardados?')) {
        saveItems([]);
        renderFavsDrawer();
      }
    });

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        activeFavTab = tab.getAttribute('data-tab') || 'all';
        renderFavsDrawer();
      });
    });

    window.addEventListener('gt:favs-changed', () => {
      renderFavsDrawer();
    });

    renderFavsDrawer();
  }

  document.addEventListener('astro:page-load', initFavsDrawer);

</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-text { color: var(--primary); }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font);
  }
  .nav-link:hover, .nav-link.active {
    color: var(--primary);
    background: rgba(99,102,241,0.1);
    text-decoration: none;
  }

  /* DROPDOWN */
  .dropdown { position: relative; }

  .dropdown-btn {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.75rem;
    box-shadow: 0 16px 40px rgba(0,0,0,0.25);
    min-width: 520px;
    z-index: 200;
  }
  .dropdown-menu.open { display: block; }

  .dropdown-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .dropdown-item:hover {
    background: rgba(99,102,241,0.1);
    text-decoration: none;
  }
  .di-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }
  .di-desc {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* HEADER ACTIONS */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .search-btn-styled {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .search-kbd {
    font-size: 0.68rem;
    font-family: inherit;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    color: var(--text-muted);
  }
  @media (max-width: 768px) {
    .search-kbd {
      display: none;
    }
  }

  .theme-toggle {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.2s;
  }
  .theme-toggle:hover { background: var(--bg-card-hover); }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: all 0.3s;
  }

  /* MOBILE NAV */
  .mobile-nav {
    display: none;
    flex-direction: column;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    padding: 0.75rem 1rem;
    gap: 0.2rem;
    max-height: 70vh;
    overflow-y: auto;
  }
  .mobile-nav.open { display: flex; }

  .mobile-link {
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.2s;
  }
  .mobile-link:hover {
    color: var(--primary);
    background: rgba(99,102,241,0.1);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .hamburger { display: flex; }
    .main-nav { display: none; }
    .dropdown-menu { min-width: 300px; right: -60px; }
    .dropdown-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* FAVORITES TRIGGER & BADGE */
  .btn-favs-trigger {
    position: relative;
  }
  .favs-badge-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #ef4444;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    min-width: 17px;
    height: 17px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    border: 2px solid var(--bg-card, #0f172a);
    line-height: 1;
    animation: badge-pop 0.25s ease-out;
  }
  @keyframes badge-pop {
    0% { transform: scale(0.5); }
    100% { transform: scale(1); }
  }

  /* FAVORITES DRAWER */
  .favs-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 9998;
  }
  .favs-drawer {
    position: fixed;
    top: 0;
    right: -420px;
    bottom: 0;
    width: 380px;
    max-width: 90vw;
    background: var(--bg-card, #0f172a);
    border-left: 1px solid var(--border, rgba(255, 255, 255, 0.12));
    z-index: 9999;
    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .favs-drawer.open {
    right: 0;
  }

  .favs-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid var(--border, rgba(255, 255, 255, 0.1));
  }
  .favs-drawer-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .favs-star-icon {
    font-size: 1.3rem;
  }
  .favs-drawer-title h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text, #f1f5f9);
  }
  .btn-close-favs {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    color: var(--text-muted, #94a3b8);
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.15s;
  }
  .btn-close-favs:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .favs-drawer-tabs {
    display: flex;
    padding: 0.65rem 1rem;
    gap: 0.4rem;
    border-bottom: 1px solid var(--border, rgba(255, 255, 255, 0.06));
    background: rgba(0, 0, 0, 0.2);
  }
  .fav-tab {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-muted, #94a3b8);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.4rem 0.2rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .fav-tab:hover {
    color: var(--text, #f1f5f9);
  }
  .fav-tab.active {
    background: rgba(99, 102, 241, 0.2);
    color: #818cf8;
  }

  .favs-drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .favs-empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted, #94a3b8);
  }
  .fes-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 0.75rem;
    opacity: 0.7;
  }
  .favs-empty-state h4 {
    font-size: 1.05rem;
    color: var(--text, #f1f5f9);
    margin: 0 0 0.5rem;
  }
  .favs-empty-state p {
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 0 0 1.25rem;
  }
  .btn-browse-tools {
    display: inline-block;
    background: var(--primary, #6366f1);
    color: #ffffff;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .fav-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 0.75rem;
    padding: 0.65rem 0.85rem;
    gap: 0.6rem;
    transition: all 0.15s;
  }
  .fav-item-row:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(99, 102, 241, 0.3);
  }
  .fav-item-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    flex: 1;
    min-width: 0;
  }
  .fav-item-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
  }
  .fav-item-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .fav-item-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
