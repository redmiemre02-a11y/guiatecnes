---
<div id="cookie-banner" class="cookie-banner">
  <div class="cookie-content">
    <p>🍪 Utilizamos cookies para personalizar el contenido y analizar nuestro tráfico. Al hacer clic en "Aceptar", aceptas el uso de cookies según nuestra <a href="/politica-de-privacidad">Política de Privacidad</a>.</p>
    <button id="accept-cookies">Aceptar todo</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: -100%;
    left: 0;
    right: 0;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border);
    padding: 1rem 1.5rem;
    z-index: 9999;
    box-shadow: 0 -4px 30px rgba(0,0,0,0.3);
    transition: bottom 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cookie-banner.show {
    bottom: 0;
  }
  .cookie-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .cookie-content p {
    margin: 0;
    font-size: 0.9rem;
    color: #e2e8f0;
    line-height: 1.5;
  }
  .cookie-content a {
    color: var(--primary);
    text-decoration: underline;
    font-weight: 600;
  }
  #accept-cookies {
    background: linear-gradient(135deg, var(--primary) 0%, #4f46e5 100%);
    color: white;
    border: none;
    padding: 0.6rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  #accept-cookies:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
  }
  @media (max-width: 768px) {
    .cookie-content {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
    #accept-cookies {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const banner = document.getElementById('cookie-banner');
    const btn = document.getElementById('accept-cookies');
    
    if (banner && btn && !localStorage.getItem('cookieConsent')) {
      // 1 saniye sonra banner'ı göster
      setTimeout(() => {
        banner.classList.add('show');
      }, 1000);
      
      btn.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'true');
        banner.classList.remove('show');
      });
    }
  });
</script>
