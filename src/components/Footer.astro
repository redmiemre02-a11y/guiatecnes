<style>
  .site-footer {
    background: var(--bg-card, #ffffff);
    border-top: 1px solid var(--border, #e2e8f0);
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    padding: 3rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .footer-logo {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text, #0f172a);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .footer-logo span { color: var(--primary, #2563eb); }

  .footer-brand p {
    color: var(--text-muted, #64748b);
    font-size: 0.9rem;
    max-width: 320px;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .social-links { display: flex; gap: 0.75rem; }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--bg, #f8fafc);
    border: 1px solid var(--border, #e2e8f0);
    color: var(--text-muted, #64748b);
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.2s;
  }

  .social-links a:hover {
    color: var(--primary, #2563eb);
    border-color: var(--primary, #2563eb);
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .footer-col h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text, #0f172a);
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .footer-col a {
    display: block;
    color: var(--text-muted, #64748b);
    text-decoration: none;
    font-size: 0.88rem;
    margin-bottom: 0.6rem;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--primary, #2563eb);
  }

  .footer-bottom {
    border-top: 1px solid var(--border, #e2e8f0);
    padding: 2rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-disclaimer-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .footer-disclaimer-text {
    font-size: 0.78rem;
    color: #475569;
    line-height: 1.6;
    margin: 0 0 0.5rem;
  }

  .footer-trademark-notice {
    font-size: 0.75rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .footer-bottom-copy {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: var(--text-muted, #64748b);
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .footer-bottom-copy a {
    color: var(--primary, #2563eb);
    text-decoration: none;
    font-weight: 600;
  }
</style>
