}
const relevantTool = getRelevantTool(post.data.title, post.data.tags);

const currentSlug = post.id.replace(/\.[^/.]+$/, "");
const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: primaryTag, url: `/categoria/${primaryTag.toLowerCase()}` },
  { name: post.data.title, url: `/blog/${currentSlug}` }
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  type="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <Header slot="header" />

  <div id="reading-progress-bar" class="reading-progress-bar" aria-hidden="true"></div>

  <article class="article-page">
    <div class="container breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href={`/categoria/${primaryTag.toLowerCase()}`}>{primaryTag}</a>
      <span>›</span>
      <span>{post.data.title.slice(0, 40)}...</span>
    </div>

    <!-- HERO IMAGE -->
    {post.data.heroImage && (
      <div class="hero-image-wrap container">
        <img
          src={post.data.heroImage}
          alt={post.data.heroImageAlt || post.data.title}
          class="hero-image"
          loading="eager"
          width="1200"
          height="630"
        />
        {post.data.photographer && (
          <p class="photo-credit">
            📷 Foto: <a href={post.data.photographerUrl || '#'} target="_blank" rel="noopener noreferrer">{post.data.photographer}</a> vía Pexels
          </p>
        )}
      </div>
    )}

    <div class="container article-layout">
      <div class="article-main">
        <header class="article-header">
          <div class="article-meta-top">
            <div style="display:flex; gap:1rem; align-items:center;">
              <a href={`/categoria/${primaryTag.toLowerCase()}`} class={`tag ${getTagColor(primaryTag)}`}>
                {primaryTag}
              </a>
              <button id="tts-btn" class="tts-btn" title="Escuchar artículo">🎧 Escuchar</button>
            </div>
            {post.data.readingTime && (
              <span class="reading-time">⏱ {post.data.readingTime} min de lectura</span>
            )}
          </div>

          <h1 class="article-title">{post.data.title}</h1>
          <p class="article-desc">{post.data.description}</p>


          <div class="article-meta">
            <span>✍️ {post.data.author || 'Experto Tech'}</span>
            <span>📅 {dateStr}</span>
            {post.data.updatedDate && (
              <span>🔄 Actualizado: {post.data.updatedDate.toLocaleDateString('es-ES')}</span>
            )}
          </div>

          <div class="share-bar">
            <span class="share-label">Compartir:</span>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' ' + Astro.url.toString())}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-wa" title="Compartir en WhatsApp"
            >💬 WhatsApp</a>
            <a
              href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.toString())}&text=${encodeURIComponent(post.data.title)}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-tg" title="Compartir en Telegram"
            >✈️ Telegram</a>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.toString())}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-x" title="Compartir en 𝕏"
            >𝕏 Twitter</a>
            <button id="copy-link-btn" class="share-btn share-copy" type="button" title="Copiar enlace">
              <span id="copy-icon">🔗</span> <span id="copy-text">Copiar</span>
            </button>
          </div>
        </header>

        <AdSenseBanner variant="in-article" />

        {toc.length > 0 && (
          <div class="toc-container">
            <h3>📑 Índice de Contenidos</h3>
            <ul>
              {toc.map(heading => (
                <li class={`toc-level-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="prose">
          <Content />
        </div>

        <!-- DYNAMIC CONTEXTUAL TOOL CTA -->
        <div class="contextual-tool-card">
          <div class="tool-card-icon">{relevantTool.icon}</div>
          <div class="tool-card-body">
            <div class="tool-card-header">
              <span class="tool-card-badge">{relevantTool.badge}</span>
              <h3 class="tool-card-title">{relevantTool.title}</h3>
            </div>
            <p class="tool-card-desc">{relevantTool.desc}</p>
            <a href={relevantTool.url} class="tool-card-btn">{relevantTool.btn} →</a>
          </div>
        </div>

        <AdSenseBanner variant="in-article" />

        <div class="article-tags">
          <strong>Etiquetas:</strong>
          {post.data.tags.map((tag, idx) => (
            idx === 0 ? (
              <a href={`/categoria/${tag.toLowerCase()}`} class={`tag ${getTagColor(tag)}`}>{tag}</a>
            ) : (
              <span class={`tag ${getTagColor(tag)}`}>{tag}</span>
            )
          ))}
        </div>

        <!-- AUTHOR BOX FOR EEAT -->
        <div class="clap-wrapper">
          <button class="clap-btn" id="clap-btn" data-slug={post.id} aria-label="Aplaudir artículo">
            <span class="clap-icon">👏</span>
          </button>
          <span class="clap-count" id="clap-count">0</span>
        </div>

        <ArticleReactions slug={post.id} />

        <StarRating 
          ratingValue={(4.5 + (post.data.title.length % 5) * 0.1).toFixed(1)} 
          reviewCount={String(45 + (post.data.title.length * 3))} 
        />

        <div class="author-box">
          <div class="author-avatar">
            <span class="avatar-emoji">👨‍💻</span>
          </div>
          <div class="author-info">
            <h4>
              <a href={`/autor/${(post.data.author || 'Experto Tech').toLowerCase().replace(/\s+/g, '-')}`} style="color: inherit; text-decoration: none;">
                {post.data.author || 'Experto Tech'}
              </a>
            </h4>
            <p>Especialista en tecnología y herramientas digitales con más de 10 años de experiencia. Apasionado por descubrir y analizar las mejores alternativas de software, inteligencia artificial y productividad para hacer tu vida más fácil.</p>
          </div>
        </div>

        <Disqus 
          url={Astro.url.toString()} 
          identifier={post.id} 
          title={post.data.title} 
        />

        {relatedPosts.length > 0 && (
          <section class="related-posts">
            <h2>Artículos Relacionados</h2>
            <div class="related-grid">
              {relatedPosts.map(p => (
                <PostCard
                  title={p.data.title}
