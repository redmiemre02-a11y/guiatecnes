---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSenseBanner from '../../components/AdSenseBanner.astro';
import PostCard from '../../components/PostCard.astro';
import Disqus from '../../components/Disqus.astro';
import StarRating from '../../components/StarRating.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    // Astro 5 glob loader uses full filename as ID. Remove extension for the URL slug.
    const slug = post.id.replace(/\.[^/.]+$/, "");
    return {
      params: { slug },
      props: post,
    };
  });
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.tags.some(t => post.data.tags.includes(t)))
  .slice(0, 3);

const dateStr = post.data.pubDate.toLocaleDateString('es-ES', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const primaryTag = post.data.tags[0] || 'tecnologia';

function getTagColor(tag: string) {
  const t = tag.toLowerCase();
  if (t.includes('ia') || t.includes('inteligencia')) return 'tag-ia';
  if (t.includes('alternativ')) return 'tag-alternativas';
  if (t.includes('tecnolog')) return 'tag-tecnologia';
  if (t.includes('guia') || t.includes('guías')) return 'tag-guias';
  return 'tag-default';
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  author={post.data.author}
>
  <Header slot="header" />

  <article class="article-page">
    <div class="container breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href={`/categoria/${primaryTag.toLowerCase()}`}>{primaryTag}</a>
      <span>›</span>
      <span>{post.data.title.slice(0, 40)}...</span>
    </div>

    <!-- HERO IMAGE -->
    {post.data.heroImage && (
      <div class="hero-image-wrap container">
        <img
          src={post.data.heroImage}
          alt={post.data.heroImageAlt || post.data.title}
          class="hero-image"
          loading="eager"
          width="1200"
          height="630"
        />
        {post.data.photographer && (
          <p class="photo-credit">
            📷 Foto: <a href={post.data.photographerUrl || '#'} target="_blank" rel="noopener noreferrer">{post.data.photographer}</a> vía Pexels
          </p>
        )}
      </div>
    )}

    <div class="container article-layout">
      <div class="article-main">
        <header class="article-header">
          <div class="article-meta-top">
            <div style="display:flex; gap:1rem; align-items:center;">
              <a href={`/categoria/${primaryTag.toLowerCase()}`} class={`tag ${getTagColor(primaryTag)}`}>
                {primaryTag}
              </a>
              <button id="tts-btn" class="tts-btn" title="Escuchar artículo">🎧 Escuchar</button>
            </div>
            {post.data.readingTime && (
              <span class="reading-time">⏱ {post.data.readingTime} min de lectura</span>
            )}
          </div>

          <h1 class="article-title">{post.data.title}</h1>
          <p class="article-desc">{post.data.description}</p>


          <div class="article-meta">
            <span>✍️ {post.data.author || 'Experto Tech'}</span>
            <span>📅 {dateStr}</span>
            {post.data.updatedDate && (
              <span>🔄 Actualizado: {post.data.updatedDate.toLocaleDateString('es-ES')}</span>
            )}
          </div>

          <div class="share-bar">
            <span>Compartir:</span>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.toString())}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-x"
            >𝕏 Twitter</a>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' ' + Astro.url.toString())}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-wa"
            >💬 WhatsApp</a>
            <a
              href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.url.toString())}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-li"
            >in LinkedIn</a>
          </div>
        </header>

        <AdSenseBanner variant="in-article" />

        {toc.length > 0 && (
          <div class="toc-container">
            <h3>📑 Índice de Contenidos</h3>
            <ul>
              {toc.map(heading => (
                <li class={`toc-level-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="prose">
          <Content />
        </div>

        <AdSenseBanner variant="in-article" />

        <div class="article-tags">
          <strong>Etiquetas:</strong>
          {post.data.tags.map(tag => (
            <a href={`/categoria/${tag.toLowerCase()}`} class={`tag ${getTagColor(tag)}`}>{tag}</a>
          ))}
        </div>

        <!-- AUTHOR BOX FOR EEAT -->
        <div class="clap-wrapper">
          <button class="clap-btn" id="clap-btn" data-slug={post.id} aria-label="Aplaudir artículo">
            <span class="clap-icon">👏</span>
          </button>
          <span class="clap-count" id="clap-count">0</span>
        </div>

        <StarRating 
          ratingValue={(4.5 + (post.data.title.length % 5) * 0.1).toFixed(1)} 
          reviewCount={String(45 + (post.data.title.length * 3))} 
        />

        <div class="author-box">
          <div class="author-avatar">
            <span class="avatar-emoji">👨‍💻</span>
          </div>
          <div class="author-info">
            <h4>
              <a href={`/autor/${(post.data.author || 'Experto Tech').toLowerCase().replace(/\s+/g, '-')}`} style="color: inherit; text-decoration: none;">
                {post.data.author || 'Experto Tech'}
              </a>
            </h4>
            <p>Especialista en tecnología y herramientas digitales con más de 10 años de experiencia. Apasionado por descubrir y analizar las mejores alternativas de software, inteligencia artificial y productividad para hacer tu vida más fácil.</p>
          </div>
        </div>

        <Disqus 
          url={Astro.url.toString()} 
          identifier={post.id} 
          title={post.data.title} 
        />

        {relatedPosts.length > 0 && (
          <section class="related-posts">
            <h2>Artículos Relacionados</h2>
            <div class="related-grid">
              {relatedPosts.map(p => (
                <PostCard
                  title={p.data.title}
                  description={p.data.description}
                  slug={p.slug}
                  pubDate={p.data.pubDate}
                  tags={p.data.tags}
                  author={p.data.author}
                  readingTime={p.data.readingTime || 5}
                />
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="article-sidebar">
        <AdSenseBanner variant="sidebar" />

        <div class="sidebar-card">
          <h3>📂 Categorías</h3>
          <a href="/categoria/ia">🤖 IA Herramientas</a>
          <a href="/categoria/alternativas">🔄 Alternativas</a>
          <a href="/categoria/finanzas">💰 Finanzas</a>
          <a href="/categoria/ciberseguridad">🔒 Ciberseguridad</a>
          <a href="/categoria/emprendimiento">🚀 Ganar Dinero</a>
          <a href="/categoria/salud">🏥 Salud Digital</a>
          <a href="/categoria/hogar">🏠 Hogar Inteligente</a>
          <a href="/categoria/gaming">🎮 Gaming y PC</a>
          <a href="/categoria/movil">📱 Apps Móviles</a>
          <a href="/categoria/familia">👶 Familia</a>
          <a href="/categoria/educacion">🎓 Educación</a>
          <a href="/categoria/productividad">⚡ Productividad</a>
          <a href="/categoria/tecnologia">💻 Tecnología</a>
          <a href="/categoria/guias">📖 Guías</a>
        </div>

        <div class="sidebar-card newsletter-mini">
          <h3>📬 Newsletter</h3>
          <p>Recibe lo mejor en tecnología cada semana.</p>
          <form action="https://formspree.io/f/XXXXX" method="POST">
            <input type="email" name="email" placeholder="tu@email.com" required />
            <button type="submit">Suscribirme</button>
          </form>
        </div>
      </aside>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .article-page { padding: 1.5rem 0 3rem; }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--primary); }

  /* HERO IMAGE */
  .hero-image-wrap {
    margin: 1.5rem auto 0;
    border-radius: 16px;
    overflow: hidden;
    max-height: 480px;
  }
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 16px;
  }
  .photo-credit {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-align: right;
    margin-top: 0.4rem;
    padding: 0 0.25rem;
  }
  .photo-credit a { color: var(--text-muted); text-decoration: underline; }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }
  .article-main, .article-sidebar {
    min-width: 0;
  }

  .article-header { margin-bottom: 1.5rem; }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .reading-time { font-size: 0.82rem; color: var(--text-muted); }

  .article-title {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .article-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    border-left: 3px solid var(--primary);
    padding-left: 1rem;
  }

  .article-meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .share-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .share-btn {
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .share-btn:hover { opacity: 0.8; text-decoration: none; }
  .share-x { background: #000; color: white; }
  .share-wa { background: #25D366; color: white; }
  .share-li { background: #0A66C2; color: white; }

  .article-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }

  .related-posts { margin-top: 3rem; }
  .related-posts h2 { font-size: 1.3rem; font-weight: 700; margin-bottom: 1.25rem; }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .article-sidebar {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .sidebar-card h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.75rem; }

  .sidebar-card a {
    display: block;
    padding: 0.4rem 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s;
  }

  .sidebar-card a:last-child { border-bottom: none; }
  .sidebar-card a:hover { color: var(--primary); }

  .newsletter-mini p { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; line-height: 1.5; }

  .newsletter-mini input {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .newsletter-mini button {
    width: 100%;
    background: var(--primary);
    color: white;
    border: none;
    padding: 0.65rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    font-family: var(--font);
    transition: background 0.2s;
  }

  .newsletter-mini button:hover { background: var(--primary-dark); }

  /* TOC Styles */
  .toc-container {
    background: rgba(99, 102, 241, 0.05);
    border-left: 4px solid var(--primary);
    padding: 1.5rem;
    border-radius: 0 12px 12px 0;
    margin-bottom: 2.5rem;
  }
  .toc-container h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--heading);
  }
  .toc-container ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .toc-level-2 { margin-left: 0; }
  .toc-level-3 { margin-left: 1.5rem; font-size: 0.9em; }
  .toc-container a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .toc-container a:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  /* Author Box Styles */
  .author-box {
    display: flex;
    gap: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2rem;
    border-radius: 16px;
    margin: 3rem 0;
    align-items: flex-start;
  }
  .author-avatar {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, var(--primary) 0%, #06b6d4 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .avatar-emoji { font-size: 1.8rem; }
  .author-info h4 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--heading);
  }
  .author-info p {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Clap Button Styles */
  .clap-wrapper { display: flex; align-items: center; gap: 1rem; margin: 2rem 0; justify-content: center; position: relative; }
  .clap-btn { background: var(--bg-card); border: 2px solid var(--border); width: 65px; height: 65px; border-radius: 50%; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
  .clap-btn:hover { border-color: var(--primary); transform: scale(1.05); }
  .clap-icon { font-size: 2rem; transition: transform 0.1s; }
  .clap-btn:active .clap-icon { transform: scale(0.9); }
  .clap-count { font-size: 1.2rem; font-weight: 700; color: var(--text-muted); min-width: 30px; }
  :global(.clap-float) { position: absolute; font-size: 1.2rem; font-weight: bold; color: var(--primary); pointer-events: none; animation: floatUp 1s ease-out forwards; }
  @keyframes floatUp { 0% { opacity: 1; transform: translateY(0) scale(1); } 100% { opacity: 0; transform: translateY(-50px) scale(1.5); } }

  /* TTS Button */
  .tts-btn {
    background: rgba(99, 102, 241, 0.1); color: var(--primary); border: 1px solid var(--primary);
    padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; transition: all 0.2s;
  }
  .tts-btn:hover { background: var(--primary); color: white; }
  .tts-btn.playing { background: #ef4444; border-color: #ef4444; color: white; animation: pulse 2s infinite; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
    70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
    100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  }

  /* Lightbox Styles */
  .prose img, .hero-image { cursor: zoom-in; transition: opacity 0.2s; }
  .prose img:hover, .hero-image:hover { opacity: 0.9; }
  :global(.lightbox-overlay) {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(15,23,42,0.95); backdrop-filter: blur(5px);
    z-index: 999999; display: flex; justify-content: center; align-items: center;
    opacity: 0; pointer-events: none; transition: opacity 0.3s ease; cursor: zoom-out;
  }
  :global(.lightbox-overlay.active) { opacity: 1; pointer-events: all; }
  :global(.lightbox-img) {
    max-width: 90%; max-height: 90vh; border-radius: 12px;
    transform: scale(0.95); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  }
  :global(.lightbox-overlay.active .lightbox-img) { transform: scale(1); }

  @media (max-width: 600px) {
    .author-box { flex-direction: column; gap: 1rem; padding: 1.5rem; }
  }

  @media (max-width: 900px) {
    .article-layout { grid-template-columns: 1fr; }
    .article-sidebar { position: static; order: -1; }
    .article-sidebar .adsense-sidebar { display: none; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Lightbox Logic
    const overlay = document.createElement('div');
    overlay.className = 'lightbox-overlay';
    const imgClone = document.createElement('img');
    imgClone.className = 'lightbox-img';
    overlay.appendChild(imgClone);
    document.body.appendChild(overlay);

    document.querySelectorAll('.prose img, .hero-image').forEach(img => {
      img.addEventListener('click', () => {
        imgClone.src = (img as HTMLImageElement).src;
        overlay.classList.add('active');
      });
    });

    overlay.addEventListener('click', () => {
      overlay.classList.remove('active');
    });

    // Clap Button Logic
    const clapBtn = document.getElementById('clap-btn');
    const clapCount = document.getElementById('clap-count');
    if (clapBtn && clapCount) {
      const slug = clapBtn.getAttribute('data-slug');
      let claps = parseInt(localStorage.getItem(`claps_${slug}`) || Math.floor(Math.random() * 40 + 10).toString());
      clapCount.textContent = claps.toString();

      clapBtn.addEventListener('click', (e) => {
        claps++;
        localStorage.setItem(`claps_${slug}`, claps.toString());
        clapCount.textContent = claps.toString();

        const float = document.createElement('div');
        float.className = 'clap-float';
        float.textContent = '👏 +1';
        document.body.appendChild(float);
        
        const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
        float.style.left = (rect.left + rect.width / 2 - 20) + 'px';
        float.style.top = rect.top + 'px';
        
        setTimeout(() => float.remove(), 1000);
      });
    }

    // TTS Logic (Escuchar Artículo)
    const ttsBtn = document.getElementById('tts-btn');
    if (ttsBtn) {
      let isPlaying = false;
      let utterance: SpeechSynthesisUtterance | null = null;

      ttsBtn.addEventListener('click', () => {
        if (isPlaying) {
          window.speechSynthesis.cancel();
          isPlaying = false;
          ttsBtn.innerHTML = '🎧 Escuchar';
          ttsBtn.classList.remove('playing');
          return;
        }
        
        const prose = document.querySelector('.prose');
        if (!prose) return;
        
        const text = (prose as HTMLElement).innerText;
        utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'es-ES'; // İspanyolca
        utterance.rate = 1.0;
        
        utterance.onend = () => {
          isPlaying = false;
          ttsBtn.innerHTML = '🎧 Escuchar';
          ttsBtn.classList.remove('playing');
        };
        
        window.speechSynthesis.speak(utterance);
        isPlaying = true;
        ttsBtn.innerHTML = '⏹ Detener';
        ttsBtn.classList.add('playing');
      });
      
      // Navigate away: Stop reading
      document.addEventListener('astro:before-swap', () => {
         window.speechSynthesis.cancel();
      }, { once: true });
    }
  });
</script>
