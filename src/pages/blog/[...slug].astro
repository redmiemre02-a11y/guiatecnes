    };
  }

  if (text.includes('luz') || text.includes('electricidad') || text.includes('consumo') || text.includes('kwh') || text.includes('vatios') || text.includes('factura')) {
    return {
      title: 'Calcula el consumo eléctrico de tu tecnología',
      desc: 'Averigua cuántos euros al mes cuesta tener encendido tu PC Gaming, consola PS5, router o Smart TV.',
      btn: 'Calcular Consumo de Luz',
