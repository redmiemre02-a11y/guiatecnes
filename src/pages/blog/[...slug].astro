---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSenseBanner from '../../components/AdSenseBanner.astro';
import PostCard from '../../components/PostCard.astro';
import Disqus from '../../components/Disqus.astro';
import StarRating from '../../components/StarRating.astro';
import ArticleReactions from '../../components/ArticleReactions.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    // Astro 5 glob loader uses full filename as ID. Remove extension for the URL slug.
    const slug = post.id.replace(/\.[^/.]+$/, "");
    return {
      params: { slug },
      props: post,
    };
  });
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

const allPosts = await getCollection('blog');
const trendingPosts = allPosts.filter(p => p.id !== post.id).slice(0, 5);
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.tags.some(t => post.data.tags.includes(t)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const dateStr = post.data.pubDate.toLocaleDateString('es-ES', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const primaryTag = post.data.tags[0] || 'tecnologia';

function getTagColor(tag: string) {
  const t = tag.toLowerCase();
  if (t.includes('ia') || t.includes('inteligencia')) return 'tag-ia';
  if (t.includes('alternativ')) return 'tag-alternativas';
  if (t.includes('tecnolog')) return 'tag-tecnologia';
  if (t.includes('guia') || t.includes('guías')) return 'tag-guias';
  if (t.includes('error') || t.includes('solucion')) return 'tag-errores';
  if (t.includes('comparativ')) return 'tag-comparativas';
  if (t.includes('streaming')) return 'tag-streaming';
  if (t.includes('windows') || t.includes('linux')) return 'tag-windows-linux';
  if (t.includes('freelance') || t.includes('remoto')) return 'tag-freelance';
  if (t.includes('movil') || t.includes('android') || t.includes('iphone')) return 'tag-movil';
  return 'tag-default';
}

// Extract FAQs from post.body for Google FAQPage Rich Snippets
const faqs: { question: string; answer: string }[] = [];
if (post.body) {
  const faqSectionMatch = post.body.split(/##\s+.*(?:Preguntas frecuentes|FAQ).*/i);
  const targetText = faqSectionMatch.length > 1 ? faqSectionMatch[1] : post.body;
  const qaRegex = /###\s+(¿[^\n]+\?)\s*\n+([^\n#]+(?:\n(?!###|##)[^\n#]+)*)/g;
  let match;
  while ((match = qaRegex.exec(targetText)) !== null) {
    const q = match[1].trim();
    const a = match[2].replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1').replace(/[*_`]/g, '').trim();
    if (q && a) {
      faqs.push({ question: q, answer: a });
    }
  }
}

function getRelevantTool(title: string, tags: string[]) {
  const text = (title + ' ' + tags.join(' ')).toLowerCase();

  if (text.includes('divisa') || text.includes('dolar') || text.includes('euro') || text.includes('peso') || text.includes('cripto') || text.includes('bitcoin') || text.includes('moneda')) {
    return {
      title: 'Conversor de Divisas y Criptomonedas en Vivo',
      desc: 'Calcula el cambio exacto entre Euro, Dólar, Pesos latinoamericanos y Criptomonedas con tipos de cambio en tiempo real.',
      btn: 'Abrir Conversor de Divisas',
      url: '/herramientas/conversor-divisas',
      icon: '💱',
      badge: 'Finanzas & Cripto'
    };
  }

  if (text.includes('utm') || text.includes('analytics') || text.includes('marketing') || text.includes('campaña') || text.includes('anuncio') || text.includes('trafico')) {
    return {
      title: 'Generador de Enlaces UTM para Google Analytics 4',
      desc: 'Etiqueta tus enlaces para rastrear exactamente qué red social o campaña publicitaria te genera más clientes.',
      btn: 'Generar Enlace UTM',
      url: '/herramientas/generador-enlaces-utm',
      icon: '🔗',
      badge: 'Marketing & GA4'
