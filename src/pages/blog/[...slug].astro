---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSenseBanner from '../../components/AdSenseBanner.astro';
import PostCard from '../../components/PostCard.astro';
import Disqus from '../../components/Disqus.astro';
import StarRating from '../../components/StarRating.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    // Astro 5 glob loader uses full filename as ID. Remove extension for the URL slug.
    const slug = post.id.replace(/\.[^/.]+$/, "");
    return {
      params: { slug },
      props: post,
    };
  });
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.tags.some(t => post.data.tags.includes(t)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const dateStr = post.data.pubDate.toLocaleDateString('es-ES', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const primaryTag = post.data.tags[0] || 'tecnologia';

function getTagColor(tag: string) {
  const t = tag.toLowerCase();
  if (t.includes('ia') || t.includes('inteligencia')) return 'tag-ia';
  if (t.includes('alternativ')) return 'tag-alternativas';
  if (t.includes('tecnolog')) return 'tag-tecnologia';
  if (t.includes('guia') || t.includes('guías')) return 'tag-guias';
  if (t.includes('error') || t.includes('solucion')) return 'tag-errores';
  if (t.includes('comparativ')) return 'tag-comparativas';
  if (t.includes('streaming')) return 'tag-streaming';
  if (t.includes('windows') || t.includes('linux')) return 'tag-windows-linux';
  if (t.includes('freelance') || t.includes('remoto')) return 'tag-freelance';
  if (t.includes('movil') || t.includes('android') || t.includes('iphone')) return 'tag-movil';
  return 'tag-default';
}

// Extract FAQs from post.body for Google FAQPage Rich Snippets
const faqs: { question: string; answer: string }[] = [];
if (post.body) {
  const faqSectionMatch = post.body.split(/##\s+.*(?:Preguntas frecuentes|FAQ).*/i);
  const targetText = faqSectionMatch.length > 1 ? faqSectionMatch[1] : post.body;
  const qaRegex = /###\s+(¿[^\n]+\?)\s*\n+([^\n#]+(?:\n(?!###|##)[^\n#]+)*)/g;
  let match;
  while ((match = qaRegex.exec(targetText)) !== null) {
    const q = match[1].trim();
    const a = match[2].replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1').replace(/[*_`]/g, '').trim();
    if (q && a) {
      faqs.push({ question: q, answer: a });
    }
  }
}

function getRelevantTool(title: string, tags: string[]) {
  const text = (title + ' ' + tags.join(' ')).toLowerCase();
  if (text.includes('wifi') || text.includes('velocidad') || text.includes('internet') || text.includes('ping') || text.includes('router') || text.includes('lag')) {
    return {
      title: '¿Problemas con tu conexión a Internet?',
      desc: 'Comprueba al instante la velocidad real de descarga, subida y latencia (ping) de tu red con nuestro test interactivo gratuito.',
      btn: 'Hacer Test de Velocidad WiFi',
      url: '/herramientas/test-velocidad',
      icon: '⚡',
      badge: 'Test en Vivo'
    };
  }
  if (text.includes('contraseña') || text.includes('password') || text.includes('segur') || text.includes('hack') || text.includes('cuenta') || text.includes('privacidad')) {
    return {
      title: 'Protege tus cuentas y contraseñas',
      desc: 'Genera claves indescifrables de alta seguridad y comprueba cuántos siglos tardaría un ciberdelincuente en descifrarlas.',
      btn: 'Generar Contraseña Segura',
      url: '/herramientas/generador-contrasenas',
      icon: '🔐',
      badge: 'Ciberseguridad'
    };
  }
  if (text.includes('foto') || text.includes('imagen') || text.includes('camara') || text.includes('espacio') || text.includes('almacenamiento') || text.includes('megas')) {
    return {
      title: '¿Tus fotos ocupan demasiado espacio?',
      desc: 'Comprime imágenes JPG, PNG y WebP reduciendo hasta un 85% su peso sin perder calidad y sin subirlas a ningún servidor.',
      btn: 'Comprimir Imágenes Gratis',
      url: '/herramientas/compresor-imagenes',
      icon: '🖼️',
      badge: 'Ahorro de Espacio'
    };
  }
  if (text.includes('descarga') || text.includes('juego') || text.includes('steam') || text.includes('pelicula') || text.includes('gb') || text.includes('ps5')) {
    return {
      title: '¿Cuánto tardará en descargarse tu archivo?',
      desc: 'Calcula con precisión las horas y minutos exactos que tardará cualquier descarga según los megas de tu conexión.',
      btn: 'Calcular Tiempo de Descarga',
      url: '/herramientas/calculadora-descarga',
      icon: '⏳',
      badge: 'Calculadora'
    };
  }
  if (text.includes('estafa') || text.includes('phishing') || text.includes('enlace') || text.includes('link') || text.includes('virus') || text.includes('banco') || text.includes('sms')) {
    return {
      title: '¿Has recibido un enlace sospechoso?',
      desc: 'Analiza enlaces y direcciones web dudosas para prevenir ataques de phishing, estafas bancarias o robo de cuentas.',
      btn: 'Analizar Enlace Sospechoso',
      url: '/herramientas/detector-enlaces',
      icon: '🛡️',
      badge: 'Antifraude'
    };
  }
  if (text.includes('freelance') || text.includes('trabajo') || text.includes('dinero') || text.includes('cobrar') || text.includes('remoto') || text.includes('precio') || text.includes('tarifa')) {
    return {
      title: 'Calcula tu tarifa profesional como freelance',
      desc: 'Descubre cuánto deberías cobrar por hora o por proyecto considerando tus gastos mensuales, vacaciones e impuestos.',
      btn: 'Calcular Tarifa Freelance',
      url: '/herramientas/calculadora-freelance',
      icon: '💼',
      badge: 'Productividad'
    };
  }
  if (text.includes('redact') || text.includes('palabra') || text.includes('escrib') || text.includes('texto') || text.includes('twitter') || text.includes('instagram') || text.includes('bio')) {
    return {
      title: 'Contador de Palabras y Límites de Redes',
      desc: 'Cuenta palabras, caracteres y mide los límites de biografía para Twitter, Instagram y TikTok en tiempo real.',
      btn: 'Abrir Contador de Palabras',
      url: '/herramientas/contador-palabras',
      icon: '📝',
      badge: 'Editor'
    };
  }
  return {
    title: 'Descubre Nuestras Herramientas Gratuitas',
    desc: 'Accede a generadores de contraseñas, test de velocidad WiFi, compresor de fotos, generador de QR y más utilidades sin registro.',
    btn: 'Ver Todas las Herramientas 🧲',
    url: '/herramientas',
    icon: '🚀',
    badge: '100% Gratis'
  };
}

const relevantTool = getRelevantTool(post.data.title, post.data.tags);

const currentSlug = post.id.replace(/\.[^/.]+$/, "");
const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: primaryTag, url: `/categoria/${primaryTag.toLowerCase()}` },
  { name: post.data.title, url: `/blog/${currentSlug}` }
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  type="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <Header slot="header" />

  <article class="article-page">
    <div class="container breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href={`/categoria/${primaryTag.toLowerCase()}`}>{primaryTag}</a>
      <span>›</span>
      <span>{post.data.title.slice(0, 40)}...</span>
    </div>

    <!-- HERO IMAGE -->
    {post.data.heroImage && (
      <div class="hero-image-wrap container">
        <img
          src={post.data.heroImage}
          alt={post.data.heroImageAlt || post.data.title}
          class="hero-image"
          loading="eager"
          width="1200"
          height="630"
        />
        {post.data.photographer && (
          <p class="photo-credit">
            📷 Foto: <a href={post.data.photographerUrl || '#'} target="_blank" rel="noopener noreferrer">{post.data.photographer}</a> vía Pexels
          </p>
        )}
      </div>
    )}

    <div class="container article-layout">
      <div class="article-main">
        <header class="article-header">
          <div class="article-meta-top">
            <div style="display:flex; gap:1rem; align-items:center;">
              <a href={`/categoria/${primaryTag.toLowerCase()}`} class={`tag ${getTagColor(primaryTag)}`}>
                {primaryTag}
              </a>
              <button id="tts-btn" class="tts-btn" title="Escuchar artículo">🎧 Escuchar</button>
            </div>
            {post.data.readingTime && (
              <span class="reading-time">⏱ {post.data.readingTime} min de lectura</span>
            )}
          </div>

          <h1 class="article-title">{post.data.title}</h1>
          <p class="article-desc">{post.data.description}</p>


          <div class="article-meta">
            <span>✍️ {post.data.author || 'Experto Tech'}</span>
            <span>📅 {dateStr}</span>
            {post.data.updatedDate && (
              <span>🔄 Actualizado: {post.data.updatedDate.toLocaleDateString('es-ES')}</span>
            )}
          </div>

          <div class="share-bar">
            <span class="share-label">Compartir:</span>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' ' + Astro.url.toString())}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-wa" title="Compartir en WhatsApp"
            >💬 WhatsApp</a>
            <a
              href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.toString())}&text=${encodeURIComponent(post.data.title)}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-tg" title="Compartir en Telegram"
            >✈️ Telegram</a>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.toString())}`}
              target="_blank" rel="noopener noreferrer" class="share-btn share-x" title="Compartir en 𝕏"
            >𝕏 Twitter</a>
            <button id="copy-link-btn" class="share-btn share-copy" type="button" title="Copiar enlace">
              <span id="copy-icon">🔗</span> <span id="copy-text">Copiar</span>
            </button>
          </div>
        </header>

        <AdSenseBanner variant="in-article" />

        {toc.length > 0 && (
          <div class="toc-container">
            <h3>📑 Índice de Contenidos</h3>
            <ul>
              {toc.map(heading => (
                <li class={`toc-level-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="prose">
          <Content />
        </div>

        <!-- DYNAMIC CONTEXTUAL TOOL CTA -->
        <div class="contextual-tool-card">
          <div class="tool-card-icon">{relevantTool.icon}</div>
          <div class="tool-card-body">
            <div class="tool-card-header">
              <span class="tool-card-badge">{relevantTool.badge}</span>
              <h3 class="tool-card-title">{relevantTool.title}</h3>
            </div>
            <p class="tool-card-desc">{relevantTool.desc}</p>
            <a href={relevantTool.url} class="tool-card-btn">{relevantTool.btn} →</a>
          </div>
        </div>

        <AdSenseBanner variant="in-article" />

        <div class="article-tags">
          <strong>Etiquetas:</strong>
          {post.data.tags.map((tag, idx) => (
            idx === 0 ? (
              <a href={`/categoria/${tag.toLowerCase()}`} class={`tag ${getTagColor(tag)}`}>{tag}</a>
            ) : (
              <span class={`tag ${getTagColor(tag)}`}>{tag}</span>
            )
          ))}
        </div>

        <!-- AUTHOR BOX FOR EEAT -->
        <div class="clap-wrapper">
          <button class="clap-btn" id="clap-btn" data-slug={post.id} aria-label="Aplaudir artículo">
            <span class="clap-icon">👏</span>
          </button>
          <span class="clap-count" id="clap-count">0</span>
        </div>

        <StarRating 
          ratingValue={(4.5 + (post.data.title.length % 5) * 0.1).toFixed(1)} 
          reviewCount={String(45 + (post.data.title.length * 3))} 
        />

        <div class="author-box">
          <div class="author-avatar">
            <span class="avatar-emoji">👨‍💻</span>
          </div>
          <div class="author-info">
            <h4>
              <a href={`/autor/${(post.data.author || 'Experto Tech').toLowerCase().replace(/\s+/g, '-')}`} style="color: inherit; text-decoration: none;">
                {post.data.author || 'Experto Tech'}
              </a>
            </h4>
            <p>Especialista en tecnología y herramientas digitales con más de 10 años de experiencia. Apasionado por descubrir y analizar las mejores alternativas de software, inteligencia artificial y productividad para hacer tu vida más fácil.</p>
          </div>
        </div>

        <Disqus 
          url={Astro.url.toString()} 
          identifier={post.id} 
          title={post.data.title} 
        />

        {relatedPosts.length > 0 && (
          <section class="related-posts">
            <h2>Artículos Relacionados</h2>
            <div class="related-grid">
              {relatedPosts.map(p => (
                <PostCard
                  title={p.data.title}
                  description={p.data.description}
                  slug={p.id.replace(/\.[^/.]+$/, "")}
                  pubDate={p.data.pubDate}
                  tags={p.data.tags}
                  author={p.data.author}
                  readingTime={p.data.readingTime || 5}
                  heroImage={p.data.heroImage}
                />
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="article-sidebar">
        <AdSenseBanner variant="sidebar" />

        <div class="sidebar-card sidebar-tools">
          <div class="sidebar-tools-header">
            <span class="tools-badge">Recomendado</span>
            <h3>🧲 Herramientas Gratis</h3>
          </div>
          <p class="sidebar-tools-desc">Utilidades rápidas y 100% online:</p>
          <ul class="sidebar-tools-list">
            <li><a href="/herramientas/test-velocidad"><span>⚡</span> Test de Velocidad WiFi</a></li>
            <li><a href="/herramientas/generador-contrasenas"><span>🔐</span> Generador de Claves</a></li>
            <li><a href="/herramientas/compresor-imagenes"><span>🖼️</span> Comprimir Imágenes</a></li>
            <li><a href="/herramientas/calculadora-descarga"><span>⏳</span> Tiempo de Descarga</a></li>
            <li><a href="/herramientas/generador-qr"><span>📱</span> Generador de QR</a></li>
            <li><a href="/herramientas/detector-enlaces"><span>🛡️</span> Detector de Enlaces</a></li>
          </ul>
          <a href="/herramientas" class="sidebar-tools-cta">Ver todas las herramientas →</a>
        </div>

        <div class="sidebar-card">
          <h3>📂 Categorías</h3>
          <a href="/categoria/ia">🤖 IA Herramientas</a>
          <a href="/categoria/errores">🛠️ Solución de Errores</a>
          <a href="/categoria/comparativas">⚖️ Comparativas 2026</a>
          <a href="/categoria/alternativas">🔄 Alternativas Gratis</a>
          <a href="/categoria/streaming">📺 Streaming y Smart TV</a>
          <a href="/categoria/windows-linux">🖥️ Windows, Mac y Linux</a>
          <a href="/categoria/freelance">💼 Trabajo Remoto</a>
          <a href="/categoria/finanzas">💰 Finanzas Digitales</a>
          <a href="/categoria/ciberseguridad">🔒 Ciberseguridad</a>
          <a href="/categoria/emprendimiento">🚀 Ganar Dinero</a>
          <a href="/categoria/salud">🏥 Salud Digital</a>
          <a href="/categoria/hogar">🏠 Hogar Inteligente</a>
          <a href="/categoria/gaming">🎮 Gaming y PC</a>
          <a href="/categoria/movil">📱 Apps y Trucos Móvil</a>
          <a href="/categoria/familia">👶 Familia y Niños</a>
          <a href="/categoria/educacion">🎓 Educación Online</a>
          <a href="/categoria/productividad">⚡ Productividad</a>
          <a href="/categoria/tecnologia">💻 Tecnología</a>
          <a href="/categoria/guias">📖 Guías Paso a Paso</a>
        </div>

        <div class="sidebar-card newsletter-mini">
          <h3>📬 Newsletter</h3>
          <p>Recibe lo mejor en tecnología cada semana.</p>
          <form action="https://formspree.io/f/xppzwgrq" method="POST">
            <input type="email" name="email" placeholder="tu@email.com" required />
            <button type="submit">Suscribirme</button>
          </form>
        </div>
      </aside>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .article-page { padding: 1.5rem 0 3rem; }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--primary); }

  /* HERO IMAGE */
  .hero-image-wrap {
    margin: 1.5rem auto 0;
    border-radius: 16px;
    overflow: hidden;
    max-height: 480px;
  }
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 16px;
  }
  .photo-credit {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-align: right;
    margin-top: 0.4rem;
    padding: 0 0.25rem;
  }
  .photo-credit a { color: var(--text-muted); text-decoration: underline; }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }
  .article-main, .article-sidebar {
    min-width: 0;
  }

  .article-header { margin-bottom: 1.5rem; }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .reading-time { font-size: 0.82rem; color: var(--text-muted); }

  .article-title {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .article-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    border-left: 3px solid var(--primary);
    padding-left: 1rem;
  }

  .article-meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .share-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .share-btn {
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .share-btn:hover { opacity: 0.8; text-decoration: none; }
  .share-x { background: #000; color: white; }
  .share-wa { background: #25D366; color: white; }
  .share-li { background: #0A66C2; color: white; }

  .article-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }

  .related-posts { margin-top: 3rem; }
  .related-posts h2 { font-size: 1.3rem; font-weight: 700; margin-bottom: 1.25rem; }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .article-sidebar {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .sidebar-card h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.75rem; }

  .sidebar-card a {
    display: block;
    padding: 0.4rem 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s;
  }

  .sidebar-card a:last-child { border-bottom: none; }
  .sidebar-card a:hover { color: var(--primary); }

  .newsletter-mini p { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; line-height: 1.5; }

  .newsletter-mini input {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .newsletter-mini button {
    width: 100%;
    background: var(--primary);
    color: white;
    border: none;
    padding: 0.65rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    font-family: var(--font);
    transition: background 0.2s;
  }

  .newsletter-mini button:hover { background: var(--primary-dark); }

  /* TOC Styles */
  .toc-container {
    background: rgba(99, 102, 241, 0.05);
    border-left: 4px solid var(--primary);
    padding: 1.5rem;
    border-radius: 0 12px 12px 0;
    margin-bottom: 2.5rem;
  }
  .toc-container h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--heading);
  }
  .toc-container ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .toc-level-2 { margin-left: 0; }
  .toc-level-3 { margin-left: 1.5rem; font-size: 0.9em; }
  .toc-container a {
