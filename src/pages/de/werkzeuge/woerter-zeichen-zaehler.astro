---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/contador-palabras/',
  en: '/en/tools/word-character-counter/',
  pt: '/pt/ferramentas/contador-palavras-caracteres/',
  fr: '/fr/outils/compteur-mots-caracteres/',
  de: '/de/werkzeuge/woerter-zeichen-zaehler/'
};

const breadcrumbs = [
  { name: 'Start', url: '/de/' },
  { name: 'Werkzeuge', url: '/de/werkzeuge/' },
  { name: 'Wörterzähler', url: '/de/werkzeuge/woerter-zeichen-zaehler/' }
];
---

<BaseLayout
  title="Kostenloser Online Wörter- & Zeichenzähler"
  description="Zählen Sie Wörter, Zeichen mit und ohne Leerzeichen, Sätze und geschätzte Lesezeit in Echtzeit."
  lang="de"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb"><a href="/de/">Start</a><span>›</span><a href="/de/werkzeuge/">Werkzeuge</a><span>›</span><span>Wörterzähler</span></div>
    <header class="tool-header">
      <div class="tool-badge">📝 Text & SEO Tool</div>
      <h1>Online Wörter- & Zeichenzähler</h1>
      <p class="tool-subtitle">Analysieren Sie Wörter, Zeichen, Sätze und die geschätzte Lesezeit sofort im Browser.</p>
    </header>

    <div class="card">
      <div class="stats-grid">
        <div class="stat-box"><span class="stat-label">Wörter</span><strong id="cnt-words">0</strong></div>
        <div class="stat-box"><span class="stat-label">Zeichen</span><strong id="cnt-chars">0</strong></div>
        <div class="stat-box"><span class="stat-label">Ohne Leerz.</span><strong id="cnt-nospaces">0</strong></div>
        <div class="stat-box"><span class="stat-label">Sätze</span><strong id="cnt-sentences">0</strong></div>
        <div class="stat-box"><span class="stat-label">Lesezeit</span><strong id="cnt-read">0 min</strong></div>
      </div>
      <textarea id="text-input" rows="12" placeholder="Text hier eingeben oder einfügen..."></textarea>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const ta = document.getElementById('text-input');
    ta.addEventListener('input', () => {
      const txt = ta.value, words = txt.trim() ? txt.trim().split(/\s+/).length : 0;
      document.getElementById('cnt-words').textContent = words;
      document.getElementById('cnt-chars').textContent = txt.length;
      document.getElementById('cnt-nospaces').textContent = txt.replace(/\s/g, '').length;
      document.getElementById('cnt-sentences').textContent = txt.trim() ? txt.split(/[.!?]+/).filter(Boolean).length : 0;
      document.getElementById('cnt-read').textContent = words === 0 ? '0 min' : `${Math.max(1, Math.ceil(words / 200))} min`;
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 920px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(99, 102, 241, 0.14); color: #818cf8; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.85rem; margin-bottom: 1.25rem; }
  .stat-box { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem; text-align: center; }
  .stat-label { display: block; font-size: 0.78rem; color: var(--text-muted); }
  .stat-box strong { font-size: 1.4rem; color: var(--primary); }
  textarea { width: 100%; padding: 1rem; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 1rem; resize: vertical; }
</style>
