---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/comprobador-seguridad-contrasenas/',
  en: '/en/tools/password-security-checker/',
  pt: '/pt/ferramentas/verificador-seguranca-senhas/',
  fr: '/fr/outils/verificateur-securite-mot-de-passe/',
  de: '/de/werkzeuge/passwort-sicherheit-pruefer/'
};

const breadcrumbs = [
  { name: 'Start', url: '/de/' },
  { name: 'Werkzeuge', url: '/de/werkzeuge/' },
  { name: 'Passwort-Prüfer', url: '/de/werkzeuge/passwort-sicherheit-pruefer/' }
];
---

<BaseLayout
  title="Passwort-Sicherheit & Entropie-Prüfer | Brute-Force Test"
  description="Prüfen Sie die Stärke Ihres Passworts, berechnen Sie die mathematische Entropie in Bits und generieren Sie sichere Passwörter lokal im Browser."
  lang="de"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb"><a href="/de/">Start</a><span>›</span><a href="/de/werkzeuge/">Werkzeuge</a><span>›</span><span>Passwort-Prüfer</span></div>
    <header class="tool-header">
      <div class="tool-badge">🔒 100% Lokale Prüfung</div>
      <h1>Passwort-Sicherheit & Entropie-Prüfer</h1>
      <p class="tool-subtitle">Berechnen Sie Entropie-Bits und Brute-Force-Resistenz ohne Datenübertragung.</p>
    </header>

    <div class="card">
      <div class="form-group">
        <label for="pwd-input">Passwort eingeben</label>
        <div class="password-box">
          <input type="password" id="pwd-input" placeholder="Passwort testen..." autocomplete="off" spellcheck="false" />
          <button type="button" id="btn-toggle-vis" class="btn-vis">👁️</button>
        </div>
      </div>
      <div class="meter-bar-track"><div id="meter-fill" class="meter-fill" style="width: 0%;"></div></div>
      <div class="stats-row">
        <div>Stärke: <strong id="meter-text">—</strong></div>
        <div>Entropie: <strong id="entropy-val">0 Bits</strong></div>
        <div>Geschätzte Zeit: <strong id="crack-time">—</strong></div>
      </div>
      <button type="button" id="btn-gen-pwd" class="btn-primary">🎲 Starkes Passwort generieren (18 Zeichen)</button>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const input = document.getElementById('pwd-input'), fill = document.getElementById('meter-fill'), mText = document.getElementById('meter-text'), eVal = document.getElementById('entropy-val'), cTime = document.getElementById('crack-time');
    document.getElementById('btn-toggle-vis').addEventListener('click', () => { input.type = input.type === 'password' ? 'text' : 'password'; });
    function evaluate(pwd) {
      if (!pwd) { fill.style.width = '0%'; mText.textContent = '—'; eVal.textContent = '0 Bits'; cTime.textContent = '—'; return; }
      let pool = 0; if (/[a-z]/.test(pwd)) pool += 26; if (/[A-Z]/.test(pwd)) pool += 26; if (/[0-9]/.test(pwd)) pool += 10; if (/[^a-zA-Z0-9]/.test(pwd)) pool += 32;
      const entropy = Math.round(pwd.length * Math.log2(Math.max(pool, 1)));
      eVal.textContent = `${entropy} Bits`; fill.style.width = `${Math.min(100, entropy)}%`;
      if (entropy < 36) { fill.style.background = '#ef4444'; mText.textContent = 'Sehr Schwach'; cTime.textContent = 'Sekunden'; }
      else if (entropy < 60) { fill.style.background = '#f59e0b'; mText.textContent = 'Mittel'; cTime.textContent = 'Tage bis Monate'; }
      else if (entropy < 80) { fill.style.background = '#3b82f6'; mText.textContent = 'Stark'; cTime.textContent = 'Jahrhunderte'; }
      else { fill.style.background = '#10b981'; mText.textContent = 'Unknackbar'; cTime.textContent = 'Millionen Jahre'; }
    }
    input.addEventListener('input', () => evaluate(input.value));
    document.getElementById('btn-gen-pwd').addEventListener('click', () => {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*()-_=+';
      const arr = new Uint32Array(18); crypto.getRandomValues(arr);
      const gen = Array.from(arr, n => chars[n % chars.length]).join('');
      input.type = 'text'; input.value = gen; evaluate(gen);
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 820px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(6, 182, 212, 0.14); color: #22d3ee; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.5rem; }
  .password-box { display: flex; gap: 0.5rem; margin: 0.5rem 0 1rem; }
  .password-box input { flex: 1; padding: 0.85rem; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 1rem; }
  .btn-vis { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0 1rem; cursor: pointer; }
  .meter-bar-track { height: 10px; background: var(--bg); border-radius: 999px; overflow: hidden; margin-bottom: 1rem; }
  .meter-fill { height: 100%; transition: width 0.2s, background 0.2s; }
  .stats-row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.75rem 1.35rem; border-radius: 10px; font-weight: 600; cursor: pointer; }
</style>
