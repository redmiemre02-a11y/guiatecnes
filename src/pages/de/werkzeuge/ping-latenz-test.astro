---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/test-ping/',
  en: '/en/tools/ping-latency-test/',
  pt: '/pt/ferramentas/teste-ping-latencia/',
  fr: '/fr/outils/test-ping-latence/',
  de: '/de/werkzeuge/ping-latenz-test/'
};

const breadcrumbs = [
  { name: 'Start', url: '/de/' },
  { name: 'Werkzeuge', url: '/de/werkzeuge/' },
  { name: 'Ping & Latenz Test', url: '/de/werkzeuge/ping-latenz-test/' }
];
---

<BaseLayout
  title="Online Ping- & Latenz-Test | Echtzeit Gaming-Jitter Check"
  description="Messen Sie Ihren Ping in Millisekunden (ms), Jitter und Verbindungsstabilität in Echtzeit direkt im Browser."
  lang="de"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb"><a href="/de/">Start</a><span>›</span><a href="/de/werkzeuge/">Werkzeuge</a><span>›</span><span>Ping & Latenz Test</span></div>
    <header class="tool-header">
      <div class="tool-badge">🎮 Gaming, Glasfaser & Netzwerk</div>
      <h1>Online Ping- & Latenz-Test</h1>
      <p class="tool-subtitle">Prüfen Sie Ihre Reaktionszeit (ms) und den Jitter direkt im Browser ohne Download.</p>
    </header>

    <div class="card gauge-card">
      <div class="ping-display-box">
        <span class="ping-label">Durchschnittliche Latenz:</span>
        <div><span id="main-ping-val" class="main-ping-val">--</span><span class="unit-text"> ms</span></div>
        <div id="ping-verdict-badge" class="verdict-badge">Zum Starten klicken</div>
      </div>
      <div class="metrics-row">
        <div class="metric-col"><span class="metric-title">Min. Ping:</span><strong id="min-ping-val">-- ms</strong></div>
        <div class="metric-col"><span class="metric-title">Jitter:</span><strong id="jitter-val">-- ms</strong></div>
        <div class="metric-col"><span class="metric-title">Gaming-Urteil:</span><strong id="gaming-verdict">--</strong></div>
      </div>
      <button type="button" id="btn-start-ping" class="btn-primary">⚡ Ping-Test starten</button>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const btn = document.getElementById('btn-start-ping'), mainVal = document.getElementById('main-ping-val'), minVal = document.getElementById('min-ping-val'), jitterVal = document.getElementById('jitter-val'), ratingVal = document.getElementById('gaming-verdict'), badge = document.getElementById('ping-verdict-badge');
    async function singlePing(url) { const t0 = performance.now(); try { await fetch(url + '?t=' + Math.random(), { mode: 'no-cors', cache: 'no-store' }); return Math.round(performance.now() - t0); } catch (e) { return null; } }
    btn.addEventListener('click', async () => {
      btn.disabled = true; btn.textContent = '⏳ Messe...'; badge.textContent = '8 Messungen laufen...';
      const samples = [], eps = ['https://1.1.1.1/cdn-cgi/trace', 'https://www.google.com/generate_204'];
      for (let i = 0; i < 8; i++) { const ms = await singlePing(eps[i % eps.length]); if (ms !== null) { samples.push(ms); mainVal.textContent = ms; } }
      if (samples.length > 0) {
        const avg = Math.round(samples.reduce((a, b) => a + b, 0) / samples.length), min = Math.min(...samples);
        let j = 0; for (let i = 1; i < samples.length; i++) j += Math.abs(samples[i] - samples[i - 1]);
        const jitter = samples.length > 1 ? Math.round(j / (samples.length - 1)) : 0;
        mainVal.textContent = avg; minVal.textContent = `${min} ms`; jitterVal.textContent = `${jitter} ms`;
        const r = avg < 35 ? 'Ausgezeichnet' : avg < 75 ? 'Gut' : avg < 120 ? 'Spielbar' : 'Hoher Lag';
        ratingVal.textContent = r; badge.textContent = `Fertig (${samples.length}/8) · ${r}`;
      }
      btn.disabled = false; btn.textContent = '🔄 Test wiederholen';
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 820px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(16, 185, 129, 0.14); color: #34d399; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.5rem; text-align: center; }
  .main-ping-val { font-size: 3.5rem; font-weight: 800; color: var(--primary); }
  .unit-text { font-size: 1.25rem; color: var(--text-muted); }
  .verdict-badge { display: inline-block; background: var(--bg); border: 1px solid var(--border); padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.88rem; margin: 0.75rem 0 1.25rem; }
  .metrics-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .metric-col { background: var(--bg); border: 1px solid var(--border); padding: 0.9rem; border-radius: 10px; }
  .metric-title { display: block; font-size: 0.78rem; color: var(--text-muted); }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.85rem 1.75rem; border-radius: 10px; font-weight: 700; cursor: pointer; font-size: 1rem; }
</style>
