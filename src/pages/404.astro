---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout 
  title="Página no encontrada" 
  description="Error 404 - La página que buscas no existe."
>
  <Header slot="header" />
  
  <div class="error-container">
    <div class="error-content">
      <div class="glitch-wrapper">
        <h1 class="glitch" data-text="404">404</h1>
      </div>
      <h2>¡Ups! Te has perdido en la matriz.</h2>
      <p>La página que buscas no existe, ha sido movida o nunca existió.</p>
      
      <div class="actions">
        <a href="/" class="btn-primary">
          <span>🏠 Volver al Inicio</span>
        </a>
        <a href="/categoria/tecnologia" class="btn-secondary">
          <span>💻 Ver Tecnología</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  }
  .error-content {
    max-width: 600px;
  }
  .glitch-wrapper {
    margin-bottom: 1rem;
  }
  .glitch {
    font-size: 8rem;
    font-weight: 900;
    margin: 0;
    line-height: 1;
    background: linear-gradient(135deg, var(--primary) 0%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    display: inline-block;
  }
  
  h2 {
    font-size: 2rem;
    color: var(--heading);
    margin-bottom: 1rem;
  }
  p {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
  }
  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  
  .btn-primary, .btn-secondary {
    padding: 0.8rem 1.8rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, #4f46e5 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.5);
  }
  
  .btn-secondary {
    background: var(--bg-card);
    color: var(--text);
    border: 1px solid var(--border);
  }
  .btn-secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-3px);
  }
  
  @media (max-width: 600px) {
    .actions { flex-direction: column; }
    .glitch { font-size: 6rem; }
    h2 { font-size: 1.5rem; }
  }
</style>
