---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const alternates = {
  es: '/',
  en: '/en/',
  pt: '/pt/'
};

const tools = [
  {
    title: 'Laboratório de Testes de Hardware (Monitor, Teclado e Controle)',
    desc: 'Teste pixels mortos e vazamento de luz no monitor, verifique anti-ghosting do teclado, teste áudio estéreo/Hz e detecte drift no controle PS5/Xbox.',
    url: '/pt/ferramentas/laboratorio-testes-hardware/',
    icon: '🖥️',
    badge: 'Hardware & Games',
  },
  {
    title: 'Assistente Interativo de Diagnóstico Técnico',
    desc: 'PC desligando sozinho, Wi-Fi sem internet, celular não carrega ou atraso no Bluetooth? Responda 3 perguntas para descobrir a causa e a solução.',
    url: '/pt/ferramentas/assistente-diagnostico-tecnico/',
    icon: '🩺',
    badge: 'Solução em 3 Passos',
  },
  {
    title: 'Auditoria de Privacidade e Impressão Digital',
    desc: 'Verifique vazamentos de IP via WebRTC mesmo com VPN, analise sua assinatura Canvas Fingerprint, GPU WebGL e pontuação de privacidade.',
    url: '/pt/ferramentas/auditoria-privacidade-impressao-digital/',
    icon: '🛡️',
    badge: 'Cibersegurança',
  },
  {
    title: 'Verificador de Segurança e Entropia de Senhas',
    desc: 'Calcule a entropia matemática da sua senha e estime o tempo contra ataques de força bruta 100% localmente no navegador.',
    url: '/pt/ferramentas/verificador-seguranca-senhas/',
    icon: '🔒',
    badge: 'Segurança Local',
  }
];
---

<BaseLayout
  title="Ferramentas Tecnológicas Gratuitas, Diagnóstico de Hardware e Privacidade"
  description="GuíaTecnes em Português: Laboratório online para testar monitor, teclado e controle, assistente de diagnóstico técnico, auditoria WebRTC e verificador de senhas."
  lang="pt"
  alternates={alternates}
>
  <Header slot="header" />

  <main class="pt-home container">
    <section class="hero-card">
      <div class="hero-badge">⚡ Utilitários Web Gratuitos · 100% no Navegador</div>
      <h1>Ferramentas de Hardware, Diagnóstico e Privacidade</h1>
      <p class="hero-sub">
        Sem downloads, sem rastreamento e execução instantânea no seu navegador. Teste seu monitor, teclado, controle, rede e segurança em segundos.
      </p>
      <div class="hero-cta-row">
        <a href="/pt/ferramentas/" class="btn-primary">Ver Todas as Ferramentas →</a>
        <a href="/pt/ferramentas/laboratorio-testes-hardware/" class="btn-secondary">🖥️ Abrir Lab de Hardware</a>
      </div>
    </section>

    <section class="tools-section">
      <h2>Ferramentas Mais Populares</h2>
      <div class="tools-grid">
        {tools.map(t => (
          <a href={t.url} class="tool-card">
            <div class="tc-top">
              <span class="tc-icon">{t.icon}</span>
              <span class="tc-badge">{t.badge}</span>
            </div>
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
            <span class="tc-link">Abrir Ferramenta →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="lang-banner card">
      <h2>🌐 Disponível em Vários Idiomas</h2>
      <p>
        Alterne a qualquer momento entre
        <a href="/">Español (ES / LATAM)</a>,
        <a href="/en/">English (Global)</a> e
        <a href="/pt/">Português (Brasil / PT)</a>.
      </p>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .pt-home { padding: 2.5rem 1rem 4rem; max-width: 1040px; margin: 0 auto; }
  .hero-card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 3rem 2rem; text-align: center; margin-bottom: 2.5rem; }
  .hero-badge { display: inline-block; background: rgba(16, 185, 129, 0.14); color: #34d399; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem; border: 1px solid rgba(16, 185, 129, 0.28); }
  .hero-card h1 { font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.15; margin-bottom: 1rem; }
  .hero-sub { color: var(--text-muted); max-width: 680px; margin: 0 auto 1.75rem; font-size: 1.08rem; line-height: 1.6; }
  .hero-cta-row { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .btn-primary { background: var(--primary); color: #fff; padding: 0.85rem 1.5rem; border-radius: 10px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: var(--bg); color: var(--text); border: 1px solid var(--border); padding: 0.85rem 1.5rem; border-radius: 10px; font-weight: 600; text-decoration: none; }
  .tools-section h2 { font-size: 1.5rem; margin-bottom: 1.25rem; }
  .tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem; }
  .tool-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; text-decoration: none; color: var(--text); display: flex; flex-direction: column; gap: 0.75rem; }
  .tool-card:hover { border-color: var(--primary); }
  .tc-top { display: flex; justify-content: space-between; align-items: center; }
  .tc-icon { font-size: 1.85rem; }
  .tc-badge { font-size: 0.75rem; font-weight: 700; background: var(--bg); border: 1px solid var(--border); padding: 0.25rem 0.65rem; border-radius: 999px; color: var(--text-muted); }
  .tool-card h3 { font-size: 1.15rem; margin: 0; line-height: 1.3; }
  .tool-card p { font-size: 0.92rem; color: var(--text-muted); line-height: 1.5; margin: 0; flex: 1; }
  .tc-link { font-size: 0.9rem; font-weight: 700; color: var(--primary); }
  .lang-banner.card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; text-align: center; }
  .lang-banner h2 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .lang-banner p { color: var(--text-muted); margin: 0; }
  .lang-banner a { color: var(--primary); font-weight: 600; }
</style>
