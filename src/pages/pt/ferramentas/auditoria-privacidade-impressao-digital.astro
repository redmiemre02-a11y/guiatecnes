---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/auditoria-privacidad-huella-digital/',
  en: '/en/tools/privacy-fingerprint-audit/',
  pt: '/pt/ferramentas/auditoria-privacidade-impressao-digital/',
  fr: '/fr/outils/audit-confidentialite-empreinte/',
  de: '/de/werkzeuge/datenschutz-fingerprint-check/'
};

const breadcrumbs = [
  { name: 'Início', url: '/pt/' },
  { name: 'Ferramentas', url: '/pt/ferramentas/' },
  { name: 'Auditoria de Privacidade', url: '/pt/ferramentas/auditoria-privacidade-impressao-digital/' }
];

const faqs = [
  {
    question: 'O que é a impressão digital do navegador (Browser Fingerprinting)?',
    answer: 'É uma técnica que combina sinais de hardware e software (placa de vídeo, resolução de tela, Canvas, fuso horário) para rastrear seu navegador mesmo em aba anônima ou sem cookies.'
  },
  {
    question: 'O que é um vazamento de IP via WebRTC?',
    answer: 'O WebRTC pode expor seu endereço IP real local ou público por meio de requisições STUN, mesmo quando você está conectado a uma VPN.'
  }
];
---

<BaseLayout
  title="Auditoria de Privacidade e Impressão Digital Online | Teste WebRTC"
  description="Analise o que seu navegador expõe em tempo real: teste de vazamento WebRTC com VPN, Canvas Fingerprint, WebGL GPU e pontuação de privacidade."
  lang="pt"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/pt/">Início</a>
      <span>›</span>
      <a href="/pt/ferramentas/">Ferramentas</a>
      <span>›</span>
      <span>Auditoria de Privacidade</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🛡️ Cibersegurança · 100% Local</div>
      <h1>Auditoria de Privacidade e Impressão Digital</h1>
      <p class="tool-subtitle">Descubra em segundos quantos dados técnicos únicos seu navegador expõe a rastreadores.</p>
    </header>

    <section class="audit-hero card">
      <div class="score-circle" id="score-circle">
        <span class="score-num" id="privacy-score">--</span>
        <span class="score-max">/ 100</span>
      </div>
      <div class="score-info">
        <h2 id="score-title">Pronto para auditar seu navegador</h2>
        <p id="score-desc">Clique abaixo para testar vazamentos WebRTC, Canvas Fingerprint e exposição WebGL.</p>
        <button type="button" id="btn-run-audit" class="btn-primary">🔍 Executar Auditoria Agora</button>
      </div>
    </section>

    <section id="audit-results" class="audit-grid" style="display:none;">
      <div class="audit-card card">
        <div class="card-head"><span>🌐</span><h3>Vazamento IP WebRTC</h3><span class="status-pill" id="webrtc-pill">...</span></div>
        <p class="card-val" id="webrtc-val">Verificando...</p>
      </div>
      <div class="audit-card card">
        <div class="card-head"><span>🎨</span><h3>Canvas Fingerprint ID</h3><span class="status-pill" id="canvas-pill">...</span></div>
        <p class="card-val mono" id="canvas-val">—</p>
      </div>
      <div class="audit-card card">
        <div class="card-head"><span>🎮</span><h3>Placa de Vídeo (WebGL)</h3><span class="status-pill" id="webgl-pill">...</span></div>
        <p class="card-val mono" id="webgl-val">—</p>
      </div>
      <div class="audit-card card">
        <div class="card-head"><span>💻</span><h3>Hardware e Sistema</h3><span class="status-pill warn">Metadados</span></div>
        <ul class="meta-list" id="hw-list"></ul>
      </div>
    </section>

    <section class="seo-guide card">
      <h2>Perguntas Frequentes</h2>
      <div class="faq-list">
        {faqs.map(faq => (<details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    function djb2(str) {
      let h = 5381; for (let i = 0; i < str.length; i++) h = ((h << 5) + h) + str.charCodeAt(i);
      return (h >>> 0).toString(16).toUpperCase().padStart(8, '0');
    }
    function getCanvas() {
      try {
        const c = document.createElement('canvas'); c.width = 240; c.height = 60;
        const ctx = c.getContext('2d'); ctx.textBaseline = 'top'; ctx.font = '14px Arial';
        ctx.fillStyle = '#f60'; ctx.fillRect(10, 10, 80, 30); ctx.fillStyle = '#069'; ctx.fillText('GuiaTecnes_FP_2026!', 14, 16);
        return djb2(c.toDataURL());
      } catch (e) { return 'BLOQUEADO'; }
    }
    function getWebGL() {
      try {
        const gl = document.createElement('canvas').getContext('webgl');
        if (!gl) return { exposed: false, renderer: 'Desativado' };
        const dbg = gl.getExtension('WEBGL_debug_renderer_info');
        if (!dbg) return { exposed: false, renderer: 'Oculto' };
        return { exposed: true, renderer: gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) || 'Desconhecido' };
      } catch (e) { return { exposed: false, renderer: 'Bloqueado' }; }
    }
    function checkWebRTC(cb) {
      const RTCPeer = window.RTCPeerConnection || window.webkitRTCPeerConnection;
      if (!RTCPeer) return cb({ status: 'safe', msg: 'WebRTC desativado.' });
      try {
        const pc = new RTCPeer({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] }), ips = new Set();
        pc.createDataChannel(''); pc.createOffer().then(o => pc.setLocalDescription(o)).catch(() => {});
        pc.onicecandidate = (ice) => {
          if (!ice || !ice.candidate || !ice.candidate.candidate) return;
          const m = ice.candidate.candidate.match(/([0-9]{1,3}(\.[0-9]{1,3}){3})/);
          if (m && m[1]) ips.add(m[1]);
        };
        setTimeout(() => {
          try { pc.close(); } catch (e) {}
          const list = Array.from(ips);
          cb(list.length === 0 ? { status: 'safe', msg: 'Sem vazamentos visíveis (protegido).' } : { status: 'leak', msg: `IPs via WebRTC: ${list.join(', ')}` });
        }, 1400);
      } catch (e) { cb({ status: 'safe', msg: 'WebRTC restrito.' }); }
    }
    document.getElementById('btn-run-audit').addEventListener('click', () => {
      const btn = document.getElementById('btn-run-audit'); btn.disabled = true; btn.textContent = '⏳ Analisando...';
      document.getElementById('audit-results').style.display = 'grid';
      const fp = getCanvas();
      document.getElementById('canvas-val').textContent = `Hash: #${fp}`;
      const cPill = document.getElementById('canvas-pill'); cPill.textContent = fp === 'BLOQUEADO' ? 'Protegido' : 'Rastreável';
      cPill.className = fp === 'BLOQUEADO' ? 'status-pill safe' : 'status-pill warn';
      const gl = getWebGL();
      document.getElementById('webgl-val').textContent = gl.renderer;
      const gPill = document.getElementById('webgl-pill'); gPill.textContent = gl.exposed ? 'Exposto' : 'Oculto';
      gPill.className = gl.exposed ? 'status-pill warn' : 'status-pill safe';
      const cores = navigator.hardwareConcurrency || 'Oculto';
      document.getElementById('hw-list').innerHTML = `<li><strong>Núcleos CPU:</strong> ${cores}</li><li><strong>Tela:</strong> ${window.screen.width} × ${window.screen.height}</li><li><strong>Fuso:</strong> ${Intl.DateTimeFormat().resolvedOptions().timeZone}</li>`;
      checkWebRTC((res) => {
        const rtcPill = document.getElementById('webrtc-pill'); document.getElementById('webrtc-val').textContent = res.msg;
        rtcPill.textContent = res.status === 'safe' ? 'Seguro' : 'Vazamento'; rtcPill.className = res.status === 'safe' ? 'status-pill safe' : 'status-pill danger';
        let score = 100; if (res.status === 'leak') score -= 30; if (fp !== 'BLOQUEADO') score -= 20; if (gl.exposed) score -= 15; if (cores !== 'Oculto') score -= 10;
        document.getElementById('privacy-score').textContent = score;
        document.getElementById('score-title').textContent = score >= 80 ? 'Privacidade Alta' : score >= 55 ? 'Exposição Média' : 'Alta Exposição';
        document.getElementById('score-circle').style.borderColor = score >= 80 ? '#10b981' : score >= 55 ? '#f59e0b' : '#ef4444';
        btn.disabled = false; btn.textContent = '🔄 Repetir Auditoria';
      });
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 980px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(239, 68, 68, 0.14); color: #f87171; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .audit-hero { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .score-circle { width: 120px; height: 120px; border-radius: 50%; border: 6px solid var(--primary); display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--bg); }
  .score-num { font-size: 2.2rem; font-weight: 800; line-height: 1; }
  .score-info { flex: 1; min-width: 240px; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.75rem 1.4rem; border-radius: 10px; font-weight: 600; cursor: pointer; }
  .audit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .audit-card { margin-bottom: 0; display: flex; flex-direction: column; gap: 0.65rem; }
  .card-head { display: flex; align-items: center; gap: 0.5rem; }
  .card-head h3 { font-size: 1.05rem; margin: 0; flex: 1; }
  .status-pill { font-size: 0.74rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 999px; }
  .status-pill.safe { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .status-pill.warn { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
  .status-pill.danger { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
  .mono { font-family: monospace; background: var(--bg); padding: 0.45rem 0.65rem; border-radius: 8px; border: 1px solid var(--border); word-break: break-word; }
  .meta-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.88rem; color: var(--text-muted); }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.95rem 1.1rem; }
  .faq-item summary { font-weight: 600; cursor: pointer; }
  .faq-item p { margin: 0.7rem 0 0; font-size: 0.93rem; color: var(--text-muted); }
</style>
