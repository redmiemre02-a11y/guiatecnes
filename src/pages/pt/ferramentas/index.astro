---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/',
  en: '/en/tools/',
  pt: '/pt/ferramentas/',
  fr: '/fr/outils/',
  de: '/de/werkzeuge/'
};

const tools = [
  {
    title: 'Laboratório de Testes de Hardware',
    desc: 'Teste de pixels mortos no monitor, anti-ghosting do teclado, áudio estéreo/Hz e detecção de drift em controles PS5/Xbox.',
    url: '/pt/ferramentas/laboratorio-testes-hardware/',
    icon: '🖥️',
    badge: 'Hardware & Games'
  },
  {
    title: 'Assistente de Diagnóstico Técnico',
    desc: 'Árvore lógica em 3 passos para diagnosticar falhas no PC Windows, celular, Wi-Fi sem internet e atraso Bluetooth.',
    url: '/pt/ferramentas/assistente-diagnostico-tecnico/',
    icon: '🩺',
    badge: 'Diagnóstico'
  },
  {
    title: 'Auditoria de Privacidade e Impressão Digital',
    desc: 'Teste vazamentos de IP por WebRTC, Canvas Fingerprint, WebGL GPU e veja sua pontuação de privacidade no navegador.',
    url: '/pt/ferramentas/auditoria-privacidade-impressao-digital/',
    icon: '🛡️',
    badge: 'Cibersegurança'
  },
  {
    title: 'Formatador e Validador JSON',
    desc: 'Formate, valide erros de sintaxe e minifique JSON 100% localmente no navegador.',
    url: '/pt/ferramentas/formatador-validador-json/',
    icon: '{}',
    badge: 'Dev'
  },
  {
    title: 'Contador de Palavras e Caracteres',
    desc: 'Conte palavras, caracteres, frases e tempo de leitura em tempo real.',
    url: '/pt/ferramentas/contador-palavras-caracteres/',
    icon: '📝',
    badge: 'Redação'
  },
  {
    title: 'Compressor de Imagens Online',
    desc: 'Reduza o peso de fotos JPG, PNG e WebP em até 80% localmente no navegador.',
    url: '/pt/ferramentas/compressor-imagens/',
    icon: '🖼️',
    badge: 'Mídia'
  },
  {
    title: 'Teste de Velocidade da Internet',
    desc: 'Meça sua velocidade real de download (Mbps) e ping direto no navegador.',
    url: '/pt/ferramentas/teste-velocidade-internet/',
    icon: '⚡',
    badge: 'Rede'
  },
  {
    title: 'Gerador de QR Code Grátis',
    desc: 'Crie códigos QR estáticos permanentes para links, redes Wi-Fi ou texto com download em PNG.',
    url: '/pt/ferramentas/gerador-qr-gratis/',
    icon: '📲',
    badge: 'Utilidades'
  },
  {
    title: 'Teste de Ping e Latência Online',
    desc: 'Meça sua latência (ms), jitter e estabilidade da conexão para jogos online.',
    url: '/pt/ferramentas/teste-ping-latencia/',
    icon: '⏱️',
    badge: 'Rede & Games'
  },
  {
    title: 'Verificador de Segurança de Senhas',
    desc: 'Calcule entropia em bits e resistência contra força bruta 100% localmente sem enviar dados.',
    url: '/pt/ferramentas/verificador-seguranca-senhas/',
    icon: '🔒',
    badge: 'Segurança'
  }
];
---

<BaseLayout
  title="Diretório de Ferramentas Online Gratuitas"
  description="Ferramentas gratuitas no navegador em Português: laboratório de hardware, diagnóstico técnico, auditoria de privacidade WebRTC e verificador de senhas."
  lang="pt"
  alternates={alternates}
>
  <Header slot="header" />

  <main class="tool-dir container">
    <header class="dir-header">
      <h1>Ferramentas Online Gratuitas</h1>
      <p>Utilitários rápidos e privados que rodam 100% no seu navegador sem instalar nada.</p>
    </header>

    <div class="tools-grid">
      {tools.map(t => (
        <a href={t.url} class="tool-card">
          <div class="tc-top">
            <span class="tc-icon">{t.icon}</span>
            <span class="tc-badge">{t.badge}</span>
          </div>
          <h2>{t.title}</h2>
          <p>{t.desc}</p>
          <span class="tc-link">Abrir Ferramenta →</span>
        </a>
      ))}
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-dir { padding: 2.5rem 1rem 4rem; max-width: 1020px; margin: 0 auto; }
  .dir-header { text-align: center; margin-bottom: 2.5rem; }
  .dir-header h1 { font-size: 2.2rem; margin-bottom: 0.6rem; }
  .dir-header p { color: var(--text-muted); font-size: 1.05rem; }
  .tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
  .tool-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; text-decoration: none; color: var(--text); display: flex; flex-direction: column; gap: 0.75rem; }
  .tool-card:hover { border-color: var(--primary); }
  .tc-top { display: flex; justify-content: space-between; align-items: center; }
  .tc-icon { font-size: 1.85rem; }
  .tc-badge { font-size: 0.75rem; font-weight: 700; background: var(--bg); border: 1px solid var(--border); padding: 0.25rem 0.65rem; border-radius: 999px; color: var(--text-muted); }
  .tool-card h2 { font-size: 1.2rem; margin: 0; }
  .tool-card p { font-size: 0.92rem; color: var(--text-muted); line-height: 1.5; margin: 0; flex: 1; }
  .tc-link { font-size: 0.9rem; font-weight: 700; color: var(--primary); }
</style>
