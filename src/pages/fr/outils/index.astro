---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/',
  en: '/en/tools/',
  pt: '/pt/ferramentas/',
  fr: '/fr/outils/',
  de: '/de/werkzeuge/'
};

const tools = [
  {
    title: 'Laboratoire de Test Matériel',
    desc: 'Test pixels morts écran, anti-ghosting clavier, audio stéréo/Hz et drift manette PS5/Xbox.',
    url: '/fr/outils/laboratoire-test-materiel/',
    icon: '🖥️',
    badge: 'Matériel'
  },
  {
    title: 'Assistant de Diagnostic Technique',
    desc: 'Arbre logique en 3 étapes pour diagnostiquer les pannes PC, smartphone et Wi-Fi.',
    url: '/fr/outils/assistant-diagnostic-technique/',
    icon: '🩺',
    badge: 'Dépannage'
  },
  {
    title: 'Audit de Confidentialité & Empreinte',
    desc: 'Test de fuite IP WebRTC sous VPN, Canvas Fingerprint et score de confidentialité.',
    url: '/fr/outils/audit-confidentialite-empreinte/',
    icon: '🛡️',
    badge: 'Cybersécurité'
  },
  {
    title: 'Générateur de Code QR Gratuit',
    desc: 'Créez des codes QR permanents pour liens, Wi-Fi ou texte avec téléchargement PNG haute qualité.',
    url: '/fr/outils/generateur-qr-gratuit/',
    icon: '📲',
    badge: 'Utilitaires'
  },
  {
    title: 'Test de Ping et Latence en Ligne',
    desc: 'Mesurez votre ping (ms), jitter et stabilité réseau en temps réel pour le gaming.',
    url: '/fr/outils/test-ping-latence/',
    icon: '⏱️',
    badge: 'Réseau & Gaming'
  },
  {
    title: 'Vérificateur de Mot de Passe',
    desc: 'Calcul d’entropie mathématique et résistance au piratage par force brute 100% local.',
    url: '/fr/outils/verificateur-securite-mot-de-passe/',
    icon: '🔒',
    badge: 'Sécurité'
  }
];
---

<BaseLayout
  title="Répertoire des Outils Web Gratuits"
  description="Outils gratuits en français : testeur écran/clavier/manette, diagnostic PC/Wi-Fi, audit WebRTC et testeur de mots de passe."
  lang="fr"
  alternates={alternates}
>
  <Header slot="header" />

  <main class="tool-dir container">
    <header class="dir-header">
      <h1>Outils Web Gratuits en Ligne</h1>
      <p>Utilitaires rapides et privés exécutés localement dans votre navigateur sans installation.</p>
    </header>
    <div class="tools-grid">
      {tools.map(t => (
        <a href={t.url} class="tool-card">
          <div class="tc-top"><span class="tc-icon">{t.icon}</span><span class="tc-badge">{t.badge}</span></div>
          <h2>{t.title}</h2>
          <p>{t.desc}</p>
          <span class="tc-link">Ouvrir →</span>
        </a>
      ))}
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-dir { padding: 2.5rem 1rem 4rem; max-width: 1020px; margin: 0 auto; }
  .dir-header { text-align: center; margin-bottom: 2.5rem; }
  .dir-header h1 { font-size: 2.2rem; margin-bottom: 0.6rem; }
  .dir-header p { color: var(--text-muted); font-size: 1.05rem; }
  .tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
  .tool-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; text-decoration: none; color: var(--text); display: flex; flex-direction: column; gap: 0.75rem; }
  .tool-card:hover { border-color: var(--primary); }
  .tc-top { display: flex; justify-content: space-between; align-items: center; }
  .tc-icon { font-size: 1.85rem; }
  .tc-badge { font-size: 0.75rem; font-weight: 700; background: var(--bg); border: 1px solid var(--border); padding: 0.25rem 0.65rem; border-radius: 999px; color: var(--text-muted); }
  .tool-card h2 { font-size: 1.2rem; margin: 0; }
  .tool-card p { font-size: 0.92rem; color: var(--text-muted); line-height: 1.5; margin: 0; flex: 1; }
  .tc-link { font-size: 0.9rem; font-weight: 700; color: var(--primary); }
</style>
