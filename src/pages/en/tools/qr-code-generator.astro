---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/generador-qr/',
  en: '/en/tools/qr-code-generator/',
  pt: '/pt/ferramentas/gerador-qr-gratis/',
  fr: '/fr/outils/generateur-qr-gratuit/',
  de: '/de/werkzeuge/qr-code-generator/'
};

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Tools', url: '/en/tools/' },
  { name: 'Free QR Code Generator', url: '/en/tools/qr-code-generator/' }
];

const faqs = [
  {
    question: 'Do these QR codes expire or have scan limits?',
    answer: 'No. We generate direct static QR codes where your URL, WiFi credentials, or text are encoded directly into the QR matrix. They work forever with zero scan limits.'
  },
  {
    question: 'Can I create a WiFi QR code for my guests?',
    answer: 'Yes. Switch to the WiFi tab, enter your network name (SSID) and password, and download the QR code. Anyone who scans it with their phone camera connects automatically.'
  }
];
---

<BaseLayout
  title="Free QR Code Generator (No Expiration & High-Res PNG)"
  description="Create custom static QR codes for URLs, WiFi networks, or plain text. Customize colors and download high-resolution PNGs for free without sign-up."
  lang="en"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb"><a href="/en/">Home</a><span>›</span><a href="/en/tools/">Tools</a><span>›</span><span>QR Code Generator</span></div>
    <header class="tool-header">
      <div class="tool-badge">📲 Free Online Tool · Never Expires</div>
      <h1>Free QR Code Generator</h1>
      <p class="tool-subtitle">Generate static, permanent QR codes for links, WiFi passwords, or text with custom colors and instant PNG download.</p>
    </header>

    <div class="qr-grid">
      <div class="card">
        <div class="tabs">
          <button type="button" class="tab-btn active" data-type="url">🔗 URL / Link</button>
          <button type="button" class="tab-btn" data-type="wifi">📶 WiFi Network</button>
          <button type="button" class="tab-btn" data-type="text">📝 Text</button>
        </div>

        <div class="tab-content" id="content-url">
          <label for="input-url">Destination URL:</label>
          <input type="url" id="input-url" placeholder="https://example.com" value="https://guiatecnes.com/en/" />
        </div>

        <div class="tab-content" id="content-wifi" style="display:none;">
          <label for="wifi-ssid">Network Name (SSID):</label>
          <input type="text" id="wifi-ssid" placeholder="My_Home_WiFi" />
          <label for="wifi-pass" style="margin-top:0.75rem;">WiFi Password:</label>
          <input type="text" id="wifi-pass" placeholder="Your WiFi password" />
        </div>

        <div class="tab-content" id="content-text" style="display:none;">
          <label for="input-text">Message or Text:</label>
          <textarea id="input-text" rows="3" placeholder="Type any note or message..."></textarea>
        </div>

        <div class="color-options">
          <div><label for="qr-fg">Foreground:</label><input type="color" id="qr-fg" value="#0f172a" /></div>
          <div><label for="qr-bg">Background:</label><input type="color" id="qr-bg" value="#ffffff" /></div>
        </div>

        <button type="button" id="btn-create-qr" class="btn-primary">⚡ Generate QR Code</button>
      </div>

      <div class="card preview-card">
        <h3>Live Preview</h3>
        <div class="qr-box">
          <img id="qr-img" src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=https%3A%2F%2Fguiatecnes.com%2Fen%2F&color=0f172a&bgcolor=ffffff&margin=1" alt="Generated QR code" width="220" height="220" />
        </div>
        <button type="button" id="btn-download" class="btn-download">💾 Download QR Code (PNG)</button>
      </div>
    </div>

    <section class="seo-guide card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">{faqs.map(f => (<details class="faq-item"><summary>{f.question}</summary><p>{f.answer}</p></details>))}</div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    let activeType = 'url';
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = { url: document.getElementById('content-url'), wifi: document.getElementById('content-wifi'), text: document.getElementById('content-text') };
    const qrImg = document.getElementById('qr-img');

    tabs.forEach(t => t.addEventListener('click', () => {
      activeType = t.getAttribute('data-type');
      tabs.forEach(x => x.classList.toggle('active', x === t));
      Object.keys(contents).forEach(k => contents[k].style.display = k === activeType ? 'block' : 'none');
    }));

    function buildData() {
      if (activeType === 'url') return document.getElementById('input-url').value.trim() || 'https://guiatecnes.com/en/';
      if (activeType === 'wifi') {
        const ssid = document.getElementById('wifi-ssid').value.trim();
        const pass = document.getElementById('wifi-pass').value.trim();
        return `WIFI:T:WPA;S:${ssid};P:${pass};;`;
      }
      return document.getElementById('input-text').value.trim() || 'GuíaTecnes';
    }

    function updateQR() {
      const data = encodeURIComponent(buildData());
      const fg = document.getElementById('qr-fg').value.replace('#', '');
      const bg = document.getElementById('qr-bg').value.replace('#', '');
      qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=${data}&color=${fg}&bgcolor=${bg}&margin=2`;
    }

    document.getElementById('btn-create-qr').addEventListener('click', updateQR);
    document.getElementById('btn-download').addEventListener('click', async () => {
      updateQR();
      try {
        const res = await fetch(qrImg.src);
        const blob = await res.blob();
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'qrcode-guiatecnes.png';
        a.click();
      } catch (e) { window.open(qrImg.src, '_blank'); }
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 960px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(99, 102, 241, 0.14); color: #818cf8; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; }
  .qr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .tabs { display: flex; gap: 0.45rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
  .tab-btn { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); padding: 0.55rem 0.9rem; border-radius: 8px; cursor: pointer; font-weight: 600; }
  .tab-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }
  label { display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.4rem; }
  input[type="url"], input[type="text"], textarea { width: 100%; padding: 0.7rem; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); }
  .color-options { display: flex; gap: 1.25rem; margin: 1.15rem 0; }
  .btn-primary, .btn-download { width: 100%; background: var(--primary); color: #fff; border: none; padding: 0.8rem; border-radius: 10px; font-weight: 700; cursor: pointer; font-size: 0.96rem; }
  .btn-download { background: #10b981; margin-top: 1rem; }
  .preview-card { text-align: center; }
  .qr-box { background: #fff; padding: 1rem; border-radius: 12px; display: inline-block; margin: 0.75rem 0; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.95rem 1.1rem; }
  .faq-item summary { font-weight: 600; cursor: pointer; }
  .faq-item p { margin: 0.7rem 0 0; font-size: 0.93rem; color: var(--text-muted); }
</style>
