---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/',
  en: '/en/tools/',
  pt: '/pt/ferramentas/',
  fr: '/fr/outils/',
  de: '/de/werkzeuge/'
};

const tools = [
  {
    title: 'Hardware Test Lab',
    desc: 'Monitor dead pixel & backlight bleed test, keyboard anti-ghosting rollover checker, stereo/frequency audio tester, and PS5/Xbox controller drift test.',
    url: '/en/tools/hardware-test-lab/',
    icon: '🖥️',
    badge: 'Hardware & Gaming'
  },
  {
    title: 'Interactive Tech Diagnostic Wizard',
    desc: '3-step logical troubleshooter for Windows PC shutdowns, slow WiFi, battery/charging failures, and Bluetooth audio lag.',
    url: '/en/tools/tech-diagnostic-wizard/',
    icon: '🩺',
    badge: 'Troubleshooting'
  },
  {
    title: 'Browser Privacy & Fingerprint Audit',
    desc: 'Test WebRTC IP leaks behind VPNs, inspect Canvas Fingerprinting, WebGL GPU exposure, and check your live browser privacy score.',
    url: '/en/tools/privacy-fingerprint-audit/',
    icon: '🛡️',
    badge: 'Cybersecurity'
  },
  {
    title: 'Online Image Compressor (JPG, PNG & WebP)',
    desc: 'Shrink image file sizes by up to 80% locally in your browser with zero uploads.',
    url: '/en/tools/image-compressor/',
    icon: '🖼️',
    badge: 'Media'
  },
  {
    title: 'Internet & WiFi Speed Test',
    desc: 'Measure your real-time download speed (Mbps) and ping latency directly in your browser.',
    url: '/en/tools/internet-speed-test/',
    icon: '⚡',
    badge: 'Network'
  },
  {
    title: 'Free QR Code Generator',
    desc: 'Create permanent static QR codes for URLs, WiFi networks, or plain text with custom colors and PNG download.',
    url: '/en/tools/qr-code-generator/',
    icon: '📲',
    badge: 'Utilities'
  },
  {
    title: 'Online Ping & Latency Test',
    desc: 'Measure real-time ping (ms), jitter, and connection stability for gaming and video calls.',
    url: '/en/tools/ping-latency-test/',
    icon: '⏱️',
    badge: 'Network & Gaming'
  },
  {
    title: 'Password Security & Entropy Checker',
    desc: 'Audit password strength, calculate mathematical entropy bits, and estimate brute-force resistance 100% locally.',
    url: '/en/tools/password-security-checker/',
    icon: '🔒',
    badge: 'Security'
  }
];
---

<BaseLayout
  title="Free Online Tech Tools Directory"
  description="Complete directory of free browser-based utilities on GuíaTecnes: hardware test lab, tech diagnostic wizard, WebRTC privacy audit, and password strength checker."
  lang="en"
  alternates={alternates}
>
  <Header slot="header" />

  <main class="tool-dir container">
    <header class="dir-header">
      <h1>Free Online Tech Tools</h1>
      <p>Fast, privacy-first web utilities that run 100% locally in your browser with zero installation.</p>
    </header>

    <div class="tools-grid">
      {tools.map(t => (
        <a href={t.url} class="tool-card">
          <div class="tc-top">
            <span class="tc-icon">{t.icon}</span>
            <span class="tc-badge">{t.badge}</span>
          </div>
          <h2>{t.title}</h2>
          <p>{t.desc}</p>
          <span class="tc-link">Launch Tool →</span>
        </a>
      ))}
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-dir { padding: 2.5rem 1rem 4rem; max-width: 1020px; margin: 0 auto; }
  .dir-header { text-align: center; margin-bottom: 2.5rem; }
  .dir-header h1 { font-size: 2.2rem; margin-bottom: 0.6rem; }
  .dir-header p { color: var(--text-muted); font-size: 1.05rem; }
  .tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
  .tool-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; text-decoration: none; color: var(--text); display: flex; flex-direction: column; gap: 0.75rem; transition: border-color 0.2s; }
  .tool-card:hover { border-color: var(--primary); }
  .tc-top { display: flex; justify-content: space-between; align-items: center; }
  .tc-icon { font-size: 1.85rem; }
  .tc-badge { font-size: 0.75rem; font-weight: 700; background: var(--bg); border: 1px solid var(--border); padding: 0.25rem 0.65rem; border-radius: 999px; color: var(--text-muted); }
  .tool-card h2 { font-size: 1.2rem; margin: 0; }
  .tool-card p { font-size: 0.92rem; color: var(--text-muted); line-height: 1.5; margin: 0; flex: 1; }
  .tc-link { font-size: 0.9rem; font-weight: 700; color: var(--primary); }
</style>
