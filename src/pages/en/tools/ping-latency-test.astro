---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/test-ping/',
  en: '/en/tools/ping-latency-test/',
  pt: '/pt/ferramentas/teste-ping-latencia/',
  fr: '/fr/outils/test-ping-latence/',
  de: '/de/werkzeuge/ping-latenz-test/'
};

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Tools', url: '/en/tools/' },
  { name: 'Ping & Latency Test', url: '/en/tools/ping-latency-test/' }
];

const faqs = [
  {
    question: 'What is a good ping for online gaming?',
    answer: 'Under 25 ms is competitive-grade (Valorant, CS2, Fortnite). 25–60 ms is smooth for all multiplayer games, while 100+ ms causes noticeable lag.'
  },
  {
    question: 'What is jitter in a ping test?',
    answer: 'Jitter measures ping fluctuation over time. A low jitter (under 5 ms) ensures smooth gameplay and stutter-free video calls.'
  }
];
---

<BaseLayout
  title="Online Ping & Latency Test | Real-Time Gaming Jitter Checker"
  description="Measure your real-time ping (ms), jitter, and connection stability to Cloudflare and Google servers directly in your browser."
  lang="en"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb"><a href="/en/">Home</a><span>›</span><a href="/en/tools/">Tools</a><span>›</span><span>Ping & Latency Test</span></div>
    <header class="tool-header">
      <div class="tool-badge">🎮 Gaming, Fiber & Network Diagnostics</div>
      <h1>Online Ping & Latency Test</h1>
      <p class="tool-subtitle">Measure response latency in milliseconds (ms) and jitter before jumping into ranked matches or video calls.</p>
    </header>

    <div class="card gauge-card">
      <div class="ping-display-box">
        <span class="ping-label">Average Latency:</span>
        <div class="ping-val-wrapper"><span id="main-ping-val" class="main-ping-val">--</span><span class="unit-text"> ms</span></div>
        <div id="ping-verdict-badge" class="verdict-badge">Click Start to measure</div>
      </div>
      <div class="metrics-row">
        <div class="metric-col"><span class="metric-title">Min Ping:</span><strong id="min-ping-val">-- ms</strong></div>
        <div class="metric-col"><span class="metric-title">Jitter:</span><strong id="jitter-val">-- ms</strong></div>
        <div class="metric-col"><span class="metric-title">Gaming Rating:</span><strong id="gaming-verdict">--</strong></div>
      </div>
      <button type="button" id="btn-start-ping" class="btn-primary">⚡ Start Latency Test</button>
    </div>

    <section class="seo-guide card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">{faqs.map(f => (<details class="faq-item"><summary>{f.question}</summary><p>{f.answer}</p></details>))}</div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const btn = document.getElementById('btn-start-ping');
    const mainVal = document.getElementById('main-ping-val');
    const minVal = document.getElementById('min-ping-val');
    const jitterVal = document.getElementById('jitter-val');
    const ratingVal = document.getElementById('gaming-verdict');
    const badge = document.getElementById('ping-verdict-badge');

    async function singlePing(url) {
      const t0 = performance.now();
      try {
        await fetch(url + '?t=' + Math.random(), { mode: 'no-cors', cache: 'no-store' });
        return Math.round(performance.now() - t0);
      } catch (e) { return null; }
    }

    btn.addEventListener('click', async () => {
      btn.disabled = true; btn.textContent = '⏳ Measuring...';
      badge.textContent = 'Running 8 latency probes...';
      const samples = [];
      const endpoints = ['https://1.1.1.1/cdn-cgi/trace', 'https://www.google.com/generate_204'];
      for (let i = 0; i < 8; i++) {
        const ms = await singlePing(endpoints[i % endpoints.length]);
        if (ms !== null) {
          samples.push(ms);
          mainVal.textContent = ms;
        }
      }
      if (samples.length > 0) {
        const avg = Math.round(samples.reduce((a, b) => a + b, 0) / samples.length);
        const min = Math.min(...samples);
        let jitterSum = 0;
        for (let i = 1; i < samples.length; i++) jitterSum += Math.abs(samples[i] - samples[i - 1]);
        const jitter = samples.length > 1 ? Math.round(jitterSum / (samples.length - 1)) : 0;

        mainVal.textContent = avg;
        minVal.textContent = `${min} ms`;
        jitterVal.textContent = `${jitter} ms`;
        const rating = avg < 35 ? 'Excellent' : avg < 75 ? 'Good' : avg < 120 ? 'Playable' : 'High Lag';
        ratingVal.textContent = rating;
        badge.textContent = `Completed (${samples.length}/8 probes) · ${rating}`;
      }
      btn.disabled = false; btn.textContent = '🔄 Run Test Again';
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 820px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(16, 185, 129, 0.14); color: #34d399; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.5rem; text-align: center; }
  .main-ping-val { font-size: 3.5rem; font-weight: 800; color: var(--primary); }
  .unit-text { font-size: 1.25rem; color: var(--text-muted); }
  .verdict-badge { display: inline-block; background: var(--bg); border: 1px solid var(--border); padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.88rem; margin: 0.75rem 0 1.25rem; }
  .metrics-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .metric-col { background: var(--bg); border: 1px solid var(--border); padding: 0.9rem; border-radius: 10px; }
  .metric-title { display: block; font-size: 0.78rem; color: var(--text-muted); }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.85rem 1.75rem; border-radius: 10px; font-weight: 700; cursor: pointer; font-size: 1rem; }
  .seo-guide { text-align: left; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.95rem 1.1rem; }
  .faq-item summary { font-weight: 600; cursor: pointer; }
  .faq-item p { margin: 0.7rem 0 0; font-size: 0.93rem; color: var(--text-muted); }
</style>
