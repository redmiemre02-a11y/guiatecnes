---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/contador-palabras/',
  en: '/en/tools/word-character-counter/',
  pt: '/pt/ferramentas/contador-palavras-caracteres/',
  fr: '/fr/outils/compteur-mots-caracteres/',
  de: '/de/werkzeuge/woerter-zeichen-zaehler/'
};

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Tools', url: '/en/tools/' },
  { name: 'Word & Character Counter', url: '/en/tools/word-character-counter/' }
];
---

<BaseLayout
  title="Free Online Word & Character Counter | Reading Time & SEO"
  description="Count words, characters (with and without spaces), sentences, paragraphs, and estimated reading time in real time."
  lang="en"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb"><a href="/en/">Home</a><span>›</span><a href="/en/tools/">Tools</a><span>›</span><span>Word Counter</span></div>
    <header class="tool-header">
      <div class="tool-badge">📝 Writing & SEO Tool</div>
      <h1>Free Word & Character Counter</h1>
      <p class="tool-subtitle">Analyze word count, characters, sentences, paragraphs, and reading time instantly.</p>
    </header>

    <div class="card">
      <div class="stats-grid">
        <div class="stat-box"><span class="stat-label">Words</span><strong id="cnt-words">0</strong></div>
        <div class="stat-box"><span class="stat-label">Characters</span><strong id="cnt-chars">0</strong></div>
        <div class="stat-box"><span class="stat-label">No Spaces</span><strong id="cnt-nospaces">0</strong></div>
        <div class="stat-box"><span class="stat-label">Sentences</span><strong id="cnt-sentences">0</strong></div>
        <div class="stat-box"><span class="stat-label">Reading Time</span><strong id="cnt-read">0 min</strong></div>
      </div>
      <textarea id="text-input" rows="12" placeholder="Start typing or paste your text here..."></textarea>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const ta = document.getElementById('text-input');
    ta.addEventListener('input', () => {
      const txt = ta.value;
      const words = txt.trim() ? txt.trim().split(/\s+/).length : 0;
      document.getElementById('cnt-words').textContent = words;
      document.getElementById('cnt-chars').textContent = txt.length;
      document.getElementById('cnt-nospaces').textContent = txt.replace(/\s/g, '').length;
      document.getElementById('cnt-sentences').textContent = txt.trim() ? txt.split(/[.!?]+/).filter(Boolean).length : 0;
      document.getElementById('cnt-read').textContent = `${Math.max(1, Math.ceil(words / 200))} min`;
      if (words === 0) document.getElementById('cnt-read').textContent = '0 min';
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 920px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(99, 102, 241, 0.14); color: #818cf8; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.85rem; margin-bottom: 1.25rem; }
  .stat-box { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem; text-align: center; }
  .stat-label { display: block; font-size: 0.78rem; color: var(--text-muted); }
  .stat-box strong { font-size: 1.4rem; color: var(--primary); }
  textarea { width: 100%; padding: 1rem; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 1rem; resize: vertical; }
</style>
