---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/comprobador-seguridad-contrasenas/',
  en: '/en/tools/password-security-checker/',
  pt: '/pt/ferramentas/verificador-seguranca-senhas/'
};

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Tools', url: '/en/tools/' },
  { name: 'Password Security Checker', url: '/en/tools/password-security-checker/' }
];

const faqs = [
  {
    question: 'Is it safe to type my password here?',
    answer: 'Yes. All calculations run 100% locally in your browser using client-side JavaScript. Zero characters are transmitted over the network.'
  },
  {
    question: 'What is password entropy?',
    answer: 'Entropy measures randomness in bits. Passwords above 75-80 bits of entropy are practically immune to modern brute-force attacks.'
  }
];
---

<BaseLayout
  title="Password Strength & Entropy Checker | Brute-Force Time Estimator"
  description="Test your password security, calculate mathematical entropy bits, and estimate brute-force cracking time 100% privately in your browser."
  lang="en"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span>›</span>
      <a href="/en/tools/">Tools</a>
      <span>›</span>
      <span>Password Security Checker</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🔒 100% Local Cryptography Audit</div>
      <h1>Password Strength & Entropy Checker</h1>
      <p class="tool-subtitle">
        Analyze password strength, compute mathematical bit entropy, and generate unbreakable random passwords locally.
      </p>
    </header>

    <div class="card">
      <div class="form-group">
        <label for="pwd-input">Enter a password to audit</label>
        <div class="password-box">
          <input type="password" id="pwd-input" placeholder="Type your password here..." autocomplete="off" spellcheck="false" />
          <button type="button" id="btn-toggle-vis" class="btn-vis" aria-label="Show or hide password">👁️</button>
        </div>
      </div>

      <div class="meter-bar-track"><div id="meter-fill" class="meter-fill" style="width: 0%;"></div></div>
      <div class="stats-row">
        <div>Strength: <strong id="meter-text">—</strong></div>
        <div>Entropy: <strong id="entropy-val">0 bits</strong></div>
        <div>Est. Crack Time: <strong id="crack-time">—</strong></div>
      </div>

      <button type="button" id="btn-gen-pwd" class="btn-primary">🎲 Generate 18-Char Strong Password</button>
    </div>

    <section class="seo-guide card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const input = document.getElementById('pwd-input');
    const toggle = document.getElementById('btn-toggle-vis');
    const fill = document.getElementById('meter-fill');
    const mText = document.getElementById('meter-text');
    const eVal = document.getElementById('entropy-val');
    const cTime = document.getElementById('crack-time');

    toggle.addEventListener('click', () => {
      input.type = input.type === 'password' ? 'text' : 'password';
    });

    function evaluate(pwd) {
      if (!pwd) {
        fill.style.width = '0%'; mText.textContent = '—'; eVal.textContent = '0 bits'; cTime.textContent = '—';
        return;
      }
      let pool = 0;
      if (/[a-z]/.test(pwd)) pool += 26;
      if (/[A-Z]/.test(pwd)) pool += 26;
      if (/[0-9]/.test(pwd)) pool += 10;
      if (/[^a-zA-Z0-9]/.test(pwd)) pool += 32;
      const entropy = Math.round(pwd.length * Math.log2(Math.max(pool, 1)));
      eVal.textContent = `${entropy} bits`;

      const pct = Math.min(100, Math.round((entropy / 100) * 100));
      fill.style.width = `${pct}%`;

      if (entropy < 36) {
        fill.style.background = '#ef4444'; mText.textContent = 'Very Weak'; cTime.textContent = 'Seconds / Minutes';
      } else if (entropy < 60) {
        fill.style.background = '#f59e0b'; mText.textContent = 'Moderate'; cTime.textContent = 'Days to Months';
      } else if (entropy < 80) {
        fill.style.background = '#3b82f6'; mText.textContent = 'Strong'; cTime.textContent = 'Centuries';
      } else {
        fill.style.background = '#10b981'; mText.textContent = 'Unbreakable'; cTime.textContent = 'Millions of Years';
      }
    }

    input.addEventListener('input', () => evaluate(input.value));
    document.getElementById('btn-gen-pwd').addEventListener('click', () => {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*()-_=+';
      const arr = new Uint32Array(18);
      crypto.getRandomValues(arr);
      const gen = Array.from(arr, n => chars[n % chars.length]).join('');
      input.type = 'text';
      input.value = gen;
      evaluate(gen);
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 820px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(6, 182, 212, 0.14); color: #22d3ee; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; border: 1px solid rgba(6, 182, 212, 0.28); }
  .tool-header h1 { font-size: clamp(1.75rem, 3.5vw, 2.3rem); margin-bottom: 0.75rem; }
  .tool-subtitle { color: var(--text-muted); font-size: 1.02rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.5rem; }
  .password-box { display: flex; gap: 0.5rem; margin-top: 0.5rem; margin-bottom: 1rem; }
  .password-box input { flex: 1; padding: 0.85rem; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 1rem; }
  .btn-vis { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0 1rem; cursor: pointer; font-size: 1.1rem; }
  .meter-bar-track { height: 10px; background: var(--bg); border-radius: 999px; overflow: hidden; margin-bottom: 1rem; }
  .meter-fill { height: 100%; transition: width 0.2s, background 0.2s; }
  .stats-row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; font-size: 0.95rem; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.75rem 1.35rem; border-radius: 10px; font-weight: 600; cursor: pointer; }
  .seo-guide h2 { font-size: 1.3rem; margin-bottom: 0.9rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.95rem 1.1rem; }
  .faq-item summary { font-weight: 600; cursor: pointer; }
  .faq-item p { margin: 0.7rem 0 0; font-size: 0.93rem; color: var(--text-muted); }
</style>
