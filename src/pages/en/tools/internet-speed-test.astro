---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/test-velocidad/',
  en: '/en/tools/internet-speed-test/',
  pt: '/pt/ferramentas/teste-velocidade-internet/',
  fr: '/fr/outils/test-vitesse-internet/',
  de: '/de/werkzeuge/internet-geschwindigkeit-test/'
};

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Tools', url: '/en/tools/' },
  { name: 'Internet Speed Test', url: '/en/tools/internet-speed-test/' }
];

const faqs = [
  {
    question: 'How much internet speed do I need for 4K streaming?',
    answer: 'A stable 25–35 Mbps download speed is sufficient for a single 4K Ultra HD stream. For households with multiple 4K TVs and remote workers, 100–300 Mbps is recommended.'
  },
  {
    question: 'Why is my WiFi speed slower than my fiber plan?',
    answer: 'Thick walls, distance from the router, and 2.4 GHz channel congestion significantly reduce WiFi throughput. Switch to 5 GHz WiFi or use an Ethernet cable for full speed.'
  }
];
---

<BaseLayout
  title="Free Internet & WiFi Speed Test | Real-Time Download & Ping"
  description="Test your real-time WiFi, fiber, or 5G mobile internet speed (Mbps) and ping latency directly in your browser without installing apps."
  lang="en"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb"><a href="/en/">Home</a><span>›</span><a href="/en/tools/">Tools</a><span>›</span><span>Internet Speed Test</span></div>
    <header class="tool-header">
      <div class="tool-badge">⚡ Free Real-Time Speedtest</div>
      <h1>Internet & WiFi Speed Test</h1>
      <p class="tool-subtitle">Measure your real download speed in Mbps and ping latency in seconds.</p>
    </header>

    <div class="card speedtest-card">
      <div class="gauge-wrapper">
        <svg class="gauge-svg" viewBox="0 0 200 120">
          <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="var(--border)" stroke-width="14" stroke-linecap="round" />
          <path id="gauge-progress" d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="url(#speed-grad)" stroke-width="14" stroke-linecap="round" stroke-dasharray="251.2" stroke-dashoffset="251.2" />
          <defs>
            <linearGradient id="speed-grad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#6366f1" /><stop offset="50%" stop-color="#06b6d4" /><stop offset="100%" stop-color="#10b981" />
            </linearGradient>
          </defs>
        </svg>
        <div class="speed-center">
          <span class="speed-number" id="speed-val">0.0</span>
          <span class="speed-unit">Mbps</span>
          <span class="test-phase" id="test-phase">Click START</span>
        </div>
      </div>

      <button type="button" id="start-btn" class="btn-primary">🚀 Start Speed Test</button>

      <div class="metrics-grid">
        <div class="metric-card"><span class="metric-label">Ping</span><strong id="ping-val">-- ms</strong></div>
        <div class="metric-card"><span class="metric-label">Download</span><strong id="down-val">-- Mbps</strong></div>
        <div class="metric-card"><span class="metric-label">Quality</span><strong id="qual-val">--</strong></div>
      </div>
    </div>

    <section class="seo-guide card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">{faqs.map(f => (<details class="faq-item"><summary>{f.question}</summary><p>{f.answer}</p></details>))}</div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const startBtn = document.getElementById('start-btn'), speedVal = document.getElementById('speed-val'), phase = document.getElementById('test-phase'), pingVal = document.getElementById('ping-val'), downVal = document.getElementById('down-val'), qualVal = document.getElementById('qual-val'), arc = document.getElementById('gauge-progress');
    function setGauge(mbps) { arc.style.strokeDashoffset = 251.2 - (Math.min(Math.max(mbps, 0), 300) / 300) * 251.2; }
    startBtn.addEventListener('click', async () => {
      startBtn.disabled = true; phase.textContent = 'Measuring Ping...';
      try {
        const p0 = performance.now();
        await fetch('https://speed.cloudflare.com/__down?bytes=1000', { cache: 'no-store' });
        const ping = Math.round(performance.now() - p0);
        pingVal.textContent = `${ping} ms`;

        phase.textContent = 'Testing Download...';
        const sizes = [2000000, 6000000, 10000000];
        let totalBytes = 0; const tStart = performance.now();
        for (const bytes of sizes) {
          const r = await fetch(`https://speed.cloudflare.com/__down?bytes=${bytes}`, { cache: 'no-store' });
          const buf = await r.arrayBuffer();
          totalBytes += buf.byteLength;
          const elapsed = (performance.now() - tStart) / 1000;
          const mbps = (totalBytes * 8) / (elapsed * 1000000);
          speedVal.textContent = mbps.toFixed(1);
          setGauge(mbps);
        }
        const finalMbps = ((totalBytes * 8) / (((performance.now() - tStart) / 1000) * 1000000));
        speedVal.textContent = finalMbps.toFixed(1);
        downVal.textContent = `${finalMbps.toFixed(1)} Mbps`;
        qualVal.textContent = finalMbps >= 100 ? 'Ultra Fast (4K+)' : finalMbps >= 35 ? 'Fast (HD/4K)' : 'Basic';
        phase.textContent = 'Completed';
      } catch (e) {
        phase.textContent = 'Network blocked';
      }
      startBtn.disabled = false; startBtn.textContent = '🔄 Run Again';
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 820px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(99, 102, 241, 0.14); color: #818cf8; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.5rem; }
  .speedtest-card { text-align: center; }
  .gauge-wrapper { position: relative; max-width: 280px; margin: 0 auto 1.25rem; }
  .gauge-svg { width: 100%; display: block; }
  .speed-center { position: absolute; inset: 35% 0 0; display: flex; flex-direction: column; align-items: center; }
  .speed-number { font-size: 2.6rem; font-weight: 800; line-height: 1; }
  .speed-unit { font-size: 0.9rem; color: var(--text-muted); }
  .test-phase { font-size: 0.82rem; color: var(--primary); font-weight: 600; margin-top: 0.25rem; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.85rem 1.75rem; border-radius: 10px; font-weight: 700; cursor: pointer; font-size: 1rem; margin-bottom: 1.5rem; }
  .metrics-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .metric-card { background: var(--bg); border: 1px solid var(--border); padding: 1rem; border-radius: 10px; }
  .metric-label { display: block; font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.25rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.95rem 1.1rem; }
  .faq-item summary { font-weight: 600; cursor: pointer; }
  .faq-item p { margin: 0.7rem 0 0; font-size: 0.93rem; color: var(--text-muted); }
</style>
