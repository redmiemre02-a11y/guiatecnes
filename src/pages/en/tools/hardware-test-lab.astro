---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/laboratorio-pruebas-hardware/',
  en: '/en/tools/hardware-test-lab/',
  pt: '/pt/ferramentas/laboratorio-testes-hardware/',
  fr: '/fr/outils/laboratoire-test-materiel/',
  de: '/de/werkzeuge/hardware-test-labor/'
};

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Tools', url: '/en/tools/' },
  { name: 'Hardware Test Lab', url: '/en/tools/hardware-test-lab/' }
];

const faqs = [
  {
    question: 'How do I detect dead or stuck pixels on my monitor?',
    answer: 'Click Fullscreen Test in the Monitor tab and cycle through Black, White, Red, Green, and Blue. A black dot across all colors indicates a dead pixel, while a permanently lit colored dot on a black screen indicates a stuck subpixel.'
  },
  {
    question: 'What is keyboard ghosting and how does this test check it?',
    answer: 'Ghosting occurs when pressing multiple keys simultaneously (e.g., W + A + Shift + Space) fails to register one of them. Our Keyboard tab counts live simultaneous keys held (N-Key Rollover) and logs every tested key code.'
  },
  {
    question: 'How can I check my PS5, Xbox, or PC controller for analog stick drift?',
    answer: 'Connect your controller via USB or Bluetooth, open the Gamepad tab, and press any button. Leave the analog sticks untouched: if the X or Y axis reads above ±0.05 or fails to return to 0.00 after moving, your controller has stick drift.'
  }
];
---

<BaseLayout
  title="Online Hardware Test Lab | Dead Pixel, Keyboard, Audio & Controller Drift Test"
  description="Free browser-based hardware test suite: check monitor dead pixels, keyboard anti-ghosting rollover, stereo speakers, frequency response, and gamepad stick drift."
  lang="en"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span>›</span>
      <a href="/en/tools/">Tools</a>
      <span>›</span>
      <span>Hardware Test Lab</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🖥️ Live Browser Diagnostics · Zero Downloads</div>
      <h1>Online Hardware Test Lab</h1>
      <p class="tool-subtitle">
        Check your monitor for dead pixels & backlight bleed, verify keyboard N-key rollover, test stereo speaker channels, or measure gamepad stick drift instantly.
      </p>
    </header>

    <div class="lab-container card">
      <div class="lab-tabs" role="tablist">
        <button type="button" class="lab-tab active" data-tab="monitor">🖥️ Monitor & Pixels</button>
        <button type="button" class="lab-tab" data-tab="keyboard">⌨️ Keyboard & Ghosting</button>
        <button type="button" class="lab-tab" data-tab="audio">🔊 Stereo Audio & Hz</button>
        <button type="button" class="lab-tab" data-tab="gamepad">🎮 Gamepad / Drift</button>
      </div>

      <!-- TAB 1: MONITOR -->
      <section id="tab-monitor" class="lab-panel active">
        <h2>Dead Pixel & Backlight Bleed (IPS Glow) Test</h2>
        <p class="panel-desc">
          Wipe your screen gently, launch <strong>Fullscreen Mode</strong>, and click anywhere (or press Right Arrow) to cycle through pure RGB, White, and Black backgrounds.
        </p>

        <div class="color-swatches">
          <button type="button" class="swatch-btn" data-color="#000000" style="background:#000000;color:#fff;">Black (Bleed)</button>
          <button type="button" class="swatch-btn" data-color="#ffffff" style="background:#ffffff;color:#000;">White (Dust)</button>
          <button type="button" class="swatch-btn" data-color="#ff0000" style="background:#ff0000;color:#fff;">Pure Red</button>
          <button type="button" class="swatch-btn" data-color="#00ff00" style="background:#00ff00;color:#000;">Pure Green</button>
          <button type="button" class="swatch-btn" data-color="#0000ff" style="background:#0000ff;color:#fff;">Pure Blue</button>
        </div>

        <button type="button" id="btn-start-pixel" class="btn-primary">⛶ Start Fullscreen Pixel Test</button>
        <p class="hint-text">Press <code>ESC</code> anytime to exit fullscreen mode.</p>
      </section>

      <!-- TAB 2: KEYBOARD -->
      <section id="tab-keyboard" class="lab-panel">
        <h2>Keyboard Key Checker & Anti-Ghosting Test</h2>
        <p class="panel-desc">
          Press any key or hold multiple keys at the same time to test N-Key Rollover limits and detect chattering or unresponsive switches.
        </p>

        <div class="kb-stats">
          <div class="stat-box">
            <span class="stat-label">Last Key</span>
            <strong id="kb-last-key" class="stat-val">—</strong>
          </div>
          <div class="stat-box">
            <span class="stat-label">Key Code</span>
            <strong id="kb-last-code" class="stat-val">—</strong>
          </div>
          <div class="stat-box">
            <span class="stat-label">Simultaneous Now</span>
            <strong id="kb-simultaneous" class="stat-val highlight">0</strong>
          </div>
          <div class="stat-box">
            <span class="stat-label">Max Simultaneous</span>
            <strong id="kb-max-sim" class="stat-val">0</strong>
          </div>
        </div>

        <div class="kb-active-list-wrap">
          <span class="mini-label">Currently held keys:</span>
          <div id="kb-active-pills" class="kb-pills">No keys pressed</div>
        </div>

        <div class="kb-history-wrap">
          <div class="history-header">
            <span class="mini-label">Tested keys history (<span id="kb-unique-count">0</span> unique):</span>
            <button type="button" id="btn-kb-reset" class="btn-sm">Clear</button>
          </div>
          <div id="kb-history" class="kb-history-grid"></div>
        </div>
      </section>

      <!-- TAB 3: AUDIO -->
      <section id="tab-audio" class="lab-panel">
        <h2>Stereo Speaker (Left / Right) & Frequency Generator</h2>
        <p class="panel-desc">
          Verify left/right headphone channel orientation, test bass/treble response, or play a pure Web Audio API tone without external files.
        </p>

        <div class="audio-controls-grid">
          <button type="button" class="audio-btn" id="btn-audio-left">
            <span>◀️ Left Channel (L)</span>
            <small>440 Hz · Left ear only</small>
          </button>
          <button type="button" class="audio-btn" id="btn-audio-right">
            <span>Right Channel (R) ▶️</span>
            <small>440 Hz · Right ear only</small>
          </button>
          <button type="button" class="audio-btn" id="btn-audio-both">
            <span>🔊 Both Channels (Center)</span>
            <small>440 Hz · Balanced stereo</small>
          </button>
        </div>

        <div class="freq-tester card-inner">
          <div class="freq-top">
            <label for="freq-slider">Pure Tone Frequency: <strong id="freq-display">165 Hz</strong></label>
            <button type="button" id="btn-freq-toggle" class="btn-primary">▶ Play Tone</button>
          </div>
          <input type="range" id="freq-slider" min="20" max="16000" value="165" step="5" />
          <div class="freq-marks">
            <span>20 Hz (Sub-bass)</span>
            <span>165 Hz (Speaker eject)</span>
            <span>1000 Hz (Mid)</span>
            <span>16 kHz (Treble)</span>
          </div>
        </div>
      </section>

      <!-- TAB 4: GAMEPAD -->
      <section id="tab-gamepad" class="lab-panel">
        <h2>Controller Button & Analog Stick Drift Test</h2>
        <p class="panel-desc">
          Connect your PS5, PS4, Xbox, or PC controller and <strong>press any button</strong> so your browser detects it.
        </p>

        <div id="gp-status" class="gp-status">
          ⏳ Waiting for controller... Connect and press any button (X, A, Start...).
        </div>

        <div id="gp-dashboard" class="gp-dashboard" style="display:none;">
          <div class="sticks-grid">
            <div class="stick-card">
              <h3>Left Analog Stick (L)</h3>
              <div class="stick-pad"><div id="dot-l" class="stick-dot"></div></div>
              <div class="axis-readout">
                X: <strong id="lx-val">0.00</strong> | Y: <strong id="ly-val">0.00</strong>
              </div>
            </div>
            <div class="stick-card">
              <h3>Right Analog Stick (R)</h3>
              <div class="stick-pad"><div id="dot-r" class="stick-dot"></div></div>
              <div class="axis-readout">
                X: <strong id="rx-val">0.00</strong> | Y: <strong id="ry-val">0.00</strong>
              </div>
            </div>
          </div>

          <div class="gp-buttons-wrap">
            <h3>Active Pressed Buttons:</h3>
            <div id="gp-buttons" class="gp-buttons-grid"></div>
          </div>
        </div>
      </section>
    </div>

    <section class="seo-guide card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <div id="pixel-overlay" class="pixel-overlay" style="display:none;">
    <div id="pixel-hint" class="pixel-hint">
      Click or press → Arrow to change color · ESC to exit
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const tabs = document.querySelectorAll('.lab-tab');
    const panels = document.querySelectorAll('.lab-panel');
    tabs.forEach(t => {
      t.addEventListener('click', () => {
        const target = t.getAttribute('data-tab');
        tabs.forEach(x => x.classList.toggle('active', x === t));
        panels.forEach(p => p.classList.toggle('active', p.id === `tab-${target}`));
      });
    });

    const colors = ['#000000', '#ffffff', '#ff0000', '#00ff00', '#0000ff', '#ffff00', '#00ffff', '#ff00ff'];
    let colorIdx = 0;
    const overlay = document.getElementById('pixel-overlay');
    const hint = document.getElementById('pixel-hint');

    function startPixelTest(startColor) {
      const idx = colors.indexOf(startColor);
      colorIdx = idx >= 0 ? idx : 0;
      overlay.style.backgroundColor = colors[colorIdx];
      overlay.style.display = 'flex';
      hint.style.opacity = '1';
      setTimeout(() => { hint.style.opacity = '0'; }, 2600);
      if (overlay.requestFullscreen) overlay.requestFullscreen().catch(() => {});
    }

    document.querySelectorAll('.swatch-btn').forEach(btn => {
      btn.addEventListener('click', () => startPixelTest(btn.getAttribute('data-color')));
    });
    document.getElementById('btn-start-pixel').addEventListener('click', () => startPixelTest('#000000'));
    overlay.addEventListener('click', () => {
      colorIdx = (colorIdx + 1) % colors.length;
      overlay.style.backgroundColor = colors[colorIdx];
    });
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) overlay.style.display = 'none';
    });
    document.addEventListener('keydown', (e) => {
      if (overlay.style.display === 'flex') {
        if (e.key === 'ArrowRight' || e.key === ' ') {
          e.preventDefault();
          colorIdx = (colorIdx + 1) % colors.length;
          overlay.style.backgroundColor = colors[colorIdx];
        } else if (e.key === 'Escape') {
          overlay.style.display = 'none';
          if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
        }
      }
    });

    const activeKeys = new Set();
    const testedCodes = new Set();
    let maxSim = 0;
    function updateKbUI() {
      document.getElementById('kb-simultaneous').textContent = activeKeys.size;
      if (activeKeys.size > maxSim) {
        maxSim = activeKeys.size;
        document.getElementById('kb-max-sim').textContent = maxSim;
      }
      const pillsEl = document.getElementById('kb-active-pills');
      pillsEl.innerHTML = activeKeys.size === 0
        ? '<span class="muted">No keys pressed</span>'
        : Array.from(activeKeys).map(c => `<span class="key-pill">${c}</span>`).join('');
    }
    window.addEventListener('keydown', (e) => {
      if (!document.getElementById('tab-keyboard').classList.contains('active')) return;
      if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Tab'].includes(e.code)) e.preventDefault();
      document.getElementById('kb-last-key').textContent = e.key === ' ' ? 'Space' : e.key;
      document.getElementById('kb-last-code').textContent = e.code;
      activeKeys.add(e.code);
      if (!testedCodes.has(e.code)) {
        testedCodes.add(e.code);
        document.getElementById('kb-unique-count').textContent = testedCodes.size;
        const badge = document.createElement('span');
        badge.className = 'tested-key';
        badge.textContent = e.code;
        document.getElementById('kb-history').prepend(badge);
      }
      updateKbUI();
    });
    window.addEventListener('keyup', (e) => { activeKeys.delete(e.code); updateKbUI(); });
    document.getElementById('btn-kb-reset').addEventListener('click', () => {
      activeKeys.clear(); testedCodes.clear(); maxSim = 0;
      document.getElementById('kb-last-key').textContent = '—';
      document.getElementById('kb-last-code').textContent = '—';
      document.getElementById('kb-max-sim').textContent = '0';
      document.getElementById('kb-unique-count').textContent = '0';
      document.getElementById('kb-history').innerHTML = '';
      updateKbUI();
    });

    let audioCtx = null;
    function getAudioCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }
    function playChime(panVal) {
      const ctx = getAudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const panner = ctx.createStereoPanner ? ctx.createStereoPanner() : null;
      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, ctx.currentTime);
      gain.gain.setValueAtTime(0.001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.35, ctx.currentTime + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.9);
      if (panner) {
        panner.pan.setValueAtTime(panVal, ctx.currentTime);
        osc.connect(gain).connect(panner).connect(ctx.destination);
      } else {
        osc.connect(gain).connect(ctx.destination);
      }
      osc.start();
      osc.stop(ctx.currentTime + 0.95);
    }
    document.getElementById('btn-audio-left').addEventListener('click', () => playChime(-1));
    document.getElementById('btn-audio-right').addEventListener('click', () => playChime(1));
    document.getElementById('btn-audio-both').addEventListener('click', () => playChime(0));

    let sweepOsc = null, sweepGain = null;
    const freqSlider = document.getElementById('freq-slider');
    const freqDisplay = document.getElementById('freq-display');
    const btnFreqToggle = document.getElementById('btn-freq-toggle');
    freqSlider.addEventListener('input', () => {
      freqDisplay.textContent = `${freqSlider.value} Hz`;
      if (sweepOsc && audioCtx) sweepOsc.frequency.setValueAtTime(Number(freqSlider.value), audioCtx.currentTime);
    });
    btnFreqToggle.addEventListener('click', () => {
      if (sweepOsc) {
        sweepOsc.stop(); sweepOsc.disconnect(); sweepOsc = null;
        btnFreqToggle.textContent = '▶ Play Tone';
      } else {
        const ctx = getAudioCtx();
        sweepOsc = ctx.createOscillator();
        sweepGain = ctx.createGain();
        sweepOsc.type = 'sine';
        sweepOsc.frequency.setValueAtTime(Number(freqSlider.value), ctx.currentTime);
        sweepGain.gain.setValueAtTime(0.2, ctx.currentTime);
        sweepOsc.connect(sweepGain).connect(ctx.destination);
        sweepOsc.start();
        btnFreqToggle.textContent = '⏹ Stop Tone';
      }
    });

    let gpLoop = null;
    function pollGamepads() {
      const gps = navigator.getGamepads ? navigator.getGamepads() : [];
      const activeGp = Array.from(gps).find(g => g && g.connected);
      const statusEl = document.getElementById('gp-status');
      const dashEl = document.getElementById('gp-dashboard');
      if (!activeGp) {
        statusEl.textContent = '⏳ Waiting for controller... Connect and press any button (X, A, Start...).';
        dashEl.style.display = 'none';
      } else {
        statusEl.textContent = `✅ Connected: ${activeGp.id}`;
        dashEl.style.display = 'block';
        const lx = activeGp.axes[0] || 0, ly = activeGp.axes[1] || 0, rx = activeGp.axes[2] || 0, ry = activeGp.axes[3] || 0;
        document.getElementById('lx-val').textContent = lx.toFixed(2);
        document.getElementById('ly-val').textContent = ly.toFixed(2);
        document.getElementById('rx-val').textContent = rx.toFixed(2);
        document.getElementById('ry-val').textContent = ry.toFixed(2);
        document.getElementById('dot-l').style.transform = `translate(${lx * 38}px, ${ly * 38}px)`;
        document.getElementById('dot-r').style.transform = `translate(${rx * 38}px, ${ry * 38}px)`;
        document.getElementById('gp-buttons').innerHTML = activeGp.buttons.map((b, i) => `<div class="gp-btn ${b.pressed ? 'pressed' : ''}">B${i}</div>`).join('');
      }
      if (document.getElementById('tab-gamepad').classList.contains('active')) {
        gpLoop = requestAnimationFrame(pollGamepads);
      } else {
        gpLoop = null;
      }
    }
    tabs.forEach(t => t.addEventListener('click', () => {
      if (t.getAttribute('data-tab') === 'gamepad' && !gpLoop) pollGamepads();
    }));
    window.addEventListener('gamepadconnected', () => {
      if (document.getElementById('tab-gamepad').classList.contains('active') && !gpLoop) pollGamepads();
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 960px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; flex-wrap: wrap; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(16, 185, 129, 0.14); color: #34d399; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; border: 1px solid rgba(16, 185, 129, 0.28); }
  .tool-header h1 { font-size: clamp(1.75rem, 3.5vw, 2.4rem); line-height: 1.2; margin-bottom: 0.75rem; }
  .tool-subtitle { color: var(--text-muted); font-size: 1.05rem; max-width: 720px; margin: 0 auto; line-height: 1.6; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.75rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  .lab-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.5rem; }
  .lab-tab { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); padding: 0.65rem 1.05rem; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 0.92rem; }
  .lab-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .lab-panel { display: none; }
  .lab-panel.active { display: block; }
  .lab-panel h2 { font-size: 1.35rem; margin-bottom: 0.6rem; }
  .panel-desc { color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.55; }
  .color-swatches { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .swatch-btn { padding: 0.75rem 1.1rem; border-radius: 10px; border: 2px solid var(--border); font-weight: 600; cursor: pointer; font-size: 0.88rem; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.75rem 1.35rem; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 0.95rem; }
  .btn-sm { background: var(--bg); color: var(--text); border: 1px solid var(--border); padding: 0.3rem 0.75rem; border-radius: 6px; font-size: 0.82rem; cursor: pointer; }
  .hint-text { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.85rem; }
  .kb-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.85rem; margin-bottom: 1.25rem; }
  .stat-box { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem; text-align: center; }
  .stat-label { display: block; font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.25rem; }
  .stat-val { font-size: 1.25rem; font-family: monospace; }
  .stat-val.highlight { color: #34d399; }
  .kb-active-list-wrap, .kb-history-wrap { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; margin-bottom: 1rem; }
  .mini-label { font-size: 0.85rem; font-weight: 600; color: var(--text-muted); display: block; margin-bottom: 0.5rem; }
  .history-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
  .kb-pills { display: flex; flex-wrap: wrap; gap: 0.45rem; min-height: 28px; align-items: center; }
  .key-pill { background: var(--primary); color: #fff; padding: 0.25rem 0.65rem; border-radius: 6px; font-family: monospace; font-weight: 700; font-size: 0.88rem; }
  .kb-history-grid { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tested-key { background: var(--surface); border: 1px solid var(--border); padding: 0.2rem 0.55rem; border-radius: 5px; font-family: monospace; font-size: 0.8rem; }
  .audio-controls-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0.85rem; margin-bottom: 1.5rem; }
  .audio-btn { background: var(--bg); border: 1.5px solid var(--border); color: var(--text); border-radius: 12px; padding: 1rem; cursor: pointer; display: flex; flex-direction: column; gap: 0.3rem; text-align: left; }
  .audio-btn span { font-weight: 700; font-size: 0.98rem; }
  .audio-btn small { color: var(--text-muted); font-size: 0.82rem; }
  .card-inner { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
  .freq-top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.85rem; }
  #freq-slider { width: 100%; accent-color: var(--primary); cursor: pointer; }
  .freq-marks { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--text-muted); margin-top: 0.45rem; }
  .gp-status { background: var(--bg); border: 1px solid var(--border); padding: 1rem; border-radius: 10px; font-weight: 600; margin-bottom: 1.25rem; }
  .sticks-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.25rem; }
  .stick-card { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; text-align: center; }
  .stick-card h3 { font-size: 1rem; margin-bottom: 0.85rem; }
  .stick-pad { width: 100px; height: 100px; border-radius: 50%; border: 2px dashed var(--border); margin: 0 auto 0.75rem; position: relative; display: flex; align-items: center; justify-content: center; }
  .stick-dot { width: 18px; height: 18px; border-radius: 50%; background: var(--primary); }
  .axis-readout { font-family: monospace; font-size: 0.88rem; color: var(--text-muted); }
  .gp-buttons-grid { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.6rem; }
  .gp-btn { padding: 0.35rem 0.65rem; border: 1px solid var(--border); border-radius: 6px; font-family: monospace; font-size: 0.82rem; background: var(--bg); }
