---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  es: '/herramientas/auditoria-privacidad-huella-digital/',
  en: '/en/tools/privacy-fingerprint-audit/',
  pt: '/pt/ferramentas/auditoria-privacidade-impressao-digital/'
};

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Tools', url: '/en/tools/' },
  { name: 'Privacy & Fingerprint Audit', url: '/en/tools/privacy-fingerprint-audit/' }
];

const faqs = [
  {
    question: 'What is browser fingerprinting?',
    answer: 'Browser fingerprinting combines hardware and software signals (GPU model, screen size, Canvas rendering, timezone, CPU cores) to create a unique identifier that tracks you even in Incognito mode or with cookies cleared.'
  },
  {
    question: 'What is a WebRTC IP leak?',
    answer: 'WebRTC enables peer-to-peer browser calls, but misconfigured browsers can reveal your real local or public IP address via STUN requests even while connected to a VPN.'
  }
];
---

<BaseLayout
  title="Browser Privacy & Fingerprint Audit | WebRTC IP Leak & Canvas Test"
  description="Check what your browser exposes in real time: test WebRTC IP leaks behind VPNs, inspect Canvas Fingerprint hash, WebGL GPU renderer, and privacy score."
  lang="en"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span>›</span>
      <a href="/en/tools/">Tools</a>
      <span>›</span>
      <span>Privacy Audit</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🛡️ Cybersecurity · 100% Client-Side</div>
      <h1>Browser Privacy & Fingerprint Audit</h1>
      <p class="tool-subtitle">
        Discover how much unique technical metadata your browser leaks to trackers, even with cookies disabled or while using a VPN.
      </p>
    </header>

    <section class="audit-hero card">
      <div class="score-circle" id="score-circle">
        <span class="score-num" id="privacy-score">--</span>
        <span class="score-max">/ 100</span>
      </div>
      <div class="score-info">
        <h2 id="score-title">Ready to audit your browser</h2>
        <p id="score-desc">Click below to run a local inspection of WebRTC leaks, Canvas Fingerprint, WebGL GPU, and navigator signals.</p>
        <button type="button" id="btn-run-audit" class="btn-primary">🔍 Run Full Privacy Audit</button>
      </div>
    </section>

    <section id="audit-results" class="audit-grid" style="display:none;">
      <div class="audit-card card">
        <div class="card-head">
          <span class="c-icon">🌐</span>
          <h3>WebRTC IP Leak</h3>
          <span class="status-pill" id="webrtc-pill">Scanning...</span>
        </div>
        <p class="card-val" id="webrtc-val">Checking ICE candidates...</p>
        <p class="card-explain">WebRTC STUN queries can expose your real IP address past a VPN tunnel if unrestricted.</p>
      </div>

      <div class="audit-card card">
        <div class="card-head">
          <span class="c-icon">🎨</span>
          <h3>Canvas Fingerprint ID</h3>
          <span class="status-pill" id="canvas-pill">Detected</span>
        </div>
        <p class="card-val mono" id="canvas-val">—</p>
        <p class="card-explain">Each GPU and OS renders canvas pixels slightly differently, creating a trackable signature.</p>
      </div>

      <div class="audit-card card">
        <div class="card-head">
          <span class="c-icon">🎮</span>
          <h3>WebGL GPU Renderer</h3>
          <span class="status-pill" id="webgl-pill">Exposed</span>
        </div>
        <p class="card-val mono" id="webgl-val">—</p>
        <p class="card-explain">Scripts can read your exact graphics card model through WebGL debug extensions.</p>
      </div>

      <div class="audit-card card">
        <div class="card-head">
          <span class="c-icon">💻</span>
          <h3>Hardware & System</h3>
          <span class="status-pill warn">Metadata</span>
        </div>
        <ul class="meta-list" id="hw-list"></ul>
      </div>
    </section>

    <section class="seo-guide card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    function djb2Hash(str) {
      let hash = 5381;
      for (let i = 0; i < str.length; i++) hash = ((hash << 5) + hash) + str.charCodeAt(i);
      return (hash >>> 0).toString(16).toUpperCase().padStart(8, '0');
    }
    function getCanvasFingerprint() {
      try {
        const c = document.createElement('canvas'); c.width = 240; c.height = 60;
        const ctx = c.getContext('2d'); ctx.textBaseline = 'top'; ctx.font = '14px Arial';
        ctx.fillStyle = '#f60'; ctx.fillRect(10, 10, 80, 30);
        ctx.fillStyle = '#069'; ctx.fillText('GuiaTecnes_FP_2026!', 14, 16);
        return djb2Hash(c.toDataURL());
      } catch (e) { return 'BLOCKED'; }
    }
    function getWebGLInfo() {
      try {
        const gl = document.createElement('canvas').getContext('webgl');
        if (!gl) return { exposed: false, renderer: 'WebGL Disabled' };
        const dbg = gl.getExtension('WEBGL_debug_renderer_info');
        if (!dbg) return { exposed: false, renderer: 'Masked by Browser' };
        return { exposed: true, renderer: gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) || 'Unknown' };
      } catch (e) { return { exposed: false, renderer: 'Blocked' }; }
    }
    function checkWebRTC(cb) {
      const RTCPeer = window.RTCPeerConnection || window.webkitRTCPeerConnection;
      if (!RTCPeer) return cb({ status: 'safe', msg: 'WebRTC is completely disabled.' });
      try {
        const pc = new RTCPeer({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });
        const ips = new Set();
        pc.createDataChannel('');
        pc.createOffer().then(o => pc.setLocalDescription(o)).catch(() => {});
        pc.onicecandidate = (ice) => {
          if (!ice || !ice.candidate || !ice.candidate.candidate) return;
          const m = ice.candidate.candidate.match(/([0-9]{1,3}(\.[0-9]{1,3}){3})/);
          if (m && m[1]) ips.add(m[1]);
        };
        setTimeout(() => {
          try { pc.close(); } catch (e) {}
          const list = Array.from(ips);
          cb(list.length === 0
            ? { status: 'safe', msg: 'No visible IP leaks (protected or mDNS masked).' }
            : { status: 'leak', msg: `Detected IPs via WebRTC: ${list.join(', ')}` });
        }, 1400);
      } catch (e) { cb({ status: 'safe', msg: 'WebRTC restricted.' }); }
    }

    document.getElementById('btn-run-audit').addEventListener('click', () => {
      const btn = document.getElementById('btn-run-audit');
      btn.disabled = true; btn.textContent = '⏳ Auditing...';
      document.getElementById('audit-results').style.display = 'grid';

      const fp = getCanvasFingerprint();
      document.getElementById('canvas-val').textContent = `Hash: #${fp}`;
      const cPill = document.getElementById('canvas-pill');
      cPill.textContent = fp === 'BLOCKED' ? 'Protected' : 'Trackable';
      cPill.className = fp === 'BLOCKED' ? 'status-pill safe' : 'status-pill warn';

      const gl = getWebGLInfo();
      document.getElementById('webgl-val').textContent = gl.renderer;
      const gPill = document.getElementById('webgl-pill');
      gPill.textContent = gl.exposed ? 'Exposed' : 'Hidden';
      gPill.className = gl.exposed ? 'status-pill warn' : 'status-pill safe';

      const cores = navigator.hardwareConcurrency || 'Hidden';
      const ram = navigator.deviceMemory ? `${navigator.deviceMemory} GB+` : 'Hidden';
      document.getElementById('hw-list').innerHTML = `
        <li><strong>CPU Cores:</strong> ${cores}</li>
        <li><strong>Est. RAM:</strong> ${ram}</li>
        <li><strong>Screen:</strong> ${window.screen.width} × ${window.screen.height}</li>
        <li><strong>Timezone:</strong> ${Intl.DateTimeFormat().resolvedOptions().timeZone}</li>
      `;

      checkWebRTC((res) => {
        const rtcPill = document.getElementById('webrtc-pill');
        document.getElementById('webrtc-val').textContent = res.msg;
        rtcPill.textContent = res.status === 'safe' ? 'Safe' : 'Potential Leak';
        rtcPill.className = res.status === 'safe' ? 'status-pill safe' : 'status-pill danger';

        let score = 100;
        if (res.status === 'leak') score -= 30;
        if (fp !== 'BLOCKED') score -= 20;
        if (gl.exposed) score -= 15;
        if (cores !== 'Hidden') score -= 10;

        document.getElementById('privacy-score').textContent = score;
        document.getElementById('score-title').textContent = score >= 80 ? 'High Privacy Protection' : score >= 55 ? 'Moderate Exposure' : 'High Fingerprint Exposure';
        document.getElementById('score-circle').style.borderColor = score >= 80 ? '#10b981' : score >= 55 ? '#f59e0b' : '#ef4444';
        btn.disabled = false; btn.textContent = '🔄 Re-run Audit';
      });
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 980px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(239, 68, 68, 0.14); color: #f87171; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; border: 1px solid rgba(239, 68, 68, 0.28); }
  .tool-header h1 { font-size: clamp(1.75rem, 3.5vw, 2.4rem); line-height: 1.2; margin-bottom: 0.75rem; }
  .tool-subtitle { color: var(--text-muted); font-size: 1.05rem; max-width: 720px; margin: 0 auto; line-height: 1.6; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .audit-hero { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .score-circle { width: 120px; height: 120px; border-radius: 50%; border: 6px solid var(--primary); display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--bg); }
  .score-num { font-size: 2.2rem; font-weight: 800; line-height: 1; }
  .score-max { font-size: 0.82rem; color: var(--text-muted); }
  .score-info { flex: 1; min-width: 240px; }
  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.75rem 1.4rem; border-radius: 10px; font-weight: 600; cursor: pointer; }
  .audit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .audit-card { margin-bottom: 0; display: flex; flex-direction: column; gap: 0.65rem; }
  .card-head { display: flex; align-items: center; gap: 0.5rem; }
  .card-head h3 { font-size: 1.05rem; margin: 0; flex: 1; }
  .status-pill { font-size: 0.74rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 999px; }
  .status-pill.safe { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .status-pill.warn { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
  .status-pill.danger { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
  .mono { font-family: monospace; background: var(--bg); padding: 0.45rem 0.65rem; border-radius: 8px; border: 1px solid var(--border); word-break: break-word; }
  .card-explain { font-size: 0.85rem; color: var(--text-muted); margin: 0; }
  .meta-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.88rem; color: var(--text-muted); }
  .seo-guide h2 { font-size: 1.3rem; margin-bottom: 0.9rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.95rem 1.1rem; }
  .faq-item summary { font-weight: 600; cursor: pointer; }
  .faq-item p { margin: 0.7rem 0 0; font-size: 0.93rem; color: var(--text-muted); }
</style>
