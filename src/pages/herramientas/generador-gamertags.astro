---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Generador de Gamertags y Nombres para Juegos', url: '/herramientas/generador-gamertags' }
];

const faqs = [
  {
    question: '¿Qué hace que un Gamertag o Nickname sea bueno y memorable?',
    answer: 'Los mejores nombres de jugador son cortos (entre 6 y 12 caracteres), fáciles de pronunciar para tus compañeros de equipo en Discord, originales y sin excesivos números genéricos al final.'
  },
  {
    question: '¿Sirven estos nombres para Twitch, Kick, Discord, Fortnite o Steam?',
    answer: 'Sí. Todos los nombres generados cumplen los formatos estándar de nombres de usuario de plataformas gaming como Steam, Xbox, PlayStation Network, Epic Games / Fortnite, Valorant, Minecraft, Roblox y Twitch.'
  },
  {
    question: '¿Qué significa el estilo «Tryhard» en los videojuegos?',
    answer: 'Es una estética minimalista, agresiva o profesional inspirada en jugadores competitivos de eSports (como CS2, Valorant o Call of Duty), que suele utilizar combinaciones cortas, letras consonánticas fuertes o prefijos limpios.'
  },
  {
    question: '¿Puedo usar símbolos especiales y letras raras en todos los juegos?',
    answer: 'Juegos como Steam, Discord o Free Fire admiten gran variedad de símbolos Unicode (como 彡, ꧁, ⚡). Sin embargo, consolas como PSN o Xbox solo permiten letras, números, guiones y barras bajas.'
  }
];
---

<BaseLayout
  title="Generador de Gamertags y Nombres para Juegos y Twitch | GuiaTecnEs"
  description="Crea nombres de usuario únicos y nicks épicos para Steam, Fortnite, Valorant, Roblox, Twitch y Discord. Filtra por estilo tryhard, cyberpunk o divertido."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Generador de Gamertags</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🎮 Gaming, Twitch & eSports</div>
      <h1>Generador de Gamertags y Nombres de Usuario</h1>
      <p class="tool-subtitle">
        Encuentra el nickname perfecto para tus partidas. Genera al instante nombres épicos, tryhards, cyberpunk o estéticos para Fortnite, Steam, Valorant, Minecraft y Discord.
      </p>
    </header>

    <div class="gamertags-app-grid">
      <!-- PANEL DE CONTROL / FILTROS -->
      <div class="card controls-card">
        <h3>⚙️ Personaliza tu Estilo</h3>

        <div class="input-group">
          <label for="base-keyword">Tu nombre o palabra base (opcional):</label>
          <input type="text" id="base-keyword" placeholder="Ej: Alex, Shadow, Luna, Rex..." maxlength="20" />
        </div>

        <div class="input-group">
          <label>Temática o Estilo de Juego:</label>
          <div class="styles-selector-grid">
            <button type="button" class="style-btn active" data-style="tryhard">🎯 Tryhard / Pro</button>
            <button type="button" class="style-btn" data-style="cyberpunk">⚡ Cyberpunk / Sci-Fi</button>
            <button type="button" class="style-btn" data-style="fantasy">🐉 Épico / Fantasía</button>
            <button type="button" class="style-btn" data-style="aesthetic">✨ Estético & Símbolos</button>
            <button type="button" class="style-btn" data-style="funny">🍕 Divertido / Troll</button>
            <button type="button" class="style-btn" data-style="dark">💀 Dark / Sombra</button>
          </div>
        </div>

        <div class="options-toggles">
          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-symbols" />
            <span>Incluir símbolos decorativos (彡, ⚡, ×, 亗)</span>
          </label>
          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-leetspeak" />
            <span>Modo Leet / Hacker (A→4, E→3, O→0)</span>
          </label>
          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-affixes" checked />
            <span>Añadir prefijos / sufijos PRO (vfx, .exe, God)</span>
          </label>
        </div>

        <button type="button" class="btn-generate-main" id="btn-generate">
          🎲 Generar Nuevos Gamertags
        </button>
      </div>

      <!-- LISTADO DE RESULTADOS -->
      <div class="card results-card">
        <div class="results-header">
          <h3>🎮 Nombres Generados</h3>
          <span class="results-badge" id="results-count">15 sugerencias</span>
        </div>

        <div class="tags-output-grid" id="tags-container">
          <!-- Generado dinámicamente -->
        </div>

        <!-- COLECCIÓN DE FAVORITOS -->
        <div class="favorites-section" id="favorites-section" style="display: none;">
          <div class="fav-header">
            <h4>⭐ Tus Nicks Guardados (<span id="fav-count">0</span>)</h4>
            <button type="button" id="btn-clear-favs" class="btn-clear-favs">Borrar</button>
          </div>
          <div class="favorites-list" id="favorites-container"></div>
        </div>
      </div>
    </div>

    <!-- GUÍA SEO -->
    <section class="seo-guide-section card">
      <h2>Consejos para elegir el mejor Nickname de Gaming en 2026</h2>
      <p>
        Un buen gamertag es tu marca personal en internet. Ya sea que busques transmitir seriedad competitiva en torneos de Valorant o crear un canal de streaming exitoso en Twitch o Kick, ten en cuenta estas claves:
      </p>

      <div class="guide-grid">
        <div class="guide-box">
          <h3>🎙️ Facilidad de Voz en Discord</h3>
          <p>
            Evita nombres que contengan series largas de números aleatorios (como <em>Juan982736</em>). Tus compañeros de escuadra deben poder llamarte en medio de un tiroteo con un monosílabo claro: «¡Shadow, a tu izquierda!».
          </p>
        </div>
        <div class="guide-box">
          <h3>🌐 Disponibilidad Cross-Platform</h3>
          <p>
            Si planeas streamear o competir, comprueba que el nombre o una ligera variante esté libre simultáneamente en YouTube, Twitch, X (Twitter) e Instagram para construir una audiencia sólida.
          </p>
        </div>
        <div class="guide-box">
          <h3>🕹️ Menos es Más</h3>
          <p>
            Las tendencias gaming actuales huyen de los clichés sobrecargados de los años 2010 como «xX_Matador_Xx» y premian nombres minimalistas de una sola palabra potente o combinaciones limpias.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQS -->
    <section class="faq-section card">
      <h2>Preguntas Frecuentes sobre Nombres de Jugador</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{faq.question}</strong></summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    padding: 2rem 1rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--text-muted, #94a3b8);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #6366f1;
  }

  .tool-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .tool-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(168, 85, 247, 0.1);
    color: #a855f7;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(168, 85, 247, 0.2);
  }

  .tool-header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-heading, #f8fafc);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .tool-subtitle {
    color: var(--text-muted, #94a3b8);
    font-size: 1.05rem;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .gamertags-app-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 900px) {
    .gamertags-app-grid {
      grid-template-columns: 1fr;
    }
  }

  /* CONTROLS */
  .controls-card h3 {
    margin-top: 0;
    font-size: 1.2rem;
    color: var(--text-heading, #f8fafc);
    margin-bottom: 1.25rem;
  }

  .input-group {
    margin-bottom: 1.25rem;
  }

  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 0.4rem;
  }

  .input-group input[type="text"] {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-color, #334155);
    background: rgba(15, 23, 42, 0.6);
    color: var(--text-heading, #f8fafc);
    font-size: 0.95rem;
    box-sizing: border-box;
  }

  .input-group input[type="text"]:focus {
    outline: none;
    border-color: #a855f7;
    box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.25);
  }

  .styles-selector-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .style-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-muted, #94a3b8);
    padding: 0.6rem 0.5rem;
    border-radius: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
  }

  .style-btn:hover {
    background: rgba(168, 85, 247, 0.15);
    color: var(--text-heading, #f8fafc);
  }

  .style-btn.active {
    background: #a855f7;
    color: #ffffff;
    border-color: #a855f7;
    box-shadow: 0 2px 10px rgba(168, 85, 247, 0.35);
  }

  .options-toggles {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 1.25rem 0 1.5rem;
    background: rgba(15, 23, 42, 0.4);
    padding: 0.85rem;
    border-radius: 0.6rem;
    border: 1px solid var(--border-color, #334155);
  }

  .toggle-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted, #94a3b8);
    cursor: pointer;
  }

  .toggle-checkbox input {
    accent-color: #a855f7;
  }

  .btn-generate-main {
    width: 100%;
    background: linear-gradient(135deg, #a855f7, #6366f1);
    color: #ffffff;
    border: none;
    padding: 0.9rem;
    border-radius: 0.65rem;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.15s, opacity 0.15s;
    box-shadow: 0 4px 15px rgba(168, 85, 247, 0.3);
  }

  .btn-generate-main:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  /* RESULTS CARD */
  .results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .results-header h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--text-heading, #f8fafc);
  }

  .results-badge {
    font-size: 0.75rem;
    color: #a855f7;
    background: rgba(168, 85, 247, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-weight: 700;
  }

  .tags-output-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 480px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  .tag-item-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.5rem;
    padding: 0.65rem 0.85rem;
    transition: all 0.15s;
  }

  .tag-item-card:hover {
    border-color: #a855f7;
    background: rgba(168, 85, 247, 0.08);
  }

  .tag-text {
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--text-heading, #f8fafc);
    letter-spacing: 0.5px;
    word-break: break-all;
  }

  .tag-actions {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .btn-tag-action {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-muted, #94a3b8);
    padding: 0.25rem 0.55rem;
    border-radius: 5px;
    font-size: 0.78rem;
    cursor: pointer;
    transition: all 0.12s;
  }

  .btn-tag-action:hover {
    color: var(--text-heading, #f8fafc);
    background: rgba(168, 85, 247, 0.25);
  }

  .btn-tag-action.copied {
    background: #10b981;
    color: #ffffff;
    border-color: #10b981;
  }

  /* FAVORITES */
  .favorites-section {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-color, #334155);
  }

  .fav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .fav-header h4 {
    margin: 0;
    font-size: 0.95rem;
    color: #f59e0b;
  }

  .btn-clear-favs {
    background: transparent;
    border: none;
    color: var(--text-muted, #94a3b8);
    font-size: 0.75rem;
    cursor: pointer;
    text-decoration: underline;
  }

  .favorites-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .fav-pill {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #f59e0b;
    border-radius: 9999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .fav-pill button {
    background: transparent;
    border: none;
    color: #f59e0b;
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0;
  }

  /* SEO & GUIDE */
  .seo-guide-section, .faq-section {
    margin-top: 2rem;
  }

  .seo-guide-section h2, .faq-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading, #f8fafc);
    margin-bottom: 1rem;
  }

  .seo-guide-section p {
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color, #334155);
    padding: 1.25rem;
    border-radius: 0.75rem;
  }

  .guide-box h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-heading, #f8fafc);
    margin-bottom: 0.5rem;
  }

  .guide-box p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.65rem;
    padding: 0.85rem 1.15rem;
  }

  .faq-question {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-heading, #f8fafc);
  }

  .faq-answer {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
  }
</style>

<script>
  function initGamertagGenerator() {
    const keywordInput = document.getElementById('base-keyword') as HTMLInputElement;
    const styleBtns = document.querySelectorAll('.style-btn');
    const toggleSymbols = document.getElementById('toggle-symbols') as HTMLInputElement;
    const toggleLeetspeak = document.getElementById('toggle-leetspeak') as HTMLInputElement;
    const toggleAffixes = document.getElementById('toggle-affixes') as HTMLInputElement;
    const btnGenerate = document.getElementById('btn-generate');
    const container = document.getElementById('tags-container');
    const favSection = document.getElementById('favorites-section');
    const favContainer = document.getElementById('favorites-container');
    const favCountEl = document.getElementById('fav-count');
    const btnClearFavs = document.getElementById('btn-clear-favs');

    if (!btnGenerate || !container) return;

    let currentStyle = 'tryhard';

    // Word dictionaries by style
    const dicts: Record<string, string[]> = {
      tryhard: ['Viper', 'Apex', 'Clutch', 'AimGod', 'Toxic', 'Phantom', 'Wraith', 'Zero', 'Pulse', 'Reflex', 'Nexus', 'Ghost', 'Rogue', 'Blade', 'Vortex', 'Krono', 'Frenzy', 'Venom', 'Specter', 'Havoc'],
      cyberpunk: ['Cyber', 'Neon', 'Matrix', 'Glitch', 'Byte', 'Sync', 'Overdrive', 'Netrunner', 'Pixel', 'Proton', 'Titan', 'Vector', 'Chrome', 'Holo', 'Neural', 'Kilo', 'Data', 'Grid', 'Terminal', 'Kernel'],
      fantasy: ['Valkyrie', 'Draco', 'Fenrir', 'Hydra', 'Valkyr', 'Storm', 'Shadow', 'Frost', 'Ignis', 'Ragnarok', 'Gryphon', 'Paladin', 'Aegis', 'Slayer', 'Zeus', 'Ares', 'Thor', 'Arcane', 'Eldritch', 'Titan'],
      aesthetic: ['Moonlight', 'Aura', 'Celestial', 'Euphoria', 'Velvet', 'Ethereal', 'Karma', 'Echo', 'Solstice', 'Zenith', 'Mirage', 'Lullaby', 'Cascade', 'Nebula', 'Symphony', 'Bliss', 'Seraph', 'Astra'],
      funny: ['TacoSupremo', 'MancoPro', 'NoobMaster', 'PatoNinja', 'WifiLento', 'DoritoLoco', 'BotSinCerebro', 'LagInfinito', 'QuesoGamer', 'PatataAsada', 'PanConManteca', 'BalaPerdida', 'CeroKills', 'ElTioCampero'],
      dark: ['Oblivion', 'Reaper', 'Doom', 'Nightfall', 'Abyss', 'Grimm', 'Malice', 'Vesper', 'Hades', 'Grave', 'Dread', 'Noctis', 'Bane', 'Sinister', 'Crypt', 'Cinder', 'Obsidian', 'Raven', 'Morbid']
    };

    const prefixes = ['El_', 'iAm_', 'xX_', 'Lord_', 'Real_', 'Master_', 'Neo_', 'Pure_', 'Captain_'];
    const suffixes = ['_v2', '_exe', '99', 'God', 'Pro', '_X', '404', 'TTV', '_GG', 'FPS', '_z'];
    const symbols = [
      ['彡', '彡'],
      ['⚡', '⚡'],
      ['×', '×'],
      ['꧁', '꧂'],
      ['亗', '亗'],
      ['𐌕', '𐌕'],
      ['†', '†'],
      ['•', '•']
    ];

    function applyLeet(str: string): string {
      return str
        .replace(/a/gi, '4')
        .replace(/e/gi, '3')
        .replace(/i/gi, '1')
        .replace(/o/gi, '0')
        .replace(/s/gi, '5');
    }

    function getRandomItem<T>(arr: T[]): T {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    function generateTags(): string[] {
      const baseWord = (keywordInput.value || '').trim();
      const stylePool = dicts[currentStyle] || dicts.tryhard;
      const results: string[] = [];

      for (let i = 0; i < 15; i++) {
        let tag = '';
        const dictWord = getRandomItem(stylePool);

        if (baseWord) {
          const coin = Math.random();
          if (coin < 0.35) {
            tag = `${baseWord}${dictWord}`;
          } else if (coin < 0.7) {
            tag = `${dictWord}${baseWord}`;
          } else {
            tag = `${baseWord}_${dictWord}`;
          }
        } else {
          // Combine 2 stylistic words or affix
          const coin = Math.random();
          if (coin < 0.4) {
            tag = dictWord;
          } else {
            const secondWord = getRandomItem(stylePool);
            tag = dictWord === secondWord ? `${dictWord}Prime` : `${dictWord}${secondWord}`;
          }
        }

        if (toggleAffixes.checked) {
          const coinAffix = Math.random();
          if (coinAffix < 0.3) {
            tag = `${getRandomItem(prefixes)}${tag}`;
          } else if (coinAffix < 0.6) {
            tag = `${tag}${getRandomItem(suffixes)}`;
          }
        }

        if (toggleLeetspeak.checked) {
          tag = applyLeet(tag);
        }

        if (toggleSymbols.checked) {
          const pair = getRandomItem(symbols);
          tag = `${pair[0]}${tag}${pair[1]}`;
        }

        results.push(tag);
      }

      return Array.from(new Set(results));
    }

    // Favorites persistence
    function getFavorites(): string[] {
      try {
        return JSON.parse(localStorage.getItem('gt_gamertag_favs') || '[]');
      } catch (e) {
        return [];
      }
    }

    function saveFavorites(favs: string[]) {
      try {
        localStorage.setItem('gt_gamertag_favs', JSON.stringify(favs));
        renderFavorites();
      } catch (e) {}
    }

    function renderFavorites() {
      const favs = getFavorites();
      if (!favSection || !favContainer || !favCountEl) return;

      favCountEl.textContent = favs.length.toString();
      if (favs.length === 0) {
        favSection.style.display = 'none';
        return;
      }

      favSection.style.display = 'block';
      favContainer.innerHTML = '';

      favs.forEach(nick => {
        const pill = document.createElement('div');
        pill.className = 'fav-pill';
        pill.innerHTML = `<span>${nick}</span><button type="button" data-nick="${nick}" title="Eliminar">✕</button>`;

        pill.querySelector('button')?.addEventListener('click', () => {
          const updated = getFavorites().filter(n => n !== nick);
          saveFavorites(updated);
        });

        favContainer.appendChild(pill);
      });
    }

    function renderTags() {
      const tags = generateTags();
      container.innerHTML = '';
      const favs = getFavorites();

      tags.forEach(tag => {
        const item = document.createElement('div');
        item.className = 'tag-item-card';

        const isFav = favs.includes(tag);

        item.innerHTML = `
          <span class="tag-text">${tag}</span>
          <div class="tag-actions">
            <button type="button" class="btn-tag-action btn-copy-tag" title="Copiar nick">📋 Copiar</button>
            <button type="button" class="btn-tag-action btn-fav-tag" title="Guardar en favoritos">${isFav ? '⭐' : '☆'}</button>
          </div>
        `;

        const btnCopy = item.querySelector('.btn-copy-tag') as HTMLButtonElement;
        btnCopy?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(tag);
            btnCopy.textContent = '✅ ¡Copiado!';
            btnCopy.classList.add('copied');
            setTimeout(() => {
              btnCopy.textContent = '📋 Copiar';
              btnCopy.classList.remove('copied');
            }, 1500);
          } catch (e) {}
        });

        const btnFav = item.querySelector('.btn-fav-tag') as HTMLButtonElement;
        btnFav?.addEventListener('click', () => {
          const currentFavs = getFavorites();
          if (currentFavs.includes(tag)) {
            const next = currentFavs.filter(n => n !== tag);
            saveFavorites(next);
            btnFav.textContent = '☆';
          } else {
            currentFavs.push(tag);
            saveFavorites(currentFavs);
            btnFav.textContent = '⭐';
          }
        });

        container.appendChild(item);
      });
    }

    styleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        styleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentStyle = btn.getAttribute('data-style') || 'tryhard';
        renderTags();
      });
    });

    [keywordInput, toggleSymbols, toggleLeetspeak, toggleAffixes].forEach(el => {
      el?.addEventListener('change', renderTags);
    });

    keywordInput?.addEventListener('keyup', (e) => {
      if (e.key === 'Enter') renderTags();
    });

    btnGenerate.addEventListener('click', renderTags);

    btnClearFavs?.addEventListener('click', () => {
      saveFavorites([]);
      renderTags();
    });

    renderFavorites();
    renderTags();
  }

  document.addEventListener('astro:page-load', initGamertagGenerator);
</script>
