    let state = {
      device: null,
      symptom: null,
      diagnosis: null
    };

    const steps = [
      document.getElementById('step-1'),
      document.getElementById('step-2'),
      document.getElementById('step-3'),
      document.getElementById('step-4')
    ];
    const pills = [
      document.getElementById('pill-1'),
      document.getElementById('pill-2'),
      document.getElementById('pill-3'),
      document.getElementById('pill-4')
    ];

    function showStep(stepIndex) {
      steps.forEach((s, idx) => s.classList.toggle('active', idx === stepIndex));
      pills.forEach((p, idx) => {
        p.classList.toggle('active', idx === stepIndex);
        p.classList.toggle('done', idx < stepIndex);
      });
    }

    // Step 1 click
    document.querySelectorAll('[data-device]').forEach(btn => {
      btn.addEventListener('click', () => {
        const devKey = btn.getAttribute('data-device');
        state.device = devKey;
        const devObj = knowledgeBase[devKey];
        document.getElementById('step-2-title').textContent = `¿Qué problema presenta tu ${devObj.label}?`;

        const symContainer = document.getElementById('symptom-options');
        symContainer.innerHTML = devObj.symptoms.map(s => `
          <button type="button" class="option-card" data-symptom="${s.id}">
            <span class="opt-icon">${s.icon}</span>
            <strong class="opt-name">${s.name}</strong>
            <span class="opt-desc">${s.desc}</span>
          </button>
        `).join('');

        symContainer.querySelectorAll('[data-symptom]').forEach(sBtn => {
          sBtn.addEventListener('click', () => {
            const symId = sBtn.getAttribute('data-symptom');
            state.symptom = devObj.symptoms.find(x => x.id === symId);
            renderStep3();
          });
        });

        showStep(1);
      });
    });

    function renderStep3() {
      document.getElementById('step-3-title').textContent = state.symptom.question;
      const detContainer = document.getElementById('detail-options');
      detContainer.innerHTML = state.symptom.details.map(d => `
        <button type="button" class="option-card" data-detail="${d.id}">
          <span class="opt-icon">${d.icon}</span>
          <strong class="opt-name">${d.name}</strong>
          <span class="opt-desc">${d.desc}</span>
        </button>
      `).join('');

      detContainer.querySelectorAll('[data-detail]').forEach(dBtn => {
        dBtn.addEventListener('click', () => {
          const detId = dBtn.getAttribute('data-detail');
          const detailObj = state.symptom.details.find(x => x.id === detId);
          state.diagnosis = detailObj.diagnosis;
          renderDiagnosis();
        });
      });

      showStep(2);
    }

    function renderDiagnosis() {
      const diag = state.diagnosis;
      document.getElementById('diag-severity').textContent = diag.severity;
      document.getElementById('diag-category').textContent = diag.category;
      document.getElementById('diag-title').textContent = diag.title;
      document.getElementById('diag-summary').textContent = diag.summary;

      const listEl = document.getElementById('diag-steps');
      listEl.innerHTML = diag.steps.map(st => `<li>${st}</li>`).join('');

      const linksEl = document.getElementById('diag-links');
      if (diag.links && diag.links.length > 0) {
        document.getElementById('diag-links-wrap').style.display = 'block';
        linksEl.innerHTML = diag.links.map(l => `
          <a href="${l.url}" class="related-link-card">
            <span>🔗 ${l.text}</span>
            <span class="arrow">→</span>
          </a>
        `).join('');
      } else {
        document.getElementById('diag-links-wrap').style.display = 'none';
      }

      showStep(3);
    }

    document.getElementById('back-to-1').addEventListener('click', () => showStep(0));
    document.getElementById('back-to-2').addEventListener('click', () => showStep(1));
    document.getElementById('btn-restart').addEventListener('click', () => showStep(0));

    document.getElementById('btn-copy-diag').addEventListener('click', () => {
      if (!state.diagnosis) return;
      const text = `DIAGNÓSTICO TÉCNICO (GuíaTecnes):\n${state.diagnosis.title}\n\nResumen: ${state.diagnosis.summary}\n\nPasos:\n${state.diagnosis.steps.map((s, i) => `${i + 1}. ${s}`).join('\n')}`;
      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById('btn-copy-diag');
        const orig = btn.textContent;
        btn.textContent = '✅ ¡Diagnóstico Copiado!';
        setTimeout(() => btn.textContent = orig, 2200);
      });
    });
  })();
</script>

