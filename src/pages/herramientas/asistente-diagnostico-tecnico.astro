---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LegalDisclaimer from '../../components/LegalDisclaimer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas/' },
  { name: 'Asistente de Diagnóstico Técnico', url: '/herramientas/asistente-diagnostico-tecnico/' }
];

const faqs = [
  {
    question: '¿Cómo funciona el Asistente de Diagnóstico Técnico de GuíaTecnes?',
    answer: 'El asistente utiliza un árbol de decisión lógica basado en las averías reales más frecuentes de hardware, redes y sistemas operativos. Al responder 3 preguntas rápidas sobre los síntomas de tu dispositivo, descarta fallos de software frente a problemas físicos y te entrega un plan de acción ordenado por probabilidad.'
  },
  {
    question: '¿Es seguro aplicar las soluciones propuestas si mi equipo está en garantía?',
    answer: 'Todas las soluciones de software, reinicios de red, actualización de controladores o limpieza externa son completamente seguras. Sin embargo, si el diagnóstico apunta a un fallo de hardware interno (como batería hinchada, fuente de alimentación dañada o placa base), nunca abras el equipo si aún conserva la garantía oficial del fabricante.'
  },
  {
    question: '¿Se recopilan datos sobre mi ordenador o teléfono móvil?',
    answer: 'No. El asistente funciona al 100% en tu navegador mediante lógica local. No escanea tu equipo ni envía datos personales a servidores externos.'
  },
  {
    question: '¿Qué hago si ninguno de los pasos soluciona mi problema técnico?',
    answer: 'Cuando un fallo persiste tras descartar errores de configuración, controladores y caché (por ejemplo, si un ordenador no da vídeo tras probar otro cable y monitor, o un móvil no carga con otro cargador oficial), es muy probable que exista un daño físico en un componente electrónico que requiera servicio técnico especializado.'
  }
];
---

<BaseLayout
  title="Asistente de Diagnóstico Técnico Interactivo | Soluciona Averías PC, Móvil y WiFi"
  description="Diagnostica en 30 segundos por qué falla tu PC, móvil, WiFi o pantalla. Responde 3 preguntas rápidas y obtén el diagnóstico exacto con pasos de solución."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  alternates={{ es: '/herramientas/asistente-diagnostico-tecnico/', en: '/en/tools/tech-diagnostic-wizard/', pt: '/pt/ferramentas/assistente-diagnostico-tecnico/', fr: '/fr/outils/assistant-diagnostic-technique/', de: '/de/werkzeuge/technik-diagnose-assistent/' }}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas/">Herramientas</a>
      <span>›</span>
      <span>Asistente de Diagnóstico Técnico</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🩺 Diagnóstico Interactivo en 3 Pasos</div>
      <h1>Asistente Inteligente de Diagnóstico Técnico</h1>
      <p class="tool-subtitle">
        ¿Tu ordenador se apaga, el WiFi va lento o tu móvil no carga? Selecciona los síntomas en nuestro árbol lógico para identificar la causa exacta y cómo repararla.
      </p>
    </header>

    <!-- PROGRESS STEPPER -->
    <div class="wizard-shell card">
      <div class="wizard-progress">
        <div class="step-pill active" id="pill-1"><span class="step-num">1</span> Dispositivo</div>
        <div class="step-line"></div>
        <div class="step-pill" id="pill-2"><span class="step-num">2</span> Síntoma</div>
        <div class="step-line"></div>
        <div class="step-pill" id="pill-3"><span class="step-num">3</span> Verificación</div>
        <div class="step-line"></div>
        <div class="step-pill" id="pill-4"><span class="step-num">✓</span> Diagnóstico</div>
      </div>

      <!-- STEP 1: DEVICE -->
      <section id="step-1" class="wizard-step active">
        <h2 class="step-title">¿Con qué dispositivo o sistema tienes problemas?</h2>
        <div class="options-grid device-grid">
          <button type="button" class="option-card" data-device="pc">
            <span class="opt-icon">💻</span>
            <strong class="opt-name">PC o Portátil (Windows / Mac)</strong>
            <span class="opt-desc">Apagones, lentitud extrema, pantalla negra o errores de sistema.</span>
          </button>
          <button type="button" class="option-card" data-device="movil">
            <span class="opt-icon">📱</span>
            <strong class="opt-name">Móvil (Android / iPhone)</strong>
            <span class="opt-desc">Batería agotada rápido, no carga, sospecha de virus o sobrecalentamiento.</span>
          </button>
          <button type="button" class="option-card" data-device="wifi">
            <span class="opt-icon">📡</span>
            <strong class="opt-name">WiFi, Router e Internet</strong>
            <span class="opt-desc">Conectado sin internet, microcortes, baja velocidad en habitaciones.</span>
          </button>
          <button type="button" class="option-card" data-device="perifericos">
            <span class="opt-icon">🎧</span>
            <strong class="opt-name">Pantalla, Audio y Bluetooth</strong>
            <span class="opt-desc">Parpadeo de monitor, retraso de sonido Bluetooth o dispositivos no detectados.</span>
          </button>
        </div>
      </section>

      <!-- STEP 2: SYMPTOM -->
      <section id="step-2" class="wizard-step">
        <div class="step-nav-top">
          <button type="button" class="btn-back" id="back-to-1">← Cambiar dispositivo</button>
        </div>
        <h2 class="step-title" id="step-2-title">¿Cuál es el síntoma principal?</h2>
        <div class="options-grid" id="symptom-options"></div>
      </section>

      <!-- STEP 3: CLARIFICATION QUESTION -->
      <section id="step-3" class="wizard-step">
        <div class="step-nav-top">
          <button type="button" class="btn-back" id="back-to-2">← Cambiar síntoma</button>
        </div>
        <h2 class="step-title" id="step-3-title">Pregunta de descarte técnico</h2>
        <div class="options-grid" id="detail-options"></div>
      </section>

      <!-- STEP 4: FINAL DIAGNOSIS -->
      <section id="step-4" class="wizard-step">
        <div class="diagnosis-header">
          <div class="diag-badge-row">
            <span class="diag-severity" id="diag-severity">Probabilidad Alta</span>
            <span class="diag-category" id="diag-category">Hardware / Red</span>
          </div>
          <h2 id="diag-title">Diagnóstico</h2>
          <p id="diag-summary" class="diag-summary"></p>
        </div>

        <div class="diag-body">
          <div class="diag-steps-box">
            <h3>🛠️ Plan de Acción Paso a Paso</h3>
            <ol id="diag-steps" class="action-list"></ol>
          </div>

          <div class="diag-links-box" id="diag-links-wrap">
            <h3>📚 Guías y Herramientas Recomendadas</h3>
            <div id="diag-links" class="related-links"></div>
          </div>
        </div>

        <div class="diag-footer-actions">
          <button type="button" id="btn-copy-diag" class="btn-primary">📋 Copiar Resumen del Diagnóstico</button>
          <button type="button" id="btn-restart" class="btn-secondary">🔄 Realizar Otro Diagnóstico</button>
        </div>
      </section>
    </div>

    <LegalDisclaimer />

    <section class="seo-guide card">
      <h2>¿Por qué usar un asistente lógico antes de llevar tu dispositivo al servicio técnico?</h2>
      <p>
        Más del <strong>65% de las incidencias informáticas cotidianas</strong> (como un router que muestra "conectado sin internet", un ordenador que sufre tirones repentinos o unos auriculares Bluetooth que no emparejan) no son averías físicas irreparables, sino bloqueos temporales de caché, conflictos de controladores o interferencias de canal.
      </p>
      <p>
        Seguir una metodología de descarte ordenada evita gastos innecesarios en reparaciones y te permite identificar cuándo un problema se resuelve en 2 minutos desde casa y cuándo existe realmente un componente dañado (como una fuente de alimentación defectuosa o una batería degradada).
      </p>

      <h3>Preguntas Frecuentes</h3>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

