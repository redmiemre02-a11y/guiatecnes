---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Conversor Universal de Unidades', url: '/herramientas/conversor-unidades' }
];

const faqs = [
  {
    question: '¿Cuántos centímetros tiene una pulgada (inch)?',
    answer: 'Exactamente 2,54 centímetros. Para pasar pulgadas a centímetros multiplica por 2,54, y para pasar de centímetros a pulgadas divide entre 2,54.'
  },
  {
    question: '¿Cómo se convierte de Celsius a Fahrenheit rápidamente?',
    answer: 'La fórmula exacta es: (°C × 9/5) + 32 = °F. Para un cálculo mental aproximado y rápido, multiplica la temperatura en °C por 2 y súmale 30.'
  },
  {
    question: '¿Cuántos kilogramos son una libra (lbs)?',
    answer: 'Una libra equivale exactamente a 0,45359237 kg (aproximadamente 454 gramos). A la inversa, 1 kg equivale a unas 2,2046 libras.'
  },
  {
    question: '¿Qué diferencia hay entre millas terrestres y millas náuticas?',
    answer: 'Una milla terrestre internacional equivale a 1.609,34 metros (1,61 km), mientras que una milla náutica (usada en navegación marítima y aviación) equivale a 1.852 metros.'
  }
];
---

<BaseLayout
  title="Conversor Universal de Unidades Online Rápido y Preciso | GuiaTecnEs"
  description="Convierte al instante longitud, peso, temperatura, velocidad y volumen. De pulgadas a cm, libras a kg, Celsius a Fahrenheit y millas a km."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Conversor de Unidades</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">📐 Medidas, Ciencia & Viajes</div>
      <h1>Conversor Universal de Unidades</h1>
      <p class="tool-subtitle">
        Pasa fácilmente entre el sistema métrico internacional y el sistema anglosajón: pulgadas a centímetros, libras a kilos, Fahrenheit a Celsius y mucho más en tiempo real.
      </p>
    </header>

    <div class="converter-app-card card">
      <!-- SELECTOR DE CATEGORÍA -->
      <div class="category-tabs">
        <button type="button" class="cat-tab active" data-cat="length">📏 Longitud</button>
        <button type="button" class="cat-tab" data-cat="weight">⚖️ Masa & Peso</button>
        <button type="button" class="cat-tab" data-cat="temp">🌡️ Temperatura</button>
        <button type="button" class="cat-tab" data-cat="speed">⚡ Velocidad</button>
        <button type="button" class="cat-tab" data-cat="volume">🧪 Volumen</button>
      </div>

      <!-- ÁREA DE CONVERSIÓN BIDIRECCIONAL -->
      <div class="conversion-engine-grid">
        <!-- ORIGEN -->
        <div class="engine-column">
          <label for="input-amount">De:</label>
          <div class="input-val-box">
            <input type="number" id="input-amount" value="1" step="any" />
          </div>
          <div class="select-unit-box">
            <select id="select-from"></select>
          </div>
        </div>

        <!-- BOTÓN INTERCAMBIAR -->
        <div class="swap-column">
          <button type="button" id="btn-swap-units" title="Invertir unidades (⇄)">
            ⇄
          </button>
        </div>

        <!-- DESTINO / RESULTADO -->
        <div class="engine-column">
          <label for="output-amount">A:</label>
          <div class="input-val-box result-highlight-box">
            <input type="text" id="output-amount" readonly />
            <button type="button" id="btn-copy-result" title="Copiar resultado">📋</button>
          </div>
          <div class="select-unit-box">
            <select id="select-to"></select>
          </div>
        </div>
      </div>

      <!-- FÓRMULA / RESUMEN -->
      <div class="formula-banner" id="formula-display">
        Fórmula de conversión: 1 pulgada = 2,54 cm
      </div>

      <!-- PRESETS POPULARES -->
      <div class="presets-row">
        <span class="presets-label">Conversiones frecuentes:</span>
        <div class="preset-chips" id="preset-chips-container">
          <!-- Chips dinámicos -->
        </div>
      </div>
    </div>

    <!-- GUÍA SEO -->
    <section class="seo-guide-section card">
      <h2>Equivalencias más comunes entre Sistema Métrico e Imperial</h2>
      <p>
        Para cocinar recetas internacionales, comprar ropa o tecnología en tiendas de EE.UU. o planificar viajes, estas son las equivalencias fundamentales:
      </p>

      <div class="guide-grid">
        <div class="guide-box">
          <h3>📏 Longitud & Pantallas</h3>
          <p>
            • 1 pulgada (in) = <strong>2,54 cm</strong><br />
            • 1 pie (ft) = <strong>30,48 cm</strong> (o 12 pulgadas)<br />
            • 1 yarda (yd) = <strong>0,9144 m</strong><br />
            • 1 milla (mi) = <strong>1,609 km</strong>
          </p>
        </div>
        <div class="guide-box">
          <h3>⚖️ Peso & Cocina</h3>
          <p>
            • 1 libra (lb) = <strong>453,59 gramos</strong><br />
            • 1 onza (oz) = <strong>28,35 gramos</strong><br />
            • 1 kilogramo = <strong>2,205 libras</strong><br />
            • 1 tonelada métrica = <strong>1.000 kg</strong>
          </p>
        </div>
        <div class="guide-box">
          <h3>🌡️ Temperaturas Clave</h3>
          <p>
            • 0 °C (congelación agua) = <strong>32 °F</strong><br />
            • 20 °C (ambiente suave) = <strong>68 °F</strong><br />
            • 37 °C (corporal normal) = <strong>98,6 °F</strong><br />
            • 100 °C (ebullición agua) = <strong>212 °F</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- FAQS -->
    <section class="faq-section card">
      <h2>Preguntas Frecuentes sobre Conversión de Unidades</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{faq.question}</strong></summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    padding: 2rem 1rem 4rem;
    max-width: 950px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--text-muted, #94a3b8);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #10b981;
  }

  .tool-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .tool-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .tool-header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-heading, #f8fafc);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .tool-subtitle {
    color: var(--text-muted, #94a3b8);
    font-size: 1.05rem;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  /* CATEGORY TABS */
  .category-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-color, #334155);
  }

  .cat-tab {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-muted, #94a3b8);
    padding: 0.6rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s;
  }

  .cat-tab:hover {
    background: rgba(16, 185, 129, 0.15);
    color: var(--text-heading, #f8fafc);
  }

  .cat-tab.active {
    background: #10b981;
    color: #ffffff;
    border-color: #10b981;
    box-shadow: 0 2px 10px rgba(16, 185, 129, 0.35);
  }

  /* ENGINE GRID */
  .conversion-engine-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.25rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 700px) {
    .conversion-engine-grid {
      grid-template-columns: 1fr;
    }
  }

  .engine-column label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .input-val-box input {
    width: 100%;
    padding: 0.9rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.6rem;
    color: var(--text-heading, #f8fafc);
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }

  .input-val-box input:focus {
    outline: none;
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .result-highlight-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .result-highlight-box input {
    color: #10b981;
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.3);
    padding-right: 3rem;
  }

  #btn-copy-result {
    position: absolute;
    right: 0.6rem;
    top: 50%;
    transform: translateY(-70%);
    background: transparent;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s;
  }

  #btn-copy-result:hover {
    opacity: 1;
  }

  .select-unit-box select {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.6rem;
    color: var(--text-heading, #f8fafc);
    font-size: 0.95rem;
    cursor: pointer;
    box-sizing: border-box;
  }

  .select-unit-box select:focus {
    outline: none;
    border-color: #10b981;
  }

  .swap-column {
    display: flex;
    justify-content: center;
    padding-top: 1.5rem;
  }

  #btn-swap-units {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-heading, #f8fafc);
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  #btn-swap-units:hover {
    background: #10b981;
    border-color: #10b981;
    transform: rotate(180deg);
  }

  /* FORMULA BANNER */
  .formula-banner {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid var(--border-color, #334155);
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted, #94a3b8);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  /* PRESETS */
  .presets-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px dashed var(--border-color, #334155);
  }

  .presets-label {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
  }

  .preset-chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .preset-chip-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-heading, #f8fafc);
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    cursor: pointer;
    transition: all 0.15s;
  }

  .preset-chip-btn:hover {
    background: rgba(16, 185, 129, 0.15);
    border-color: #10b981;
  }

  /* SEO & GUIDE */
  .seo-guide-section, .faq-section {
    margin-top: 2rem;
  }

  .seo-guide-section h2, .faq-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading, #f8fafc);
    margin-bottom: 1rem;
  }

  .seo-guide-section p {
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color, #334155);
    padding: 1.25rem;
    border-radius: 0.75rem;
  }

  .guide-box h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-heading, #f8fafc);
    margin-bottom: 0.5rem;
  }

  .guide-box p {
    font-size: 0.9rem;
    margin-bottom: 0;
    line-height: 1.6;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.65rem;
    padding: 0.85rem 1.15rem;
  }

  .faq-question {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-heading, #f8fafc);
  }

  .faq-answer {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
  }
</style>

<script>
  function initUnitConverter() {
    const catTabs = document.querySelectorAll('.cat-tab');
    const inputAmount = document.getElementById('input-amount') as HTMLInputElement;
    const outputAmount = document.getElementById('output-amount') as HTMLInputElement;
    const selectFrom = document.getElementById('select-from') as HTMLSelectElement;
    const selectTo = document.getElementById('select-to') as HTMLSelectElement;
    const btnSwap = document.getElementById('btn-swap-units');
    const btnCopy = document.getElementById('btn-copy-result');
    const formulaDisplay = document.getElementById('formula-display');
    const presetsContainer = document.getElementById('preset-chips-container');

    if (!inputAmount || !selectFrom || !selectTo) return;

    interface UnitDef {
      name: string;
      toBase: (v: number) => number;
      fromBase: (v: number) => number;
    }

    interface CategoryConfig {
      units: Record<string, UnitDef>;
      defaultFrom: string;
      defaultTo: string;
      presets: { label: string; val: number; from: string; to: string }[];
    }

    const categories: Record<string, CategoryConfig> = {
      length: {
        units: {
          mm: { name: 'Milímetros (mm)', toBase: v => v / 1000, fromBase: b => b * 1000 },
          cm: { name: 'Centímetros (cm)', toBase: v => v / 100, fromBase: b => b * 100 },
          m: { name: 'Metros (m)', toBase: v => v, fromBase: b => b },
          km: { name: 'Kilómetros (km)', toBase: v => v * 1000, fromBase: b => b / 1000 },
          in: { name: 'Pulgadas (in)', toBase: v => v * 0.0254, fromBase: b => b / 0.0254 },
          ft: { name: 'Pies (ft)', toBase: v => v * 0.3048, fromBase: b => b / 0.3048 },
          yd: { name: 'Yardas (yd)', toBase: v => v * 0.9144, fromBase: b => b / 0.9144 },
          mi: { name: 'Millas (mi)', toBase: v => v * 1609.344, fromBase: b => b / 1609.344 }
        },
        defaultFrom: 'in',
        defaultTo: 'cm',
        presets: [
          { label: '1 pulgada a cm', val: 1, from: 'in', to: 'cm' },
          { label: '1 pie a cm', val: 1, from: 'ft', to: 'cm' },
          { label: '1 metro a pies', val: 1, from: 'm', to: 'ft' },
          { label: '1 milla a km', val: 1, from: 'mi', to: 'km' }
        ]
      },
      weight: {
        units: {
          g: { name: 'Gramos (g)', toBase: v => v / 1000, fromBase: b => b * 1000 },
          kg: { name: 'Kilogramos (kg)', toBase: v => v, fromBase: b => b },
          t: { name: 'Toneladas (t)', toBase: v => v * 1000, fromBase: b => b / 1000 },
          oz: { name: 'Onzas (oz)', toBase: v => v * 0.028349523125, fromBase: b => b / 0.028349523125 },
          lb: { name: 'Libras (lb)', toBase: v => v * 0.45359237, fromBase: b => b / 0.45359237 }
        },
        defaultFrom: 'lb',
        defaultTo: 'kg',
        presets: [
          { label: '1 libra a kg', val: 1, from: 'lb', to: 'kg' },
          { label: '1 kg a libras', val: 1, from: 'kg', to: 'lb' },
          { label: '1 onza a gramos', val: 1, from: 'oz', to: 'g' },
          { label: '500 g a libras', val: 500, from: 'g', to: 'lb' }
        ]
      },
      temp: {
        units: {
          c: { name: 'Celsius (°C)', toBase: v => v, fromBase: b => b },
          f: { name: 'Fahrenheit (°F)', toBase: v => (v - 32) * (5 / 9), fromBase: b => (b * 9 / 5) + 32 },
          k: { name: 'Kelvin (K)', toBase: v => v - 273.15, fromBase: b => b + 273.15 }
        },
        defaultFrom: 'c',
        defaultTo: 'f',
        presets: [
          { label: '0 °C a °F', val: 0, from: 'c', to: 'f' },
          { label: '37 °C a °F', val: 37, from: 'c', to: 'f' },
          { label: '100 °F a °C', val: 100, from: 'f', to: 'c' },
          { label: '300 K a °C', val: 300, from: 'k', to: 'c' }
        ]
      },
      speed: {
        units: {
          kmh: { name: 'Kilómetros/hora (km/h)', toBase: v => v / 3.6, fromBase: b => b * 3.6 },
          mph: { name: 'Millas/hora (mph)', toBase: v => v * 0.44704, fromBase: b => b / 0.44704 },
          ms: { name: 'Metros/segundo (m/s)', toBase: v => v, fromBase: b => b },
          knots: { name: 'Nudos (knots)', toBase: v => v * 0.514444, fromBase: b => b / 0.514444 }
        },
        defaultFrom: 'kmh',
        defaultTo: 'mph',
        presets: [
          { label: '100 km/h a mph', val: 100, from: 'kmh', to: 'mph' },
          { label: '60 mph a km/h', val: 60, from: 'mph', to: 'kmh' },
          { label: '120 km/h a m/s', val: 120, from: 'kmh', to: 'ms' },
          { label: '25 nudos a km/h', val: 25, from: 'knots', to: 'kmh' }
        ]
      },
      volume: {
        units: {
          ml: { name: 'Mililitros (ml)', toBase: v => v / 1000, fromBase: b => b * 1000 },
          l: { name: 'Litros (l)', toBase: v => v, fromBase: b => b },
          m3: { name: 'Metros cúbicos (m³)', toBase: v => v * 1000, fromBase: b => b / 1000 },
          gal: { name: 'Galones US (gal)', toBase: v => v * 3.78541, fromBase: b => b / 3.78541 },
          floz: { name: 'Onzas líquidas (fl oz)', toBase: v => v * 0.0295735, fromBase: b => b / 0.0295735 },
          cups: { name: 'Tazas de cocina (cups)', toBase: v => v * 0.24, fromBase: b => b / 0.24 }
        },
        defaultFrom: 'gal',
        defaultTo: 'l',
        presets: [
          { label: '1 galón a litros', val: 1, from: 'gal', to: 'l' },
          { label: '1 litro a tazas', val: 1, from: 'l', to: 'cups' },
          { label: '12 fl oz a ml', val: 12, from: 'floz', to: 'ml' },
          { label: '5 litros a galones', val: 5, from: 'l', to: 'gal' }
        ]
      }
    };

    let currentCat = 'length';

    function populateSelects(catKey: string, forceFrom?: string, forceTo?: string) {
      const cat = categories[catKey];
      if (!cat) return;

      selectFrom.innerHTML = '';
      selectTo.innerHTML = '';

      Object.entries(cat.units).forEach(([k, def]) => {
        const optFrom = new Option(def.name, k);
        const optTo = new Option(def.name, k);
        selectFrom.add(optFrom);
        selectTo.add(optTo);
      });

      selectFrom.value = forceFrom || cat.defaultFrom;
      selectTo.value = forceTo || cat.defaultTo;

      renderPresets(catKey);
      convert();
    }

    function renderPresets(catKey: string) {
      if (!presetsContainer) return;
      presetsContainer.innerHTML = '';
      const cat = categories[catKey];
      if (!cat) return;

      cat.presets.forEach(p => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'preset-chip-btn';
        btn.textContent = p.label;
        btn.addEventListener('click', () => {
          inputAmount.value = p.val.toString();
          selectFrom.value = p.from;
          selectTo.value = p.to;
          convert();
        });
        presetsContainer.appendChild(btn);
      });
    }

    function convert() {
      const val = parseFloat(inputAmount.value);
      if (isNaN(val)) {
        outputAmount.value = '';
        if (formulaDisplay) formulaDisplay.textContent = 'Introduce una cantidad válida.';
        return;
      }

      const cat = categories[currentCat];
      const fromUnit = cat.units[selectFrom.value];
      const toUnit = cat.units[selectTo.value];

      if (!fromUnit || !toUnit) return;

      const baseVal = fromUnit.toBase(val);
      const resVal = toUnit.fromBase(baseVal);

      // Clean decimals
      let displayRes = '';
      if (Math.abs(resVal) < 0.000001 && resVal !== 0) {
        displayRes = resVal.toExponential(4);
      } else if (Number.isInteger(resVal)) {
        displayRes = resVal.toLocaleString('es-ES');
      } else {
        displayRes = parseFloat(resVal.toFixed(6)).toLocaleString('es-ES', { maximumFractionDigits: 6 });
      }

      outputAmount.value = displayRes;

      // Update formula display
      if (formulaDisplay) {
        const sampleBase = fromUnit.toBase(1);
        const sampleRes = toUnit.fromBase(sampleBase);
        const formattedSample = parseFloat(sampleRes.toFixed(4)).toLocaleString('es-ES', { maximumFractionDigits: 4 });
        formulaDisplay.textContent = `Equivalencia directa: 1 ${fromUnit.name.split(' (')[0]} = ${formattedSample} ${toUnit.name.split(' (')[0]}`;
      }
    }

    catTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        catTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentCat = tab.getAttribute('data-cat') || 'length';
        populateSelects(currentCat);
      });
    });

    [inputAmount, selectFrom, selectTo].forEach(el => {
      el.addEventListener('input', convert);
      el.addEventListener('change', convert);
    });

    btnSwap?.addEventListener('click', () => {
      const prevFrom = selectFrom.value;
      selectFrom.value = selectTo.value;
      selectTo.value = prevFrom;
      convert();
    });

    btnCopy?.addEventListener('click', async () => {
      if (!outputAmount.value) return;
      try {
        await navigator.clipboard.writeText(outputAmount.value);
        const orig = btnCopy.textContent;
        btnCopy.textContent = '✅';
        setTimeout(() => {
          btnCopy.textContent = orig;
        }, 1200);
      } catch (e) {}
    });

    populateSelects('length');
  }

  document.addEventListener('astro:page-load', initUnitConverter);
</script>
