---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Calculadora de Porcentajes Completa', url: '/herramientas/calculadora-porcentajes' }
];

const faqs = [
  {
    question: '¿Cómo se calcula el porcentaje de una cantidad rápidamente?',
    answer: 'Para calcular el X% de una cantidad, multiplica dicha cantidad por el porcentaje y divídela entre 100. Por ejemplo, para calcular el 20% de 80: (80 × 20) / 100 = 16.'
  },
  {
    question: '¿Cómo calcular el porcentaje de descuento en una tienda?',
    answer: 'Si un producto cuesta 50 € y tiene un 30% de descuento, multiplica 50 × 0,30 = 15 € de ahorro. El precio final a pagar será 50 - 15 = 35 €.'
  },
  {
    question: '¿Qué es la diferencia o variación porcentual?',
    answer: 'Indica cuánto ha aumentado o disminuido un valor respecto a su cantidad inicial. La fórmula es: ((Valor Final - Valor Inicial) / Valor Inicial) × 100.'
  },
  {
    question: '¿Cuál es el truco mental para calcular el 10% y el 1%?',
    answer: 'Para el 10%, simplemente corre la coma decimal un lugar hacia la izquierda (el 10% de 250 es 25). Para el 1%, corre la coma dos lugares hacia la izquierda (el 1% de 250 es 2,5).'
  }
];
---

<BaseLayout
  title="Calculadora de Porcentajes Online Rápida y Gratuita | GuiaTecnEs"
  description="Calcula el porcentaje de una cantidad, descuentos de compras, aumentos de precio y variación porcentual con fórmulas y ejemplos paso a paso."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Calculadora de Porcentajes</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🧮 Matemáticas, Compras & Finanzas</div>
      <h1>Calculadora de Porcentajes Completa</h1>
      <p class="tool-subtitle">
        Resuelve cualquier cálculo de porcentajes al instante: descuentos en tiendas, porcentajes de una cifra, subidas de precio y regla de tres con explicaciones paso a paso.
      </p>
    </header>

    <div class="percent-calc-grid">
      <!-- MODO 1: ¿Cuánto es el X% de Y? -->
      <div class="card calc-card">
        <div class="calc-card-header">
          <span class="badge-num">1</span>
          <h3>¿Cuánto es el X% de una cantidad?</h3>
        </div>
        <p class="calc-sub">Ideal para calcular propinas, impuestos o descuentos.</p>

        <div class="calc-form-flex">
          <div class="input-inline">
            <span>¿Cuánto es el</span>
            <input type="number" id="c1-percent" value="15" min="0" step="any" />
            <span>%</span>
          </div>
          <div class="input-inline">
            <span>de</span>
            <input type="number" id="c1-amount" value="250" min="0" step="any" />
            <span>?</span>
          </div>
        </div>

        <div class="result-box">
          <span class="res-label">Resultado:</span>
          <div class="res-num" id="c1-result">37.5</div>
          <span class="res-formula" id="c1-formula">Fórmula: (250 × 15) / 100 = 37.5</span>
        </div>
      </div>

      <!-- MODO 2: ¿Qué porcentaje representa X de Y? -->
      <div class="card calc-card">
        <div class="calc-card-header">
          <span class="badge-num">2</span>
          <h3>¿Qué porcentaje representa X de Y?</h3>
        </div>
        <p class="calc-sub">Averigua qué parte proporcional representa un número respecto al total.</p>

        <div class="calc-form-flex">
          <div class="input-inline">
            <span>El número</span>
            <input type="number" id="c2-part" value="45" min="0" step="any" />
          </div>
          <div class="input-inline">
            <span>respecto al total de</span>
            <input type="number" id="c2-total" value="180" min="0" step="any" />
            <span>es:</span>
          </div>
        </div>

        <div class="result-box">
          <span class="res-label">Resultado:</span>
          <div class="res-num" id="c2-result">25%</div>
          <span class="res-formula" id="c2-formula">Fórmula: (45 / 180) × 100 = 25%</span>
        </div>
      </div>

      <!-- MODO 3: Aumento o Disminución Porcentual -->
      <div class="card calc-card full-width-card">
        <div class="calc-card-header">
          <span class="badge-num">3</span>
          <h3>Porcentaje de Aumento o Disminución (Variación)</h3>
        </div>
        <p class="calc-sub">Comprueba la subida de un precio, inflación o pérdida respecto a un valor anterior.</p>

        <div class="calc-form-flex">
          <div class="input-inline">
            <span>Valor inicial:</span>
            <input type="number" id="c3-initial" value="80" min="0" step="any" />
          </div>
          <div class="input-inline">
            <span>Valor final:</span>
            <input type="number" id="c3-final" value="100" min="0" step="any" />
          </div>
        </div>

        <div class="result-box">
          <span class="res-label">Variación:</span>
          <div class="res-num" id="c3-result">+25%</div>
          <span class="res-formula" id="c3-formula">Diferencia: +20 | Aumento del 25%</span>
        </div>
      </div>
    </div>

    <!-- SEO GUIDE -->
    <section class="seo-guide-section card">
      <h2>Trucos para calcular porcentajes de cabeza sin calculadora</h2>
      <div class="guide-grid">
        <div class="guide-box">
          <h3>⚡ El truco de la conmutatividad (X% de Y = Y% de X)</h3>
          <p>
            Si calcular el <strong>16% de 25</strong> te parece difícil, inviértelo: calcula el <strong>25% de 16</strong> (que es una cuarta parte de 16 = 4). ¡El resultado es exactamente el mismo!
          </p>
        </div>
        <div class="guide-box">
          <h3>🎯 Descomposición en 10% y 5%</h3>
          <p>
            Para calcular el 15% de 60 €: el 10% es 6 €, y la mitad (el 5%) es 3 €. Sumas ambos y obtienes 9 € de forma instantánea.
          </p>
        </div>
        <div class="guide-box">
          <h3>🛒 Descuentos rápidos del 20% y 50%</h3>
          <p>
            El 50% es siempre dividir entre 2. El 20% es calcular el 10% (quitar un cero o mover la coma) y multiplicar por 2.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section card">
      <h2>Preguntas Frecuentes sobre Porcentajes</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{faq.question}</strong></summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .tool-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .tool-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.25);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .tool-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .percent-calc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 768px) {
    .percent-calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .full-width-card {
    grid-column: 1 / -1;
  }

  .calc-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .badge-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #10b981;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .calc-card-header h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-heading);
  }

  .calc-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .calc-form-flex {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .input-inline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: var(--text-heading);
  }

  .input-inline input {
    width: 95px;
    padding: 0.55rem 0.65rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-color, #334155);
    background: var(--input-bg, #0f172a);
    color: var(--text-heading);
    font-size: 1.1rem;
    font-weight: 700;
    text-align: center;
  }

  .input-inline input:focus {
    outline: none;
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .result-box {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 0.65rem;
    padding: 1rem;
    text-align: center;
  }

  .res-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .res-num {
    font-size: 2.2rem;
    font-weight: 900;
    color: #10b981;
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .res-formula {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: ui-monospace, monospace;
  }

  /* SEO GUIDE & FAQ */
  .seo-guide-section {
    margin-bottom: 2rem;
  }

  .seo-guide-section h2, .faq-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 1rem;
  }

  .seo-guide-section p {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color, #334155);
    padding: 1.25rem;
    border-radius: 0.75rem;
  }

  .guide-box h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .guide-box p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .faq-section {
    margin-bottom: 2rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.65rem;
    padding: 0.85rem 1.15rem;
  }

  .faq-question {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-heading);
  }

  .faq-answer {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>

<script>
  function initPercentCalculator() {
    // Mode 1: X% of Y
    const c1Percent = document.getElementById('c1-percent') as HTMLInputElement;
    const c1Amount = document.getElementById('c1-amount') as HTMLInputElement;
    const c1Result = document.getElementById('c1-result');
    const c1Formula = document.getElementById('c1-formula');

    // Mode 2: X of Y = ?%
    const c2Part = document.getElementById('c2-part') as HTMLInputElement;
    const c2Total = document.getElementById('c2-total') as HTMLInputElement;
    const c2Result = document.getElementById('c2-result');
    const c2Formula = document.getElementById('c2-formula');

    // Mode 3: Increase/Decrease
    const c3Initial = document.getElementById('c3-initial') as HTMLInputElement;
    const c3Final = document.getElementById('c3-final') as HTMLInputElement;
    const c3Result = document.getElementById('c3-result');
    const c3Formula = document.getElementById('c3-formula');

    function calc1() {
      const p = parseFloat(c1Percent.value) || 0;
      const a = parseFloat(c1Amount.value) || 0;
      const res = (a * p) / 100;
      if (c1Result) c1Result.textContent = Number(res.toFixed(2)).toLocaleString('es-ES');
      if (c1Formula) c1Formula.textContent = `Fórmula: (${a} × ${p}) / 100 = ${res.toFixed(2)}`;
    }

    function calc2() {
      const part = parseFloat(c2Part.value) || 0;
      const total = parseFloat(c2Total.value) || 0;
      if (total === 0) {
        if (c2Result) c2Result.textContent = '0%';
        return;
      }
      const pct = (part / total) * 100;
      if (c2Result) c2Result.textContent = `${Number(pct.toFixed(2)).toLocaleString('es-ES')}%`;
      if (c2Formula) c2Formula.textContent = `Fórmula: (${part} / ${total}) × 100 = ${pct.toFixed(2)}%`;
    }

    function calc3() {
      const init = parseFloat(c3Initial.value) || 0;
      const fin = parseFloat(c3Final.value) || 0;
      if (init === 0) {
        if (c3Result) c3Result.textContent = '0%';
        return;
      }
      const diff = fin - init;
      const pct = (diff / init) * 100;
      const sign = pct > 0 ? '+' : '';
      const label = pct > 0 ? 'Aumento' : (pct < 0 ? 'Disminución' : 'Sin cambio');

      if (c3Result) {
        c3Result.textContent = `${sign}${Number(pct.toFixed(2)).toLocaleString('es-ES')}%`;
        c3Result.style.color = pct > 0 ? '#10b981' : (pct < 0 ? '#ef4444' : 'inherit');
      }
      if (c3Formula) {
        c3Formula.textContent = `Diferencia: ${diff > 0 ? '+' : ''}${diff.toFixed(2)} | ${label} del ${Math.abs(pct).toFixed(2)}%`;
      }
    }

    [c1Percent, c1Amount].forEach(el => el?.addEventListener('input', calc1));
    [c2Part, c2Total].forEach(el => el?.addEventListener('input', calc2));
    [c3Initial, c3Final].forEach(el => el?.addEventListener('input', calc3));

    calc1();
    calc2();
    calc3();
  }

  document.addEventListener('astro:page-load', initPercentCalculator);
</script>
