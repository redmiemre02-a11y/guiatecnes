---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LegalDisclaimer from '../../components/LegalDisclaimer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas/' },
  { name: 'Comparador de Tarifas de Fibra y Móvil España 2026', url: '/herramientas/comparador-tarifas-fibra-movil/' }
];

const faqs = [
  {
    question: '¿Qué operadora usa la mejor cobertura de fibra en España?',
    answer: 'La red de fibra óptica con mayor despliegue nacional pertenece a Movistar (usada también por O2 y parcialmente por Digi en cobertura indirecta NEBA), seguida de las redes propias de Orange/MasOrange (usada por Jazztel, Simyo y Pepephone en ciertas zonas) y Vodafone (usada por Lowi). Digi también dispone de Fibra SMART propia a precios muy reducidos en grandes ciudades.'
  },
  {
    question: '¿Qué significa que una tarifa no tenga permanencia?',
    answer: 'Significa que puedes darte de baja o hacer una portabilidad a otra compañía en cualquier momento sin pagar penalizaciones económicas. Algunas operadoras como Digi o Lowi aplican un breve compromiso de 3 meses en fibra por costes de instalación, mientras que O2 o Pepephone ofrecen 0 meses de permanencia desde el primer día.'
  },
  {
    question: '¿Cuánto cuesta realmente una tarifa al año contando subidas promocionales?',
    answer: 'Muchas grandes operadoras anuncian precios gancho durante los primeros 3 o 12 meses y luego suben la cuota un 30% o 40%. Nuestro comparador calcula el coste total acumulado a 12 meses para que veas el gasto real y no caigas en letra pequeña.'
  },
  {
    question: '¿Necesito realmente 1 Gbps de fibra o me basta con 300 Mbps?',
    answer: 'Para el 90% de los hogares (teletrabajo, streaming 4K en 2 televisores y juegos online), 300 Mbps o 600 Mbps simétricos son más que suficientes. Solo notarás diferencia con 1 Gbps si descargas archivos pesados de decenas de gigas a diario o compartes piso entre más de 5 personas conectadas por cable Ethernet.'
  }
];
---

<BaseLayout
  title="Comparador de Tarifas de Fibra y Móvil España 2026 | Sin Permanencia y Precio Real"
  description="Compara al instante las tarifas de fibra y móvil en España (Digi, O2, Lowi, Pepephone, Simyo, Movistar, Vodafone). Filtra por GB, velocidad, red y permanencia."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas/">Herramientas</a>
      <span>›</span>
      <span>Comparador Fibra y Móvil 2026</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">📡 Comparador Telecom España 2026</div>
      <h1>Comparador Inteligente de Fibra y Móvil</h1>
      <p class="tool-subtitle">
        Filtra por velocidad de fibra, datos móviles, cobertura real y permanencia para descubrir cuánto pagarás al año sin trampas promocionales.
      </p>
    </header>

    <!-- FILTERS PANEL -->
    <section class="filters-card card">
      <div class="filters-grid">
        <div class="filter-group">
          <label for="f-speed">Velocidad de Fibra Mínima</label>
          <select id="f-speed">
            <option value="0">Cualquiera (300 Mb+)</option>
            <option value="500">500 / 600 Mbps+</option>
            <option value="1000">1 Gbps (1.000 Mbps)</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="f-gb">Datos Móviles Mínimos</label>
          <select id="f-gb">
            <option value="0">Cualquier cantidad</option>
            <option value="30">30 GB o más</option>
            <option value="50">50 GB o más</option>
            <option value="100">100 GB o Ilimitados</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="f-net">Red / Cobertura</label>
          <select id="f-net">
            <option value="all">Todas las redes</option>
            <option value="Movistar">Red Movistar</option>
            <option value="Orange">Red Orange / MasOrange</option>
            <option value="Vodafone">Red Vodafone</option>
            <option value="Digi SMART">Fibra Propia Digi SMART</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="f-perm">Permanencia Máxima</label>
          <select id="f-perm">
            <option value="99">Todas</option>
            <option value="0">0 meses (Sin permanencia)</option>
            <option value="3">Hasta 3 meses</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="f-sort">Ordenar Por</label>
          <select id="f-sort">
            <option value="price-asc">Menor precio mensual</option>
            <option value="annual-asc">Menor coste anual (12 meses)</option>
            <option value="speed-desc">Mayor velocidad de fibra</option>
          </select>
        </div>
      </div>

      <div class="results-summary-bar">
        <span>Mostrando <strong id="res-count">0</strong> tarifas optimizadas</span>
        <button type="button" id="btn-reset-filters" class="btn-sm">Restablecer filtros</button>
      </div>
    </section>

    <!-- RESULTS GRID -->
    <section id="tariffs-list" class="tariffs-grid"></section>

    <!-- SAVINGS CALCULATOR -->
    <section class="savings-box card">
      <h2>💶 ¿Cuánto dinero ahorrarías cambiando de operadora?</h2>
      <p class="panel-desc">Introduce lo que pagas actualmente al mes por tu internet y móvil para calcular tu ahorro anual.</p>
      <div class="savings-input-row">
        <label for="current-bill">Tu factura mensual actual (€/mes):</label>
        <input type="number" id="current-bill" value="65" min="15" max="250" step="1" />
      </div>
      <div id="savings-result" class="savings-result"></div>
    </section>

    <LegalDisclaimer />

    <section class="seo-guide card">
      <h2>Claves para elegir la mejor tarifa de fibra y móvil en España</h2>
      <p>
        El mercado español de telecomunicaciones se divide en cuatro grandes infraestructuras físicas: <strong>Movistar, Orange/MasOrange, Vodafone y la red propia SMART de Digi</strong>. Las llamadas operadoras <em>low-cost</em> (O2, Lowi, Pepephone, Simyo) utilizan exactamente las mismas antenas y cables que sus matrices, pero eliminan servicios extra como televisión de pago obligatoria o tiendas físicas para ofrecer precios definitivos sin subidas sorpresa.
      </p>
      <ul>
        <li><strong>Fibra simétrica:</strong> Asegúrate de que ofrece la misma velocidad de subida y bajada; hoy en día es imprescindible para videollamadas y copias en la nube.</li>
        <li><strong>CG-NAT vs IP Pública:</strong> Algunas compañías baratas como Digi usan CG-NAT por defecto. Si necesitas abrir puertos para servidores, cámaras IP o juegos, consulta si permiten desactivarlo o contratar IP fija.</li>
        <li><strong>Datos acumulables:</strong> Operadoras como Lowi, Pepephone y Simyo permiten guardar los gigas que no gastes este mes para sumarlos al mes siguiente.</li>
      </ul>

      <h3>Preguntas Frecuentes</h3>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    const tariffs = [
      {
        operator: 'Digi',
        name: 'Fibra SMART 600 Mb + 50 GB',
        speed: 600,
        gb: 50,
        gbLabel: '50 GB acumulables',
        network: 'Digi SMART',
        mobileNet: 'Cobertura Movistar',
        permanence: 3,
        monthlyPrice: 25,
        promoMonths: 0,
        promoPrice: 25,
        routerIncluded: true,
        highlight: 'Mejor Precio Calidad',
        badgeColor: '#0ea5e9',
        notes: 'Solo disponible en zonas con fibra propia SMART. CG-NAT desactivable (+1 €/mes).'
      },
      {
        operator: 'Digi',
        name: 'Fibra 300 Mb + 30 GB (Cobertura Nacional)',
        speed: 300,
        gb: 30,
        gbLabel: '30 GB acumulables',
        network: 'Movistar',
        mobileNet: 'Cobertura Movistar',
        permanence: 3,
        monthlyPrice: 30,
        promoMonths: 0,
        promoPrice: 30,
        routerIncluded: true,
        highlight: 'Disponible en toda España',
        badgeColor: '#0284c7',
        notes: 'Utiliza red indirecta de Movistar (NEBA) con instalación gratuita.'
      },
      {
        operator: 'Lowi',
        name: 'Fibra 600 Mb + 50 GB 5G',
        speed: 600,
        gb: 50,
        gbLabel: '50 GB acumulables',
        network: 'Vodafone',
        mobileNet: 'Cobertura Vodafone 5G',
        permanence: 3,
        monthlyPrice: 30,
        promoMonths: 0,
        promoPrice: 30,
        routerIncluded: true,
        highlight: 'Gigas acumulables',
        badgeColor: '#e11d48',
        notes: 'Permite compartir megas con otros usuarios Lowi y acumular datos no gastados.'
      },
      {
        operator: 'O2',
        name: 'Fibra 600 Mb + 35 GB 5G+',
        speed: 600,
        gb: 35,
        gbLabel: '35 GB 5G+',
        network: 'Movistar',
        mobileNet: 'Cobertura Movistar 5G+',
        permanence: 0,
        monthlyPrice: 35,
        promoMonths: 0,
        promoPrice: 35,
        routerIncluded: true,
        highlight: '0 Permanencia · Red Movistar',
        badgeColor: '#2563eb',
        notes: 'Incluye teléfono fijo con llamadas ilimitadas y cero permanencia desde el día 1.'
      },
      {
        operator: 'O2',
        name: 'Fibra 1 Gbps + 120 GB 5G+',
        speed: 1000,
        gb: 120,
        gbLabel: '120 GB 5G+',
        network: 'Movistar',
        mobileNet: 'Cobertura Movistar 5G+',
        permanence: 0,
        monthlyPrice: 50,
        promoMonths: 0,
        promoPrice: 50,
        routerIncluded: true,
        highlight: 'Máxima Estabilidad',
        badgeColor: '#1d4ed8',
        notes: 'Ideal para teletrabajo exigente, gaming sin CG-NAT y familias con alto consumo.'
      },
      {
        operator: 'Simyo',
        name: 'Fibra 500 Mb + 50 GB',
        speed: 500,
        gb: 50,
        gbLabel: '50 GB acumulables',
        network: 'Orange',
        mobileNet: 'Cobertura Orange 5G',
        permanence: 3,
        monthlyPrice: 31.99,
        promoMonths: 0,
        promoPrice: 31.99,
        routerIncluded: true,
        highlight: 'Flexible a medida',
        badgeColor: '#f97316',
        notes: 'Gigas acumulables durante 3 meses y cobertura 5G de Orange.'
      },
      {
        operator: 'Pepephone',
        name: 'Fibra 600 Mb + 50 GB + Netflix',
        speed: 600,
        gb: 50,
        gbLabel: '50 GB acumulables',
        network: 'Orange',
        mobileNet: 'Cobertura Yoigo / Orange',
        permanence: 0,
        monthlyPrice: 42,
        promoMonths: 0,
        promoPrice: 42,
        routerIncluded: true,
        highlight: 'Sin permanencia + Atención top',
        badgeColor: '#dc2626',
        notes: 'Incluye suscripción básica de Netflix y baja el precio por cada año de antigüedad.'
      },
      {
        operator: 'Digi',
        name: 'Fibra SMART 1 Gbps + Ilimitados',
        speed: 1000,
        gb: 999,
        gbLabel: 'Datos Ilimitados',
        network: 'Digi SMART',
        mobileNet: 'Cobertura Movistar',
        permanence: 3,
        monthlyPrice: 30,
        promoMonths: 0,
        promoPrice: 30,
        routerIncluded: true,
        highlight: 'Imbatible en 1 Gbps',
        badgeColor: '#0ea5e9',
        notes: 'Solo en edificios con cobertura directa Fibra SMART de Digi.'
      },
      {
        operator: 'Vodafone',
        name: 'Fibra 600 Mb + Móvil Ilimitado',
        speed: 600,
        gb: 999,
        gbLabel: 'Datos Ilimitados 5G',
        network: 'Vodafone',
        mobileNet: 'Cobertura Vodafone 5G',
        permanence: 12,
        monthlyPrice: 54,
        promoMonths: 12,
        promoPrice: 45,
        routerIncluded: true,
        highlight: 'Con permanencia 12m',
        badgeColor: '#b91c1c',
        notes: 'Precio promocional 45 €/mes el primer año; luego pasa a tarifa estándar.'
      },
      {
        operator: 'Movistar',
        name: 'miMovistar Base 600 Mb + 50 GB',
        speed: 600,
        gb: 50,
        gbLabel: '50 GB 5G+',
        network: 'Movistar',
        mobileNet: 'Cobertura Movistar 5G+',
        permanence: 0,
        monthlyPrice: 53,
        promoMonths: 0,
        promoPrice: 53,
        routerIncluded: true,
        highlight: 'Sin permanencia + TV Básica',
        badgeColor: '#1e40af',
        notes: 'Incluye router Smart WiFi, teléfono fijo y paquete Movistar Plus+ básico.'
      }
    ];

    const els = {
      speed: document.getElementById('f-speed'),
      gb: document.getElementById('f-gb'),
      net: document.getElementById('f-net'),
      perm: document.getElementById('f-perm'),
      sort: document.getElementById('f-sort'),
      list: document.getElementById('tariffs-list'),
      count: document.getElementById('res-count'),
      bill: document.getElementById('current-bill'),
      savings: document.getElementById('savings-result')
    };

    function getAnnualCost(t) {
      if (t.promoMonths > 0) {
        const promoM = Math.min(12, t.promoMonths);
        const stdM = 12 - promoM;
        return promoM * t.promoPrice + stdM * t.monthlyPrice;
      }
      return t.monthlyPrice * 12;
    }

    function render() {
      const minSpeed = Number(els.speed.value);
      const minGb = Number(els.gb.value);
      const net = els.net.value;
      const maxPerm = Number(els.perm.value);
      const sortMode = els.sort.value;

      let filtered = tariffs.filter(t => {
        if (t.speed < minSpeed) return false;
        if (t.gb < minGb) return false;
        if (net !== 'all' && t.network !== net) return false;
        if (t.permanence > maxPerm) return false;
        return true;
      });

      filtered.sort((a, b) => {
        if (sortMode === 'price-asc') {
          const pa = a.promoMonths > 0 ? a.promoPrice : a.monthlyPrice;
          const pb = b.promoMonths > 0 ? b.promoPrice : b.monthlyPrice;
          return pa - pb;
        }
        if (sortMode === 'annual-asc') return getAnnualCost(a) - getAnnualCost(b);
        if (sortMode === 'speed-desc') return b.speed - a.speed;
        return 0;
      });

      els.count.textContent = filtered.length;

      if (filtered.length === 0) {
        els.list.innerHTML = `<div class="empty-state card">No hay tarifas exactas con esta combinación de filtros. Prueba a ampliar la permanencia o cambiar de red.</div>`;
      } else {
        els.list.innerHTML = filtered.map(t => {
          const displayPrice = t.promoMonths > 0 ? t.promoPrice : t.monthlyPrice;
          const annual = getAnnualCost(t);
          return `
            <article class="tariff-card">
              <div class="tariff-top">
                <div>
                  <span class="op-tag" style="background:${t.badgeColor}">${t.operator}</span>
                  <span class="hl-tag">${t.highlight}</span>
                </div>
                <div class="price-col">
                  <span class="price-big">${displayPrice.toFixed(2).replace('.00','')} €<small>/mes</small></span>
                  <span class="annual-sub">Coste 12 meses: <strong>${annual.toFixed(0)} €</strong></span>
                </div>
              </div>
              <h3>${t.name}</h3>
              <div class="specs-pills">
                <span>⚡ ${t.speed >= 1000 ? '1 Gbps' : t.speed + ' Mbps'} Fibra Simétrica</span>
                <span>📱 ${t.gbLabel}</span>
                <span>📡 Red ${t.network}</span>
                <span>🔓 ${t.permanence === 0 ? 'Sin permanencia' : t.permanence + ' meses perm.'}</span>
              </div>
              <p class="tariff-note">${t.notes}</p>
            </article>
          `;
        }).join('');
      }

      updateSavings(filtered);
    }

    function updateSavings(filtered) {
      const current = Number(els.bill.value) || 0;
      const pool = filtered.length > 0 ? filtered : tariffs;
      const cheapest = pool.reduce((min, t) => getAnnualCost(t) < getAnnualCost(min) ? t : min, pool[0]);
      const cheapestAnnual = getAnnualCost(cheapest);
      const currentAnnual = current * 12;
      const diff = currentAnnual - cheapestAnnual;

      if (diff > 0) {
        els.savings.innerHTML = `Cambiando a <strong>${cheapest.operator} (${cheapest.name})</strong> ahorrarías <span class="save-green">${diff.toFixed(0)} € al año</span> (${(diff/12).toFixed(1)} €/mes menos).`;
      } else {
        els.savings.innerHTML = `Tu tarifa actual de <strong>${current} €/mes</strong> ya es muy competitiva frente a las opciones filtradas.`;
      }
    }

    [els.speed, els.gb, els.net, els.perm, els.sort].forEach(el => el.addEventListener('change', render));
    els.bill.addEventListener('input', render);

    document.getElementById('btn-reset-filters').addEventListener('click', () => {
      els.speed.value = '0';
      els.gb.value = '0';
      els.net.value = 'all';
      els.perm.value = '99';
      els.sort.value = 'price-asc';
      render();
    });

    render();
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 980px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; flex-wrap: wrap; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(14, 165, 233, 0.14); color: #38bdf8; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; border: 1px solid rgba(14, 165, 233, 0.28); }
  .tool-header h1 { font-size: clamp(1.75rem, 3.5vw, 2.4rem); line-height: 1.2; margin-bottom: 0.75rem; }
  .tool-subtitle { color: var(--text-muted); font-size: 1.05rem; max-width: 720px; margin: 0 auto; line-height: 1.6; }

  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  .filters-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
  .filter-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .filter-group label { font-size: 0.82rem; font-weight: 600; color: var(--text-muted); }
  .filter-group select, .savings-input-row input { background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: 0.55rem 0.75rem; font-size: 0.92rem; }

  .results-summary-bar { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 0.9rem; font-size: 0.92rem; color: var(--text-muted); }
  .btn-sm { background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 0.35rem 0.75rem; border-radius: 6px; cursor: pointer; font-size: 0.82rem; }

  .tariffs-grid { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.75rem; }
  .tariff-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.35rem; transition: border-color 0.2s; }
  .tariff-card:hover { border-color: var(--primary); }
  .tariff-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.65rem; }
  .op-tag { color: #fff; font-weight: 700; font-size: 0.78rem; padding: 0.25rem 0.65rem; border-radius: 6px; text-transform: uppercase; margin-right: 0.4rem; }
  .hl-tag { background: var(--bg); border: 1px solid var(--border); color: var(--text-muted); font-size: 0.78rem; padding: 0.22rem 0.6rem; border-radius: 6px; font-weight: 600; }

  .price-col { text-align: right; }
  .price-big { font-size: 1.65rem; font-weight: 800; color: var(--primary); display: block; line-height: 1.1; }
  .price-big small { font-size: 0.85rem; font-weight: 500; color: var(--text-muted); }
  .annual-sub { font-size: 0.8rem; color: var(--text-muted); }

  .tariff-card h3 { font-size: 1.18rem; margin-bottom: 0.75rem; }
  .specs-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem; }
  .specs-pills span { background: var(--bg); border: 1px solid var(--border); padding: 0.3rem 0.65rem; border-radius: 8px; font-size: 0.83rem; font-weight: 500; }
  .tariff-note { font-size: 0.86rem; color: var(--text-muted); margin: 0; line-height: 1.45; }

  .savings-box h2 { font-size: 1.25rem; margin-bottom: 0.4rem; }
  .panel-desc { color: var(--text-muted); margin-bottom: 1rem; font-size: 0.94rem; }
  .savings-input-row { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .savings-result { background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); padding: 1rem; border-radius: 10px; font-size: 1rem; }
  .save-green { color: #10b981; font-weight: 800; font-size: 1.15rem; }

  .seo-guide h2 { font-size: 1.35rem; margin-bottom: 0.9rem; }
  .seo-guide h3 { font-size: 1.15rem; margin: 1.5rem 0 0.85rem; }
  .seo-guide p, .seo-guide ul { color: var(--text-muted); line-height: 1.65; }
  .seo-guide ul { padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.95rem 1.1rem; }
  .faq-item summary { font-weight: 600; cursor: pointer; color: var(--text); }
  .faq-item p { margin: 0.7rem 0 0; font-size: 0.93rem; }
</style>
