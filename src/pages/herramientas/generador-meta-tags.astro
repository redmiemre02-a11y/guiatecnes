---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Generador y Previsualizador de Open Graph Meta Tags', url: '/herramientas/generador-meta-tags' }
];

const faqs = [
  {
    question: '¿Qué son las etiquetas Open Graph y Twitter Cards?',
    answer: 'El protocolo Open Graph (creado originalmente por Facebook y adoptado por LinkedIn, WhatsApp y Telegram) junto a Twitter Cards son metaetiquetas HTML que controlan exactamente qué título, descripción e imagen se muestran cuando alguien comparte tu enlace en redes sociales.'
  },
  {
    question: '¿Cuál es el tamaño recomendado para la imagen og:image?',
    answer: 'El tamaño estándar internacional recomendado es de 1200 × 630 píxeles con una relación de aspecto de 1,91:1. Esto garantiza que la imagen se vea nítida en tarjetas grandes tanto en Twitter/X como en Facebook y WhatsApp.'
  },
  {
    question: '¿Dónde se pegan estas etiquetas en mi página web?',
    answer: 'Debes insertarlas dentro de la sección <head> ... </head> del archivo HTML de tu página web o en la plantilla principal de tu gestor de contenidos (Astro, WordPress, Next.js, etc.).'
  },
  {
    question: '¿Por qué WhatsApp a veces no muestra la imagen de mi enlace?',
    answer: 'WhatsApp almacena en caché la información de los enlaces. Si la imagen pesa más de 300 KB, no tiene protocolo HTTPS seguro o la etiqueta og:image está ausente o mal configurada, WhatsApp mostrará un enlace de texto simple.'
  }
];
---

<BaseLayout
  title="Generador de Meta Tags Open Graph y Twitter Cards con Vista Previa | GuiaTecnEs"
  description="Crea y previsualiza cómo se verá tu enlace en Twitter/X, Facebook, WhatsApp y Google. Genera etiquetas Open Graph y Twitter Cards listas para tu web."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Generador de Meta Tags</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🔍 SEO Técnico, Redes Sociales & Web</div>
      <h1>Generador de Meta Tags Open Graph y Twitter Cards</h1>
      <p class="tool-subtitle">
        Optimiza la apariencia de tus enlaces al compartirlos en redes sociales. Previsualiza el diseño en tiempo real y copia el código HTML.
      </p>
    </header>

    <div class="metatags-layout-grid">
      <!-- FORMULARIO DE ENTRADA -->
      <div class="card form-card">
        <h3>📝 Datos de tu Página Web</h3>

        <div class="input-group">
          <label for="meta-title">Título de la página (máx. 65 caracteres):</label>
          <input type="text" id="meta-title" value="GuiaTecnEs - Noticias de Tecnología y Herramientas Online" maxlength="90" />
        </div>

        <div class="input-group">
          <label for="meta-desc">Descripción (máx. 155 caracteres):</label>
          <textarea id="meta-desc" rows="3" maxlength="200">Aprende tecnología, descubre las mejores herramientas de inteligencia artificial y soluciona errores con guías paso a paso en español.</textarea>
        </div>

        <div class="input-group">
          <label for="meta-url">URL de la página (og:url):</label>
          <input type="url" id="meta-url" value="https://guiatecnes.com/" />
        </div>

        <div class="input-group">
          <label for="meta-image">URL de la imagen de portada (og:image 1200x630):</label>
          <input type="url" id="meta-image" value="https://images.unsplash.com/photo-1518770660439-4636190af475?w=1200&auto=format&fit=crop&q=80" />
        </div>

        <div class="form-row-2">
          <div class="input-group">
            <label for="meta-sitename">Nombre del sitio (og:site_name):</label>
            <input type="text" id="meta-sitename" value="GuiaTecnEs" />
          </div>
          <div class="input-group">
            <label for="meta-twitter-user">Usuario de 𝕏 / Twitter (opcional):</label>
            <input type="text" id="meta-twitter-user" value="@guiatecnes" placeholder="@tuusuario" />
          </div>
        </div>
      </div>

      <!-- VISTA PREVIA SOCIAL EN VIVO -->
      <div class="card preview-card">
        <div class="preview-tabs">
          <button type="button" class="prev-tab active" data-tab="twitter">𝕏 Twitter / X</button>
          <button type="button" class="prev-tab" data-tab="facebook">Facebook / WhatsApp</button>
          <button type="button" class="prev-tab" data-tab="google">Google SERP</button>
        </div>

        <!-- PREVIEWS -->
        <div class="mockup-stage">
          <!-- TWITTER CARD -->
          <div id="mockup-twitter" class="mockup-box twitter-box">
            <div class="twitter-img-wrap">
              <img id="tw-preview-img" src="" alt="Vista previa" />
            </div>
            <div class="twitter-text-wrap">
              <span id="tw-preview-domain" class="card-domain">guiatecnes.com</span>
              <h4 id="tw-preview-title" class="card-title">Título</h4>
              <p id="tw-preview-desc" class="card-desc">Descripción...</p>
            </div>
          </div>

          <!-- FACEBOOK CARD -->
          <div id="mockup-facebook" class="mockup-box facebook-box" style="display: none;">
            <div class="fb-img-wrap">
              <img id="fb-preview-img" src="" alt="Vista previa" />
            </div>
            <div class="fb-text-wrap">
              <span id="fb-preview-domain" class="card-domain">GUIATECNES.COM</span>
              <h4 id="fb-preview-title" class="card-title">Título</h4>
              <p id="fb-preview-desc" class="card-desc">Descripción...</p>
            </div>
          </div>

          <!-- GOOGLE SERP -->
          <div id="mockup-google" class="mockup-box google-box" style="display: none;">
            <div class="google-site-flex">
              <div class="google-favicon">🌐</div>
              <div class="google-site-names">
                <span id="gg-preview-sitename" class="gg-site">GuiaTecnEs</span>
                <span id="gg-preview-url" class="gg-url">https://guiatecnes.com</span>
              </div>
            </div>
            <h4 id="gg-preview-title" class="gg-title">Título de la página</h4>
            <p id="gg-preview-desc" class="gg-desc">Descripción...</p>
          </div>
        </div>

        <!-- CÓDIGO HTML GENERADO -->
        <div class="code-export-section">
          <div class="export-header">
            <span>Código HTML para el &lt;head&gt;:</span>
            <button type="button" id="btn-copy-meta" class="btn-copy-code">📋 Copiar Etiquetas</button>
          </div>
          <pre id="output-meta-code" class="code-output-pre"></pre>
        </div>
      </div>
    </div>

    <!-- SEO GUIDE -->
    <section class="seo-guide-section card">
      <h2>¿Por qué las etiquetas Open Graph aumentan tu tráfico web?</h2>
      <div class="guide-grid">
        <div class="guide-box">
          <h3>📈 Hasta un 40% más de Clics (CTR)</h3>
          <p>
            Los enlaces que muestran una tarjeta grande con imagen atractiva obtienen significativamente más interacciones y retuits que los enlaces de texto planos sin previsualización.
          </p>
        </div>
        <div class="guide-box">
          <h3>🛡️ Control Total de tu Marca</h3>
          <p>
            Evitas que redes sociales como WhatsApp o Facebook elijan al azar un icono o imagen secundaria de tu barra lateral para representar tu artículo.
          </p>
        </div>
        <div class="guide-box">
          <h3>🚀 E-E-A-T y Confianza</h3>
          <p>
            Una previsualización profesional genera credibilidad inmediata entre los usuarios, reduciendo la desconfianza ante posibles enlaces sospechosos o spam.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section card">
      <h2>Preguntas Frecuentes sobre Meta Tags</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{faq.question}</strong></summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    max-width: 1140px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .tool-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .tool-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    background: rgba(6, 182, 212, 0.12);
    color: #06b6d4;
    border: 1px solid rgba(6, 182, 212, 0.25);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .tool-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .metatags-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 900px) {
    .metatags-layout-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 1.25rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.15rem;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-heading);
  }

  input[type="text"], input[type="url"], textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-color, #334155);
    background: var(--input-bg, #0f172a);
    color: var(--text-heading);
    font-family: inherit;
    font-size: 0.95rem;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: #06b6d4;
    box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.2);
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }

  /* PREVIEWS */
  .preview-tabs {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.3rem;
    border-radius: 0.5rem;
  }

  .prev-tab {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.45rem;
    border-radius: 0.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
  }

  .prev-tab.active {
    background: #06b6d4;
    color: #000;
  }

  .mockup-stage {
    margin-bottom: 1.5rem;
  }

  .mockup-box {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid #334155;
    background: #000;
  }

  .twitter-img-wrap, .fb-img-wrap {
    width: 100%;
    aspect-ratio: 1.91;
    overflow: hidden;
    background: #0f172a;
  }

  .twitter-img-wrap img, .fb-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .twitter-text-wrap, .fb-text-wrap {
    padding: 0.85rem;
    background: #15181c;
  }

  .card-domain {
    display: block;
    font-size: 0.75rem;
    color: #71767b;
    margin-bottom: 0.2rem;
  }

  .card-title {
    margin: 0 0 0.3rem 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #e7e9ea;
    line-height: 1.3;
  }

  .card-desc {
    margin: 0;
    font-size: 0.82rem;
    color: #71767b;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* GOOGLE SERP */
  .google-box {
    background: #202124;
    padding: 1.25rem;
    border-radius: 0.75rem;
  }

  .google-site-flex {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .google-favicon {
    font-size: 1.1rem;
  }

  .google-site-names {
    display: flex;
    flex-direction: column;
  }

  .gg-site {
    font-size: 0.8rem;
    font-weight: 600;
    color: #dadce0;
  }

  .gg-url {
    font-size: 0.7rem;
    color: #bdc1c6;
  }

  .gg-title {
    margin: 0 0 0.35rem 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: #8ab4f8;
    line-height: 1.3;
  }

  .gg-desc {
    margin: 0;
    font-size: 0.85rem;
    color: #bdc1c6;
    line-height: 1.45;
  }

  /* CODE EXPORT */
  .code-export-section {
    background: #0b0f19;
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.65rem;
    padding: 1rem;
  }

  .export-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .btn-copy-code {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-heading);
    padding: 0.3rem 0.75rem;
    border-radius: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-copy-code:hover {
    background: #06b6d4;
    color: #000;
    border-color: #06b6d4;
  }

  .code-output-pre {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: #38bdf8;
    white-space: pre-wrap;
    word-break: break-all;
    max-height: 180px;
    overflow-y: auto;
  }

  /* SEO GUIDE & FAQ */
  .seo-guide-section {
    margin-bottom: 2rem;
  }

  .seo-guide-section h2, .faq-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 1rem;
  }

  .seo-guide-section p {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color, #334155);
    padding: 1.25rem;
    border-radius: 0.75rem;
  }

  .guide-box h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .guide-box p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .faq-section {
    margin-bottom: 2rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.65rem;
    padding: 0.85rem 1.15rem;
  }

  .faq-question {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-heading);
  }

  .faq-answer {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>

<script>
  function initMetaGenerator() {
    const inputTitle = document.getElementById('meta-title') as HTMLInputElement;
    const inputDesc = document.getElementById('meta-desc') as HTMLTextAreaElement;
    const inputUrl = document.getElementById('meta-url') as HTMLInputElement;
    const inputImage = document.getElementById('meta-image') as HTMLInputElement;
    const inputSiteName = document.getElementById('meta-sitename') as HTMLInputElement;
    const inputTwitterUser = document.getElementById('meta-twitter-user') as HTMLInputElement;

    // Tabs
    const tabs = document.querySelectorAll('.prev-tab');
    const mockTwitter = document.getElementById('mockup-twitter');
    const mockFb = document.getElementById('mockup-facebook');
    const mockGg = document.getElementById('mockup-google');

    // Twitter elements
    const twImg = document.getElementById('tw-preview-img') as HTMLImageElement;
    const twDomain = document.getElementById('tw-preview-domain');
    const twTitle = document.getElementById('tw-preview-title');
    const twDesc = document.getElementById('tw-preview-desc');

    // FB elements
    const fbImg = document.getElementById('fb-preview-img') as HTMLImageElement;
    const fbDomain = document.getElementById('fb-preview-domain');
    const fbTitle = document.getElementById('fb-preview-title');
    const fbDesc = document.getElementById('fb-preview-desc');

    // Google elements
    const ggSite = document.getElementById('gg-preview-sitename');
    const ggUrl = document.getElementById('gg-preview-url');
    const ggTitle = document.getElementById('gg-preview-title');
    const ggDesc = document.getElementById('gg-preview-desc');

    const outputCode = document.getElementById('output-meta-code');
    const btnCopy = document.getElementById('btn-copy-meta');

    function getDomain(urlStr: string): string {
      try {
        const u = new URL(urlStr.startsWith('http') ? urlStr : 'https://' + urlStr);
        return u.hostname;
      } catch (e) {
        return 'tuweb.com';
      }
    }

    function update() {
      const title = inputTitle.value || 'Título de ejemplo';
      const desc = inputDesc.value || 'Descripción del artículo...';
      const url = inputUrl.value || 'https://tuweb.com';
      const img = inputImage.value || '';
      const siteName = inputSiteName.value || 'Mi Sitio Web';
      const twUser = inputTwitterUser.value || '@usuario';
      const domain = getDomain(url);

      // Twitter
      if (twImg) twImg.src = img;
      if (twDomain) twDomain.textContent = domain;
      if (twTitle) twTitle.textContent = title;
      if (twDesc) twDesc.textContent = desc;

      // Facebook
      if (fbImg) fbImg.src = img;
      if (fbDomain) fbDomain.textContent = domain.toUpperCase();
      if (fbTitle) fbTitle.textContent = title;
      if (fbDesc) fbDesc.textContent = desc;

      // Google
      if (ggSite) ggSite.textContent = siteName;
      if (ggUrl) ggUrl.textContent = url;
      if (ggTitle) ggTitle.textContent = title;
      if (ggDesc) ggDesc.textContent = desc;

      // HTML Code
      const htmlSnippet = `<!-- Etiquetas Primarias HTML -->
<title>${title}</title>
<meta name="title" content="${title}">
<meta name="description" content="${desc}">

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:type" content="website">
<meta property="og:url" content="${url}">
<meta property="og:title" content="${title}">
<meta property="og:description" content="${desc}">
<meta property="og:image" content="${img}">
<meta property="og:site_name" content="${siteName}">

<!-- Twitter / X Cards -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="${url}">
<meta property="twitter:title" content="${title}">
<meta property="twitter:description" content="${desc}">
<meta property="twitter:image" content="${img}">
${twUser ? `<meta property="twitter:creator" content="${twUser}">` : ''}`;

      if (outputCode) outputCode.textContent = htmlSnippet;
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const mode = tab.getAttribute('data-tab');

        if (mockTwitter) mockTwitter.style.display = mode === 'twitter' ? 'block' : 'none';
        if (mockFb) mockFb.style.display = mode === 'facebook' ? 'block' : 'none';
        if (mockGg) mockGg.style.display = mode === 'google' ? 'block' : 'none';
      });
    });

    [inputTitle, inputDesc, inputUrl, inputImage, inputSiteName, inputTwitterUser].forEach(el => {
      el?.addEventListener('input', update);
    });

    btnCopy?.addEventListener('click', () => {
      if (outputCode?.textContent) {
        navigator.clipboard.writeText(outputCode.textContent);
        btnCopy.textContent = '¡Etiquetas Copiadas!';
        setTimeout(() => {
          btnCopy.textContent = '📋 Copiar Etiquetas';
        }, 1800);
      }
    });

    update();
  }

  document.addEventListener('astro:page-load', initMetaGenerator);
</script>
