---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Minificador de Código CSS, HTML y JavaScript', url: '/herramientas/minificador-codigo' }
];

const faqs = [
  {
    question: '¿Qué es minificar código y por qué mejora la velocidad web?',
    answer: 'La minificación consiste en eliminar caracteres innecesarios (espacios en blanco, saltos de línea, tabulaciones y comentarios) sin alterar la funcionalidad del código. Esto reduce el peso en kilobytes de los archivos y acelera el tiempo de carga y renderizado de tu página web (Core Web Vitals).'
  },
  {
    question: '¿Cuál es la diferencia entre minificación y compresión Gzip o Brotli?',
    answer: 'La minificación limpia el código fuente eliminando redundancias sintácticas, mientras que Gzip o Brotli comprimen el archivo a nivel de servidor HTTP mediante algoritmos de compresión binaria. Lo ideal para obtener el máximo rendimiento es aplicar ambas técnicas.'
  },
  {
    question: '¿Es seguro minificar JavaScript o CSS en el navegador?',
    answer: 'Sí. Nuestra herramienta funciona íntegramente en el lado del cliente (en tu propio navegador) mediante expresiones regulares seguras. Tu código nunca se envía a servidores externos, garantizando total privacidad.'
  },
  {
    question: '¿Puedo revertir la minificación después?',
    answer: 'Sí, para volver a hacer el código legible para humanos puedes utilizar un formateador o «beautifier» de código. No obstante, te recomendamos guardar siempre una copia de respaldo de tu código fuente original con comentarios.'
  }
];
---

<BaseLayout
  title="Minificador de Código CSS, HTML y JavaScript Online Gratis | GuiaTecnEs"
  description="Minifica y optimiza tu código CSS, HTML y JS en el navegador. Reduce el peso en KB, elimina comentarios y acelera la velocidad de tu web al instante."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Minificador de Código</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">⚡ Rendimiento & Core Web Vitals</div>
      <h1>Minificador de Código CSS, HTML y JS</h1>
      <p class="tool-subtitle">
        Comprime y limpia hojas de estilo, páginas web y scripts en segundos. Reduce el peso de tus archivos para mejorar el PageSpeed y la experiencia de usuario.
      </p>
    </header>

    <div class="minifier-container">
      <!-- BARRA DE PESTAÑAS Y MODOS -->
      <div class="card toolbar-card">
        <div class="tabs-group">
          <button type="button" class="tab-btn active" data-lang="css">🎨 CSS</button>
          <button type="button" class="tab-btn" data-lang="html">🌐 HTML</button>
          <button type="button" class="tab-btn" data-lang="js">⚡ JavaScript</button>
        </div>

        <div class="options-flex">
          <label class="checkbox-label">
            <input type="checkbox" id="opt-strip-comments" checked />
            <span>Eliminar comentarios</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="opt-preserve-licence" checked />
            <span>Conservar licencias (/*! ... */)</span>
          </label>
          <button type="button" id="btn-load-sample" class="btn-sample">
            📄 Cargar Ejemplo
          </button>
        </div>
      </div>

      <!-- ÁREA DE EDICIÓN DOBLE COLUMNA -->
      <div class="editor-grid">
        <!-- ENTRADA -->
        <div class="card editor-card">
          <div class="editor-header">
            <div class="editor-title">
              <span>📥 Código Original</span>
              <span class="size-badge" id="original-size">0 B</span>
            </div>
            <button type="button" id="btn-clear" class="btn-text-action">Limpiar</button>
          </div>
          <textarea id="input-code" spellcheck="false" placeholder="Pega aquí tu código CSS, HTML o JavaScript..."></textarea>
        </div>

        <!-- SALIDA MINIFICADA -->
        <div class="card editor-card">
          <div class="editor-header">
            <div class="editor-title">
              <span>🚀 Código Minificado</span>
              <span class="size-badge success" id="minified-size">0 B</span>
            </div>
            <span class="savings-tag" id="savings-badge" style="display: none;">0% Ahorro</span>
          </div>
          <textarea id="output-code" readonly spellcheck="false" placeholder="El código comprimido aparecerá aquí..."></textarea>
        </div>
      </div>

      <!-- BOTONES DE ACCIÓN PRINCIPALES -->
      <div class="card actions-card">
        <button type="button" id="btn-minify" class="btn-primary-action">
          <span>⚡</span> Minificar y Optimizar Código
        </button>
        <button type="button" id="btn-copy" class="btn-secondary-action">
          <span>📋</span> Copiar Código
        </button>
        <button type="button" id="btn-download" class="btn-secondary-action">
          <span>💾</span> Descargar Archivo Minificado
        </button>
      </div>
    </div>

    <!-- GUÍA Y CONTENIDO SEO -->
    <section class="seo-guide-section card">
      <h2>¿Por qué la minificación de código es clave para el SEO en 2026?</h2>
      <p>
        Google premia activamente a los sitios web que ofrecen tiempos de respuesta ultrarrápidos mediante las métricas de <strong>Core Web Vitals</strong> (especialmente el LCP o Largest Contentful Paint y el INP o Interaction to Next Paint). Cada kilobyte que tus usuarios descargan en conexiones móviles 4G o 3G inestables marca la diferencia entre una conversión o un abandono inmediato.
      </p>

      <div class="guide-grid">
        <div class="guide-box">
          <h3>📉 Menor Tiempo de Descarga</h3>
          <p>
            Eliminar espacios, comentarios de desarrollo y saltos de línea suele reducir el peso de las hojas de estilo CSS y archivos JavaScript entre un <strong>20% y un 60%</strong>.
          </p>
        </div>
        <div class="guide-box">
          <h3>⚡ Renderizado del DOM Acelerado</h3>
          <p>
            El motor de navegación (Chromium, WebKit o Gecko) parsea y procesa el código en árbol sintáctico (AST) mucho más rápido al no tener que saltar bloques de comentarios redundantes.
          </p>
        </div>
        <div class="guide-box">
          <h3>🔒 100% Privado en tu Navegador</h3>
          <p>
            A diferencia de otras herramientas que envían tus archivos a APIs de terceros, nuestra compresión se realiza en local, protegiendo tus claves privadas o proyectos en desarrollo.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section card">
      <h2>Preguntas Frecuentes sobre la Minificación</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{faq.question}</strong></summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .tool-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .tool-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    background: rgba(14, 165, 233, 0.12);
    color: #0ea5e9;
    border: 1px solid rgba(14, 165, 233, 0.25);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .tool-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .toolbar-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 1rem 1.5rem;
  }

  .tabs-group {
    display: flex;
    gap: 0.4rem;
  }

  .tab-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }

  .tab-btn:hover {
    color: var(--text-heading);
    background: rgba(255, 255, 255, 0.1);
  }

  .tab-btn.active {
    background: #0ea5e9;
    color: #fff;
    border-color: #0ea5e9;
  }

  .options-flex {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .btn-sample {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    padding: 0.4rem 0.8rem;
    border-radius: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-heading);
    cursor: pointer;
    transition: background 0.15s;
  }

  .btn-sample:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  /* EDITORS GRID */
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 860px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .editor-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-heading);
  }

  .size-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
  }

  .size-badge.success {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  .savings-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: #10b981;
    color: #fff;
    animation: popIn 0.3s ease;
  }

  @keyframes popIn {
    0% { transform: scale(0.8); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .btn-text-action {
    background: transparent;
    border: none;
    color: #ef4444;
    font-size: 0.8rem;
    cursor: pointer;
    font-weight: 600;
    padding: 0.2rem 0.4rem;
  }

  .btn-text-action:hover {
    text-decoration: underline;
  }

  textarea {
    width: 100%;
    height: 380px;
    padding: 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-color, #334155);
    background: var(--input-bg, #0b0f19);
    color: #38bdf8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    line-height: 1.5;
    resize: vertical;
    tab-size: 2;
  }

  textarea:focus {
    outline: none;
    border-color: #0ea5e9;
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
  }

  #output-code {
    color: #4ade80;
    background: #080c14;
  }

  /* ACTIONS BAR */
  .actions-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .btn-primary-action {
    background: linear-gradient(135deg, #0ea5e9, #3b82f6);
    color: #fff;
    border: none;
    padding: 0.85rem 2rem;
    border-radius: 0.65rem;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(14, 165, 233, 0.35);
    transition: transform 0.15s, opacity 0.15s;
  }

  .btn-primary-action:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  .btn-secondary-action {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-heading);
    padding: 0.85rem 1.4rem;
    border-radius: 0.65rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }

  .btn-secondary-action:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  /* SEO & GUIDE */
  .seo-guide-section {
    margin-bottom: 2rem;
  }

  .seo-guide-section h2, .faq-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 1rem;
  }

  .seo-guide-section p {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color, #334155);
    padding: 1.25rem;
    border-radius: 0.75rem;
  }

  .guide-box h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .guide-box p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  /* FAQ */
  .faq-section {
    margin-bottom: 2rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.65rem;
    padding: 0.85rem 1.15rem;
  }

  .faq-question {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-heading);
  }

  .faq-answer {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>

<script>
  function initMinifier() {
    const tabs = document.querySelectorAll('.tab-btn');
    const inputCode = document.getElementById('input-code') as HTMLTextAreaElement;
    const outputCode = document.getElementById('output-code') as HTMLTextAreaElement;
    const optStripComments = document.getElementById('opt-strip-comments') as HTMLInputElement;
    const optPreserveLicence = document.getElementById('opt-preserve-licence') as HTMLInputElement;
    const btnSample = document.getElementById('btn-load-sample');
    const btnClear = document.getElementById('btn-clear');
    const btnMinify = document.getElementById('btn-minify');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');

    const originalSizeEl = document.getElementById('original-size');
    const minifiedSizeEl = document.getElementById('minified-size');
    const savingsBadge = document.getElementById('savings-badge');

    let currentLang = 'css';

    const samples: Record<string, string> = {
      css: `/* ====================================================
   Hoja de estilos de ejemplo - GuiaTecnEs
   ==================================================== */

/*! Licencia MIT: Open Source Project 2026 */
body {
  margin: 0px;
  padding: 0px;
  background-color: #0f172a;
  font-family: 'Inter', sans-serif;
  color: #f8fafc;
}

.hero-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}

.btn-primary {
  background: #0ea5e9;
  color: #ffffff;
  padding: 10px 24px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 700;
  transition: all 0.2s ease-in-out;
}

.btn-primary:hover {
  background: #0284c7;
  transform: translateY(-2px);
}`,
      html: `<!DOCTYPE html>
<html lang="es">
<head>
  <!-- Metadatos de la página web -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Sitio Web Optimizado</title>
  <!-- Estilos en línea -->
  <link rel="stylesheet" href="/styles.min.css">
</head>
<body>
  <header class="header">
    <div class="container">
      <h1>Bienvenido a la Web</h1>
      <p>Cargando a máxima velocidad sin código innecesario.</p>
    </div>
  </header>
  <!-- Fin del encabezado -->
</body>
</html>`,
      js: `// Funciones de utilidad frontend
/*! Versión 1.4.0 - Licencia Libre */
function calcularDescuento(precio, tasa) {
  // Verificamos parámetros válidos
  if (precio <= 0 || tasa < 0) {
    return 0;
  }
  
  /* Cálculo final con deducción */
  const resultado = precio - (precio * (tasa / 100));
  return resultado.toFixed(2);
}

console.log("Descuento calculado:", calcularDescuento(150, 20));`
    };

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      return `${(bytes / 1024).toFixed(2)} KB`;
    }

    function minifyCSS(code: string, stripComments: boolean, preserveLicence: boolean): string {
      let res = code;

      // Licencias
      let licenses: string[] = [];
      if (preserveLicence) {
        res = res.replace(/\/\*![\s\S]*?\*\//g, (match) => {
          licenses.push(match);
          return `___LIC_${licenses.length - 1}___`;
        });
      }

      if (stripComments) {
        res = res.replace(/\/\*[\s\S]*?\*\//g, '');
      }

      // Quitar saltos de linea y espacios multiples
      res = res.replace(/\s+/g, ' ');

      // Quitar espacios alrededor de delimitadores
      res = res.replace(/\s*([\{\}\:\;\,\>])\s*/g, '$1');

      // Quitar punto y coma final antes de cerrar llave
      res = res.replace(/;\}/g, '}');

      // Optimizar 0px -> 0
      res = res.replace(/\b0(px|em|rem|%|pt)\b/g, '0');

      // Restaurar licencias
      if (preserveLicence) {
        licenses.forEach((lic, idx) => {
          res = res.replace(`___LIC_${idx}___`, `${lic}\n`);
        });
      }

      return res.trim();
    }

    function minifyHTML(code: string, stripComments: boolean): string {
      let res = code;

      if (stripComments) {
        res = res.replace(/<!--(?!\[if)[\s\S]*?-->/g, '');
      }

      // Quitar espacios entre etiquetas
      res = res.replace(/>\s+</g, '><');
      // Colapsar espacios dentro de texto
      res = res.replace(/\s+/g, ' ');

      return res.trim();
    }

    function minifyJS(code: string, stripComments: boolean, preserveLicence: boolean): string {
      let res = code;

      let licenses: string[] = [];
      if (preserveLicence) {
        res = res.replace(/\/\*![\s\S]*?\*\//g, (match) => {
          licenses.push(match);
          return `___LIC_${licenses.length - 1}___`;
        });
      }

      if (stripComments) {
        // Bloque multilínea
        res = res.replace(/\/\*[\s\S]*?\*\//g, '');
        // Línea simple (cuidado con http:// pero funciona en la mayoría de código sin cadenas)
        res = res.replace(/(^|[^\:])\/\/.*$/gm, '$1');
      }

      // Líneas vacías y sangrías
      res = res.split('\n')
        .map(l => l.trim())
        .filter(l => l.length > 0)
        .join('\n');

      if (preserveLicence) {
        licenses.forEach((lic, idx) => {
          res = res.replace(`___LIC_${idx}___`, lic);
        });
      }

      return res;
    }

    function runMinification() {
      const source = inputCode.value;
      const originalBytes = new TextEncoder().encode(source).length;
      if (originalSizeEl) originalSizeEl.textContent = formatBytes(originalBytes);

      if (!source.trim()) {
        outputCode.value = '';
        if (minifiedSizeEl) minifiedSizeEl.textContent = '0 B';
        if (savingsBadge) savingsBadge.style.display = 'none';
        return;
      }

      const stripComments = optStripComments?.checked ?? true;
      const preserveLicence = optPreserveLicence?.checked ?? true;

      let minified = '';
      if (currentLang === 'css') {
        minified = minifyCSS(source, stripComments, preserveLicence);
      } else if (currentLang === 'html') {
        minified = minifyHTML(source, stripComments);
      } else {
        minified = minifyJS(source, stripComments, preserveLicence);
      }

      outputCode.value = minified;

      const minifiedBytes = new TextEncoder().encode(minified).length;
      if (minifiedSizeEl) minifiedSizeEl.textContent = formatBytes(minifiedBytes);

      if (originalBytes > 0 && minifiedBytes < originalBytes) {
        const savingsPct = (((originalBytes - minifiedBytes) / originalBytes) * 100).toFixed(1);
        if (savingsBadge) {
          savingsBadge.textContent = `${savingsPct}% Ahorro`;
          savingsBadge.style.display = 'inline-block';
        }
      } else if (savingsBadge) {
        savingsBadge.style.display = 'none';
      }
    }

    // Tabs
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentLang = tab.getAttribute('data-lang') || 'css';
        inputCode.value = samples[currentLang] || '';
        runMinification();
      });
    });

    btnSample?.addEventListener('click', () => {
      inputCode.value = samples[currentLang] || '';
      runMinification();
    });

    btnClear?.addEventListener('click', () => {
      inputCode.value = '';
      outputCode.value = '';
      runMinification();
    });

    btnMinify?.addEventListener('click', runMinification);
    inputCode?.addEventListener('input', runMinification);
    optStripComments?.addEventListener('change', runMinification);
    optPreserveLicence?.addEventListener('change', runMinification);

    btnCopy?.addEventListener('click', () => {
      if (!outputCode.value) return;
      navigator.clipboard.writeText(outputCode.value);
      btnCopy.textContent = '¡Copiado con Éxito!';
      setTimeout(() => {
        btnCopy.innerHTML = '<span>📋</span> Copiar Código';
      }, 1800);
    });

    btnDownload?.addEventListener('click', () => {
      if (!outputCode.value) return;
      const ext = currentLang === 'css' ? 'min.css' : (currentLang === 'html' ? 'min.html' : 'min.js');
      const mime = currentLang === 'css' ? 'text/css' : (currentLang === 'html' ? 'text/html' : 'application/javascript');
      const blob = new Blob([outputCode.value], { type: `${mime};charset=utf-8` });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `codigo.${ext}`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // Cargar inicial CSS
    inputCode.value = samples.css;
    runMinification();
  }

  document.addEventListener('astro:page-load', initMinifier);
</script>
