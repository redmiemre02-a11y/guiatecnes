<script>
  function initRetirementCalculator() {
    const inputCurrAge = document.getElementById('input-curr-age') as HTMLInputElement;
    const inputRetAge = document.getElementById('input-ret-age') as HTMLInputElement;

    const inputInitFund = document.getElementById('input-initial-fund') as HTMLInputElement;
    const rangeInitFund = document.getElementById('range-initial-fund') as HTMLInputElement;
    const valInitDisplay = document.getElementById('val-initial-display');

    const inputMonthlySave = document.getElementById('input-monthly-save') as HTMLInputElement;
    const rangeMonthlySave = document.getElementById('range-monthly-save') as HTMLInputElement;
    const valMonthlyDisplay = document.getElementById('val-monthly-display');

    const inputRate = document.getElementById('input-pension-rate') as HTMLInputElement;
    const inputPayoutYears = document.getElementById('input-pension-years') as HTMLInputElement;

    const resMonthlyPension = document.getElementById('res-monthly-pension');
    const resPensionSub = document.getElementById('res-pension-sub');
    const resTotalFund = document.getElementById('res-total-fund');
    const resTotalContributed = document.getElementById('res-total-contributed');
    const resTotalGains = document.getElementById('res-total-gains');
    const resYearsLeft = document.getElementById('res-years-left');

    const barPrinc = document.getElementById('bar-princ');
    const barInt = document.getElementById('bar-int');
    const txtBarPrinc = document.getElementById('txt-bar-princ');
    const txtBarInt = document.getElementById('txt-bar-int');

    const btnReset = document.getElementById('btn-reset');
    const btnCopySummary = document.getElementById('btn-copy-summary');
    const btnPrintSheet = document.getElementById('btn-print-sheet');
    const btnToggleEmbed = document.getElementById('btn-toggle-embed');
    const embedBox = document.getElementById('embed-box');
    const btnCopyEmbed = document.getElementById('btn-copy-embed');

    if (!inputCurrAge || !inputRetAge || !inputInitFund || !inputMonthlySave) return;

    function formatEUR(val: number) {
      return new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(val);
    }

    function calculate() {
      const currAge = parseInt(inputCurrAge.value, 10) || 40;
      const retAge = parseInt(inputRetAge.value, 10) || 67;
      const yearsLeft = Math.max(1, retAge - currAge);

      const p = parseFloat(inputInitFund.value) || 0;
      const pmt = parseFloat(inputMonthlySave.value) || 0;
      const annualRate = (parseFloat(inputRate.value) || 0) / 100;
      const payoutYears = parseInt(inputPayoutYears.value, 10) || 20;

      // Accumulation phase
      const monthlyRate = annualRate / 12;
      const totalMonths = yearsLeft * 12;

      let balance = p;
      let totalContributed = p;

      for (let m = 1; m <= totalMonths; m++) {
        balance = (balance + pmt) * (1 + monthlyRate);
        totalContributed += pmt;
      }

      const totalGains = Math.max(0, balance - totalContributed);
      const intPct = balance > 0 ? Math.round((totalGains / balance) * 100) : 0;
      const princPct = 100 - intPct;

      // Decumulation phase (Renta mensual durante payoutYears)
      // Presuming conservative 3% during retirement drawdown
      const decumRateMonthly = 0.03 / 12;
      const decumMonths = payoutYears * 12;
      const monthlyPayout = (balance * decumRateMonthly) / (1 - Math.pow(1 + decumRateMonthly, -decumMonths));

      // Display
      if (valInitDisplay) valInitDisplay.textContent = formatEUR(p);
      if (valMonthlyDisplay) valMonthlyDisplay.textContent = `${formatEUR(pmt)} / mes`;

      if (resMonthlyPension) resMonthlyPension.textContent = formatEUR(monthlyPayout);
      if (resPensionSub) resPensionSub.textContent = `al mes durante ${payoutYears} años`;
      if (resTotalFund) resTotalFund.textContent = formatEUR(balance);
      if (resTotalContributed) resTotalContributed.textContent = formatEUR(totalContributed);
      if (resTotalGains) resTotalGains.textContent = formatEUR(totalGains);
      if (resYearsLeft) resYearsLeft.textContent = `${yearsLeft} años`;

      if (barPrinc) barPrinc.style.width = `${princPct}%`;
      if (barInt) barInt.style.width = `${intPct}%`;
      if (txtBarPrinc) txtBarPrinc.textContent = `${princPct}%`;
      if (txtBarInt) txtBarInt.textContent = `${intPct}%`;
    }

    function bindSlider(num: HTMLInputElement, range: HTMLInputElement) {
      num.addEventListener('input', () => { range.value = num.value; calculate(); });
      range.addEventListener('input', () => { num.value = range.value; calculate(); });
    }

    bindSlider(inputInitFund, rangeInitFund);
    bindSlider(inputMonthlySave, rangeMonthlySave);

    [inputCurrAge, inputRetAge, inputRate, inputPayoutYears].forEach(el => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });

    // Presets
    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const a = btn.getAttribute('data-age');
        const r = btn.getAttribute('data-ret');
        const s = btn.getAttribute('data-save');
        if (a) inputCurrAge.value = a;
        if (r) inputRetAge.value = r;
        if (s) {
          inputMonthlySave.value = s;
          rangeMonthlySave.value = s;
        }
        calculate();
      });
    });

    // Reset
    btnReset?.addEventListener('click', () => {
      inputCurrAge.value = '40';
      inputRetAge.value = '67';
      inputInitFund.value = '12000';
      rangeInitFund.value = '12000';
      inputMonthlySave.value = '300';
      rangeMonthlySave.value = '300';
      inputRate.value = '6.0';
      inputPayoutYears.value = '22';
      presetBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-save') === '300'));
      calculate();
    });

    // Copy Summary
    btnCopySummary?.addEventListener('click', async () => {
      const fund = resTotalFund?.textContent || '';
      const monthly = resMonthlyPension?.textContent || '';
      const years = resYearsLeft?.textContent || '';

      const text = `⏳ *Plan de Ahorro para la Jubilación*\n` +
                   `• Tiempo de ahorro: ${years}\n` +
                   `• Fondo acumulado al jubilarte: ${fund}\n` +
                   `• *Renta privada mensual complementaria:* ${monthly}\n` +
                   `Calculado en GuíaTecnes: https://guiatecnes.com/herramientas/calculadora-jubilacion`;
      try {
        await navigator.clipboard.writeText(text);
        btnCopySummary.textContent = '✅ ¡Plan Copiado al portapapeles!';
        setTimeout(() => {
          btnCopySummary.textContent = '📋 Copiar Plan de Jubilación';
        }, 2000);
      } catch (e) {}
    });

    // Print
    btnPrintSheet?.addEventListener('click', () => window.print());

    // Embed Toggle
    btnToggleEmbed?.addEventListener('click', () => {
      if (!embedBox) return;
      embedBox.style.display = embedBox.style.display === 'none' ? 'block' : 'none';
    });

    // Copy Embed
    btnCopyEmbed?.addEventListener('click', async () => {
      const code = (document.getElementById('embed-code') as HTMLTextAreaElement)?.value || '';
      try {
        await navigator.clipboard.writeText(code);
        btnCopyEmbed.textContent = '✅ ¡Código Iframe Copiado!';
        setTimeout(() => {
          btnCopyEmbed.textContent = 'Copiar código iframe';
        }, 2000);
      } catch (e) {}
    });

    calculate();
  }

  document.addEventListener('astro:page-load', initRetirementCalculator);
</script>
