      a = II(a, b, c, d, words[i + 4] || 0, 6, 0xf7537e82);
      d = II(d, a, b, c, words[i + 11] || 0, 10, 0xbd3af235);
      c = II(c, d, a, b, words[i + 2] || 0, 15, 0x2ad7d2bb);
      b = II(b, c, d, a, words[i + 9] || 0, 21, 0xeb86d391);

      a = addUnsigned(a, aa);
      b = addUnsigned(b, bb);
      c = addUnsigned(c, cc);
      d = addUnsigned(d, dd);
    }

    function wordToHex(val: number) {
      let str = '';
      for (let j = 0; j <= 3; j++) {
        const b = (val >>> (j * 8)) & 255;
        str += ('0' + b.toString(16)).slice(-2);
      }
      return str;
    }

    return wordToHex(a) + wordToHex(b) + wordToHex(c) + wordToHex(d);
  }

  function initHashGenerator() {
    const modeTabs = document.querySelectorAll('.mode-tab');
    const textModeBox = document.getElementById('mode-text-box');
    const fileModeBox = document.getElementById('mode-file-box');
    const textInput = document.getElementById('hash-text-input') as HTMLTextAreaElement;
    const dropZone = document.getElementById('file-drop-zone');
    const fileSelector = document.getElementById('file-selector-input') as HTMLInputElement;
    const fileInfoBadge = document.getElementById('file-info-badge');
    const fileNameEl = document.getElementById('selected-file-name');
    const fileSizeEl = document.getElementById('selected-file-size');
    const toggleUpper = document.getElementById('toggle-uppercase') as HTMLInputElement;

    const outSha256 = document.getElementById('hash-sha256') as HTMLInputElement;
    const outSha512 = document.getElementById('hash-sha512') as HTMLInputElement;
    const outSha1 = document.getElementById('hash-sha1') as HTMLInputElement;
    const outMd5 = document.getElementById('hash-md5') as HTMLInputElement;

    const verifyInput = document.getElementById('verify-hash-input') as HTMLInputElement;
    const verifyStatus = document.getElementById('verify-status-msg');

    if (!outSha256 || !textInput) return;

    let activeMode = 'text';
    let fileBuffer: ArrayBuffer | null = null;

    async function cryptoDigest(algo: string, buffer: ArrayBuffer): Promise<string> {
      try {
        const hashBuf = await crypto.subtle.digest(algo, buffer);
        const hashArr = Array.from(new Uint8Array(hashBuf));
        return hashArr.map(b => b.toString(16).padStart(2, '0')).join('');
      } catch (e) {
        return 'No soportado';
      }
    }

    function formatBytes(bytes: number): string {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    async function calculateHashes() {
      let buffer: ArrayBuffer;

      if (activeMode === 'text') {
        const str = textInput.value;
        buffer = new TextEncoder().encode(str).buffer;
      } else {
        if (!fileBuffer) return;
        buffer = fileBuffer;
      }

      const isUpper = toggleUpper.checked;

      const [sha256, sha512, sha1] = await Promise.all([
        cryptoDigest('SHA-256', buffer),
        cryptoDigest('SHA-512', buffer),
        cryptoDigest('SHA-1', buffer),
      ]);

      const md5Hash = md5(buffer);

      const applyCase = (s: string) => isUpper ? s.toUpperCase() : s.toLowerCase();

      outSha256.value = applyCase(sha256);
      outSha512.value = applyCase(sha512);
      outSha1.value = applyCase(sha1);
      outMd5.value = applyCase(md5Hash);

      checkVerification();
    }

    function checkVerification() {
      if (!verifyInput || !verifyStatus) return;
      const expected = verifyInput.value.trim().toLowerCase();
      if (!expected) {
        verifyStatus.style.display = 'none';
        return;
      }

      const computed = [
        outSha256.value.toLowerCase(),
        outSha512.value.toLowerCase(),
        outSha1.value.toLowerCase(),
        outMd5.value.toLowerCase()
      ];

      verifyStatus.style.display = 'block';
      if (computed.includes(expected)) {
        verifyStatus.className = 'verify-status match';
        verifyStatus.textContent = '✅ ¡Checksum verificado! Coincide exactamente con el hash generado.';
      } else {
        verifyStatus.className = 'verify-status mismatch';
        verifyStatus.textContent = '❌ No coincide con ninguno de los hashes generados (SHA-256, SHA-512, SHA-1 o MD5).';
      }
    }

    modeTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        modeTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        activeMode = tab.getAttribute('data-mode') || 'text';

        if (activeMode === 'text') {
          if (textModeBox) textModeBox.style.display = 'block';
          if (fileModeBox) fileModeBox.style.display = 'none';
          calculateHashes();
        } else {
          if (textModeBox) textModeBox.style.display = 'none';
          if (fileModeBox) fileModeBox.style.display = 'block';
          if (fileBuffer) calculateHashes();
        }
      });
    });

    textInput.addEventListener('input', calculateHashes);
    toggleUpper.addEventListener('change', calculateHashes);
    verifyInput?.addEventListener('input', checkVerification);

    // File handling
    function loadFile(file: File) {
      if (!file) return;
      if (fileNameEl) fileNameEl.textContent = file.name;
      if (fileSizeEl) fileSizeEl.textContent = formatBytes(file.size);
      if (fileInfoBadge) fileInfoBadge.style.display = 'flex';

      const reader = new FileReader();
      reader.onload = (e) => {
        if (e.target?.result instanceof ArrayBuffer) {
          fileBuffer = e.target.result;
          calculateHashes();
        }
      };
      reader.readAsArrayBuffer(file);
    }

    dropZone?.addEventListener('click', () => fileSelector.click());
    fileSelector?.addEventListener('change', () => {
      if (fileSelector.files && fileSelector.files[0]) {
        loadFile(fileSelector.files[0]);
      }
    });

    dropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });

    dropZone?.addEventListener('dragleave', () => {
      dropZone.classList.remove('drag-over');
    });

    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
        loadFile(e.dataTransfer.files[0]);
      }
    });

    // Copy buttons
    document.querySelectorAll('.btn-copy-hash').forEach(btn => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-target');
        const targetInput = document.getElementById(targetId || '') as HTMLInputElement;
        if (!targetInput || !targetInput.value) return;

        try {
          await navigator.clipboard.writeText(targetInput.value);
          const orig = btn.textContent;
          btn.textContent = '✅ ¡Copiado!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = orig;
            btn.classList.remove('copied');
          }, 1500);
        } catch (e) {}
      });
    });

    calculateHashes();
  }

  document.addEventListener('astro:page-load', initHashGenerator);
</script>
