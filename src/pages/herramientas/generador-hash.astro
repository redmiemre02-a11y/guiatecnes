  .faq-question {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-heading, #f8fafc);
  }

  .faq-answer {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted, #94a3b8);
