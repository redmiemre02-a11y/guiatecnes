---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Generador de Hash Criptográfico Online', url: '/herramientas/generador-hash' }
];

const faqs = [
  {
    question: '¿Qué es una función hash criptográfica?',
    answer: 'Es un algoritmo matemático unidireccional que transforma cualquier entrada de datos (un texto, una contraseña o un archivo de varios gigabytes) en una cadena alfanumérica de longitud fija única (huella digital).'
  },
  {
    question: '¿Se suben mis archivos o contraseñas a algún servidor?',
    answer: 'No. El cálculo se ejecuta al 100% en tu propio navegador web mediante la Web Crypto API nativa de JavaScript. Tus textos y archivos nunca abandonan tu dispositivo, garantizando privacidad total.'
  },
  {
    question: '¿Cuál es la diferencia entre MD5, SHA-1 y SHA-256?',
    answer: 'MD5 y SHA-1 son algoritmos clásicos que hoy en día se consideran vulnerables ante colisiones deliberadas y solo deben usarse para comprobación de errores en descargas. SHA-256 y SHA-512 son el estándar criptográfico moderno seguro utilizado en blockchain, certificados SSL/TLS y seguridad bancaria.'
  },
  {
    question: '¿Para qué sirve comparar un checksum o hash de un archivo?',
    answer: 'Te permite verificar que un archivo o instalador descargado de internet es exactamente idéntico al original publicado por el autor y que no ha sufrido corrupción durante la descarga ni ha sido manipulado con malware.'
  }
];
---

<BaseLayout
  title="Generador de Hash Criptográfico SHA-256, MD5 y SHA-512 | GuiaTecnEs"
  description="Calcula hashes de texto y archivos locales en tu navegador (SHA-256, SHA-1, SHA-512, MD5). Privado, instantáneo y con comparador de integridad."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Generador de Hash</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🔒 Ciberseguridad, Desarrollo & Privacidad</div>
      <h1>Generador de Hash Criptográfico</h1>
      <p class="tool-subtitle">
        Calcula la huella digital (checksum) de cualquier texto o archivo local en SHA-256, SHA-512, SHA-1 y MD5. Procesamiento 100% privado en tu navegador sin enviar datos a servidores.
      </p>
    </header>

    <div class="hash-tool-layout">
      <!-- PANEL DE ENTRADA -->
      <div class="card input-card">
        <!-- PESTAÑAS MODO -->
        <div class="mode-tabs">
          <button type="button" class="mode-tab active" data-mode="text">📝 Texto Plano</button>
          <button type="button" class="mode-tab" data-mode="file">📁 Archivo Local (Checksum)</button>
        </div>

        <!-- MODO TEXTO -->
        <div class="mode-content" id="mode-text-box">
          <label for="hash-text-input">Texto o Contraseña a Hashear:</label>
          <textarea
            id="hash-text-input"
            placeholder="Escribe o pega aquí el texto para calcular sus hashes..."
            rows="5"
          >Hola Mundo</textarea>
        </div>

        <!-- MODO ARCHIVO -->
        <div class="mode-content" id="mode-file-box" style="display: none;">
          <div class="drop-zone" id="file-drop-zone">
            <span class="drop-icon">📂</span>
            <p class="drop-title">Arrastra tu archivo aquí o <strong>haz clic para seleccionar</strong></p>
            <p class="drop-sub">El archivo se analiza localmente en tu memoria RAM. Límite recomendado: hasta 500 MB.</p>
            <input type="file" id="file-selector-input" style="display: none;" />
          </div>
          <div class="file-loaded-info" id="file-info-badge" style="display: none;">
            <span class="file-name" id="selected-file-name"></span>
            <span class="file-size" id="selected-file-size"></span>
          </div>
        </div>

        <!-- OPCIONES -->
        <div class="hash-options-bar">
          <label class="toggle-checkbox">
            <input type="checkbox" id="toggle-uppercase" />
            <span>Salida en Mayúsculas (A-F)</span>
          </label>
        </div>
      </div>

      <!-- RESULTADOS DE HASHES -->
      <div class="card results-card">
        <h3>🔑 Resultados Criptográficos</h3>

        <div class="hash-output-list">
          <!-- SHA-256 -->
          <div class="hash-item">
            <div class="hash-meta">
              <span class="algo-name">SHA-256 <span class="badge-rec">Estándar Seguro</span></span>
              <button type="button" class="btn-copy-hash" data-target="hash-sha256">📋 Copiar</button>
            </div>
            <div class="hash-value-wrap">
              <input type="text" id="hash-sha256" readonly />
            </div>
          </div>

          <!-- SHA-512 -->
          <div class="hash-item">
            <div class="hash-meta">
              <span class="algo-name">SHA-512 <span class="badge-rec">Alta Seguridad</span></span>
              <button type="button" class="btn-copy-hash" data-target="hash-sha512">📋 Copiar</button>
            </div>
            <div class="hash-value-wrap">
              <input type="text" id="hash-sha512" readonly />
            </div>
          </div>

          <!-- SHA-1 -->
          <div class="hash-item">
            <div class="hash-meta">
              <span class="algo-name">SHA-1 <span class="badge-legacy">Legacy / Git</span></span>
              <button type="button" class="btn-copy-hash" data-target="hash-sha1">📋 Copiar</button>
            </div>
            <div class="hash-value-wrap">
              <input type="text" id="hash-sha1" readonly />
            </div>
          </div>

          <!-- MD5 -->
          <div class="hash-item">
            <div class="hash-meta">
              <span class="algo-name">MD5 <span class="badge-legacy">Checksum Rápido</span></span>
              <button type="button" class="btn-copy-hash" data-target="hash-md5">📋 Copiar</button>
            </div>
            <div class="hash-value-wrap">
              <input type="text" id="hash-md5" readonly />
            </div>
          </div>
        </div>

        <!-- COMPARADOR DE VERIFICACIÓN -->
        <div class="verifier-box">
          <label for="verify-hash-input">🔍 Comparar e Integrar Checksum:</label>
          <div class="verify-input-group">
            <input type="text" id="verify-hash-input" placeholder="Pega el hash esperado para verificar coincidencia..." />
          </div>
          <div class="verify-status" id="verify-status-msg" style="display: none;"></div>
        </div>
      </div>
    </div>

    <!-- GUÍA SEO -->
    <section class="seo-guide-section card">
      <h2>¿Cuándo utilizar cada algoritmo de Hash?</h2>
      <p>
        Las funciones de resumen o hash tienen propósitos muy concretos según el entorno técnico:
      </p>

      <div class="guide-grid">
        <div class="guide-box">
          <h3>🛡️ SHA-256 (Recomendado)</h3>
          <p>
            Es el estándar criptográfico de la NSA y el consorcio NIST. Utilizado en la minería de Bitcoin, firmas digitales SSL, autenticación JWT y comprobaciones de integridad gubernamentales. No se conocen colisiones viables.
          </p>
        </div>
        <div class="guide-box">
          <h3>📦 SHA-1 y Git</h3>
          <p>
            Históricamente empleado para identificar commits y objetos en sistemas de control de versiones Git y repositorios de paquetes Linux. Está en desuso para firmas TLS por colisiones demostradas.
          </p>
        </div>
        <div class="guide-box">
          <h3>⚡ MD5 (Solo verificación simple)</h3>
          <p>
            Genera un resumen de 128 bits sumamente veloz. Se usa comúnmente en descargas masivas ISO para verificar que el archivo no se ha cortado a mitad de transferencia, pero nunca debe usarse para almacenar contraseñas.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQS -->
    <section class="faq-section card">
      <h2>Preguntas Frecuentes sobre Hashing</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{faq.question}</strong></summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
