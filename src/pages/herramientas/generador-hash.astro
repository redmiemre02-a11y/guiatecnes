      d = FF(d, a, b, c, words[i + 5] || 0, 12, 0x4787c62a);
      c = FF(c, d, a, b, words[i + 6] || 0, 17, 0xa8304613);
      b = FF(b, c, d, a, words[i + 7] || 0, 22, 0xfd469501);
