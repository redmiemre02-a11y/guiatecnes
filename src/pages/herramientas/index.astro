---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const tools = [
  {
    title: 'Calculadora de Propinas y División de Cuenta',
    desc: 'Divide la cuenta de restaurantes con amigos, calcula la propina justa y genera un mensaje para pedir Bizum por WhatsApp.',
    url: '/herramientas/calculadora-propinas',
    icon: '🧾',
    badge: 'Restaurantes',
    color: '#f59e0b'
  },
  {
    title: 'Conversor de Almacenamiento y Capacidad Real',
    desc: 'Convierte GB a TB/MB, calcula el espacio útil real de tu disco o móvil y averigua cuántas fotos y juegos caben.',
    url: '/herramientas/conversor-almacenamiento',
    icon: '💾',
    badge: 'Hardware & Móvil',
    color: '#0ea5e9'
  },
  {
    title: 'Generador de Gradientes CSS Visual',
    desc: 'Crea degradados lineales, radiales y cónicos para diseño web. Ajusta colores y copia el código CSS listo para usar.',
    url: '/herramientas/generador-gradientes-css',
    icon: '🎨',
    badge: 'Diseño Web',
    color: '#ec4899'
  },
  {
    title: 'Test de Ping y Latencia Online',
    desc: 'Mide tu ping en ms, jitter y estabilidad hacia servidores de Cloudflare, Google y AWS para saber si tienes lag.',
    url: '/herramientas/test-ping',
    icon: '⏱️',
    badge: 'Gaming & Redes',
    color: '#10b981'
  },
  {
    title: 'Ruleta Aleatoria de Decisiones y Sorteos',
    desc: 'Gira la ruleta de la suerte online para tomar decisiones, sorteos de amigos o qué comer. Con física, sonido y confeti.',
    url: '/herramientas/ruleta-decisiones',
    icon: '🎡',
    badge: 'Viral & Sorteos',
    color: '#ec4899'
  },
  {
    title: 'Creador de Páginas Link en Bio',
    desc: 'Crea tu micro-sitio para la bio de Instagram y TikTok gratis. Personaliza temas, botones sociales y descarga el HTML.',
    url: '/herramientas/creador-link-bio',
    icon: '✨',
    badge: 'Alternativa Linktree',
    color: '#a855f7'
  },
  {
    title: 'Calculadora de Sueldo Neto a Bruto España 2026',
    desc: 'Calcula tu sueldo neto mensual y anual en 12 o 14 pagas con desglose detallado de IRPF y Seguridad Social.',
    url: '/herramientas/calculadora-sueldo-neto',
    icon: '💶',
    badge: 'Nómina & IRPF',
    color: '#10b981'
  },
  {
    title: 'Minificador de Código CSS, HTML y JS',
    desc: 'Comprime hojas de estilo, páginas web y scripts en el navegador. Elimina comentarios y acelera la velocidad web.',
    url: '/herramientas/minificador-codigo',
    icon: '⚡',
    badge: 'PageSpeed & SEO',
    color: '#0ea5e9'
  },
  {
    title: 'Generador de Enlaces de WhatsApp con QR',
    desc: 'Crea tu enlace wa.me directo con mensaje personalizado y código QR listo para descargar en alta calidad.',
    url: '/herramientas/generador-link-whatsapp',
    icon: '💬',
    badge: 'Negocios & Bio',
    color: '#25d366'
  },
  {
    title: 'Calculadora de DPI / PPI de Pantalla',
    desc: 'Calcula la nitidez exacta, densidad de píxeles, dot pitch y distancia de visión para monitores, móviles o TV.',
    url: '/herramientas/calculadora-ppi',
    icon: '🖥️',
    badge: 'Hardware',
    color: '#06b6d4'
  },
  {
    title: 'Test: ¿Qué Inteligencia Artificial necesitas?',
    desc: 'Responde a 4 preguntas y descubre si tu IA ideal es ChatGPT, Claude 3.5 Sonnet, DeepSeek o Perplexity según tus tareas.',
    url: '/herramientas/test-inteligencia-artificial',
    icon: '🧠',
    badge: 'Quiz 2026',
    color: '#6366f1'
  },
  {
    title: 'Test de Velocidad WiFi e Internet',
    desc: 'Mide la velocidad real de tu conexión, ping y latencia en tiempo real. Descubre si tu operadora te da lo que pagas.',
    url: '/herramientas/test-velocidad',
    icon: '⚡',
    badge: 'Popular',
    color: '#6366f1'
  },
  {
    title: 'Compresor de Fotos e Imágenes',
    desc: 'Reduce el peso de tus imágenes JPG, PNG y WebP hasta un 80% sin perder calidad. 100% privado en tu navegador.',
    url: '/herramientas/compresor-imagenes',
    icon: '🖼️',
    badge: 'Sin Pérdida',
    color: '#10b981'
  },
  {
    title: 'Conversor de Letras Bonitas para Instagram',
    desc: 'Transforma texto normal en letras cursivas, góticas y estéticas para copiar y pegar en tu biografía de redes.',
    url: '/herramientas/letras-bonitas',
    icon: '✨',
    badge: 'Viral',
    color: '#a855f7'
  },
  {
    title: 'Generador de Nombres y Gamertags',
    desc: 'Crea nombres chidos para Instagram, TikTok y gamertags pro para Free Fire, Roblox, Valorant y Twitch.',
    url: '/herramientas/generador-nombres',
    icon: '🎮',
    badge: 'Gamer',
    color: '#ec4899'
  },
  {
    title: 'Calculadora de Tiempo de Descarga',
    desc: 'Calcula cuántas horas y minutos tardará en descargarse tu juego (Steam, PS5), película o archivo según tus megas.',
    url: '/herramientas/calculadora-descarga',
    icon: '⏳',
    badge: 'Gaming & Fibra',
    color: '#f59e0b'
  },
  {
    title: 'Calculadora de Consumo Eléctrico (Luz)',
    desc: 'Averigua cuánto cuesta tener encendido tu PC Gaming, PS5, router o Smart TV al mes según tu tarifa de luz.',
    url: '/herramientas/calculadora-luz',
    icon: '💡',
    badge: 'Ahorro',
    color: '#eab308'
  },
  {
    title: 'Calculadora de Consumo de Datos (GB)',
    desc: 'Calcula cuántos Gigas gastas con Netflix, YouTube, TikTok y Spotify al mes. Averigua si tu tarifa móvil es suficiente.',
    url: '/herramientas/calculadora-datos',
    icon: '📶',
    badge: 'Ahorro Móvil',
    color: '#38bdf8'
  },
  {
    title: 'Generador de Códigos QR Gratis',
    desc: 'Crea códigos QR personalizados para enlaces, cartas de restaurante o WiFi. Sin caducidad y en alta resolución.',
    url: '/herramientas/generador-qr',
    icon: '📲',
    badge: 'Sin Caducidad',
    color: '#06b6d4'
  },
  {
    title: 'Calculadora de IVA y Descuentos',
    desc: 'Añade o quita el IVA (desglose) de facturas y presupuestos. Tipos de España (21%, 10%, 4%), México, Colombia y descuentos.',
    url: '/herramientas/calculadora-iva',
    icon: '💶',
    badge: 'Facturación',
    color: '#10b981'
  },
  {
    title: 'Codificador y Decodificador Base64',
    desc: 'Codifica y descodifica cadenas de texto a formato Base64 con soporte completo para UTF-8 y caracteres especiales.',
    url: '/herramientas/conversor-base64',
    icon: '🔒',
    badge: 'Dev Tools',
    color: '#6366f1'
  },
  {
    title: 'Formateador y Validador JSON',
    desc: 'Embellece, valida y minifica código JSON al instante. Resaltado de sintaxis, detección de errores y 100% privado.',
    url: '/herramientas/formateador-json',
    icon: '💻',
    badge: 'Desarrollo',
    color: '#818cf8'
  },
  {
    title: 'Conversor de Mayúsculas, Minúsculas y Slugs',
    desc: 'Convierte textos a MAYÚSCULAS, minúsculas, Tipo Título, genera slugs limpios para URLs y elimina espacios sobrantes.',
    url: '/herramientas/conversor-texto',
    icon: '🔠',
    badge: 'Redacción',
    color: '#ec4899'
  },
  {
    title: '¿Cuál es mi IP y Ubicación?',
    desc: 'Detecta tu dirección IP pública, proveedor de internet, país y comprueba si tu conexión está protegida con VPN.',
    url: '/herramientas/mi-ip',
    icon: '🌐',
    badge: 'Red & VPN',
    color: '#0ea5e9'
  },
  {
    title: 'Contador de Palabras y Caracteres',
    desc: 'Analiza tu texto al instante: palabras, caracteres con y sin espacios, tiempo de lectura y límites para Twitter e Instagram.',
    url: '/herramientas/contador-palabras',
    icon: '📝',
    badge: 'SEO & Redes',
    color: '#a855f7'
  },
  {
    title: 'Generador y Test de Contraseñas',
    desc: 'Crea claves 100% indescifrables y comprueba cuánto tardaría un hacker con IA en descifrar tu contraseña actual.',
    url: '/herramientas/generador-contrasenas',
    icon: '🛡️',
    badge: 'Seguridad',
    color: '#10b981'
  },
  {
    title: 'Comprobador de Enlaces Sospechosos',
    desc: 'Analiza enlaces de WhatsApp, SMS o correos antes de abrirlos. Detecta estafas, troyanos y phishing al instante.',
    url: '/herramientas/detector-enlaces',
    icon: '🔍',
    badge: 'Anti-Estafas',
    color: '#ef4444'
  },
  {
    title: 'Calculadora Freelance y Tarifa/Hora',
    desc: 'Calcula exactamente cuánto cobrar por hora o proyecto como teletrabajador para cubrir impuestos y ganar un sueldo digno.',
    url: '/herramientas/calculadora-freelance',
    icon: '💰',
    badge: 'Finanzas',
    color: '#eab308'
  }
];
---

<BaseLayout
  title="28 Herramientas Online Gratuitas de Tecnología, Ciberseguridad y Redes | GuíaTecnes"
  description="Colección de 24 utilidades online gratuitas: Ruleta de la suerte, link en bio, sueldo neto España, minificador de código, WhatsApp QR y más."
>
  <Header slot="header" />

  <main class="hub-container">
    <div class="hub-hero">
      <span class="badge">🧲 28 Utilidades 100% Gratuitas</span>
      <h1>Herramientas Digitales y Utilidades Online</h1>
      <p class="subtitle">Herramientas prácticas, rápidas y privadas diseñadas para solucionar problemas del día a día. Sin registros, sin suscripciones y sin trampas.</p>
    </div>

    <div class="tools-grid">
      {tools.map(t => (
        <a href={t.url} class="tool-card">
          <div class="card-header">
            <span class="tool-icon">{t.icon}</span>
            <span class="tool-badge" style={`color: ${t.color}; background: ${t.color}15; border-color: ${t.color}35;`}>{t.badge}</span>
          </div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
          <span class="tool-cta">Abrir herramienta →</span>
        </a>
      ))}
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .hub-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .hub-hero {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3.5rem;
  }

  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .hub-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .tool-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .tool-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .tool-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  .tool-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 50px;
    border: 1px solid;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tool-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    line-height: 1.35;
    color: var(--text);
  }

  .tool-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .tool-cta {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.2s;
  }

  .tool-card:hover .tool-cta {
    gap: 0.6rem;
  }

  @media (max-width: 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
