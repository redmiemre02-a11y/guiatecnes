    icon: '📅',
    badge: 'Calendario & Tiempo',
    color: '#f59e0b',
    category: 'social'
  },
  {
    title: 'Contador de Caracteres para Redes Sociales',
    desc: 'Comprueba al instante si tu texto cabe en X/Twitter (280), Instagram bio y pie de foto, TikTok, LinkedIn y YouTube.',
    url: '/herramientas/contador-caracteres-redes',
    icon: '📱',
    badge: 'Social Media',
    color: '#6366f1',
    category: 'social'
  },
  {
    title: 'Generador de Gamertags y Nombres de Usuario',
