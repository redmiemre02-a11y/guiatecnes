---

<BaseLayout
  title="44 Herramientas Online Gratuitas de Tecnología, Ciberseguridad y Redes | GuíaTecnes"
  description="Colección de 44 utilidades online gratuitas: Calculadora de hipotecas, conversor de imágenes WebP, extractor de colores, calculadora de fechas, sueldo neto y más."
>
  <Header slot="header" />

  <main class="hub-container">
    <div class="hub-hero">
      <span class="badge">🧲 44 Utilidades 100% Gratuitas</span>
      <h1>Herramientas Digitales y Utilidades Online</h1>
      <p class="subtitle">Herramientas prácticas, rápidas y privadas diseñadas para solucionar problemas del día a día. Sin registros, sin suscripciones y sin trampas.</p>

      <!-- BUSCADOR EN VIVO Y FILTROS POR CATEGORÍA -->
      <div class="hub-search-wrapper">
        <div class="search-input-box">
          <span class="search-icon">🔍</span>
          <input type="text" id="tool-search-input" placeholder="Buscar entre las 44 herramientas gratis (ej: sueldo, wifi, porcentajes, qr)..." />
          <button type="button" id="btn-clear-search" style="display: none;">✕</button>
        </div>

        <div class="hub-filter-chips">
          <button type="button" class="filter-chip active" data-cat="all">Todas (44)</button>
          <button type="button" class="filter-chip btn-fav-filter" data-cat="fav">⭐ Favoritas (<span id="fav-chip-count">0</span>)</button>
          <button type="button" class="filter-chip" data-cat="finanzas">💰 Finanzas & Nómina</button>
          <button type="button" class="filter-chip" data-cat="diseno">🎨 Diseño & Web</button>
          <button type="button" class="filter-chip" data-cat="gaming">⚡ Redes & Gaming</button>
          <button type="button" class="filter-chip" data-cat="social">📱 Social & Utilidades</button>
          <button type="button" class="filter-chip btn-random-hub" id="btn-random-tool">🎲 Probar al azar</button>
        </div>

        <div class="tools-count-feedback" id="tools-counter">
          Mostrando 44 herramientas disponibles
        </div>
      </div>
    </div>

    <div class="tools-grid" id="tools-grid">
      {tools.map(t => {
        const cat = t.category || (t.url.includes('sueldo') || t.url.includes('propina') || t.url.includes('iva') || t.url.includes('divisas') || t.url.includes('porcentajes') || t.url.includes('freelance') || t.url.includes('luz') ? 'finanzas' : (t.url.includes('paleta') || t.url.includes('gradiente') || t.url.includes('compresor') || t.url.includes('letras') || t.url.includes('base64') || t.url.includes('minificador') ? 'diseno' : (t.url.includes('ping') || t.url.includes('velocidad') || t.url.includes('nombres') || t.url.includes('ppi') || t.url.includes('descarga') || t.url.includes('datos') || t.url.includes('cronometro') ? 'gaming' : 'social')));
        return (
          <a href={t.url} class="tool-card" data-title={t.title.toLowerCase()} data-desc={t.desc.toLowerCase()} data-cat={cat}>
            <div class="card-header">
              <span class="tool-icon">{t.icon}</span>
              <div class="header-right-badges">
                <span class="tool-badge" style={`color: ${t.color}; background: ${t.color}15; border-color: ${t.color}35;`}>{t.badge}</span>
                <button type="button" class="btn-fav-star" data-url={t.url} title="Guardar en favoritas">☆</button>
              </div>
            </div>
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
            <span class="tool-cta">Abrir herramienta →</span>
          </a>
        );
      })}
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .hub-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .hub-hero {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3.5rem;
  }

  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .hub-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .tool-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .tool-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .tool-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  .tool-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 50px;
    border: 1px solid;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tool-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    line-height: 1.35;
    color: var(--text);
  }

  .tool-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .tool-cta {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.2s;
  }

  .tool-card:hover .tool-cta {
    gap: 0.6rem;
  }

  @media (max-width: 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }

  
  .header-right-badges {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .btn-fav-star {
    background: transparent;
    border: none;
    font-size: 1.15rem;
    color: var(--text-muted, #94a3b8);
    cursor: pointer;
    padding: 0 0.2rem;
    line-height: 1;
    transition: transform 0.15s, color 0.15s;
    z-index: 2;
  }

  .btn-fav-star:hover {
    transform: scale(1.25);
    color: #f59e0b;
  }

  .btn-fav-star.is-fav {
    color: #f59e0b;
  }

  .btn-fav-filter.has-favs {
    border-color: #f59e0b;
    color: #f59e0b;
  }

  /* HUB SEARCH & FILTER */
  .hub-search-wrapper {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .search-input-box {
    position: relative;
    width: 100%;
    max-width: 580px;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    font-size: 1.1rem;
    pointer-events: none;
    opacity: 0.6;
  }

  #tool-search-input {
    width: 100%;
    padding: 0.85rem 2.8rem 0.85rem 3rem;
    border-radius: 9999px;
    border: 1px solid var(--border-color, #334155);
    background: var(--card-bg, #1e293b);
    color: var(--text-heading, #f8fafc);
    font-size: 0.95rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transition: all 0.2s;
  }

  #tool-search-input:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
  }

  #btn-clear-search {
    position: absolute;
    right: 1rem;
    background: transparent;
    border: none;
    color: var(--text-muted, #94a3b8);
    font-size: 1.1rem;
    cursor: pointer;
  }

  .hub-filter-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .filter-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    border-radius: 9999px;
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted, #94a3b8);
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter-chip:hover {
    background: rgba(99, 102, 241, 0.15);
    color: var(--text-heading, #f8fafc);
  }

  .filter-chip.active {
    background: #6366f1;
    color: #ffffff;
    border-color: #6366f1;
    box-shadow: 0 2px 10px rgba(99, 102, 241, 0.35);
  }

  .filter-chip.btn-random-hub {
    background: linear-gradient(135deg, #ec4899, #8b5cf6);
    color: #ffffff;
    border: none;
    font-weight: 700;
  }

  .tools-count-feedback {
    font-size: 0.82rem;
    color: var(--text-muted, #94a3b8);
  }
</style>

<script>
  function initToolsHubFilter() {
    const input = document.getElementById('tool-search-input') as HTMLInputElement;
    const btnClear = document.getElementById('btn-clear-search');
    const filterChips = document.querySelectorAll('.filter-chip');
    const cards = document.querySelectorAll<HTMLElement>('.tool-card');
    const counter = document.getElementById('tools-counter');
    const btnRandom = document.getElementById('btn-random-tool');

    if (!input || cards.length === 0) return;

    let activeCat = 'all';

    function getFavUrls(): string[] {
      try {
        return JSON.parse(localStorage.getItem('gt_user_fav_tools') || '[]');
      } catch (e) {
        return [];
      }
    }

    function saveFavUrls(urls: string[]) {
      try {
        localStorage.setItem('gt_user_fav_tools', JSON.stringify(urls));
        updateFavsUI();
      } catch (e) {}
    }

    function updateFavsUI() {
      const favs = getFavUrls();
      const favCountBadge = document.getElementById('fav-chip-count');
      const favFilterBtn = document.querySelector('.btn-fav-filter');

      if (favCountBadge) favCountBadge.textContent = favs.length.toString();
      if (favFilterBtn) {
        if (favs.length > 0) favFilterBtn.classList.add('has-favs');
        else favFilterBtn.classList.remove('has-favs');
      }

      document.querySelectorAll('.btn-fav-star').forEach(star => {
        const u = star.getAttribute('data-url');
        if (u && favs.includes(u)) {
          star.textContent = '⭐';
          star.classList.add('is-fav');
        } else {
          star.textContent = '☆';
          star.classList.remove('is-fav');
        }
      });
    }

    function filterTools() {
      const q = (input.value || '').trim().toLowerCase();
      if (btnClear) btnClear.style.display = q ? 'block' : 'none';

      let visibleCount = 0;
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const cat = card.getAttribute('data-cat') || 'general';

        const cardUrl = card.getAttribute('href') || '';
        const isFav = getFavUrls().includes(cardUrl);

        const matchesQuery = !q || title.includes(q) || desc.includes(q);
        const matchesCat = activeCat === 'all' ? true : (activeCat === 'fav' ? isFav : cat === activeCat);

        if (matchesQuery && matchesCat) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (counter) {
        counter.textContent = `Mostrando ${visibleCount} de ${cards.length} herramientas`;
      }
    }

    input.addEventListener('input', filterTools);
    btnClear?.addEventListener('click', () => {
      input.value = '';
      filterTools();
      input.focus();
    });

    filterChips.forEach(chip => {
      if (chip.id === 'btn-random-tool') return;
      chip.addEventListener('click', () => {
        filterChips.forEach(c => {
          if (c.id !== 'btn-random-tool') c.classList.remove('active');
        });
        chip.classList.add('active');
        activeCat = chip.getAttribute('data-cat') || 'all';
        filterTools();
      });
    });

    btnRandom?.addEventListener('click', () => {
      const allUrls = Array.from(cards).map(c => c.getAttribute('href')).filter(Boolean) as string[];
      if (allUrls.length > 0) {
        const randUrl = allUrls[Math.floor(Math.random() * allUrls.length)];
        window.location.href = randUrl;
      }
    });

    // Star toggle clicks
    document.querySelectorAll('.btn-fav-star').forEach(star => {
      star.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const u = star.getAttribute('data-url');
        if (!u) return;
        let favs = getFavUrls();
        if (favs.includes(u)) {
          favs = favs.filter(x => x !== u);
        } else {
          favs.push(u);
        }
        saveFavUrls(favs);
        filterTools();
      });
    });

    updateFavsUI();
  }

  document.addEventListener('astro:page-load', initToolsHubFilter);
</script>

