---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LegalDisclaimer from '../../components/LegalDisclaimer.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Calculadora de Finiquito e Indemnización', url: '/herramientas/calculadora-finiquito-indemnizacion' }
];

const faqs = [
  {
    question: '¿Qué diferencia hay entre el finiquito y la indemnización por despido?',
    answer: 'El finiquito es la liquidación final de las cantidades que la empresa debe al trabajador por su trabajo realizado (salario de los días trabajados en el mes, vacaciones no disfrutadas y parte proporcional de pagas extras). Se cobra SIEMPRE, incluso en bajas voluntarias. La indemnización, en cambio, es una compensación económica que solo se paga si hay un despido (objetivo, improcedente o fin de contrato temporal).'
  },
  {
    question: '¿Cuántos días de indemnización corresponden por despido improcedente en España?',
    answer: 'Desde la reforma laboral de 2012, corresponden 33 días de salario por año trabajado con un tope máximo de 24 mensualidades (o 720 días). Para periodos trabajados con anterioridad al 12 de febrero de 2012, se calculan 45 días por año con tope de 42 mensualidades.'
  },
  {
    question: '¿Tributa la indemnización por despido en el IRPF?',
    answer: 'La indemnización legal por despido improcedente u objetivo está totalmente exenta de tributar en el IRPF hasta un límite de 180.000 euros, siempre que el despido se formalice en acto de conciliación laboral (SMAC) o vía judicial.'
  },
  {
    question: '¿Qué pasa con el finiquito si me voy voluntariamente de la empresa?',
    answer: 'Si presentas tu dimisión o baja voluntaria, no tienes derecho a cobrar indemnización por despido ni a prestación por desempleo (paro), pero SÍ tienes derecho a cobrar tu finiquito con los días trabajados del mes, tus pagas extras acumuladas y las vacaciones no disfrutadas.'
  }
];
---

<BaseLayout
  title="Calculadora de Finiquito e Indemnización por Despido 2026 | GuiaTecnEs"
  description="Calcula tu finiquito e indemnización por despido improcedente, objetivo o fin de contrato según el Estatuto de los Trabajadores en España. Rápido y 100% privado."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Calculadora de Finiquito e Indemnización</span>
    </div>

    <!-- HEADER TOOL -->
    <div class="tool-header">
      <div class="tool-icon-wrap">💼</div>
      <div class="tool-title-wrap">
        <span class="tool-badge-top">Laboral & Legal España</span>
        <h1>Calculadora de Finiquito e Indemnización</h1>
        <p class="tool-subtitle">Simula con exactitud la indemnización por despido y el finiquito completo (vacaciones no disfrutadas, pagas extras pendientes y días trabajados) según la legislación laboral española vigente.</p>
      </div>
    </div>

    <!-- CALCULATOR MAIN GRID -->
    <div class="calc-grid">
      <!-- INPUT PANEL -->
      <div class="card input-card">
        <div class="card-title-row">
          <h2>Datos Laborales y Contrato</h2>
          <button type="button" class="btn-reset" id="btn-reset" title="Restablecer valores">🔄 Reiniciar</button>
        </div>

        <!-- Tipo de despido / extinción -->
        <div class="input-group">
          <label for="select-reason">Causa de extinción del contrato:</label>
          <select id="select-reason">
            <option value="improcedente" selected>Despido Improcedente (33 días/año - Tope 24 meses)</option>
            <option value="objetivo">Despido Objetivo / Económico (20 días/año - Tope 12 meses)</option>
            <option value="temporal">Fin de Contrato Temporal / Obra (12 días/año)</option>
            <option value="voluntaria">Baja Voluntaria / Dimisión (0 días - Solo Finiquito)</option>
          </select>
        </div>

        <!-- Salario bruto mensual y pagas -->
        <div class="grid-2-cols">
          <div class="input-group">
            <label for="input-salary">Salario bruto mensual:</label>
            <div class="input-unit-wrapper">
              <input type="number" id="input-salary" value="1800" min="500" max="50000" step="50" />
              <span class="unit-symbol">€ / mes</span>
            </div>
          </div>
          <div class="input-group">
            <label for="select-pagas">Número de pagas anuales:</label>
            <select id="select-pagas">
              <option value="12" selected>12 pagas (Prorrateadas)</option>
              <option value="14">14 pagas (2 Extras aparte)</option>
            </select>
          </div>
        </div>

        <!-- Antigüedad en la empresa -->
        <div class="grid-2-cols">
          <div class="input-group">
            <label for="input-years">Años trabajados:</label>
            <div class="input-unit-wrapper">
              <input type="number" id="input-years" value="3" min="0" max="45" step="1" />
              <span class="unit-symbol">años</span>
            </div>
          </div>
          <div class="input-group">
            <label for="input-months">Meses adicionales:</label>
            <div class="input-unit-wrapper">
              <input type="number" id="input-months" value="6" min="0" max="11" step="1" />
              <span class="unit-symbol">meses</span>
            </div>
          </div>
        </div>

        <!-- Vacaciones y días de mes -->
        <div class="grid-2-cols">
          <div class="input-group">
            <label for="input-holidays">Días vacaciones no disfrutadas:</label>
            <div class="input-unit-wrapper">
              <input type="number" id="input-holidays" value="5" min="0" max="60" step="1" />
              <span class="unit-symbol">días</span>
            </div>
          </div>
          <div class="input-group">
            <label for="input-monthdays">Días trabajados en el mes:</label>
            <div class="input-unit-wrapper">
              <input type="number" id="input-monthdays" value="15" min="1" max="31" step="1" />
              <span class="unit-symbol">días</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RESULTS PANEL -->
      <div class="card result-card">
        <div class="result-header">
          <h3>Liquidación Total Estimada</h3>
          <span class="badge-live">⚡ Cálculo Legal 2026</span>
        </div>

        <div class="main-metric-box">
          <span class="metric-label">Total a Percibir (Finiquito + Indemnización):</span>
          <div class="main-price-row">
            <span class="main-amount" id="res-total-payout">8.415 €</span>
            <span class="main-sub" id="res-salary-day">Salario diario: 60.00 €/día</span>
          </div>
        </div>

        <div class="secondary-metrics-grid">
          <div class="sec-metric">
            <span class="sm-label">Indemnización por Despido:</span>
            <span class="sm-val" id="res-indemnity" style="color: #34d399;">6.930 €</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">Finiquito Líquido Pendiente:</span>
            <span class="sm-val" id="res-finiquito" style="color: #60a5fa;">1.485 €</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">Días de Salario Mes:</span>
            <span class="sm-val" id="res-part-month">900 €</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">Vacaciones no Disfrutadas:</span>
            <span class="sm-val" id="res-part-holidays">300 €</span>
          </div>
        </div>

        <!-- LEGAL EXEMPTION BANNER -->
        <div class="legal-badge-box">
          <span class="lbb-icon">⚖️</span>
          <p class="lbb-text" id="res-legal-note">Indemnización exenta de retención de IRPF al ser inferior a 180.000 € (formalizado en conciliación laboral).</p>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="tool-actions-box">
          <button type="button" class="btn-tool-action btn-copy-summary" id="btn-copy-summary">
            📋 Copiar Desglose para mi Asesor
          </button>
          <button type="button" class="btn-tool-action btn-print-sheet" id="btn-print-sheet">
            📄 Imprimir / Guardar en PDF
          </button>
          <button type="button" class="btn-tool-action btn-embed-tool" id="btn-toggle-embed">
            ‹/› Insertar en tu Web
          </button>
        </div>

        <!-- EMBED MODAL SNIPPET -->
        <div class="embed-box" id="embed-box" style="display: none;">
          <p class="embed-desc">Copia y pega este código HTML en cualquier artículo laboral o blog de empleo:</p>
          <textarea readonly class="embed-code" id="embed-code">&lt;iframe src="https://guiatecnes.com/herramientas/calculadora-finiquito-indemnizacion" width="100%" height="720" frameborder="0" style="border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.15);" title="Calculadora de Finiquito e Indemnización"&gt;&lt;/iframe&gt;
&lt;p style="font-size:12px;text-align:right;"&gt;Calculadora cortesía de &lt;a href="https://guiatecnes.com/herramientas/calculadora-finiquito-indemnizacion" target="_blank" rel="noopener"&gt;GuíaTecnes&lt;/a&gt;&lt;/p&gt;</textarea>
          <button type="button" class="btn-copy-embed" id="btn-copy-embed">Copiar código iframe</button>
        </div>
      </div>
    </div>

    <!-- SEO GUIDE CONTENT & TIPS -->
    <section class="seo-guide-section card">
      <h2>Cómo comprobar que tu empresa ha calculado bien tu finiquito y no firmar con errores</h2>
      <p>Al finalizar una relación laboral en España, la empresa está obligada por ley a presentar una propuesta de liquidación (finiquito) y el certificado de empresa para tramitar el desempleo en el SEPE. Si no estás 100% de acuerdo con las cantidades o sospechas que el despido no está justificado, debes firmar siempre indicando de puño y letra la frase: <strong>«No conforme»</strong> junto a la fecha exacta.</p>

      <div class="tips-grid">
        <div class="tip-card">
          <span class="tip-icon">📝</span>
          <h3>Firma «No Conforme»</h3>
          <p>Firmar con «No conforme» no te impide cobrar la transferencia bancaria del finiquito, pero te reserva el derecho legal de demandar a la empresa en los 20 días hábiles siguientes ante el SMAC.</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">📅</span>
          <h3>Plazo de 20 Días Hábiles</h3>
          <p>El plazo legal para impugnar un despido injustificado es muy corto: solo 20 días hábiles (excluyendo sábados, domingos y festivos) desde el día siguiente a la fecha de efectos del despido.</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">🏖️</span>
          <h3>Cotización de Vacaciones</h3>
          <p>Los días de vacaciones pagados en el finiquito cotizan a la Seguridad Social. Durante esos días no puedes cobrar todavía la prestación por desempleo (el paro empieza al terminar esas vacaciones).</p>
        </div>
      </div>

      <!-- FAQ ACCORDION -->
      <div class="faq-container">
        <h3>Preguntas Frecuentes sobre Finiquitos e Indemnizaciones Laborales</h3>
        {faqs.map((faq, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    
    <!-- AVISO LEGAL Y RESPONSABILIDAD -->
    <LegalDisclaimer type="legal" />

    <!-- TOPIC CLUSTER: RELATED ARTICLES -->
    <div class="card related-guides-card">
      <div class="rg-header">
        <span class="rg-badge">📖 Guías Relacionadas</span>
        <h3 class="rg-title">Aprende más y toma mejores decisiones</h3>
      </div>
      <div class="related-guides-grid">
        <a href="/blog/detectar-estafas-ofertas-trabajo-remoto-linkedin-telegram" class="related-guide-item">
          <span class="rgi-icon">🛡️</span>
          <div>
            <h4>Cómo identificar ofertas de empleo seguras y evitar fraudes</h4>
            <span class="rgi-read">6 min de lectura →</span>
          </div>
        </a>
        <a href="/blog/ganar-dinero-online-desde-casa-2026-reales" class="related-guide-item">
          <span class="rgi-icon">💼</span>
          <div>
            <h4>Opciones reales de teletrabajo para generar ingresos tras un cese</h4>
            <span class="rgi-read">7 min de lectura →</span>
          </div>
        </a>
        <a href="/blog/apps-ganar-dinero-extra-tiempo-libre-2026" class="related-guide-item">
          <span class="rgi-icon">⏳</span>
          <div>
            <h4>Proyectos y microtareas para generar ingresos en tu tiempo libre</h4>
            <span class="rgi-read">5 min de lectura →</span>
          </div>
        </a>
      </div>
    </div>

    <!-- HELPFUL CONTENT FEEDBACK -->
    <HelpfulFeedback targetName="esta Calculadora de Finiquito" />

  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--text-muted, #94a3b8);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--primary, #6366f1);
  }

  .tool-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .tool-icon-wrap {
    font-size: 2.8rem;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    flex-shrink: 0;
  }
  .tool-badge-top {
    font-size: 0.78rem;
    font-weight: 700;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .tool-title-wrap h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    font-weight: 800;
    margin: 0.3rem 0;
    color: var(--text, #f1f5f9);
    line-height: 1.2;
  }
  .tool-subtitle {
    color: var(--text-muted, #94a3b8);
    font-size: 0.95rem;
    max-width: 820px;
    margin: 0;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }
  @media (max-width: 900px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    border-radius: 1.2rem;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .card-title-row h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--text, #f1f5f9);
  }
  .btn-reset {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    color: var(--text-muted, #94a3b8);
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-reset:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .grid-2-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .input-group {
    margin-bottom: 1.25rem;
  }
  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text, #f1f5f9);
    margin-bottom: 0.4rem;
  }
  .input-unit-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-unit-wrapper input, .input-group select {
    width: 100%;
    padding: 0.75rem 3.5rem 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.15));
    border-radius: 0.6rem;
    color: var(--text, #f1f5f9);
    font-size: 1.1rem;
    font-weight: 700;
    box-sizing: border-box;
  }
  .input-group select {
    padding-right: 1rem;
    font-size: 0.95rem;
  }
  .input-unit-wrapper input:focus, .input-group select:focus {
    outline: none;
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
  }
  .unit-symbol {
    position: absolute;
    right: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted, #94a3b8);
  }

  /* RESULTS CARD */
  .result-card {
    background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
    border-color: rgba(245, 158, 11, 0.25);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .result-header h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--text, #f1f5f9);
  }
  .badge-live {
    font-size: 0.72rem;
    font-weight: 700;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.15);
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
  }

  .main-metric-box {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .main-price-row {
    margin-top: 0.4rem;
  }
  .main-amount {
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #fbbf24;
    line-height: 1.1;
    display: block;
  }
  .main-sub {
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    margin-top: 0.2rem;
    display: inline-block;
  }

  .secondary-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .sec-metric {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.85rem;
    border-radius: 0.75rem;
  }
  .sm-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 0.25rem;
  }
  .sm-val {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text, #f1f5f9);
  }

  .legal-badge-box {
    background: rgba(255, 255, 255, 0.02);
    border-left: 3px solid #f59e0b;
    padding: 0.75rem 1rem;
    border-radius: 0 0.5rem 0.5rem 0;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .lbb-icon { font-size: 1.1rem; }
  .lbb-text {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
    margin: 0;
    line-height: 1.4;
  }

  .tool-actions-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .btn-tool-action {
    width: 100%;
    padding: 0.7rem 1rem;
    border-radius: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
    text-align: center;
  }
  .btn-copy-summary {
    background: #f59e0b;
    color: #000000;
  }
  .btn-copy-summary:hover {
    background: #d97706;
  }
  .btn-print-sheet {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text, #f1f5f9);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.15));
  }
  .btn-print-sheet:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  .btn-embed-tool {
    background: transparent;
    color: var(--text-muted, #94a3b8);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    font-size: 0.8rem;
  }
  .btn-embed-tool:hover {
    border-color: #f59e0b;
    color: #f59e0b;
  }

  .embed-box {
    margin-top: 1rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    padding: 1rem;
  }
  .embed-desc {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
    margin: 0 0 0.5rem;
  }
  .embed-code {
    width: 100%;
    height: 70px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #93c5fd;
    font-family: monospace;
    font-size: 0.75rem;
    padding: 0.5rem;
    box-sizing: border-box;
    resize: none;
  }
  .btn-copy-embed {
    margin-top: 0.5rem;
    width: 100%;
    padding: 0.5rem;
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid #f59e0b;
    color: #ffffff;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  /* SEO GUIDE SECTION */
  .seo-guide-section {
    margin-top: 2rem;
