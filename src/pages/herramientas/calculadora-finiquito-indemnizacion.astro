<script>
  function initSeveranceCalculator() {
    const selectReason = document.getElementById('select-reason') as HTMLSelectElement;
    const inputSalary = document.getElementById('input-salary') as HTMLInputElement;
    const selectPagas = document.getElementById('select-pagas') as HTMLSelectElement;
    const inputYears = document.getElementById('input-years') as HTMLInputElement;
    const inputMonths = document.getElementById('input-months') as HTMLInputElement;
    const inputHolidays = document.getElementById('input-holidays') as HTMLInputElement;
    const inputMonthdays = document.getElementById('input-monthdays') as HTMLInputElement;

    const resTotalPayout = document.getElementById('res-total-payout');
    const resSalaryDay = document.getElementById('res-salary-day');
    const resIndemnity = document.getElementById('res-indemnity');
    const resFiniquito = document.getElementById('res-finiquito');
    const resPartMonth = document.getElementById('res-part-month');
    const resPartHolidays = document.getElementById('res-part-holidays');
    const resLegalNote = document.getElementById('res-legal-note');

    const btnReset = document.getElementById('btn-reset');
    const btnCopySummary = document.getElementById('btn-copy-summary');
    const btnPrintSheet = document.getElementById('btn-print-sheet');
    const btnToggleEmbed = document.getElementById('btn-toggle-embed');
    const embedBox = document.getElementById('embed-box');
    const btnCopyEmbed = document.getElementById('btn-copy-embed');

    if (!selectReason || !inputSalary) return;

    function formatEUR(val: number) {
      return new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(val);
    }

    function calculate() {
      const monthlySalary = parseFloat(inputSalary.value) || 0;
      const numPagas = parseInt(selectPagas.value, 10) || 12;
      const years = parseInt(inputYears.value, 10) || 0;
      const months = parseInt(inputMonths.value, 10) || 0;
      const holidayDays = parseInt(inputHolidays.value, 10) || 0;
      const workedDays = parseInt(inputMonthdays.value, 10) || 0;
      const reason = selectReason.value;

      // Annual salary calculation
      // If 14 pagas, annual is monthly * 14; if 12 pagas, monthly * 12
      const annualSalary = monthlySalary * numPagas;
      const dailySalary = annualSalary / 365;

      // Seniority in months (rounded up to next full month as per Spanish law)
      const totalMonths = (years * 12) + months;
      const effectiveYears = totalMonths / 12;

      // Indemnity calculation
      let daysPerYear = 0;
      let maxMonthsCap = 0;

      if (reason === 'improcedente') {
        daysPerYear = 33;
        maxMonthsCap = 24;
      } else if (reason === 'objetivo') {
        daysPerYear = 20;
        maxMonthsCap = 12;
      } else if (reason === 'temporal') {
        daysPerYear = 12;
        maxMonthsCap = 12;
      } else {
        daysPerYear = 0;
        maxMonthsCap = 0;
      }

      let indemnity = 0;
      if (daysPerYear > 0) {
        // Legal formula: daysPerYear * effectiveYears * dailySalary
        const rawIndemnity = daysPerYear * effectiveYears * dailySalary;
        const maxLimit = (annualSalary / 12) * maxMonthsCap;
        indemnity = Math.min(rawIndemnity, maxLimit);
      }

      // Finiquito items
      // 1. Worked days in month
      const workedSalary = (monthlySalary / 30) * Math.min(30, workedDays);

      // 2. Unused holidays payout (daily salary * holiday days)
      const holidayPayout = dailySalary * holidayDays;

      // 3. Pro-rated extra pay (if 14 pagas and devengadas)
      let extraPayDevengada = 0;
      if (numPagas === 14) {
        // Average estimation: 6 months semester cycle
        extraPayDevengada = (monthlySalary * 2) * (Math.min(6, (workedDays / 30)) / 6);
      }

      const totalFiniquito = workedSalary + holidayPayout + extraPayDevengada;
      const grandTotal = indemnity + totalFiniquito;

      // Update UI
      if (resSalaryDay) resSalaryDay.textContent = `Salario diario: ${dailySalary.toFixed(2)} €/día`;
      if (resTotalPayout) resTotalPayout.textContent = formatEUR(grandTotal);
      if (resIndemnity) resIndemnity.textContent = formatEUR(indemnity);
      if (resFiniquito) resFiniquito.textContent = formatEUR(totalFiniquito);
      if (resPartMonth) resPartMonth.textContent = formatEUR(workedSalary);
      if (resPartHolidays) resPartHolidays.textContent = formatEUR(holidayPayout);

      if (resLegalNote) {
        if (reason === 'voluntaria') {
          resLegalNote.textContent = 'En baja voluntaria no corresponde indemnización por despido, pero el cobro del finiquito es 100% obligatorio.';
        } else if (indemnity > 180000) {
          resLegalNote.textContent = 'Atención: La indemnización excede el tope de 180.000 €. La cantidad sobrante tributará en el IRPF.';
        } else {
          resLegalNote.textContent = 'Indemnización exenta de IRPF hasta 180.000 € (según art. 7.e de la Ley del IRPF formalizado ante el SMAC).';
        }
      }
    }

    [selectReason, inputSalary, selectPagas, inputYears, inputMonths, inputHolidays, inputMonthdays].forEach(el => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });

    // Reset
    btnReset?.addEventListener('click', () => {
      selectReason.value = 'improcedente';
      inputSalary.value = '1800';
      selectPagas.value = '12';
      inputYears.value = '3';
      inputMonths.value = '6';
      inputHolidays.value = '5';
      inputMonthdays.value = '15';
      calculate();
    });

    // Copy Summary
    btnCopySummary?.addEventListener('click', async () => {
      const total = resTotalPayout?.textContent || '';
      const indem = resIndemnity?.textContent || '';
      const fini = resFiniquito?.textContent || '';
      const type = selectReason.options[selectReason.selectedIndex].text;

      const text = `💼 *Cálculo de Finiquito e Indemnización Laboral*\n` +
                   `• Causa: ${type}\n` +
                   `• Indemnización por despido: ${indem}\n` +
                   `• Finiquito (días + vacaciones): ${fini}\n` +
                   `• *Total a liquidar:* ${total}\n` +
                   `Calculado en GuíaTecnes: https://guiatecnes.com/herramientas/calculadora-finiquito-indemnizacion`;
      try {
        await navigator.clipboard.writeText(text);
        btnCopySummary.textContent = '✅ ¡Copiado al portapapeles!';
        setTimeout(() => {
          btnCopySummary.textContent = '📋 Copiar Desglose para mi Asesor';
        }, 2000);
      } catch (e) {}
    });

    // Print
    btnPrintSheet?.addEventListener('click', () => window.print());

    // Embed Toggle
    btnToggleEmbed?.addEventListener('click', () => {
      if (!embedBox) return;
      embedBox.style.display = embedBox.style.display === 'none' ? 'block' : 'none';
    });

    // Copy Embed
    btnCopyEmbed?.addEventListener('click', async () => {
      const code = (document.getElementById('embed-code') as HTMLTextAreaElement)?.value || '';
      try {
        await navigator.clipboard.writeText(code);
        btnCopyEmbed.textContent = '✅ ¡Código Iframe Copiado!';
        setTimeout(() => {
          btnCopyEmbed.textContent = 'Copiar código iframe';
        }, 2000);
      } catch (e) {}
    });

    calculate();
  }

  document.addEventListener('astro:page-load', initSeveranceCalculator);
</script>
