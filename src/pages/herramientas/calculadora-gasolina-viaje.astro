---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Calculadora de Gasolina y Gasto de Viaje', url: '/herramientas/calculadora-gasolina-viaje' }
];

const faqs = [
  {
    question: '¿Cómo se calcula el gasto de gasolina de un viaje en coche?',
    answer: 'La fórmula exacta es: Gasto Total (€) = (Distancia en km / 100) × Consumo medio (L/100km) × Precio del litro (€). Si viajas con amigos o en coche compartido, divide el resultado entre el número total de ocupantes para obtener el coste por persona.'
  },
  {
    question: '¿Cuánto consume de media un coche de gasolina, diésel o híbrido?',
    answer: 'Un coche de gasolina medio suele consumir entre 6,0 y 7,5 litros cada 100 km. Un diésel eficiente ronda entre 4,5 y 5,5 L/100km, mientras que los híbridos no enchufables en ciudad y carretera mixta consumen entre 4,0 y 5,0 L/100km. Los todocaminos (SUV) y coches grandes pueden superar los 8,5 L/100km.'
  },
  {
    question: '¿Qué trucos reducen el consumo de combustible hasta un 20%?',
    answer: 'Mantener una velocidad constante en autovía (110-120 km/h en vez de 135 km/h ahorra hasta un 18%), revisar la presión correcta de los neumáticos, usar marchas largas, evitar acelerones bruscos y apagar el climatizador cuando no sea imprescindible son las pautas más efectivas.'
  },
  {
    question: '¿Cómo calcular el coste de compartir coche justamente?',
    answer: 'Nuestra calculadora suma los litros de combustible consumidos, el precio exacto en la gasolinera y los posibles peajes de autopista, dividiendo la factura equitativamente entre los pasajeros para evitar malentendidos en viajes largos.'
  }
];
---

<BaseLayout
  title="Calculadora de Gasolina y Gasto de Viaje 2026 | GuiaTecnEs"
  description="Calcula el coste de combustible en tus trayectos en coche, litros consumidos y precio a pagar por pasajero en España. Ahorra y comparte gastos fácilmente."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Calculadora de Gasolina y Viaje</span>
    </div>

    <!-- HEADER TOOL -->
    <div class="tool-header">
      <div class="tool-icon-wrap">🚗</div>
      <div class="tool-title-wrap">
        <span class="tool-badge-top">Finanzas & Movilidad</span>
        <h1>Calculadora de Gasolina y Gasto de Viaje</h1>
        <p class="tool-subtitle">Calcula con precisión los litros de combustible necesarios, el coste total del trayecto y el reparto equitativo por pasajero en coche compartido.</p>
      </div>
    </div>

    <!-- CALCULATOR MAIN CARD -->
    <div class="calc-grid">
      <!-- INPUT PANEL -->
      <div class="card input-card">
        <div class="card-title-row">
          <h2>Parámetros del Trayecto</h2>
          <button type="button" class="btn-reset" id="btn-reset" title="Restablecer valores">🔄 Reiniciar</button>
        </div>

        <!-- Presets trayectos populares -->
        <div class="presets-box">
          <span class="preset-title">Rutas populares en España:</span>
          <div class="presets-chips">
            <button type="button" class="preset-btn" data-km="620" data-route="Madrid - Barcelona">Madrid-Bcn (620 km)</button>
            <button type="button" class="preset-btn" data-km="355" data-route="Madrid - Valencia">Madrid-Vlc (355 km)</button>
            <button type="button" class="preset-btn" data-km="535" data-route="Madrid - Sevilla">Madrid-Sev (535 km)</button>
            <button type="button" class="preset-btn" data-km="205" data-route="Sevilla - Málaga">Sev-Málaga (205 km)</button>
          </div>
        </div>

        <!-- Distancia -->
        <div class="input-group">
          <div class="range-header">
            <label for="input-km">Distancia del viaje:</label>
            <span class="range-val" id="val-km-display">400 km</span>
          </div>
          <div class="input-unit-wrapper">
            <input type="number" id="input-km" value="400" min="1" max="10000" step="1" />
            <span class="unit-symbol">km</span>
          </div>
          <input type="range" id="range-km" min="10" max="1500" step="5" value="400" class="custom-range" />
        </div>

        <!-- Ida y vuelta toggle -->
        <div class="toggle-group">
          <label class="switch-container">
            <input type="checkbox" id="check-roundtrip" />
            <span class="slider-toggle"></span>
            <span class="toggle-label">Viaje de Ida y Vuelta (x2 distancia)</span>
          </label>
        </div>

        <!-- Consumo medio -->
        <div class="input-group">
          <div class="range-header">
            <label for="input-consumption">Consumo medio de tu coche:</label>
            <span class="range-val" id="val-consumption-display">6.5 L/100km</span>
          </div>
          <div class="input-unit-wrapper">
            <input type="number" id="input-consumption" value="6.5" min="2.0" max="25.0" step="0.1" />
            <span class="unit-symbol">L / 100km</span>
          </div>
          <div class="car-types-chips">
            <button type="button" class="car-chip" data-cons="4.4">🌱 Híbrido (4.4L)</button>
            <button type="button" class="car-chip" data-cons="5.2">⛽ Diésel (5.2L)</button>
            <button type="button" class="car-chip active" data-cons="6.5">🚗 Gasolina (6.5L)</button>
            <button type="button" class="car-chip" data-cons="8.0">🚙 SUV / Grande (8.0L)</button>
          </div>
        </div>

        <!-- Precio combustible -->
        <div class="input-group">
          <label for="input-price">Precio del combustible:</label>
          <div class="input-unit-wrapper">
            <input type="number" id="input-price" value="1.55" min="0.5" max="4.0" step="0.01" />
            <span class="unit-symbol">€ / litro</span>
          </div>
          <div class="fuel-price-chips">
            <button type="button" class="fuel-chip" data-price="1.55">Gasolina 95 (~1.55€)</button>
            <button type="button" class="fuel-chip" data-price="1.48">Diésel A (~1.48€)</button>
            <button type="button" class="fuel-chip" data-price="1.68">Gasolina 98 (~1.68€)</button>
          </div>
        </div>

        <!-- Pasajeros & Peajes -->
        <div class="grid-2-cols">
          <div class="input-group">
            <label for="input-passengers">Ocupantes en total:</label>
            <select id="input-passengers">
              <option value="1">1 (Solo conductor)</option>
              <option value="2">2 personas</option>
              <option value="3">3 personas</option>
              <option value="4" selected>4 personas</option>
              <option value="5">5 personas</option>
            </select>
          </div>
          <div class="input-group">
            <label for="input-tolls">Peajes / Extras (€):</label>
            <div class="input-unit-wrapper">
              <input type="number" id="input-tolls" value="0" min="0" max="500" step="1" />
              <span class="unit-symbol">€</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RESULTS PANEL -->
      <div class="card result-card">
        <div class="result-header">
          <h3>Resumen Estimado del Viaje</h3>
          <span class="badge-live">⚡ Cálculo en Vivo</span>
        </div>

        <div class="main-metric-box">
          <span class="metric-label">Coste por Persona:</span>
          <div class="main-price-row">
            <span class="main-amount" id="res-price-person">10.08 €</span>
            <span class="main-sub" id="res-person-badge">4 ocupantes</span>
          </div>
        </div>

        <div class="secondary-metrics-grid">
          <div class="sec-metric">
            <span class="sm-label">Total Combustible + Peajes:</span>
            <span class="sm-val" id="res-total-cost">40.30 €</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">Litros Consumidos:</span>
            <span class="sm-val" id="res-total-liters">26.0 L</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">Distancia Total:</span>
            <span class="sm-val" id="res-total-distance">400 km</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">Emisiones CO₂ Estimadas:</span>
            <span class="sm-val" id="res-total-co2">61.4 kg</span>
          </div>
        </div>

        <!-- BARRA VISUAL DE REPARTO -->
        <div class="share-breakdown-box">
          <div class="sbb-header">
            <span>Ahorro al compartir coche:</span>
            <strong id="res-saving-pct" style="color: #10b981;">Ahorras un 75%</strong>
          </div>
          <p class="sbb-desc">Viajando 4 personas ahorras <strong id="res-saving-amount">30.22 €</strong> frente a viajar solo.</p>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="tool-actions-box">
          <button type="button" class="btn-tool-action btn-copy-summary" id="btn-copy-summary">
            📋 Copiar resumen para WhatsApp
          </button>
          <button type="button" class="btn-tool-action btn-print-sheet" id="btn-print-sheet">
            📄 Imprimir / Guardar en PDF
          </button>
          <button type="button" class="btn-tool-action btn-embed-tool" id="btn-toggle-embed">
            ‹/› Insertar en tu Web
          </button>
        </div>

        <!-- EMBED MODAL SNIPPET -->
        <div class="embed-box" id="embed-box" style="display: none;">
          <p class="embed-desc">Copia y pega este código HTML en cualquier artículo o web:</p>
          <textarea readonly class="embed-code" id="embed-code">&lt;iframe src="https://guiatecnes.com/herramientas/calculadora-gasolina-viaje" width="100%" height="700" frameborder="0" style="border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.15);" title="Calculadora de Gasolina y Gasto de Viaje"&gt;&lt;/iframe&gt;
&lt;p style="font-size:12px;text-align:right;"&gt;Calculadora cortesía de &lt;a href="https://guiatecnes.com/herramientas/calculadora-gasolina-viaje" target="_blank" rel="noopener"&gt;GuíaTecnes&lt;/a&gt;&lt;/p&gt;</textarea>
          <button type="button" class="btn-copy-embed" id="btn-copy-embed">Copiar código iframe</button>
        </div>
      </div>
    </div>

    <!-- SEO GUIDE CONTENT & TIPS -->
    <section class="seo-guide-section card">
      <h2>Cómo calcular el gasto exacto de combustible en un viaje por carretera</h2>
      <p>Organizar una escapada de fin de semana, unas vacaciones o compartir coche a diario para ir al trabajo requiere una fórmula clara para que todos los ocupantes aporten su parte de manera justa. El coste real de la gasolina o el diésel no depende únicamente de la distancia, sino también de la orografía, la velocidad sostenida y la eficiencia del motor.</p>

      <div class="tips-grid">
        <div class="tip-card">
          <span class="tip-icon">⛽</span>
          <h3>Consumo Real vs Catálogo</h3>
          <p>Los consumos homologados WLTP de los fabricantes suelen ser un 15% inferiores a los de la conducción real en autopista con maletero cargado y aire acondicionado.</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">🛞</span>
          <h3>Presión de Neumáticos</h3>
          <p>Llevar una presión inferior a la recomendada en solo 0,5 bares incrementa el consumo de combustible hasta un 4% y acelera el desgaste del dibujo.</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">💨</span>
          <h3>Resistencia Aerodinámica</h3>
          <p>Llevar bacas, cofres de techo o circular con las ventanillas bajadas a más de 90 km/h aumenta drásticamente el rozamiento aerodinámico elevando el consumo.</p>
        </div>
      </div>

      <!-- FAQ ACCORDION -->
      <div class="faq-container">
        <h3>Preguntas Frecuentes sobre Consumo de Combustible y Gastos</h3>
        {faqs.map((faq, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--text-muted, #94a3b8);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--primary, #6366f1);
  }

  .tool-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .tool-icon-wrap {
    font-size: 2.8rem;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    flex-shrink: 0;
  }
  .tool-badge-top {
    font-size: 0.78rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .tool-title-wrap h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    font-weight: 800;
    margin: 0.3rem 0;
    color: var(--text, #f1f5f9);
    line-height: 1.2;
  }
  .tool-subtitle {
    color: var(--text-muted, #94a3b8);
    font-size: 0.95rem;
    max-width: 820px;
    margin: 0;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }
  @media (max-width: 900px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    border-radius: 1.2rem;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .card-title-row h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--text, #f1f5f9);
  }
  .btn-reset {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    color: var(--text-muted, #94a3b8);
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-reset:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .presets-box {
    margin-bottom: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .preset-title {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 0.4rem;
  }
  .presets-chips, .car-types-chips, .fuel-price-chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .preset-btn, .car-chip, .fuel-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted, #94a3b8);
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .preset-btn:hover, .car-chip:hover, .fuel-chip:hover {
    background: rgba(16, 185, 129, 0.15);
    border-color: #10b981;
    color: #ffffff;
  }
  .car-chip.active {
    background: #10b981;
    color: #ffffff;
    border-color: #10b981;
  }

  .input-group {
    margin-bottom: 1.25rem;
  }
  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text, #f1f5f9);
    margin-bottom: 0.4rem;
  }
  .range-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.3rem;
  }
  .range-header label { margin: 0; }
  .range-val {
    font-size: 0.95rem;
    font-weight: 800;
    color: #10b981;
  }
  .custom-range {
    width: 100%;
    accent-color: #10b981;
    cursor: pointer;
    margin-top: 0.5rem;
  }

  .input-unit-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .input-unit-wrapper input, .input-group select {
    width: 100%;
    padding: 0.75rem 4rem 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.15));
    border-radius: 0.6rem;
    color: var(--text, #f1f5f9);
    font-size: 1.15rem;
    font-weight: 700;
    box-sizing: border-box;
  }
  .input-group select {
    padding-right: 1rem;
    font-size: 0.95rem;
  }
  .input-unit-wrapper input:focus, .input-group select:focus {
    outline: none;
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }
  .unit-symbol {
    position: absolute;
    right: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted, #94a3b8);
  }

  .toggle-group {
    margin-bottom: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.6rem 0.9rem;
    border-radius: 0.6rem;
  }
  .switch-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    user-select: none;
  }
  .switch-container input {
    display: none;
  }
  .slider-toggle {
    width: 44px;
    height: 24px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    position: relative;
    transition: background 0.2s;
    flex-shrink: 0;
  }
  .slider-toggle::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    background: #ffffff;
    border-radius: 50%;
    top: 3px;
    left: 3px;
    transition: transform 0.2s;
  }
  .switch-container input:checked + .slider-toggle {
    background: #10b981;
  }
  .switch-container input:checked + .slider-toggle::after {
    transform: translateX(20px);
  }
  .toggle-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text, #f1f5f9);
  }

  .grid-2-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  /* RESULTS CARD */
  .result-card {
    background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
    border-color: rgba(16, 185, 129, 0.25);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .result-header h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--text, #f1f5f9);
  }
  .badge-live {
    font-size: 0.72rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.15);
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
  }

  .main-metric-box {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .main-price-row {
    margin-top: 0.4rem;
  }
  .main-amount {
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #10b981;
    line-height: 1.1;
    display: block;
  }
  .main-sub {
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    margin-top: 0.2rem;
    display: inline-block;
  }

  .secondary-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .sec-metric {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.85rem;
    border-radius: 0.75rem;
  }
  .sm-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 0.25rem;
  }
  .sm-val {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text, #f1f5f9);
  }

  .share-breakdown-box {
    background: rgba(255, 255, 255, 0.02);
    border-left: 3px solid #10b981;
    padding: 0.75rem 1rem;
    border-radius: 0 0.5rem 0.5rem 0;
    margin-bottom: 1.5rem;
  }
  .sbb-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
  }
  .sbb-desc {
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
    margin: 0;
  }

  .tool-actions-box {
    display: flex;
    flex-direction: column;
