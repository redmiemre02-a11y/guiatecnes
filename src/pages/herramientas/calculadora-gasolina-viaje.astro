  .btn-copy-embed {
    margin-top: 0.5rem;
    width: 100%;
    padding: 0.5rem;
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid #6366f1;
    color: #ffffff;
    border-radius: 6px;
