<script>
  function initFuelCalculator() {
    const inputKm = document.getElementById('input-km') as HTMLInputElement;
    const rangeKm = document.getElementById('range-km') as HTMLInputElement;
    const valKmDisplay = document.getElementById('val-km-display');

    const inputCons = document.getElementById('input-consumption') as HTMLInputElement;
    const valConsDisplay = document.getElementById('val-consumption-display');

    const inputPrice = document.getElementById('input-price') as HTMLInputElement;
    const inputPassengers = document.getElementById('input-passengers') as HTMLSelectElement;
    const inputTolls = document.getElementById('input-tolls') as HTMLInputElement;
    const checkRoundtrip = document.getElementById('check-roundtrip') as HTMLInputElement;

    const resPricePerson = document.getElementById('res-price-person');
    const resPersonBadge = document.getElementById('res-person-badge');
    const resTotalCost = document.getElementById('res-total-cost');
    const resTotalLiters = document.getElementById('res-total-liters');
    const resTotalDistance = document.getElementById('res-total-distance');
    const resTotalCo2 = document.getElementById('res-total-co2');
    const resSavingPct = document.getElementById('res-saving-pct');
    const resSavingAmount = document.getElementById('res-saving-amount');

    const btnReset = document.getElementById('btn-reset');
    const btnCopySummary = document.getElementById('btn-copy-summary');
    const btnPrintSheet = document.getElementById('btn-print-sheet');
    const btnToggleEmbed = document.getElementById('btn-toggle-embed');
    const embedBox = document.getElementById('embed-box');
    const btnCopyEmbed = document.getElementById('btn-copy-embed');

    if (!inputKm || !inputCons || !inputPrice) return;

    function calculate() {
      let km = parseFloat(inputKm.value) || 0;
      if (checkRoundtrip.checked) km *= 2;

      const cons = parseFloat(inputCons.value) || 0;
      const price = parseFloat(inputPrice.value) || 0;
      const passengers = parseInt(inputPassengers.value, 10) || 1;
      const tolls = parseFloat(inputTolls.value) || 0;

      const liters = (km / 100) * cons;
      const fuelCost = liters * price;
      const totalCost = fuelCost + tolls;
      const pricePerPerson = totalCost / passengers;
      const co2Kg = liters * 2.36; // Aprox 2.36 kg CO2 por litro de carburante

      // Render
      if (valKmDisplay) valKmDisplay.textContent = `${km} km${checkRoundtrip.checked ? ' (ida y vuelta)' : ''}`;
      if (valConsDisplay) valConsDisplay.textContent = `${cons.toFixed(1)} L/100km`;

      if (resPricePerson) resPricePerson.textContent = `${pricePerPerson.toFixed(2)} €`;
      if (resPersonBadge) resPersonBadge.textContent = `${passengers} ${passengers === 1 ? 'ocupante' : 'ocupantes'}`;
      if (resTotalCost) resTotalCost.textContent = `${totalCost.toFixed(2)} €`;
      if (resTotalLiters) resTotalLiters.textContent = `${liters.toFixed(1)} L`;
      if (resTotalDistance) resTotalDistance.textContent = `${km} km`;
      if (resTotalCo2) resTotalCo2.textContent = `${co2Kg.toFixed(1)} kg`;

      if (passengers > 1) {
        const savingAmount = totalCost - pricePerPerson;
        const savingPct = Math.round(((passengers - 1) / passengers) * 100);
        if (resSavingPct) resSavingPct.textContent = `Ahorras un ${savingPct}%`;
        if (resSavingAmount) resSavingAmount.textContent = `${savingAmount.toFixed(2)} €`;
      } else {
        if (resSavingPct) resSavingPct.textContent = `Viajando solo`;
        if (resSavingAmount) resSavingAmount.textContent = `0.00 €`;
      }
    }

    // Sync distance range & number input
    inputKm.addEventListener('input', () => {
      rangeKm.value = inputKm.value;
      calculate();
    });
    rangeKm.addEventListener('input', () => {
      inputKm.value = rangeKm.value;
      calculate();
    });

    [inputCons, inputPrice, inputPassengers, inputTolls, checkRoundtrip].forEach(el => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });

    // Preset routes
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const km = btn.getAttribute('data-km');
        if (km) {
          inputKm.value = km;
          rangeKm.value = km;
          calculate();
        }
      });
    });

    // Preset car chips
    const carChips = document.querySelectorAll('.car-chip');
    carChips.forEach(chip => {
      chip.addEventListener('click', () => {
        carChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        const cVal = chip.getAttribute('data-cons');
        if (cVal) {
          inputCons.value = cVal;
          calculate();
        }
      });
    });

    // Preset fuel chips
    document.querySelectorAll('.fuel-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const pVal = chip.getAttribute('data-price');
        if (pVal) {
          inputPrice.value = pVal;
          calculate();
        }
      });
    });

    // Reset button
    btnReset?.addEventListener('click', () => {
      inputKm.value = '400';
      rangeKm.value = '400';
      inputCons.value = '6.5';
      inputPrice.value = '1.55';
      inputPassengers.value = '4';
      inputTolls.value = '0';
      checkRoundtrip.checked = false;
      carChips.forEach(c => c.classList.toggle('active', c.getAttribute('data-cons') === '6.5'));
      calculate();
    });

    // Copy summary for WhatsApp
    btnCopySummary?.addEventListener('click', async () => {
      const perPerson = resPricePerson?.textContent || '';
      const total = resTotalCost?.textContent || '';
      const km = resTotalDistance?.textContent || '';
      const liters = resTotalLiters?.textContent || '';
      const pass = inputPassengers.value;

      const text = `🚗 *Gasto del Viaje en Coche (${km})*\n` +
                   `• Coste por persona (${pass} pax): *${perPerson}*\n` +
                   `• Total combustible + peajes: ${total} (${liters})\n` +
                   `Calculado en GuíaTecnes: https://guiatecnes.com/herramientas/calculadora-gasolina-viaje`;
      try {
        await navigator.clipboard.writeText(text);
        btnCopySummary.textContent = '✅ ¡Copiado para WhatsApp!';
        setTimeout(() => {
          btnCopySummary.textContent = '📋 Copiar resumen para WhatsApp';
        }, 2000);
      } catch (e) {}
    });

    // Print
    btnPrintSheet?.addEventListener('click', () => {
      window.print();
    });

    // Embed Toggle
    btnToggleEmbed?.addEventListener('click', () => {
      if (!embedBox) return;
      embedBox.style.display = embedBox.style.display === 'none' ? 'block' : 'none';
    });

    // Copy Embed
    btnCopyEmbed?.addEventListener('click', async () => {
      const code = (document.getElementById('embed-code') as HTMLTextAreaElement)?.value || '';
      try {
        await navigator.clipboard.writeText(code);
        btnCopyEmbed.textContent = '✅ ¡Código Iframe Copiado!';
        setTimeout(() => {
          btnCopyEmbed.textContent = 'Copiar código iframe';
        }, 2000);
      } catch (e) {}
    });

    calculate();
  }

  document.addEventListener('astro:page-load', initFuelCalculator);
</script>
