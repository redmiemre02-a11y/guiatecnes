<script>
  function initCompoundCalculator() {
    const inputInit = document.getElementById('input-initial') as HTMLInputElement;
    const rangeInit = document.getElementById('range-initial') as HTMLInputElement;
    const valInitDisplay = document.getElementById('val-initial-display');

    const inputMonthly = document.getElementById('input-monthly') as HTMLInputElement;
    const rangeMonthly = document.getElementById('range-monthly') as HTMLInputElement;
    const valMonthlyDisplay = document.getElementById('val-monthly-display');

    const inputRate = document.getElementById('input-rate') as HTMLInputElement;
    const rangeRate = document.getElementById('range-rate') as HTMLInputElement;
    const valRateDisplay = document.getElementById('val-rate-display');

    const inputYears = document.getElementById('input-years') as HTMLInputElement;
    const rangeYears = document.getElementById('range-years') as HTMLInputElement;
    const valYearsDisplay = document.getElementById('val-years-display');

    const resTotalBalance = document.getElementById('res-total-balance');
    const resYearsBadge = document.getElementById('res-years-badge');
    const resTotalPrincipal = document.getElementById('res-total-principal');
    const resTotalInterest = document.getElementById('res-total-interest');
    const resMultiplier = document.getElementById('res-multiplier');
    const resInterestPct = document.getElementById('res-interest-pct');

    const barPrinc = document.getElementById('bar-princ');
    const barInt = document.getElementById('bar-int');
    const txtBarPrinc = document.getElementById('txt-bar-princ');
    const txtBarInt = document.getElementById('txt-bar-int');

    const btnReset = document.getElementById('btn-reset');
    const btnToggleTable = document.getElementById('btn-toggle-table');
    const annualTableWrap = document.getElementById('annual-table-wrap');
    const btnCloseTable = document.getElementById('btn-close-table');
    const compoundTbody = document.getElementById('compound-tbody');
    const btnPrintSheet = document.getElementById('btn-print-sheet');
    const btnToggleEmbed = document.getElementById('btn-toggle-embed');
    const embedBox = document.getElementById('embed-box');
    const btnCopyEmbed = document.getElementById('btn-copy-embed');

    if (!inputInit || !inputMonthly || !inputRate || !inputYears) return;

    function formatEUR(val: number) {
      return new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(val);
    }

    function calculate() {
      const p = parseFloat(inputInit.value) || 0;
      const pmt = parseFloat(inputMonthly.value) || 0;
      const rateAnnual = (parseFloat(inputRate.value) || 0) / 100;
      const years = parseInt(inputYears.value, 10) || 1;

      // Compound calculation month by month
      const monthlyRate = rateAnnual / 12;
      const totalMonths = years * 12;

      let currentBalance = p;
      let totalDeposited = p;
      const annualData = [];

      for (let m = 1; m <= totalMonths; m++) {
        currentBalance = (currentBalance + pmt) * (1 + monthlyRate);
        totalDeposited += pmt;

        if (m % 12 === 0) {
          const yr = m / 12;
          annualData.push({
            year: yr,
            deposited: totalDeposited,
            balance: currentBalance,
            interestYear: currentBalance - totalDeposited
          });
        }
      }

      const totalInterest = Math.max(0, currentBalance - totalDeposited);
      const mult = totalDeposited > 0 ? (currentBalance / totalDeposited).toFixed(2) : '1.00';
      const intPct = currentBalance > 0 ? Math.round((totalInterest / currentBalance) * 100) : 0;
      const princPct = 100 - intPct;

      // Update UI displays
      if (valInitDisplay) valInitDisplay.textContent = formatEUR(p);
      if (valMonthlyDisplay) valMonthlyDisplay.textContent = `${formatEUR(pmt)} / mes`;
      if (valRateDisplay) valRateDisplay.textContent = `${(rateAnnual * 100).toFixed(1)}%`;
      if (valYearsDisplay) valYearsDisplay.textContent = `${years} años`;

      if (resTotalBalance) resTotalBalance.textContent = formatEUR(currentBalance);
      if (resYearsBadge) resYearsBadge.textContent = `en ${years} años`;
      if (resTotalPrincipal) resTotalPrincipal.textContent = formatEUR(totalDeposited);
      if (resTotalInterest) resTotalInterest.textContent = formatEUR(totalInterest);
      if (resMultiplier) resMultiplier.textContent = `${mult}x`;
      if (resInterestPct) resInterestPct.textContent = `${intPct}%`;

      if (barPrinc) barPrinc.style.width = `${princPct}%`;
      if (barInt) barInt.style.width = `${intPct}%`;
      if (txtBarPrinc) txtBarPrinc.textContent = `${princPct}%`;
      if (txtBarInt) txtBarInt.textContent = `${intPct}%`;

      // Fill table
      if (compoundTbody) {
        let prevInt = 0;
        compoundTbody.innerHTML = annualData.map(d => {
          const intThisYear = d.interestYear - prevInt;
          prevInt = d.interestYear;
          return `
            <tr>
              <td><strong>Año ${d.year}</strong></td>
              <td>${formatEUR(d.deposited)}</td>
              <td style="color:#34d399;">+${formatEUR(intThisYear)}</td>
              <td>${formatEUR(d.interestYear)}</td>
              <td><strong style="color:#a5b4fc;">${formatEUR(d.balance)}</strong></td>
            </tr>
          `;
        }).join('');
      }
    }

    // Two-way bindings
    function bindSlider(num: HTMLInputElement, range: HTMLInputElement) {
      num.addEventListener('input', () => { range.value = num.value; calculate(); });
      range.addEventListener('input', () => { num.value = range.value; calculate(); });
    }

    bindSlider(inputInit, rangeInit);
    bindSlider(inputMonthly, rangeMonthly);
    bindSlider(inputRate, rangeRate);
    bindSlider(inputYears, rangeYears);

    // Presets
    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const r = btn.getAttribute('data-rate');
        const y = btn.getAttribute('data-years');
        if (r) { inputRate.value = r; rangeRate.value = r; }
        if (y) { inputYears.value = y; rangeYears.value = y; }
        calculate();
      });
    });

    // Reset
    btnReset?.addEventListener('click', () => {
      inputInit.value = '3000'; rangeInit.value = '3000';
      inputMonthly.value = '200'; rangeMonthly.value = '200';
      inputRate.value = '8.0'; rangeRate.value = '8';
      inputYears.value = '20'; rangeYears.value = '20';
      presetBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-rate') === '8'));
      calculate();
    });

    // Toggle Table
    btnToggleTable?.addEventListener('click', () => {
      if (!annualTableWrap) return;
      annualTableWrap.style.display = annualTableWrap.style.display === 'none' ? 'block' : 'none';
      if (annualTableWrap.style.display === 'block') {
        annualTableWrap.scrollIntoView({ behavior: 'smooth' });
      }
    });

    btnCloseTable?.addEventListener('click', () => {
      if (annualTableWrap) annualTableWrap.style.display = 'none';
    });

    // Print
    btnPrintSheet?.addEventListener('click', () => window.print());

    // Embed Toggle
    btnToggleEmbed?.addEventListener('click', () => {
      if (!embedBox) return;
      embedBox.style.display = embedBox.style.display === 'none' ? 'block' : 'none';
    });

    // Copy Embed
    btnCopyEmbed?.addEventListener('click', async () => {
      const code = (document.getElementById('embed-code') as HTMLTextAreaElement)?.value || '';
      try {
        await navigator.clipboard.writeText(code);
        btnCopyEmbed.textContent = '✅ ¡Código Iframe Copiado!';
        setTimeout(() => {
          btnCopyEmbed.textContent = 'Copiar código iframe';
        }, 2000);
      } catch (e) {}
    });

    calculate();
  }

  document.addEventListener('astro:page-load', initCompoundCalculator);
</script>
