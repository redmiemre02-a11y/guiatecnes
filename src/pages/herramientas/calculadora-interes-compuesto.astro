---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LegalDisclaimer from '../../components/LegalDisclaimer.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Calculadora de Interés Compuesto', url: '/herramientas/calculadora-interes-compuesto' }
];

const faqs = [
  {
    question: '¿Qué es el interés compuesto y cómo funciona?',
    answer: 'El interés compuesto es aquel en el que los rendimientos o intereses generados en cada periodo se reinvierten y se suman al capital inicial para generar nuevos intereses en los periodos siguientes. A diferencia del interés simple, el dinero crece de forma exponencial con el paso de los años.'
  },
  {
    question: '¿Cuál es la fórmula matemática del interés compuesto?',
    answer: 'La fórmula con aportaciones periódicas es: A = P(1 + r/n)^(nt) + PMT × [((1 + r/n)^(nt) - 1) / (r/n)], donde P es el capital inicial, PMT la aportación mensual, r la tasa anual de rentabilidad, n la frecuencia de capitalización (12 para mensual) y t los años de inversión.'
  },
  {
    question: '¿Qué rentabilidad anual media es realista esperar?',
    answer: 'Históricamente, los índices bursátiles globales como el MSCI World o el S&P 500 han obtenido rentabilidades medias anualizadas de entre el 7% y el 10% a largo plazo (20-30 años). En carteras más conservadoras o fondos monetarios, suele oscilar entre el 2,5% y el 4%.'
  },
  {
    question: '¿Por qué el tiempo es el factor más decisivo en la inversión?',
    answer: 'Debido al efecto exponencial (bola de nieve), los últimos años de inversión generan infinitamente más beneficios que los primeros. Comenzar a invertir 10 años antes puede llegar a duplicar o triplicar el patrimonio final incluso aportando menos dinero total.'
  }
];
---

<BaseLayout
  title="Calculadora de Interés Compuesto e Inversión 2026 | GuiaTecnEs"
  description="Calcula el crecimiento exponencial de tus ahorros con interés compuesto, aportaciones mensuales y gráfico visual. Simula fondos indexados, ETFs y planes de inversión."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Calculadora de Interés Compuesto</span>
    </div>

    <!-- HEADER TOOL -->
    <div class="tool-header">
      <div class="tool-icon-wrap">📈</div>
      <div class="tool-title-wrap">
        <span class="tool-badge-top">Finanzas & Inversión</span>
        <h1>Calculadora de Interés Compuesto</h1>
        <p class="tool-subtitle">Simula el efecto de la «octava maravilla del mundo»: observa cómo tus ahorros crecen exponencialmente mes a mes gracias a la reinversión de dividendos y rendimientos.</p>
      </div>
    </div>

    <!-- CALCULATOR MAIN GRID -->
    <div class="calc-grid">
      <!-- INPUT PANEL -->
      <div class="card input-card">
        <div class="card-title-row">
          <h2>Parámetros de Inversión</h2>
          <button type="button" class="btn-reset" id="btn-reset" title="Restablecer valores">🔄 Reiniciar</button>
        </div>

        <!-- Presets Perfiles -->
        <div class="presets-box">
          <span class="preset-title">Estrategias de inversión predefinidas:</span>
          <div class="presets-chips">
            <button type="button" class="preset-btn" data-rate="4" data-years="10">🛡️ Conservador (4% a 10 años)</button>
            <button type="button" class="preset-btn active" data-rate="8" data-years="20">🚀 Indexado Global (8% a 20 años)</button>
            <button type="button" class="preset-btn" data-rate="10" data-years="30">💎 S&P 500 Largo Plazo (10% a 30 años)</button>
          </div>
        </div>

        <!-- Capital Inicial -->
        <div class="input-group">
          <div class="range-header">
            <label for="input-initial">Depósito inicial:</label>
            <span class="range-val" id="val-initial-display">3.000 €</span>
          </div>
          <div class="input-unit-wrapper">
            <input type="number" id="input-initial" value="3000" min="0" max="1000000" step="100" />
            <span class="unit-symbol">€</span>
          </div>
          <input type="range" id="range-initial" min="0" max="50000" step="500" value="3000" class="custom-range" />
        </div>

        <!-- Aportación Mensual -->
        <div class="input-group">
          <div class="range-header">
            <label for="input-monthly">Aportación periódica mensual:</label>
            <span class="range-val" id="val-monthly-display">200 € / mes</span>
          </div>
          <div class="input-unit-wrapper">
            <input type="number" id="input-monthly" value="200" min="0" max="10000" step="10" />
            <span class="unit-symbol">€ / mes</span>
          </div>
          <input type="range" id="range-monthly" min="0" max="2000" step="25" value="200" class="custom-range" />
        </div>

        <!-- Rentabilidad Anual -->
        <div class="input-group">
          <div class="range-header">
            <label for="input-rate">Rentabilidad anual estimada:</label>
            <span class="range-val" id="val-rate-display">8.0%</span>
          </div>
          <div class="input-unit-wrapper">
            <input type="number" id="input-rate" value="8.0" min="0.5" max="30.0" step="0.1" />
            <span class="unit-symbol">% anual</span>
          </div>
          <input type="range" id="range-rate" min="1" max="20" step="0.5" value="8" class="custom-range" />
        </div>

        <!-- Plazo de Inversión -->
        <div class="input-group">
          <div class="range-header">
            <label for="input-years">Plazo de inversión:</label>
            <span class="range-val" id="val-years-display">20 años</span>
          </div>
          <div class="input-unit-wrapper">
            <input type="number" id="input-years" value="20" min="1" max="50" step="1" />
            <span class="unit-symbol">años</span>
          </div>
          <input type="range" id="range-years" min="1" max="45" step="1" value="20" class="custom-range" />
        </div>
      </div>

      <!-- RESULTS PANEL -->
      <div class="card result-card">
        <div class="result-header">
          <h3>Proyección Final Acumulada</h3>
          <span class="badge-live">⚡ Cálculo Exponencial</span>
        </div>

        <div class="main-metric-box">
          <span class="metric-label">Patrimonio Total al Finalizar:</span>
          <div class="main-price-row">
            <span class="main-amount" id="res-total-balance">126.314 €</span>
            <span class="main-sub" id="res-years-badge">en 20 años</span>
          </div>
        </div>

        <div class="secondary-metrics-grid">
          <div class="sec-metric">
            <span class="sm-label">Total Aportado (Tu Bolsillo):</span>
            <span class="sm-val" id="res-total-principal" style="color: #60a5fa;">51.000 €</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">Intereses Generados (Ganancia):</span>
            <span class="sm-val" id="res-total-interest" style="color: #34d399;">75.314 €</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">Multiplicador de Inversión:</span>
            <span class="sm-val" id="res-multiplier">2.48x</span>
          </div>
          <div class="sec-metric">
            <span class="sm-label">% Intereses sobre el Total:</span>
            <span class="sm-val" id="res-interest-pct">59.6%</span>
          </div>
        </div>

        <!-- VISUAL PROGRESS BAR COMPARISON -->
        <div class="visual-bar-wrap">
          <div class="vb-labels">
            <span class="vb-leg vb-princ">● Capital aportado (<span id="txt-bar-princ">40%</span>)</span>
            <span class="vb-leg vb-int">● Interés ganado (<span id="txt-bar-int">60%</span>)</span>
          </div>
          <div class="compound-bar">
            <div class="bar-part-princ" id="bar-princ" style="width: 40.4%;"></div>
            <div class="bar-part-int" id="bar-int" style="width: 59.6%;"></div>
          </div>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="tool-actions-box">
          <button type="button" class="btn-tool-action btn-copy-summary" id="btn-toggle-table">
            📊 Ver Tabla Detallada Año a Año
          </button>
          <button type="button" class="btn-tool-action btn-print-sheet" id="btn-print-sheet">
            📄 Imprimir / Guardar en PDF
          </button>
          <button type="button" class="btn-tool-action btn-embed-tool" id="btn-toggle-embed">
            ‹/› Insertar en tu Web
          </button>
        </div>

        <!-- EMBED MODAL SNIPPET -->
        <div class="embed-box" id="embed-box" style="display: none;">
          <p class="embed-desc">Copia y pega este código HTML en cualquier artículo o blog financiero:</p>
          <textarea readonly class="embed-code" id="embed-code">&lt;iframe src="https://guiatecnes.com/herramientas/calculadora-interes-compuesto" width="100%" height="720" frameborder="0" style="border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.15);" title="Calculadora de Interés Compuesto"&gt;&lt;/iframe&gt;
&lt;p style="font-size:12px;text-align:right;"&gt;Calculadora cortesía de &lt;a href="https://guiatecnes.com/herramientas/calculadora-interes-compuesto" target="_blank" rel="noopener"&gt;GuíaTecnes&lt;/a&gt;&lt;/p&gt;</textarea>
          <button type="button" class="btn-copy-embed" id="btn-copy-embed">Copiar código iframe</button>
        </div>
      </div>
    </div>

    <!-- ANNUAL TABLE BREAKDOWN ACCORDION -->
    <div class="annual-table-card card" id="annual-table-wrap" style="display: none; margin-bottom: 2.5rem;">
      <div class="table-header-row">
        <h3>Evolución Anual del Patrimonio y Ganancias</h3>
        <button type="button" class="btn-close-table" id="btn-close-table">✕ Cerrar</button>
      </div>
      <div class="table-responsive">
        <table class="compound-table">
          <thead>
            <tr>
              <th>Año</th>
              <th>Aportación Acumulada</th>
              <th>Interés Anual Generado</th>
              <th>Interés Total Acumulado</th>
              <th>Saldo Final al Cierre</th>
            </tr>
          </thead>
          <tbody id="compound-tbody">
            <!-- Dynamic rows -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- SEO GUIDE CONTENT & TIPS -->
    <section class="seo-guide-section card">
      <h2>Cómo aprovechar la magia del interés compuesto para alcanzar la libertad financiera</h2>
      <p>El interés compuesto es el motor patrimonial más potente de la economía moderna. Albert Einstein lo definió célebremente como la mayor fuerza del universo: «quien lo entiende, lo gana; quien no, lo paga». A diferencia de tener los ahorros parados en una cuenta bancaria perdiendo valor por la inflación, el interés compuesto transforma pequeñas aportaciones periódicas en capitales considerables.</p>

      <div class="tips-grid">
        <div class="tip-card">
          <span class="tip-icon">⏳</span>
          <h3>El Tiempo es Oro</h3>
          <p>Comenzar a invertir 100€ al mes a los 25 años genera más del doble de dinero que empezar con 200€ al mes a los 40 años gracias al número de ciclos de capitalización.</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">🔁</span>
          <h3>Reinversión Sistemática</h3>
          <p>Para que la fórmula funcione al 100%, nunca retires los dividendos ni intereses en los primeros años: reinviértelos automáticamente en el fondo para que formen parte de la base de cálculo.</p>
        </div>
        <div class="tip-card">
          <span class="tip-icon">📉</span>
          <h3>Comisiones Bajas</h3>
          <p>Una comisión bancaria del 2% puede comerse más del 40% de tus ganancias a 30 años. Opta por fondos indexados o ETFs de coste ultra bajo (TER menor al 0,25%).</p>
        </div>
      </div>

      <!-- FAQ ACCORDION -->
      <div class="faq-container">
        <h3>Preguntas Frecuentes sobre Interés Compuesto e Inversión</h3>
        {faqs.map((faq, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    
    <!-- AVISO LEGAL Y RESPONSABILIDAD -->
    <LegalDisclaimer type="finance" />

    <!-- TOPIC CLUSTER: RELATED ARTICLES -->
    <div class="card related-guides-card">
      <div class="rg-header">
        <span class="rg-badge">📖 Guías Relacionadas</span>
        <h3 class="rg-title">Aprende más y toma mejores decisiones</h3>
      </div>
      <div class="related-guides-grid">
        <a href="/blog/ingresos-pasivos-desde-casa-poco-dinero-2026" class="related-guide-item">
          <span class="rgi-icon">💎</span>
          <div>
            <h4>Cómo generar ingresos pasivos y multiplicar tu capital desde casa</h4>
            <span class="rgi-read">8 min de lectura →</span>
          </div>
        </a>
        <a href="/blog/apps-controlar-gastos-no-quedarse-sin-dinero" class="related-guide-item">
          <span class="rgi-icon">📊</span>
          <div>
            <h4>Control sistemático de gastos para aumentar tu capacidad de ahorro</h4>
            <span class="rgi-read">5 min de lectura →</span>
          </div>
        </a>
        <a href="/blog/declarar-criptomonedas-renta-espana-2026" class="related-guide-item">
          <span class="rgi-icon">⚖️</span>
          <div>
            <h4>Fiscalidad de inversiones y cuentas remuneradas en España</h4>
            <span class="rgi-read">6 min de lectura →</span>
          </div>
        </a>
      </div>
    </div>

    <!-- HELPFUL CONTENT FEEDBACK -->
    <HelpfulFeedback targetName="esta Calculadora de Interés Compuesto" />

  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--text-muted, #94a3b8);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--primary, #6366f1);
  }

  .tool-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .tool-icon-wrap {
    font-size: 2.8rem;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.3);
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    flex-shrink: 0;
  }
  .tool-badge-top {
    font-size: 0.78rem;
    font-weight: 700;
    color: #818cf8;
    background: rgba(99, 102, 241, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .tool-title-wrap h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    font-weight: 800;
    margin: 0.3rem 0;
    color: var(--text, #f1f5f9);
    line-height: 1.2;
  }
  .tool-subtitle {
    color: var(--text-muted, #94a3b8);
    font-size: 0.95rem;
    max-width: 820px;
    margin: 0;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }
  @media (max-width: 900px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    border-radius: 1.2rem;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .card-title-row h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--text, #f1f5f9);
  }
  .btn-reset {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    color: var(--text-muted, #94a3b8);
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-reset:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .presets-box {
    margin-bottom: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .preset-title {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 0.4rem;
  }
  .presets-chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .preset-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted, #94a3b8);
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .preset-btn:hover {
    background: rgba(99, 102, 241, 0.15);
    border-color: #6366f1;
    color: #ffffff;
  }
  .preset-btn.active {
    background: #6366f1;
    color: #ffffff;
    border-color: #6366f1;
  }

  .input-group {
    margin-bottom: 1.25rem;
  }
  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text, #f1f5f9);
    margin-bottom: 0.4rem;
  }
  .range-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.3rem;
  }
  .range-header label { margin: 0; }
  .range-val {
    font-size: 0.95rem;
    font-weight: 800;
    color: #818cf8;
  }
  .custom-range {
    width: 100%;
    accent-color: #6366f1;
    cursor: pointer;
    margin-top: 0.5rem;
  }

  .input-unit-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .input-unit-wrapper input {
    width: 100%;
    padding: 0.75rem 4.5rem 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.15));
    border-radius: 0.6rem;
    color: var(--text, #f1f5f9);
    font-size: 1.15rem;
    font-weight: 700;
    box-sizing: border-box;
  }
  .input-unit-wrapper input:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  }
  .unit-symbol {
    position: absolute;
    right: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted, #94a3b8);
  }

  /* RESULTS CARD */
  .result-card {
    background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
    border-color: rgba(99, 102, 241, 0.25);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .result-header h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--text, #f1f5f9);
  }
  .badge-live {
    font-size: 0.72rem;
    font-weight: 700;
    color: #818cf8;
    background: rgba(99, 102, 241, 0.15);
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
  }

  .main-metric-box {
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .main-price-row {
    margin-top: 0.4rem;
  }
  .main-amount {
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #a5b4fc;
    line-height: 1.1;
    display: block;
  }
  .main-sub {
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    margin-top: 0.2rem;
    display: inline-block;
  }

  .secondary-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .sec-metric {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.85rem;
    border-radius: 0.75rem;
  }
  .sm-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 0.25rem;
  }
  .sm-val {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text, #f1f5f9);
  }

  /* BAR PROPORTION */
  .visual-bar-wrap {
    margin-bottom: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    padding: 0.85rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  .vb-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .vb-princ { color: #60a5fa; }
