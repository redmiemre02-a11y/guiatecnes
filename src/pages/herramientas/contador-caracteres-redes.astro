  .faq-question {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-heading, #f8fafc);
  }

  .faq-answer {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
  }
</style>

<script>
  function initSocialCounter() {
    const input = document.getElementById('social-text-input') as HTMLTextAreaElement;
    if (!input) return;

    // General stats
    const statChars = document.getElementById('stat-chars');
    const statCharsNoSpaces = document.getElementById('stat-chars-no-spaces');
    const statWords = document.getElementById('stat-words');
    const statParagraphs = document.getElementById('stat-paragraphs');
    const statHashtags = document.getElementById('stat-hashtags');
    const statReadingTime = document.getElementById('stat-reading-time');

    // Platforms config
    const platforms = [
      { id: 'x', max: 280, name: 'X (Twitter)' },
      { id: 'ig-bio', max: 150, name: 'Instagram Bio' },
      { id: 'ig-post', max: 2200, name: 'Instagram Post' },
      { id: 'tiktok', max: 2200, name: 'TikTok' },
      { id: 'linkedin', max: 3000, name: 'LinkedIn' },
      { id: 'yt-title', max: 100, name: 'YouTube Título' },
      { id: 'fb', max: 63206, name: 'Facebook' },
    ];

    function update() {
      const text = input.value;
      const totalChars = text.length;
      const charsNoSpaces = text.replace(/\s+/g, '').length;

      // Words
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;

      // Paragraphs
      const paragraphs = text.trim() ? text.split(/\n+/).filter(p => p.trim().length > 0).length : 0;

      // Hashtags
      const hashtagsMatch = text.match(/#[a-zA-Z0-9_\u00C0-\u017F]+/g);
      const hashtagsCount = hashtagsMatch ? hashtagsMatch.length : 0;

      // Reading time (average 200 words per minute)
      const minutes = Math.max(1, Math.ceil(words / 200));

      if (statChars) statChars.textContent = totalChars.toLocaleString('es-ES');
      if (statCharsNoSpaces) statCharsNoSpaces.textContent = charsNoSpaces.toLocaleString('es-ES');
      if (statWords) statWords.textContent = words.toLocaleString('es-ES');
      if (statParagraphs) statParagraphs.textContent = paragraphs.toString();
      if (statHashtags) statHashtags.textContent = hashtagsCount.toString();
      if (statReadingTime) statReadingTime.textContent = words > 0 ? `${minutes} min` : '0 min';

      // Update each platform bar
      platforms.forEach(p => {
        const cntEl = document.getElementById(`cnt-${p.id}`);
        const barEl = document.getElementById(`bar-${p.id}`);
        const fbEl = document.getElementById(`fb-${p.id}`);

        if (cntEl) cntEl.textContent = totalChars.toLocaleString('es-ES');

        const pct = Math.min(100, (totalChars / p.max) * 100);
        if (barEl) {
          barEl.style.width = `${pct}%`;
          barEl.classList.remove('warning', 'danger');

          if (totalChars > p.max) {
            barEl.classList.add('danger');
          } else if (totalChars > p.max * 0.85) {
            barEl.classList.add('warning');
          }
        }

        if (fbEl) {
          fbEl.classList.remove('over-limit');
          if (p.id === 'fb') {
            fbEl.textContent = 'Límite prácticamente ilimitado';
          } else if (totalChars > p.max) {
            const diff = totalChars - p.max;
            fbEl.textContent = `⚠️ Te pasas por ${diff} ${diff === 1 ? 'carácter' : 'caracteres'}`;
            fbEl.classList.add('over-limit');
          } else {
            const remaining = p.max - totalChars;
            fbEl.textContent = `${remaining.toLocaleString('es-ES')} caracteres restantes`;
          }
        }
      });
    }

    input.addEventListener('input', update);

    // Emoji chips
    document.querySelectorAll('.emoji-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        const emoji = btn.getAttribute('data-emoji') || '';
        const start = input.selectionStart || input.value.length;
        const end = input.selectionEnd || input.value.length;
        input.value = input.value.substring(0, start) + emoji + input.value.substring(end);
        input.selectionStart = input.selectionEnd = start + emoji.length;
        input.focus();
        update();
      });
    });

    // Copy text
    const btnCopy = document.getElementById('btn-copy-text');
    btnCopy?.addEventListener('click', async () => {
      if (!input.value) return;
      try {
        await navigator.clipboard.writeText(input.value);
        const originalText = btnCopy.textContent;
        btnCopy.textContent = '✅ ¡Copiado!';
        setTimeout(() => {
          btnCopy.textContent = originalText;
        }, 1500);
      } catch (e) {}
    });

    // Clear text
    const btnClear = document.getElementById('btn-clear-text');
    btnClear?.addEventListener('click', () => {
      input.value = '';
      update();
      input.focus();
    });

    update();
  }

  document.addEventListener('astro:page-load', initSocialCounter);
</script>
