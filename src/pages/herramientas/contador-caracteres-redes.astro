  .progress-bar {
    height: 100%;
    background: #10b981;
    border-radius: 9999px;
    transition: width 0.15s ease, background-color 0.15s ease;
  }

  .progress-bar.warning {
    background: #f59e0b;
  }

  .progress-bar.danger {
    background: #ef4444;
  }

  .net-feedback {
    font-size: 0.78rem;
    color: var(--text-muted, #94a3b8);
  }

  .net-feedback.over-limit {
    color: #ef4444;
    font-weight: 700;
  }

  /* SEO & FAQS */
  .seo-guide-section, .faq-section {
    margin-top: 2rem;
  }

  .seo-guide-section h2, .faq-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading, #f8fafc);
    margin-bottom: 1rem;
  }

  .seo-guide-section p {
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .limits-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .limits-table th, .limits-table td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color, #334155);
  }

  .limits-table th {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-heading, #f8fafc);
  }

  .limits-table td {
    color: var(--text-muted, #94a3b8);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.65rem;
    padding: 0.85rem 1.15rem;
