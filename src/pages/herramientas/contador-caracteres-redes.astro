  }

  .net-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .net-name {
    font-weight: 700;
    color: var(--text-heading, #f8fafc);
    display: flex;
