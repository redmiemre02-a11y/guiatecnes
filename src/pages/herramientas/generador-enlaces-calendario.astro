---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Generador de Enlaces para Google Calendar y Outlook | GuíaTecnológica";
const description = "Crea enlaces directos para añadir eventos a Google Calendar, Outlook y Apple iCal con un solo clic. Ideal para newsletters, webs y WhatsApp.";
---

<BaseLayout title={title} description={description}>
  <main class="tool-container">
    <div class="tool-header">
      <nav class="breadcrumb">
        <a href="/">Inicio</a> &gt; <a href="/herramientas">Herramientas</a> &gt; <span>Enlaces de Calendario</span>
      </nav>
      <span class="badge">📅 Productividad & Eventos</span>
      <h1>Generador de Enlaces de Calendario</h1>
      <p class="tool-desc">
        Genera enlaces universales "Añadir a mi calendario" para Google Calendar, Outlook.com, Office 365 o descarga el archivo estándar `.ics` para Apple Calendar.
      </p>
    </div>

    <div class="calculator-card">
      <div class="form-grid">
        <div class="input-group">
          <label for="eventTitle">Título del evento:</label>
          <input type="text" id="eventTitle" value="Reunión de Proyecto / Lanzamiento Web" placeholder="Ej. Webinar de Marketing o Sesión con Cliente" />
        </div>

        <div class="grid-2col">
          <div class="input-group">
            <label for="startDate">Fecha y hora de inicio:</label>
            <input type="datetime-local" id="startDate" />
          </div>

          <div class="input-group">
            <label for="endDate">Fecha y hora de finalización:</label>
            <input type="datetime-local" id="endDate" />
          </div>
        </div>

        <div class="input-group">
          <label for="eventLocation">Ubicación (o enlace de videollamada):</label>
          <input type="text" id="eventLocation" value="Google Meet / Zoom (online)" placeholder="Ej. Calle Mayor 12 o enlace meet.google.com/xyz" />
        </div>

        <div class="input-group">
          <label for="eventDesc">Descripción o notas:</label>
          <textarea id="eventDesc" rows="3" placeholder="Detalles de la sesión, temario o enlaces de interés..."></textarea>
        </div>
      </div>

      <div class="results-box">
        <h3>Enlaces Directos Generados</h3>

        <div class="buttons-list">
          <div class="link-item">
            <div class="link-info">
              <span class="link-title">Google Calendar</span>
              <small>Abre la app o web de Google con el evento prerrellenado</small>
            </div>
            <div class="link-actions">
              <a id="btnGoogle" href="#" target="_blank" rel="noopener" class="action-btn btn-primary">Abrir</a>
              <button type="button" class="action-btn btn-secondary" onclick="copyLink('btnGoogle')">Copiar Enlace</button>
            </div>
          </div>

          <div class="link-item">
            <div class="link-info">
              <span class="link-title">Microsoft Outlook / Office 365</span>
              <small>Compatible con cuentas personales @outlook y corporativas 365</small>
            </div>
            <div class="link-actions">
              <a id="btnOutlook" href="#" target="_blank" rel="noopener" class="action-btn btn-primary">Abrir</a>
              <button type="button" class="action-btn btn-secondary" onclick="copyLink('btnOutlook')">Copiar Enlace</button>
            </div>
          </div>

          <div class="link-item">
            <div class="link-info">
              <span class="link-title">Apple Calendar / Móviles (.ICS)</span>
              <small>Descarga el archivo estándar compatible con iPhone, Mac y Thunderbird</small>
            </div>
            <div class="link-actions">
              <button type="button" id="btnDownloadIcs" class="action-btn btn-success">Descargar .ICS</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="tool-explanation">
      <h2>¿Por qué usar enlaces directos de calendario?</h2>
      <p>
        Si envías un correo electrónico o un mensaje de WhatsApp a un cliente diciendo *"Te esperamos el jueves a las 18:00"*, más del **40% de las personas olvidan agendarlo manualment** y no asisten.
      </p>
      <p>
        Al incluir un enlace directo generado con esta herramienta, el usuario solo tiene que pulsar un botón para que el evento quede automáticamente registrado en su móvil con sus alertas y recordatorios de 10 minutos activados.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  // Set default dates: tomorrow at 10:00 to 11:00
  const now = new Date();
  const tomorrow = new Date(now);
  tomorrow.setDate(tomorrow.getDate() + 1);
  tomorrow.setHours(10, 0, 0, 0);

  const tomorrowEnd = new Date(tomorrow);
  tomorrowEnd.setHours(11, 0, 0, 0);

  const toInputDate = (d: Date) => {
    const pad = (n: number) => n < 10 ? '0' + n : n;
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  };

  const startInput = document.getElementById('startDate') as HTMLInputElement;
  const endInput = document.getElementById('endDate') as HTMLInputElement;

  if (startInput && endInput) {
    startInput.value = toInputDate(tomorrow);
    endInput.value = toInputDate(tomorrowEnd);
  }

  function formatIsoUtc(dateStr: string): string {
    const d = new Date(dateStr);
    return d.toISOString().replace(/-|:|\.\d\d\d/g, "");
  }

  function updateLinks() {
    const title = (document.getElementById('eventTitle') as HTMLInputElement).value || "Evento";
    const start = startInput.value;
    const end = endInput.value;
    const location = (document.getElementById('eventLocation') as HTMLInputElement).value || "";
    const desc = (document.getElementById('eventDesc') as HTMLTextAreaElement).value || "";

    if (!start || !end) return;

    const startIso = formatIsoUtc(start);
    const endIso = formatIsoUtc(end);

    // Google Calendar URL
    const googleUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${startIso}/${endIso}&details=${encodeURIComponent(desc)}&location=${encodeURIComponent(location)}`;
    const btnGoogle = document.getElementById('btnGoogle') as HTMLAnchorElement;
    if (btnGoogle) btnGoogle.href = googleUrl;

    // Outlook URL
    const startD = new Date(start).toISOString();
    const endD = new Date(end).toISOString();
    const outlookUrl = `https://outlook.live.com/calendar/0/deeplink/compose?subject=${encodeURIComponent(title)}&startdt=${encodeURIComponent(startD)}&enddt=${encodeURIComponent(endD)}&body=${encodeURIComponent(desc)}&location=${encodeURIComponent(location)}`;
    const btnOutlook = document.getElementById('btnOutlook') as HTMLAnchorElement;
    if (btnOutlook) btnOutlook.href = outlookUrl;
  }

  function downloadIcs() {
    const title = (document.getElementById('eventTitle') as HTMLInputElement).value || "Evento";
    const start = startInput.value;
    const end = endInput.value;
    const location = (document.getElementById('eventLocation') as HTMLInputElement).value || "";
    const desc = (document.getElementById('eventDesc') as HTMLTextAreaElement).value || "";

    const startIso = formatIsoUtc(start);
    const endIso = formatIsoUtc(end);

    const icsData = [
      "BEGIN:VCALENDAR",
      "VERSION:2.0",
      "PRODID:-//GuiaTecnologica//Calendario//ES",
      "BEGIN:VEVENT",
      `SUMMARY:${title}`,
      `DESCRIPTION:${desc.replace(/\n/g, "\\n")}`,
      `LOCATION:${location}`,
      `DTSTART:${startIso}`,
      `DTEND:${endIso}`,
      `DTSTAMP:${formatIsoUtc(new Date().toISOString())}`,
      "UID:" + Date.now() + "@guiatecnes.com",
      "STATUS:CONFIRMED",
      "END:VEVENT",
      "END:VCALENDAR"
    ].join("\r\n");

    const blob = new Blob([icsData], { type: "text/calendar;charset=utf-8" });
    const link = document.createElement("a");
    link.href = window.URL.createObjectURL(blob);
    link.setAttribute("download", `${title.toLowerCase().replace(/[^a-z0-9]/g, "_")}.ics`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  // Global copy helper
  (window as any).copyLink = (id: string) => {
    const el = document.getElementById(id) as HTMLAnchorElement;
    if (el && el.href) {
      navigator.clipboard.writeText(el.href);
      alert("¡Enlace copiado al portapapeles!");
    }
  };

  document.querySelectorAll('input, textarea').forEach(el => {
    el.addEventListener('input', updateLinks);
  });

  document.getElementById('btnDownloadIcs')?.addEventListener('click', downloadIcs);

  updateLinks();
</script>

<style>
  .tool-container {
    max-width: 860px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 0.75rem;
  }
  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;
  }
  .badge {
    background: #ecfdf5;
    color: #059669;
    font-weight: 600;
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    text-transform: uppercase;
  }
  .tool-header h1 {
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0.5rem 0;
  }
  .tool-desc {
    color: #475569;
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .calculator-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
    margin: 2rem 0;
  }
  .form-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .grid-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 600px) {
    .grid-2col {
      grid-template-columns: 1fr;
    }
  }
  .input-group label {
    display: block;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 0.4rem;
  }
  .input-group input, .input-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 0.5rem;
    font-size: 1rem;
    color: #0f172a;
  }
  .results-box {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 2px dashed #e2e8f0;
  }
  .results-box h3 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    color: #0f172a;
  }
  .buttons-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .link-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .link-info {
    display: flex;
    flex-direction: column;
  }
  .link-title {
    font-weight: 700;
    color: #0f172a;
    font-size: 1.05rem;
  }
  .link-info small {
    color: #64748b;
    font-size: 0.8rem;
  }
  .link-actions {
    display: flex;
    gap: 0.5rem;
  }
  .action-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }
  .btn-primary {
    background: #2563eb;
    color: #ffffff;
  }
  .btn-primary:hover {
    background: #1d4ed8;
  }
  .btn-secondary {
    background: #e2e8f0;
    color: #334155;
  }
  .btn-secondary:hover {
    background: #cbd5e1;
  }
  .btn-success {
    background: #059669;
    color: #ffffff;
  }
  .btn-success:hover {
    background: #047857;
  }
  .tool-explanation {
    margin-top: 3rem;
    color: #334155;
    line-height: 1.7;
  }
</style>
