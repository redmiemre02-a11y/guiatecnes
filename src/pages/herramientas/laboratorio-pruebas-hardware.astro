---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas/' },
  { name: 'Laboratorio de Pruebas de Hardware', url: '/herramientas/laboratorio-pruebas-hardware/' }
];

const faqs = [
  {
    question: '¿Cómo detectar píxeles muertos o atascados con este test?',
    answer: 'Activa el modo Pantalla Completa en la pestaña Monitor y ve cambiando entre los colores Rojo, Verde, Azul, Blanco y Negro haciendo clic o usando las flechas del teclado. Un punto negro sobre todos los colores indica un píxel muerto, mientras que un punto fijo de un color sobre fondo negro indica un subpíxel atascado.'
  },
  {
    question: '¿Qué es el ghosting en un teclado y cómo lo compruebo?',
    answer: 'El efecto ghosting ocurre cuando pulsas varias teclas simultáneamente (por ejemplo, W + A + Shift + Espacio en un juego) y el teclado no registra alguna de ellas. En la pestaña Teclado puedes pulsar varias teclas a la vez y comprobar el contador de pulsaciones simultáneas en tiempo real.'
  },
  {
    question: '¿Cómo detecto el drift en mi mando de PS5, Xbox o Nintendo Switch?',
    answer: 'Conecta el mando por USB o Bluetooth a tu ordenador, ve a la pestaña Mando / Gamepad y pulsa cualquier botón para activarlo. Sin tocar los joysticks, observa los valores X e Y; si oscilan más allá de ±0.05 o no vuelven a 0.00 tras soltarlos, el potenciómetro presenta drift.'
  },
  {
    question: '¿Esta herramienta instala algo o accede a mis archivos?',
    answer: 'No. Todas las pruebas utilizan APIs nativas del navegador (Fullscreen API, Keyboard Events, Web Audio API y Gamepad API) de forma totalmente local y segura.'
  }
];
---

<BaseLayout
  title="Laboratorio de Pruebas de Hardware Online | Monitor, Teclado, Audio y Mando"
  description="Suite gratuita en el navegador para probar tu hardware: test de píxeles muertos en monitor, teclado y ghosting, altavoces estéreo y drift en mandos PS5/Xbox."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  alternates={{ es: '/herramientas/laboratorio-pruebas-hardware/', en: '/en/tools/hardware-test-lab/', pt: '/pt/ferramentas/laboratorio-testes-hardware/' }}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas/">Herramientas</a>
      <span>›</span>
      <span>Laboratorio de Hardware</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🖥️ Diagnóstico Físico en Vivo · Sin Descargas</div>
      <h1>Laboratorio de Pruebas de Hardware</h1>
      <p class="tool-subtitle">
        Comprueba en segundos si tu monitor nuevo tiene píxeles muertos, si tu teclado sufre ghosting, si tus auriculares invierten el estéreo o si tu mando tiene drift.
      </p>
    </header>

    <div class="lab-container card">
      <!-- TABS -->
      <div class="lab-tabs" role="tablist">
        <button type="button" class="lab-tab active" data-tab="monitor">🖥️ Monitor y Píxeles</button>
        <button type="button" class="lab-tab" data-tab="keyboard">⌨️ Teclado y Ghosting</button>
        <button type="button" class="lab-tab" data-tab="audio">🔊 Audio Estéreo y Hz</button>
        <button type="button" class="lab-tab" data-tab="gamepad">🎮 Mando / Drift</button>
      </div>

      <!-- TAB 1: MONITOR -->
      <section id="tab-monitor" class="lab-panel active">
        <h2>Test de Píxeles Muertos y Fugas de Luz (IPS Glow)</h2>
        <p class="panel-desc">
          Limpia ligeramente tu pantalla, inicia el modo <strong>Pantalla Completa</strong> y haz clic (o pulsa la flecha derecha) para alternar entre colores puros y detectar puntos defectuosos.
        </p>

        <div class="color-swatches">
          <button type="button" class="swatch-btn" data-color="#000000" style="background:#000000;color:#fff;">Negro (Fugas)</button>
          <button type="button" class="swatch-btn" data-color="#ffffff" style="background:#ffffff;color:#000;">Blanco (Suciedad)</button>
          <button type="button" class="swatch-btn" data-color="#ff0000" style="background:#ff0000;color:#fff;">Rojo Puro</button>
          <button type="button" class="swatch-btn" data-color="#00ff00" style="background:#00ff00;color:#000;">Verde Puro</button>
          <button type="button" class="swatch-btn" data-color="#0000ff" style="background:#0000ff;color:#fff;">Azul Puro</button>
        </div>

        <button type="button" id="btn-start-pixel" class="btn-primary">⛶ Iniciar Test en Pantalla Completa</button>
        <p class="hint-text">Pulsa <code>ESC</code> en cualquier momento para salir del modo pantalla completa.</p>
      </section>

      <!-- TAB 2: KEYBOARD -->
      <section id="tab-keyboard" class="lab-panel">
        <h2>Comprobador de Teclado, Pulsaciones y Anti-Ghosting</h2>
        <p class="panel-desc">
          Pulsa cualquier tecla o mantén varias teclas pulsadas a la vez para comprobar el límite de detección simultánea (N-Key Rollover) y detectar teclas defectuosas o repetidas.
        </p>

        <div class="kb-stats">
          <div class="stat-box">
            <span class="stat-label">Última Tecla</span>
            <strong id="kb-last-key" class="stat-val">—</strong>
          </div>
          <div class="stat-box">
            <span class="stat-label">Código Interno</span>
            <strong id="kb-last-code" class="stat-val">—</strong>
          </div>
          <div class="stat-box">
            <span class="stat-label">Simultáneas Ahora</span>
            <strong id="kb-simultaneous" class="stat-val highlight">0</strong>
          </div>
          <div class="stat-box">
            <span class="stat-label">Máx. Simultáneas</span>
            <strong id="kb-max-sim" class="stat-val">0</strong>
          </div>
        </div>

        <div class="kb-active-list-wrap">
          <span class="mini-label">Teclas mantenidas actualmente:</span>
          <div id="kb-active-pills" class="kb-pills">Ninguna tecla pulsada</div>
        </div>

        <div class="kb-history-wrap">
          <div class="history-header">
            <span class="mini-label">Historial de pulsaciones probadas (<span id="kb-unique-count">0</span> únicas):</span>
            <button type="button" id="btn-kb-reset" class="btn-sm">Limpiar</button>
          </div>
          <div id="kb-history" class="kb-history-grid"></div>
        </div>
      </section>

      <!-- TAB 3: AUDIO -->
      <section id="tab-audio" class="lab-panel">
        <h2>Test de Altavoces Estéreo (Izquierdo / Derecho) y Frecuencia</h2>
        <p class="panel-desc">
          Verifica si tus auriculares están puestos al revés, comprueba la respuesta de graves/agudos o emite un tono puro mediante Web Audio API sin abrir archivos externos.
        </p>

        <div class="audio-controls-grid">
          <button type="button" class="audio-btn" id="btn-audio-left">
            <span>◀️ Canal Izquierdo (L)</span>
            <small>440 Hz · Solo oído izquierdo</small>
          </button>
          <button type="button" class="audio-btn" id="btn-audio-right">
            <span>Canal Derecho (R) ▶️</span>
            <small>440 Hz · Solo oído derecho</small>
          </button>
          <button type="button" class="audio-btn" id="btn-audio-both">
            <span>🔊 Ambos Canales (Centro)</span>
            <small>440 Hz · Estéreo equilibrado</small>
          </button>
        </div>

        <div class="freq-tester card-inner">
          <div class="freq-top">
            <label for="freq-slider">Generador de Frecuencia Pura: <strong id="freq-display">165 Hz</strong></label>
            <button type="button" id="btn-freq-toggle" class="btn-primary">▶ Reproducir Tono</button>
          </div>
          <input type="range" id="freq-slider" min="20" max="16000" value="165" step="5" />
          <div class="freq-marks">
            <span>20 Hz (Sub-graves)</span>
            <span>165 Hz (Limpieza altavoz)</span>
            <span>1000 Hz (Voz)</span>
            <span>16 kHz (Agudos)</span>
          </div>
        </div>
      </section>

      <!-- TAB 4: GAMEPAD -->
      <section id="tab-gamepad" class="lab-panel">
        <h2>Test de Mando y Detección de Drift en Joysticks</h2>
        <p class="panel-desc">
          Conecta tu mando de PS5, PS4, Xbox o PC y <strong>pulsa cualquier botón</strong> para que el navegador lo reconozca.
        </p>

        <div id="gp-status" class="gp-status">
          ⏳ Esperando mando... Conéctalo y pulsa un botón (X, A, Start...).
        </div>

        <div id="gp-dashboard" class="gp-dashboard" style="display:none;">
          <div class="sticks-grid">
            <div class="stick-card">
              <h3>Joystick Izquierdo (L)</h3>
              <div class="stick-pad"><div id="dot-l" class="stick-dot"></div></div>
              <div class="axis-readout">
                X: <strong id="lx-val">0.00</strong> | Y: <strong id="ly-val">0.00</strong>
              </div>
            </div>
            <div class="stick-card">
              <h3>Joystick Derecho (R)</h3>
              <div class="stick-pad"><div id="dot-r" class="stick-dot"></div></div>
              <div class="axis-readout">
                X: <strong id="rx-val">0.00</strong> | Y: <strong id="ry-val">0.00</strong>
              </div>
            </div>
          </div>

          <div class="gp-buttons-wrap">
            <h3>Botones Detectados Activos:</h3>
            <div id="gp-buttons" class="gp-buttons-grid"></div>
          </div>
        </div>
      </section>
    </div>

    <section class="seo-guide card">
      <h2>Guía rápida para interpretar tus pruebas de hardware</h2>
      <ul>
        <li><strong>Píxeles muertos vs Atascados:</strong> Si ves un punto negro permanente sobre rojo, verde, azul y blanco, es un píxel muerto físico. Si ves un punto rojo, verde o azul brillante sobre fondo negro, es un subpíxel atascado que a veces puede recuperarse con cambios rápidos de color.</li>
        <li><strong>Fugas de luz (Backlight Bleed):</strong> Con la pantalla en Negro Puro y la habitación a oscuras, es normal un ligero brillo uniforme en paneles IPS (IPS Glow), pero manchas amarillentas intensas en los bordes indican presión excesiva del marco.</li>
        <li><strong>Drift en joysticks:</strong> Si al soltar las palancas los valores X o Y se quedan por encima de <code>0.06</code> o por debajo de <code>-0.06</code>, tu mando necesita calibración de zona muerta o limpieza del sensor.</li>
      </ul>

      <h3>Preguntas Frecuentes</h3>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <!-- FULLSCREEN PIXEL TEST OVERLAY -->
  <div id="pixel-overlay" class="pixel-overlay" style="display:none;">
    <div id="pixel-hint" class="pixel-hint">
      Haz clic o pulsa la flecha → para cambiar color · ESC para salir
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (function() {
    // --- TABS ---
    const tabs = document.querySelectorAll('.lab-tab');
    const panels = document.querySelectorAll('.lab-panel');
    tabs.forEach(t => {
      t.addEventListener('click', () => {
        const target = t.getAttribute('data-tab');
        tabs.forEach(x => x.classList.toggle('active', x === t));
        panels.forEach(p => p.classList.toggle('active', p.id === `tab-${target}`));
      });
    });

    // --- 1. MONITOR PIXEL TEST ---
    const colors = ['#000000', '#ffffff', '#ff0000', '#00ff00', '#0000ff', '#ffff00', '#00ffff', '#ff00ff'];
    let colorIdx = 0;
    const overlay = document.getElementById('pixel-overlay');
    const hint = document.getElementById('pixel-hint');

    function startPixelTest(startColor) {
      const idx = colors.indexOf(startColor);
      colorIdx = idx >= 0 ? idx : 0;
      overlay.style.backgroundColor = colors[colorIdx];
      overlay.style.display = 'flex';
      hint.style.opacity = '1';
      setTimeout(() => { hint.style.opacity = '0'; }, 2600);
      if (overlay.requestFullscreen) {
        overlay.requestFullscreen().catch(() => {});
      }
    }

    document.querySelectorAll('.swatch-btn').forEach(btn => {
      btn.addEventListener('click', () => startPixelTest(btn.getAttribute('data-color')));
    });

    document.getElementById('btn-start-pixel').addEventListener('click', () => startPixelTest('#000000'));

    overlay.addEventListener('click', () => {
      colorIdx = (colorIdx + 1) % colors.length;
      overlay.style.backgroundColor = colors[colorIdx];
    });

    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        overlay.style.display = 'none';
      }
    });

    document.addEventListener('keydown', (e) => {
      if (overlay.style.display === 'flex') {
        if (e.key === 'ArrowRight' || e.key === ' ') {
          e.preventDefault();
          colorIdx = (colorIdx + 1) % colors.length;
          overlay.style.backgroundColor = colors[colorIdx];
        } else if (e.key === 'Escape') {
          overlay.style.display = 'none';
          if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
        }
      }
    });

    // --- 2. KEYBOARD TESTER ---
    const activeKeys = new Set();
    const testedCodes = new Set();
    let maxSim = 0;

    function updateKbUI() {
      document.getElementById('kb-simultaneous').textContent = activeKeys.size;
      if (activeKeys.size > maxSim) {
        maxSim = activeKeys.size;
        document.getElementById('kb-max-sim').textContent = maxSim;
      }
      const pillsEl = document.getElementById('kb-active-pills');
      if (activeKeys.size === 0) {
        pillsEl.innerHTML = '<span class="muted">Ninguna tecla pulsada</span>';
      } else {
        pillsEl.innerHTML = Array.from(activeKeys).map(c => `<span class="key-pill">${c}</span>`).join('');
      }
    }

    window.addEventListener('keydown', (e) => {
      const kbPanel = document.getElementById('tab-keyboard');
      if (!kbPanel.classList.contains('active')) return;
      if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Tab'].includes(e.code)) {
        e.preventDefault();
      }
      document.getElementById('kb-last-key').textContent = e.key === ' ' ? 'Espacio' : e.key;
      document.getElementById('kb-last-code').textContent = e.code;

      activeKeys.add(e.code);
      if (!testedCodes.has(e.code)) {
        testedCodes.add(e.code);
        document.getElementById('kb-unique-count').textContent = testedCodes.size;
        const badge = document.createElement('span');
        badge.className = 'tested-key';
        badge.textContent = e.code;
        document.getElementById('kb-history').prepend(badge);
      }
      updateKbUI();
    });

    window.addEventListener('keyup', (e) => {
      activeKeys.delete(e.code);
      updateKbUI();
    });

    document.getElementById('btn-kb-reset').addEventListener('click', () => {
      activeKeys.clear();
      testedCodes.clear();
      maxSim = 0;
      document.getElementById('kb-last-key').textContent = '—';
      document.getElementById('kb-last-code').textContent = '—';
      document.getElementById('kb-max-sim').textContent = '0';
      document.getElementById('kb-unique-count').textContent = '0';
      document.getElementById('kb-history').innerHTML = '';
      updateKbUI();
    });

    // --- 3. WEB AUDIO API ---
    let audioCtx = null;
    function getAudioCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playChime(panVal) {
      const ctx = getAudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const panner = ctx.createStereoPanner ? ctx.createStereoPanner() : null;

      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, ctx.currentTime);
      gain.gain.setValueAtTime(0.001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.35, ctx.currentTime + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.9);

      if (panner) {
        panner.pan.setValueAtTime(panVal, ctx.currentTime);
        osc.connect(gain).connect(panner).connect(ctx.destination);
      } else {
        osc.connect(gain).connect(ctx.destination);
      }
      osc.start();
      osc.stop(ctx.currentTime + 0.95);
    }

    document.getElementById('btn-audio-left').addEventListener('click', () => playChime(-1));
    document.getElementById('btn-audio-right').addEventListener('click', () => playChime(1));
    document.getElementById('btn-audio-both').addEventListener('click', () => playChime(0));

    let sweepOsc = null;
    let sweepGain = null;
    const freqSlider = document.getElementById('freq-slider');
    const freqDisplay = document.getElementById('freq-display');
    const btnFreqToggle = document.getElementById('btn-freq-toggle');

    freqSlider.addEventListener('input', () => {
      freqDisplay.textContent = `${freqSlider.value} Hz`;
      if (sweepOsc && audioCtx) {
        sweepOsc.frequency.setValueAtTime(Number(freqSlider.value), audioCtx.currentTime);
      }
    });

    btnFreqToggle.addEventListener('click', () => {
      if (sweepOsc) {
        sweepOsc.stop();
        sweepOsc.disconnect();
        sweepOsc = null;
        btnFreqToggle.textContent = '▶ Reproducir Tono';
      } else {
        const ctx = getAudioCtx();
        sweepOsc = ctx.createOscillator();
        sweepGain = ctx.createGain();
        sweepOsc.type = 'sine';
        sweepOsc.frequency.setValueAtTime(Number(freqSlider.value), ctx.currentTime);
        sweepGain.gain.setValueAtTime(0.2, ctx.currentTime);
        sweepOsc.connect(sweepGain).connect(ctx.destination);
        sweepOsc.start();
        btnFreqToggle.textContent = '⏹ Detener Tono';
      }
    });

    // --- 4. GAMEPAD API ---
    let gpLoop = null;
    function pollGamepads() {
      const gps = navigator.getGamepads ? navigator.getGamepads() : [];
      const activeGp = Array.from(gps).find(g => g && g.connected);
      const statusEl = document.getElementById('gp-status');
      const dashEl = document.getElementById('gp-dashboard');

      if (!activeGp) {
        statusEl.textContent = '⏳ Esperando mando... Conéctalo y pulsa un botón (X, A, Start...).';
        dashEl.style.display = 'none';
      } else {
        statusEl.textContent = `✅ Conectado: ${activeGp.id}`;
        dashEl.style.display = 'block';

        const lx = activeGp.axes[0] || 0;
        const ly = activeGp.axes[1] || 0;
        const rx = activeGp.axes[2] || 0;
        const ry = activeGp.axes[3] || 0;

        document.getElementById('lx-val').textContent = lx.toFixed(2);
        document.getElementById('ly-val').textContent = ly.toFixed(2);
        document.getElementById('rx-val').textContent = rx.toFixed(2);
        document.getElementById('ry-val').textContent = ry.toFixed(2);

        document.getElementById('dot-l').style.transform = `translate(${lx * 38}px, ${ly * 38}px)`;
        document.getElementById('dot-r').style.transform = `translate(${rx * 38}px, ${ry * 38}px)`;

        const btnsHtml = activeGp.buttons.map((b, i) =>
          `<div class="gp-btn ${b.pressed ? 'pressed' : ''}">B${i}</div>`
        ).join('');
        document.getElementById('gp-buttons').innerHTML = btnsHtml;
      }

      if (document.getElementById('tab-gamepad').classList.contains('active')) {
        gpLoop = requestAnimationFrame(pollGamepads);
      } else {
        gpLoop = null;
      }
    }

    tabs.forEach(t => {
      t.addEventListener('click', () => {
        if (t.getAttribute('data-tab') === 'gamepad' && !gpLoop) {
          pollGamepads();
        }
      });
    });

    window.addEventListener('gamepadconnected', () => {
      if (document.getElementById('tab-gamepad').classList.contains('active') && !gpLoop) {
        pollGamepads();
      }
    });
  })();
</script>

<style>
  .tool-page { padding: 2rem 1rem 4rem; max-width: 960px; margin: 0 auto; }
  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; flex-wrap: wrap; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .tool-header { text-align: center; margin-bottom: 2rem; }
  .tool-badge { display: inline-block; background: rgba(16, 185, 129, 0.14); color: #34d399; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; border: 1px solid rgba(16, 185, 129, 0.28); }
  .tool-header h1 { font-size: clamp(1.75rem, 3.5vw, 2.4rem); line-height: 1.2; margin-bottom: 0.75rem; }
  .tool-subtitle { color: var(--text-muted); font-size: 1.05rem; max-width: 720px; margin: 0 auto; line-height: 1.6; }

  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.75rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  .lab-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.5rem; }
  .lab-tab { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); padding: 0.65rem 1.05rem; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 0.92rem; transition: all 0.2s; }
  .lab-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }

  .lab-panel { display: none; }
  .lab-panel.active { display: block; animation: fadeIn 0.2s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .lab-panel h2 { font-size: 1.35rem; margin-bottom: 0.6rem; }
  .panel-desc { color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.55; }

  .color-swatches { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .swatch-btn { padding: 0.75rem 1.1rem; border-radius: 10px; border: 2px solid var(--border); font-weight: 600; cursor: pointer; font-size: 0.88rem; }

  .btn-primary { background: var(--primary); color: #fff; border: none; padding: 0.75rem 1.35rem; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 0.95rem; }
  .btn-sm { background: var(--bg); color: var(--text); border: 1px solid var(--border); padding: 0.3rem 0.75rem; border-radius: 6px; font-size: 0.82rem; cursor: pointer; }
  .hint-text { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.85rem; }

  .kb-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.85rem; margin-bottom: 1.25rem; }
  .stat-box { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem; text-align: center; }
  .stat-label { display: block; font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.25rem; }
  .stat-val { font-size: 1.25rem; font-family: monospace; }
  .stat-val.highlight { color: #34d399; }

