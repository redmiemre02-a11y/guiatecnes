---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Calculadora de Propinas y División de Cuenta', url: '/herramientas/calculadora-propinas' }
];

const faqs = [
  {
    question: '¿Es obligatorio dejar propina en España y Europa?',
    answer: 'No. En España y en la gran mayoría de países de la Unión Europea el servicio y el sueldo de los camareros ya están incluidos por ley en el precio de la carta (IVA incluido). No obstante, es habitual dejar entre un 5% y un 10% voluntario en caso de un servicio excelente o mesas grandes.'
  },
  {
    question: '¿Cómo funciona la división de cuenta con propina?',
    answer: 'La herramienta calcula el importe total sumando la cuenta original más el porcentaje de propina elegido. Posteriormente, divide ese total exacto entre el número de comensales para que cada amigo pague su parte equitativa sin discusiones.'
  },
  {
    question: '¿Qué es el botón de compartir por WhatsApp?',
    answer: 'Genera un mensaje de texto formateado con el importe exacto por persona y el total, listo para enviar al grupo de WhatsApp de amigos o compañeros de trabajo para solicitar el pago por Bizum o transferencia.'
  },
  {
    question: '¿Cuánto se suele dejar de propina en Estados Unidos?',
    answer: 'En EE.UU. la propina (tip) es prácticamente obligatoria debido al sistema salarial de la hostelería. Lo estándar oscila entre el 15% y el 22% sobre el importe total de la cuenta antes de impuestos.'
  }
];
---

<BaseLayout
  title="Calculadora de Propinas y División de Cuenta entre Amigos | GuiaTecnEs"
  description="Calcula cuánto pagar de propina y divide la cuenta del restaurante fácilmente entre amigos. Con redondeo y botón para enviar por WhatsApp o Bizum."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header slot="header" />

  <main class="tool-page container">
    <div class="breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/herramientas">Herramientas</a>
      <span>›</span>
      <span>Calculadora de Propinas</span>
    </div>

    <header class="tool-header">
      <div class="tool-badge">🧾 Restaurantes, Bares y Cenas con Amigos</div>
      <h1>Calculadora de Propinas y División de Cuentas</h1>
      <p class="tool-subtitle">
        Calcula la propina justa, divide el ticket entre los comensales y envía el importe por persona a tu grupo de WhatsApp con un solo clic.
      </p>
    </header>

    <div class="tip-calc-grid">
      <!-- FORMULARIO -->
      <div class="card form-card">
        <h3>🍽️ Datos de la Cuenta</h3>

        <div class="input-group">
          <label for="bill-amount">Total del Ticket / Cuenta (€):</label>
          <div class="input-currency-wrapper">
            <input type="number" id="bill-amount" value="65.00" min="0" step="0.5" />
            <span class="currency-symbol">€</span>
          </div>
        </div>

        <div class="input-group">
          <label>Porcentaje de Propina:</label>
          <div class="tip-presets-grid">
            <button type="button" class="tip-btn" data-pct="0">0% (Nada)</button>
            <button type="button" class="tip-btn active" data-pct="10">10% (Estándar)</button>
            <button type="button" class="tip-btn" data-pct="15">15% (Buen trato)</button>
            <button type="button" class="tip-btn" data-pct="20">20% (Excelente)</button>
          </div>
          <div class="custom-tip-wrapper">
            <span>O porcentaje manual:</span>
            <input type="number" id="custom-tip-input" placeholder="Ej: 8" min="0" max="100" />
            <span>%</span>
          </div>
        </div>

        <div class="input-group">
          <label for="people-count">👥 Número de Personas (Comensales):</label>
          <div class="people-counter-wrapper">
            <button type="button" id="btn-minus-people" class="btn-step">-</button>
            <input type="number" id="people-count" value="4" min="1" max="100" />
            <button type="button" id="btn-plus-people" class="btn-step">+</button>
          </div>
        </div>

        <div class="input-group checkbox-group">
          <label class="toggle-checkbox">
            <input type="checkbox" id="round-up-toggle" />
            <span>Redondear total al alza (sin decimales incómodos)</span>
          </label>
        </div>
      </div>

      <!-- RESULTADOS -->
      <div class="card results-card">
        <h3>Resumen a Pagar</h3>

        <div class="per-person-highlight">
          <span class="highlight-label">Cada persona paga:</span>
          <div class="highlight-amount" id="per-person-total">17,88 €</div>
          <span class="highlight-sub" id="per-person-tip-sub">(incluye 1,63 € de propina)</span>
        </div>

        <div class="summary-breakdown">
          <div class="summary-row">
            <span>Importe cuenta original:</span>
            <strong id="sum-bill">65,00 €</strong>
          </div>
          <div class="summary-row">
            <span>Propina total (<span id="sum-tip-pct">10%</span>):</span>
            <strong id="sum-tip-val">6,50 €</strong>
          </div>
          <div class="summary-row total-row">
            <span>Total a pagar en mesa:</span>
            <strong id="sum-grand-total">71,50 €</strong>
          </div>
        </div>

        <!-- ACCIONES COMPARTIR -->
        <div class="share-actions-wrap">
          <button type="button" id="btn-share-whatsapp" class="btn-whatsapp-share">
            <span>💬</span> Pedir Bizum por WhatsApp
          </button>
          <button type="button" id="btn-copy-summary" class="btn-copy-summary">
            📋 Copiar Resumen
          </button>
          <button type="button" id="btn-print-tip" class="btn-print-summary">
            📄 Imprimir / Guardar PDF
          </button>
        </div>
      </div>
    </div>

    <!-- GUÍA SEO -->
    <section class="seo-guide-section card">
      <h2>Guía de Propinas: ¿Cuánto se deja en cada país?</h2>
      <p>
        El protocolo y la costumbre sobre las propinas varía radicalmente según la parte del mundo en la que te encuentres:
      </p>

      <div class="guide-grid">
        <div class="guide-box">
          <h3>🇪🇸 España y Europa</h3>
          <p>
            No es obligatoria. Se suele dejar entre un <strong>5% y un 10%</strong> en restaurantes si la comida y la atención han sido muy buenas, o redondear la cuenta al euro superior en bares y cafeterías.
          </p>
        </div>
        <div class="guide-box">
          <h3>🇺🇸 Estados Unidos y Canadá</h3>
          <p>
            Casi mandatoria. Se espera entre un <strong>15% y un 22%</strong>, ya que forma la base de la remuneración de los camareros. Dejar menos del 15% suele interpretarse como un descontento grave.
          </p>
        </div>
        <div class="guide-box">
          <h3>🇲🇽 México y Latinoamérica</h3>
          <p>
            Lo habitual en restaurantes con servicio a mesa es dejar entre un <strong>10% y un 15%</strong>. En muchos lugares te preguntarán amablemente si deseas «incluir el servicio».
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section card">
      <h2>Preguntas Frecuentes sobre la Calculadora de Propinas</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{faq.question}</strong></summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .tool-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .tool-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .tool-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.25);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .tool-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .tip-calc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 860px) {
    .tip-calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 1.25rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .input-group label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-heading);
  }

  .input-currency-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-currency-wrapper input {
    width: 100%;
    padding: 0.75rem 2.5rem 0.75rem 0.85rem;
    border-radius: 0.6rem;
    border: 1px solid var(--border-color, #334155);
    background: var(--input-bg, #0f172a);
    color: var(--text-heading);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .currency-symbol {
    position: absolute;
    right: 1rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-muted);
    pointer-events: none;
  }

  .tip-presets-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .tip-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.5rem;
    padding: 0.6rem 0.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-heading);
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
  }

  .tip-btn:hover {
    background: rgba(245, 158, 11, 0.2);
    border-color: #f59e0b;
  }

  .tip-btn.active {
    background: #f59e0b;
    color: #000;
    border-color: #f59e0b;
  }

  .custom-tip-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .custom-tip-wrapper input {
    width: 80px;
    padding: 0.4rem 0.6rem;
    border-radius: 0.4rem;
    border: 1px solid var(--border-color, #334155);
    background: var(--input-bg, #0f172a);
    color: var(--text-heading);
    font-size: 0.9rem;
  }

  .people-counter-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-step {
    width: 44px;
    height: 44px;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-heading);
    font-size: 1.3rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s;
  }

  .btn-step:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .people-counter-wrapper input {
    flex: 1;
    text-align: center;
    font-size: 1.2rem;
    font-weight: 700;
    padding: 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-color, #334155);
    background: var(--input-bg, #0f172a);
    color: var(--text-heading);
  }

  .toggle-checkbox {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  /* RESULTS CARD */
  .per-person-highlight {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(234, 88, 12, 0.1));
    border: 2px solid #f59e0b;
    border-radius: 0.85rem;
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .highlight-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #f59e0b;
    margin-bottom: 0.35rem;
  }

  .highlight-amount {
    font-size: 2.7rem;
    font-weight: 900;
    color: var(--text-heading);
    line-height: 1.1;
  }

  .highlight-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .summary-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    color: var(--text-muted);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border-color, #334155);
  }

  .summary-row strong {
    color: var(--text-heading);
  }

  .summary-row.total-row {
    border-bottom: none;
    border-top: 2px solid var(--border-color, #334155);
    padding-top: 0.75rem;
    font-size: 1.1rem;
    color: var(--text-heading);
  }

  .summary-row.total-row strong {
    color: #f59e0b;
  }

  .share-actions-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .btn-whatsapp-share {
    background: #25d366;
    color: #ffffff;
    border: none;
    padding: 0.85rem;
    border-radius: 0.65rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
    transition: transform 0.15s, opacity 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .btn-whatsapp-share:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  .btn-copy-summary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-heading);
    padding: 0.65rem;
    border-radius: 0.65rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }

  .btn-copy-summary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* SEO GUIDE & FAQ */
  .seo-guide-section {
    margin-bottom: 2rem;
  }

  .seo-guide-section h2, .faq-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 1rem;
  }

  .seo-guide-section p {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color, #334155);
    padding: 1.25rem;
    border-radius: 0.75rem;
  }

  .guide-box h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .guide-box p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .faq-section {
    margin-bottom: 2rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.65rem;
    padding: 0.85rem 1.15rem;
  }

  .faq-question {
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--text-heading);
  }

  .faq-answer {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .btn-print-summary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color, #334155);
    color: var(--text-heading, #f8fafc);
    padding: 0.75rem 1rem;
    border-radius: 0.65rem;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s;
    width: 100%;
  }

  .btn-print-summary:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  @media print {
    header, footer, .breadcrumb, .seo-guide-section, .faq-section, .share-actions-wrap, .tool-page .tool-subtitle, .tool-badge {
      display: none !important;
    }
    body {
      background: #ffffff !important;
      color: #0f172a !important;
    }
    .tip-calc-grid {
      grid-template-columns: 1fr 1fr !important;
      gap: 1.5rem !important;
    }
    .card {
      box-shadow: none !important;
      border: 1px solid #cbd5e1 !important;
      background: #ffffff !important;
      color: #0f172a !important;
    }
  }
</style>

<script>
  function initTipCalculator() {
    const billInput = document.getElementById('bill-amount') as HTMLInputElement;
    const peopleInput = document.getElementById('people-count') as HTMLInputElement;
    const customTipInput = document.getElementById('custom-tip-input') as HTMLInputElement;
    const roundUpToggle = document.getElementById('round-up-toggle') as HTMLInputElement;
    const tipBtns = document.querySelectorAll('.tip-btn');
    const btnMinus = document.getElementById('btn-minus-people');
    const btnPlus = document.getElementById('btn-plus-people');

    // Outputs
    const perPersonTotalEl = document.getElementById('per-person-total');
    const perPersonTipSubEl = document.getElementById('per-person-tip-sub');
    const sumBillEl = document.getElementById('sum-bill');
    const sumTipPctEl = document.getElementById('sum-tip-pct');
    const sumTipValEl = document.getElementById('sum-tip-val');
    const sumGrandTotalEl = document.getElementById('sum-grand-total');

    const btnShareWa = document.getElementById('btn-share-whatsapp');
    const btnCopySummary = document.getElementById('btn-copy-summary');

    let currentTipPct = 10;

    function formatEur(num: number): string {
      return num.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    }

    function calculate() {
      const bill = Math.max(0, parseFloat(billInput.value) || 0);
      const people = Math.max(1, parseInt(peopleInput.value, 10) || 1);

      let tipPct = currentTipPct;
      if (customTipInput.value.trim() !== '') {
        tipPct = Math.max(0, parseFloat(customTipInput.value) || 0);
      }

      let tipVal = bill * (tipPct / 100);
      let grandTotal = bill + tipVal;

      if (roundUpToggle.checked && grandTotal > 0) {
        grandTotal = Math.ceil(grandTotal);
        tipVal = Math.max(0, grandTotal - bill);
      }

      const perPersonTotal = grandTotal / people;
      const perPersonTip = tipVal / people;

      if (perPersonTotalEl) perPersonTotalEl.textContent = formatEur(perPersonTotal);
      if (perPersonTipSubEl) perPersonTipSubEl.textContent = `(incluye ${formatEur(perPersonTip)} de propina)`;
      if (sumBillEl) sumBillEl.textContent = formatEur(bill);
      if (sumTipPctEl) sumTipPctEl.textContent = `${tipPct}%`;
      if (sumTipValEl) sumTipValEl.textContent = formatEur(tipVal);
      if (sumGrandTotalEl) sumGrandTotalEl.textContent = formatEur(grandTotal);
    }

    tipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tipBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentTipPct = parseFloat(btn.getAttribute('data-pct') || '10');
        if (customTipInput) customTipInput.value = '';
        calculate();
      });
    });

    customTipInput?.addEventListener('input', () => {
      tipBtns.forEach(b => b.classList.remove('active'));
      calculate();
    });

    btnMinus?.addEventListener('click', () => {
      const p = Math.max(1, (parseInt(peopleInput.value, 10) || 1) - 1);
      peopleInput.value = p.toString();
      calculate();
    });

    btnPlus?.addEventListener('click', () => {
      const p = (parseInt(peopleInput.value, 10) || 1) + 1;
      peopleInput.value = p.toString();
      calculate();
    });

    [billInput, peopleInput, roundUpToggle].forEach(el => {
      el?.addEventListener('input', calculate);
      el?.addEventListener('change', calculate);
    });

    // Share by WhatsApp
    btnShareWa?.addEventListener('click', () => {
      const bill = billInput.value || '0';
      const perPerson = perPersonTotalEl?.textContent || '0 €';
      const people = peopleInput.value || '1';
      const grandTotal = sumGrandTotalEl?.textContent || '0 €';

      const msg = `¡Hola a todos! 🍕🍻\nHemos hecho la cuenta del restaurante:\n- Total con propina: ${grandTotal}\n- Somos: ${people} personas\n👉 Nos toca a: *${perPerson}* por persona.\n¡Podéis ir haciendo el Bizum!`;
      const url = `https://wa.me/?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
    });

    btnCopySummary?.addEventListener('click', () => {
      const perPerson = perPersonTotalEl?.textContent || '0 €';
      const people = peopleInput.value || '1';
      const grandTotal = sumGrandTotalEl?.textContent || '0 €';
      const text = `Cuenta total: ${grandTotal} (${people} personas) -> A pagar: ${perPerson}/persona.`;
      navigator.clipboard.writeText(text);
      btnCopySummary.textContent = '¡Copiado!';
      setTimeout(() => {
        btnCopySummary.textContent = '📋 Copiar Resumen';
      }, 1500);
    });

    document.getElementById('btn-print-tip')?.addEventListener('click', () => {
      window.print();
    });

    calculate();
  }

  document.addEventListener('astro:page-load', initTipCalculator);
</script>
